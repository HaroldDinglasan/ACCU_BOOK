@page "/Descriptions/{ownercode}"
@* @page "/Accountdialog/{id:guid}" *@
@attribute [Authorize(Roles = "Admin,User")]
@inject HttpClient http
@inject NotificationService notificationService
@inject NavigationManager navigationManager


@if (isloading == false)
{
    <RadzenTemplateForm Submit="@Submit" TItem="Descriptions" Data="descriptions">

        <RadzenDataGrid EditMode="@editMode" @ref="grid" ColumnWidth="90px" Style="height: 75vh"
                        Data="@descriptionsList" AllowColumnResize=true RowCreate="@OnCreateRow"
                        TItem="Descriptions" RowUpdate="@OnUpdateRow">
            @*   <HeaderTemplate>
                        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New Order" Size="ButtonSize.ExtraSmall" Click="@InsertRow" Disabled="@(editMode == DataGridEditMode.Single && quotationsDetailsToInsert.Count() > 0)" />
                    </HeaderTemplate> *@
            <HeaderTemplate>
                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New"
                              Click="@(() => InsertAfterRow(descriptionsList.LastOrDefault()))" title="Add new row after this row"
                              Disabled="@(descriptionsDetailsToInsert.Any() || descriptionsDetailsToUpdate.Any())" />
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn Width="20px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                    <Template Context="data">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                      Click="@(args => EditRow(data))" title="Edit this row" />
                    </Template>
                    <EditTemplate Context="data">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(data))" title="Save" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="200px" TItem="Descriptions" Property="@nameof(Descriptions.Description)" Title="Description">
                    <EditTemplate Context="data">
                        <RadzenTextBox style="width: 100%;" @bind-Value="@data.Description" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="30px" TItem="Descriptions" Title="Default">
                    <Template Context="data">
                        @if (data.IsDefault)
                        {
                          
                            <RadzenIcon Icon="done" IconColor="@Colors.Success" />
                        }
                        else
                        {
                            
                            <RadzenIcon Icon="cancel" IconColor="@Colors.Danger" />
                        
                        }

                    </Template>

                    <EditTemplate Context="data">
                        <RadzenCheckBox TValue="bool"
                                        Value="@data.IsDefault"
                                        Change="@(args => OnDefaultChanged(data, args))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    <br/>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right">
        <RadzenRow>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="Check" Text="OK" Click="@(() => DialogService.Close())" />
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="close" Text="CANCEL" Click="@(() => DialogService.Close())" />
        </RadzenRow>

    </RadzenStack>
</RadzenTemplateForm>
}
else
{
    <Spinner />
}



@*Purchaser Table Here:*@
@code {

    private void OnDefaultChanged(Descriptions selectedItem, bool isChecked)
    {
        if (isChecked)
        {
            // Uncheck all other items
            foreach (var item in descriptionsList)
            {
                if (item != selectedItem)
                {
                    item.IsDefault = false;
                }
            }
            selectedItem.IsDefault = true;
        }
        else
        {
            // If unchecking, just set this item to false
            selectedItem.IsDefault = false;
        }

        // Refresh the grid to reflect changes
        StateHasChanged();
    }

    [Parameter]
    public string OwnerCode { get; set; }
