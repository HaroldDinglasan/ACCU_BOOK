    private async Task LoadDescriptionsByCode()
    {

        await GetDescriptions();
        isloading = false;

    }
    private List<Descriptions> descriptionsList { get; set; }
    protected async Task GetDescriptions()
    {
        var data = await descriptionsService.GetDescriptions(descriptionFilter);
        descriptionsList = data is not null ? data.ToList() : new List<Descriptions>();
    }


    async Task InsertAfterRow(Descriptions descriptions)
    {
        if (descriptionsDetailsToInsert.Any() || descriptionsDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!grid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var newdescriptions = new Descriptions();
        descriptionsDetailsToInsert.Add(newdescriptions);
        // var index = descriptionsList.IndexOf(descriptions);
        // if (index >= 0)
        // {
        //     descriptionsList.Insert(index + 1, newdescriptions); // Insert after selected row
        // }
        // else
        // {
        descriptionsList.Add(newdescriptions);
        // }


        // if (descriptions is not null)
        // {
        //     await grid.InsertAfterRow(newdescriptions, descriptions);
        // }
        // else
        // {
        await grid.InsertRow(newdescriptions);
        // }

        // await grid.Reload();
        StateHasChanged();


    }

    async Task EditRow(Descriptions descriptions)
    {
        if (descriptionsDetailsToInsert.Any() || descriptionsDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!grid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        descriptionsDetailsToUpdate.Add(descriptions);
        await grid.EditRow(descriptions);
        StateHasChanged(); // Ensure UI updates and list is reflected
    }


    async Task SaveRow(Descriptions descriptions)
    {

        await grid.UpdateRow(descriptions);
        await grid.Reload();
        StateHasChanged();
    }


    void OnUpdateRow(Descriptions descriptions)
    {
        Reset(descriptions);

    }

    void OnCreateRow(Descriptions descriptions)
    {
        descriptionsDetailsToInsert.Remove(descriptions);
    }

    void Reset(Descriptions descriptions)
    {
        descriptionsDetailsToInsert.Remove(descriptions);
        descriptionsDetailsToUpdate.Remove(descriptions);
    }

    void Reset()
    {
        descriptionsDetailsToInsert.Clear();
        descriptionsDetailsToUpdate.Clear();
    }
}

