
<RadzenStack>

    <RadzenText Text="@documentInfo.DocType"
                TextStyle="TextStyle.H5" />

    <RadzenFieldset Icon="info">

        <RadzenRow>

            <RadzenColumn Size="5">
                <b>First Created Date</b>
            </RadzenColumn>
            <RadzenColumn Size="6">
                @documentInfo.FirstCreatedDate.ToString("MMMM dd, yyyy hh:mm tt")
            </RadzenColumn>

            <RadzenColumn Size="5" Class="mt-2">
                <b>First Created User</b>
            </RadzenColumn>

            <RadzenColumn Size="6" Class="mt-2">
                <RadzenChip Icon="person" ChipStyle="BadgeStyle.Secondary">
                    @{
                        var username = securitySystemUsersList?.FirstOrDefault(u => u.Oid == Guid.Parse(documentInfo.FirstCreatedUserId));
                    }
                    @username?.FullName
                </RadzenChip>
            </RadzenColumn>


            <RadzenColumn Size="5">
                <b>Last Modified Date</b>
            </RadzenColumn>
            <RadzenColumn Size="6">
                @documentInfo.LastModifiedDate.ToString("MMMM dd, yyyy hh:mm tt")
            </RadzenColumn>
            
            <RadzenColumn Size="5" Class="mt-2">
                <b>Last Modified User</b>
            </RadzenColumn>
            <RadzenColumn Size="6" Class="mt-2">
                <RadzenChip Icon="person" ChipStyle="BadgeStyle.Secondary">
                    @{
                        var username = securitySystemUsersList?.FirstOrDefault(u => u.Oid == Guid.Parse(documentInfo.LastModifiedUserId));
                    }
                    @username?.FullName
                </RadzenChip>
            </RadzenColumn>

            <RadzenColumn Size="5" Class="mt-2">
                <b>Print Count</b>
            </RadzenColumn>
            <RadzenColumn Size="6" Class="mt-2">
                @documentInfo.PrintCount
            </RadzenColumn>

        </RadzenRow>

    </RadzenFieldset>

</RadzenStack>


