    [Parameter]
    public Guid? Id { get; set; }

    protected DocumentInfo documentInfo { get; set; } = new();
    protected IEnumerable<SecuritySystemUser> securitySystemUsersList { get; set; } = [];

    protected string FirstCreatedUserName { get; set; } = "";
    protected string LastModifiedUserName { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!Id.HasValue)
            return;

        documentInfo = await documentsInfoService.GetDocumentInfoById(Id.Value.ToString())
                      ?? new DocumentInfo();

        securitySystemUsersList =
            await systemUserServices.GetSystemUserSettings()
            ?? [];

        if (Guid.TryParse(documentInfo.FirstCreatedUserId, out var firstUserId))
        {
            FirstCreatedUserName =
                securitySystemUsersList.FirstOrDefault(x => x.Oid == firstUserId)?.FullName ?? "";
        }

        if (Guid.TryParse(documentInfo.LastModifiedUserId, out var lastUserId))
        {
            LastModifiedUserName =
                securitySystemUsersList.FirstOrDefault(x => x.Oid == lastUserId)?.FullName ?? "";
        }
    }
   
}
