	protected async Task GetUserName()
	{
		var user = (await authenticationState).User;

		if (user.Identity.IsAuthenticated)
		{
			//Displaying Givenname and Role of User from Claims in TokeController.cs
			Name = user.FindFirst(x => x.Type == System.Security.Claims.ClaimTypes.Name).Value;
		}
	}

	protected void TimeStamp()
	{
		string uppercasename = Name.ToUpper();
		string timestamp = $"{DateTime.Now:MM/dd/yyyy hh:mm:ss tt} - ({uppercasename}): ";

		chartOfAccountNotes.Notes += timestamp;

	}

