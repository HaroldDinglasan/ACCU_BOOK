<RadzenTemplateForm TItem="SystemUser" Data="@model" Submit="@Save">
    <RadzenStack Gap="1rem">

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
            <RadzenIcon Icon="lock_reset" Style="font-size:2rem; color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.Body2" Style="margin:0; color: var(--rz-text-secondary-color);">
                Enter your current password, then choose a new one.
            </RadzenText>
        </RadzenStack>

        <RadzenFormField Text="Old password" Variant="Variant.Filled">
            <ChildContent>
                <RadzenPassword Name="OldPassword" @bind-Value="model.OldStoredPassword" AutoComplete="false" />
            </ChildContent>
            <Helper>
                <RadzenRequiredValidator Component="OldPassword" Text="Old password is required." />
            </Helper>
        </RadzenFormField>

        <RadzenFormField Text="New password" Variant="Variant.Filled">
            <ChildContent>
                <RadzenPassword Name="NewPassword" @bind-Value="newPassword" AutoComplete="false" />
            </ChildContent>
            <Helper>
                <RadzenRequiredValidator Component="NewPassword" Text="New password is required." />
                <RadzenLengthValidator Component="NewPassword" Min="8" Text="Use at least 8 characters." />
            </Helper>
        </RadzenFormField>

        <RadzenFormField Text="Confirm new password" Variant="Variant.Filled">
            <ChildContent>
                <RadzenPassword Name="ConfirmPassword" @bind-Value="confirmPassword" AutoComplete="false" />
            </ChildContent>
            <Helper>
                <RadzenRequiredValidator Component="ConfirmPassword" Text="Please confirm your new password." />
                <RadzenCompareValidator Component="ConfirmPassword" Value="@newPassword" Text="Passwords do not match." />
            </Helper>
        </RadzenFormField>

        @if (!string.IsNullOrEmpty(message))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
                         AllowClose="false" Size="AlertSize.Small">
                @message
            </RadzenAlert>
        }

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Cancel" Variant="Variant.Outlined"
                          ButtonType="ButtonType.Button" Disabled="@busy"
                          Click="@(() => DialogService.Close(false))" />
            <RadzenButton Text="Save password" Icon="lock_reset" ButtonStyle="ButtonStyle.Primary"
                          ButtonType="ButtonType.Submit" IsBusy="@busy" BusyText="Saving..." />
        </RadzenStack>

    </RadzenStack>
</RadzenTemplateForm>

@code {
    /// <summary>Oid ng user na magpapalit ng password (ipasa galing sa page).</summary>
    [Parameter]
    public Guid Oid { get; set; }

    private SystemUser model = new SystemUser();
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string message = string.Empty;
    private bool busy = false;

    protected override void OnInitialized()
    {
        model.Oid = Oid;
        model.OldStoredPassword = string.Empty;
        model.StoredPassword = string.Empty; // iwas default na "NTBIDEFAULT123"
    }

    private async Task Save()
    {
        message = string.Empty;

        if (newPassword != confirmPassword)
        {
            message = "New password and confirmation do not match.";
            return;
        }

        busy = true;
        try
        {
            model.Oid = Oid;
            model.StoredPassword = newPassword;

            var data = await systemUserServices.UpdateUserPassword(model);
            if (data != "0")
            {
                DialogService.Close(true);
                return;
            }

            message = "Old password does not match. Please try again.";
        }
        catch (Exception ex)
        {
            message = $"Something went wrong. {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
