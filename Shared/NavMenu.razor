@* @using Accounting_V4.Model.MenuModels
@inject MenuService menuService


<RadzenPanelMenu DisplayStyle="@DisplayStyle" ShowArrow=true Multiple=false>

    <ChildContent>
        @if (systemMenuObjectList == null)
        {
            <MenuLoading />
        }
        else
        {
            @foreach (var mn in systemMenuObjectList)
            {
                @if (mn.ParentMenuId == 0)
                {
                    <RadzenPanelMenuItem Text="@mn.MenuName" Icon="@mn.IconNames">
                        <ChildContent>
                            @foreach (var mn1 in systemMenuObjectList)
                            {
                                @if (mn.MenuId == mn1.ParentMenuId)
                                {
                                    <RadzenPanelMenuItem Text="@mn1.MenuName" Path="@mn1.PageName" Icon="@mn1.IconNames" />
                                }
                            }
                        </ChildContent>

                    </RadzenPanelMenuItem>
                }
            }
        }
    </ChildContent>
</RadzenPanelMenu>


@code {
    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }
    public IEnumerable<SystemMenuObjectPermissionResult> systemMenuObjectList;

    MenuItemDisplayStyle DisplayStyle = MenuItemDisplayStyle.IconAndText;

    protected override async Task OnInitializedAsync()
    {

        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            var UserId = authState.FindFirst(x => x.Type == System.Security.Claims.ClaimTypes.NameIdentifier);
            GetLoadMenu(UserId.Value);
        }
        //con = companyCode;
    }

    protected async void GetLoadMenu(string UserId)
    {

        var data = await menuService.GetSystemMenuObjectById(UserId);
        if (data != null)
            systemMenuObjectList = data;
        StateHasChanged();
    }
}
 *@


