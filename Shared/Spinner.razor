@page "/spinner"

<style>
    .sp-overlay {
        --ab-brand: var(--rz-primary);
        --ab-brand-deep: var(--rz-primary-darker, var(--rz-primary));
        --ab-on-brand: var(--rz-on-primary, #fff);
        --ab-page: var(--rz-body-background-color);
        --ab-surface: var(--rz-base-background-color, #fff);
        --ab-line: var(--rz-base-300, rgba(128, 128, 128, 0.3));
        --ab-muted: var(--rz-text-secondary-color);
        --ab-ok: var(--rz-success);
        position: fixed;
        inset: 0;
        z-index: 998;
        display: grid;
        place-items: center;
        background: color-mix(in srgb, var(--ab-brand-deep) 55%, transparent);
        backdrop-filter: blur(2px);
    }

        .sp-overlay .rz-card.sp-card {
            width: 260px;
            padding: 2rem 1.5rem 1.75rem;
            border-radius: 14px;
            background: var(--ab-surface);
            box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6);
            text-align: center;
        }

    /* AB logo drawn as a book. Laki: palitan lang ang --s. Kulay: sumusunod sa Radzen theme. */
    .sp-book {
        --s: 72px;
        --book-cover: var(--ab-brand);
        --book-spine: var(--ab-brand-deep);
        --book-ink: var(--ab-on-brand);
        --book-pages: var(--ab-surface);
        --book-edge: var(--rz-base-400, var(--ab-line));
        position: relative;
        box-sizing: border-box;
        width: var(--s);
        height: calc(var(--s) * 1.25);
        margin: 0 calc(var(--s) * 0.1) calc(var(--s) * 0.09) 0;
        padding-left: calc(var(--s) * 0.2);
        display: grid;
        place-items: center;
        background: var(--book-cover);
        color: var(--book-ink);
        border-radius: 3px 9px 9px 3px;
        font-weight: 700;
        font-size: calc(var(--s) * 0.4);
        line-height: 1;
        letter-spacing: -0.02em;
        box-shadow: inset calc(var(--s) * 0.2) 0 0 var(--book-spine), calc(var(--s) * 0.04) calc(var(--s) * 0.035) 0 0 var(--book-pages), calc(var(--s) * 0.04) calc(var(--s) * 0.035) 0 1px var(--book-edge), calc(var(--s) * 0.08) calc(var(--s) * 0.07) 0 0 var(--book-pages), calc(var(--s) * 0.08) calc(var(--s) * 0.07) 0 1px var(--book-edge);
    }

        .sp-book::before {
            content: "";
            position: absolute;
            top: 0;
            right: 16%;
            width: 13%;
            height: 30%;
            background: var(--ab-ok, var(--rz-success));
            clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
        }

    .sp-message {
        font-weight: 600;
        margin: 0;
    }

    .sp-overlay .rz-progressbar {
        height: 6px;
        border-radius: 999px;
    }

    .sp-overlay .rz-progressbar-value {
        border-radius: 999px;
    }
</style>

<div class="sp-overlay" role="status" aria-live="polite">
    <RadzenCard class="sp-card">
        <RadzenStack AlignItems="AlignItems.Center" Gap="1.5rem">
            <div class="sp-book" role="img" aria-label="AccuBook">AB</div>
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Value="100" ShowValue="false" Style="width:100%;" />
            <p class="sp-message">@Message</p>
        </RadzenStack>
    </RadzenCard>
</div>

@code {
    [Parameter]
    public string Message { get; set; } = "Please wait...";
}
