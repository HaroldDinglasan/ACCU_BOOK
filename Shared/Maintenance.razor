<RadzenMenu>
    <RadzenMenuItem Text="Maintenance" Icon="build">
        <RadzenMenuItem Text="Projects" Icon="assignment"></RadzenMenuItem>
        <RadzenMenuItem Text="Financial Period" Icon="finance"></RadzenMenuItem>
        <RadzenMenuItem Text="Running Numbers" Path="RunningNumbers" Icon="numbers"></RadzenMenuItem>
        <RadzenMenuItem Text="Valid Posting Periods" Path="ValidPostingPeriodList" Icon="numbers"></RadzenMenuItem>
        <RadzenMenuItem Text="Menu Settings" Path="ABMenuSettings" Icon="tune"></RadzenMenuItem>

    </RadzenMenuItem>
    <RadzenMenuItem Text="Inquiry" Icon="query_stats" Disabled="@false">
        <RadzenMenuItem Text="Account Inquiry" Icon="check_circle"></RadzenMenuItem>
        <RadzenMenuItem Text="TextBox" Path="textbox" Icon="input"></RadzenMenuItem>
    </RadzenMenuItem>

    <RadzenMenuItem Text="User Account" Icon="person">
        <RadzenMenuItem Text="User Roles" Click=@( () => navManager.NavigateTo("/ABSystemRoleList")) Icon="check_circle"></RadzenMenuItem>
        <RadzenMenuItem Text="Users" Click=@( () => navManager.NavigateTo("/ABSystemUserList")) Icon="input"></RadzenMenuItem>
    </RadzenMenuItem>
</RadzenMenu>


@code {
    bool isTrue = true;
}

