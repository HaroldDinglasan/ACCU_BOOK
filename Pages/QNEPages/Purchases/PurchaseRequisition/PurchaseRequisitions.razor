@page "/PurchaseRequisitions"
@page "/PurchaseRequisitions/Edit/{id:guid}"
@attribute [Authorize(Roles = "Admin,User")]

@if (isloading)
{
    <Spinner />
}

<RadzenTemplateForm Visible=true" TItem="PurchaseRequisitionModel" Data="purchaserequisitionModel" Submit="@OnSubmit">
    <RadzenStack Gap="0.2rem">
        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="5">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        <RadzenButton Disabled=@(purchaserequisitionModel.CreditorId is null || btnDiseabled || !string.IsNullOrWhiteSpace(purchaserequisitionModel.TransferToInfo))
                                      Size="@smallbtn"
                                      Icon="save"
                                      BusyText="Saving..."
                                      IsBusy=@busy
                                      ButtonStyle="ButtonStyle.Primary"
                                      Text="@btnText"
                                      ButtonType="@Radzen.ButtonType.Submit" />

                        <RadzenButton Visible="@btnDiseabled" Text="New" Icon="add" Size="@smallbtn"
                                      ButtonStyle="ButtonStyle.Success"
                                      ButtonType="@Radzen.ButtonType.Button"
                                      Click="@OnNew" />

                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Seach" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenCard>

            <div style="margin-bottom: 0.5rem">
                Purchase Requisitions @purchaserequisitionModel.PurchaseRequisitionCode <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Details">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Supplier" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" Disabled="@(purchaserequisitionModel.IsCancelled == true || purchaserequisitionModel.TransferToInfo != null)" @bind-Value=purchaserequisitionModel.CreditorId
                                                                        Change=@(args => OnCreditorChanged((Guid?)args)) AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@supplieraccountList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CompanyCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="4%" Property="CompanyCode" Title="Supplier #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CompanyName" Title="Name"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="From" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=purchaserequisitionModel.CreditorName Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Term" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Name="Terms" class="@redtext" @bind-Value=@purchaserequisitionModel.TermId Style="width: 100%;" AllowSorting="false" PageSize=10 Data="@termList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="Term" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Term" Title="Term"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Terms" Text="'Term' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@purchaserequisitionModel.StockLocationId Change="@(args => OnStockLocationChanged(args))"
                                                                        AllowSorting="false"
                                                                        Style="width: 120%;" PageSize=10 Data="@stocklocationList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data"><RadzenCheckBox TValue="bool" Value="data.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>


                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@purchaserequisitionModel.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Currency" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Disabled="true" class="@redtext" @bind-Value=@purchaserequisitionModel.CurrencyId AllowSorting="false" Style="width: 100%;" PageSize=10 AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CurrencyCode" Density="@density" Data="@currencyList" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CurrencyCode" Title="CurrencyCode"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Attention" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Attention Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Purchaser" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@purchaserequisitionModel.PurchaserId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@purchaserList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="StaffCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="StaffCode" Title="Purchaser #"></RadzenDropDownDataGridColumn>

                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Require Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker class="@redtext" DateFormat="MM/dd/yyyy" @bind-Value=@purchaserequisitionModel.RequireDate Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Rate" AllowFloatingLabel="false">
                                                <RadzenNumeric ShowUpDown="false" Disabled="true" @bind-Value=@purchaserequisitionModel.CurrencyRate Style="@(purchaserequisitionModel.IsCancelled == true || purchaserequisitionModel.IsClosed == true ? "width:100%; color:red;" : "width:100%;")" Placeholder="Exchange Rate"></RadzenNumeric>
                                                @*   <RadzenTextBox @bind-Value=purchaserequisition.CurrencyRate Style="width: 100%;" Placeholder="Exchange Rate" /> *@
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetPurchaseRequisitionNo" class="@redtext" @bind-Value="@purchaserequisitionModel.PurchaseRequisitionDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:92%" Text="Requisition No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@purchaserequisitionModel.PurchaseRequisitionCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="width:5%" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@(args => popup.ToggleAsync(button.Element))" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox Name="Reference" class="@redtext" @bind-Value="@purchaserequisitionModel.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Reference" Text="'Reference No.' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems" JustifyContent="JustifyContent.Start" Style="margin-top:1rem;">
                                        <RadzenColumn Size="4">
                                            <RadzenSwitch @bind-Value=purchaserequisitionModel.IsTaxInclusive Name="Active" Change="@IsTaxInclusiveChanged" />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Tax Inclusive"></RadzenText>
                                        </RadzenColumn>

                                        @if (Id is not null)
                                        {
                                            <RadzenColumn Size="4">
                                                <RadzenSwitch @bind-Value="@purchaserequisitionModel.IsCancelled" Change=@(args => OnSwitchChanged("IsCancelled")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Cancelled"></RadzenText>
                                            </RadzenColumn>

                                            <RadzenColumn Size="4">
                                                <RadzenSwitch @bind-Value="@purchaserequisitionModel.IsClosed" Change=@(args => OnSwitchChanged("IsClosed")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Closed"></RadzenText>
                                            </RadzenColumn>
                                        }
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Supplier">
                        <RadzenRow>

                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Address1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Address2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Address3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Address4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>


                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="GST ID" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled="true" class="@redtext" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Delivery Term" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.DeliveryTerm Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenFormField Style="width:100%" Text="Phone" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Phone Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>

                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenFormField Style="width:100%" Text="Fax" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Fax Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>


                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Deliver To">
                        <RadzenRow>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.DeliverAddress1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.DeliverAddress2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.DeliverAddress3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.DeliverAddress4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Delivery Contact" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.DeliverContact Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">

                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Phone" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.DeliverPhone Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Fax" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.DeliverFax Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Others">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Title" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="width: 90%;" Gap="0.5rem;">
                                                        <RadzenDropDown class="@redtext" @bind-Value=@purchaserequisitionModel.Title
                                                                        Data=@descriptionsList
                                                                        TextProperty="@nameof(Descriptions.Description)" SelectedItem="0"
                                                                        ValueProperty="@nameof(Descriptions.Description)" Style="width: 100%;" />
                                                    </RadzenStack>
                                                </RadzenStack>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Transfer To" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@purchaserequisitionModel.TransferToInfo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Ref1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Ref2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>


                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Remark1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaserequisitionModel.Remark2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Notes">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="12">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenTextArea @bind-Value=@purchaserequisitionModel.Notes Rows="10" Style="width:100%" class="@redtext" aria-label="TextArea" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Approvals">

                        <RadzenDropDownDataGrid class="@redtext" @bind-Value="purchaserequisitionModel.RequestByUserId"
                                                ValueProperty="@nameof(SecuritySystemUser.OiddAsString)"
                                                TextProperty="@nameof(SecuritySystemUser.UserName)"
                                                Data="@requestedList" AllowClear="true" FilterCaseSensitivity="@filter"
                                                AllowFilteringByAllStringColumns="true" Density="@density"
                                                AllowSorting="false" Style="width: 100%;" PageSize="10" AllowVirtualization="true" AllowColumnResize="true">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(SecuritySystemUser.UserName)" Title="User Name"></RadzenDropDownDataGridColumn>
                                <RadzenDropDownDataGridColumn Property="@nameof(SecuritySystemUser.FullName)" Title="Full Name"></RadzenDropDownDataGridColumn>
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>

            @* TABLE DETAILS*@
            <br />
            <RadzenDataGrid EditMode="@editMode" @ref="purchaserequisitionDetailsGrid" Style="width: 100%; font-size:12px"
                            Data="@purchaserequisitionDetailsList" AllowColumnResize=true RowCreate="@OnCreateRow"
                            TItem="PurchaseRequisitionDetails" Density="@density" RowUpdate="@OnUpdateRow" RowRender="@RowRender">

                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New Order" Size="ButtonSize.ExtraSmall" Click="@(() => InsertAfterRow(purchaserequisitionDetailsList.LastOrDefault()))" Disabled="@(purchaserequisitionDetailsToInsert.Any() || purchaserequisitionDetailsToUpdate.Any())" />
                </HeaderTemplate>

                <Columns>

                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
