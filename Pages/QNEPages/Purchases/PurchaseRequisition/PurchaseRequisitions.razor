    //insert after row
    async Task InsertAfterRow(PurchaseRequisitionDetails purchaserequisitionsDetails)
    {
        // If there's an active edit, prevent adding another row until it's saved.
        if (purchaserequisitionDetailsToInsert.Any() || purchaserequisitionDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");

            return;
        }

        if (!purchaserequisitionDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        var purchDetails = new PurchaseRequisitionDetails();
        //Set QuotationId to new inserted row
        purchDetails.PurchaseRequisitionId = Id ?? purchaserequisitionModel.Id;
        purchDetails.IsTaxInclusive = purchaserequisitionModel.IsTaxInclusive;
        // Assign a sequential Pos for new rows, inserting after the current row's Pos
        purchaserequisitionDetailsToInsert.Add(purchDetails);
        var index = purchaserequisitionDetailsList.IndexOf(purchaserequisitionsDetails);
        if (index >= 0)
        {
            purchaserequisitionDetailsList.Insert(index + 1, purchDetails); // Insert after selected row
        }
        else
        {
            purchaserequisitionDetailsList.Add(purchDetails);
        }

        ResetPosIndexes();
        await purchaserequisitionDetailsGrid.InsertRow(purchDetails);
        await purchaserequisitionDetailsGrid.Reload();
        StateHasChanged();
    }



    async Task EditRow(PurchaseRequisitionDetails purchaserequisitionsDetails)
    {

        // If there's another row already in edit/insert mode, prevent editing this one.
        if (purchaserequisitionDetailsToInsert.Any() || purchaserequisitionDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");

            return;
        }
        if (!purchaserequisitionDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        purchaserequisitionDetailsToUpdate.Add(purchaserequisitionsDetails); // Track it as an item being updated
        await purchaserequisitionDetailsGrid.EditRow(purchaserequisitionsDetails);
        StateHasChanged(); // Ensure UI updates and list is reflected
    }


    async Task DeleteRow(PurchaseRequisitionDetails purchaserequisitionsDetails)
    {
        if (purchaserequisitionDetailsToInsert.Any() || purchaserequisitionDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");

            return;
        }

        if (await DialogService.Confirm("You are about to delete record(s). Do you want to proceed?", "Delete") == true)

        {
            var data = await purchaseRequisitionsService.DeletePurchaseRequisitionDetailsRows(purchaserequisitionsDetails.Id.ToString());

            Reset(purchaserequisitionsDetails);
            purchaserequisitionDetailsList.Remove(purchaserequisitionsDetails);
            ResetPosIndexes();
            await purchaserequisitionDetailsGrid.Reload();
            StateHasChanged();
        }


    }


