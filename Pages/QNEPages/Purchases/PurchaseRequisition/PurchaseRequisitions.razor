    protected IEnumerable<TaxCodes> taxCodesList { get; set; }

    protected IEnumerable<Descriptions> descriptionsList { get; set; }
    protected IEnumerable<TransactionsCode> transactionCodesList { get; set; }

    protected DescriptionFilter descriptionFilter { get; set; } = new DescriptionFilter();
    protected TransactionCodesFilter transactionCodesFilter = new TransactionCodesFilter();
    protected TaxCodeFilter taxCodeFilter = new TaxCodeFilter();

    private PurchaseRequisitionModel purchaseRequest = new();
    protected override async Task OnInitializedAsync()
    {

        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            var RoleId = authState.FindFirst("RoleId").Value;
            GetLoadMenuPermission(RoleId);
        }



    }




    private SystemMenuObjectPermission? permission;
    protected async void GetLoadMenuPermission(string RoleId)
    {
        permission = await permissionService.GetPermissionAsync(
         RoleId,
         "Purchase Requisitions");

        if (permission is null)
            return;

        SetTransactionCodeData();
        InitializePurchaseRequisitionDetails();
        await loadAllData();
        if (Id is not null)
        {
            await loadAllDataById();
            purchaseRequest = await purchaseRequisitionsService.GetPurchaseRequisitions(Id.ToString());
        }
        StateHasChanged();

        // if (Id != null)
        //     await loadAllDataById();

        // StateHasChanged();
    }



    protected void SetTransactionCodeData()
    {
        //For Generating Requisition Code Getting Format from db.TransactionCodes
        descriptionFilter.OwnerCode = "PurchaseRequisitions.Title";
        transactionCodesFilter.TableId = 73;

    }




    protected async Task loadAllData()
    {
        await GetTransactionNo();
        await GetSupplierList();
        await GetTermList();
        await GetLocationList();
        await GetProjectList();
        await GetPurchaserList();
        await GetCurrencyList();
        await GetStockList();
        await GetStocksPriceList();
        await GetUOMSList();
        await GetTaxCodesList();
        await GetWTaxCodesList();
        await GetDescriptions();
        await GetSystemUserSetting();
        await SetPurchaseRequisitionNo();

        SetDefaultCurrency();
        isloading = false;
        StateHasChanged();
    }


    protected async Task loadAllDataById()
    {
        await GetPurchaseRequisitionById();
        await GetPurchaseRequisitionsDetailById();

        LoadPRStatus();
        isloading = false;
        StateHasChanged();
    }


    //GET ALL UOMLIST PER STOCK
    protected async Task GetUOMSList()
    {
        var data = await stockItemsService.GetUOMsList();
        uomsList = data is not null ? data : new List<UOMs>();
    }

    //LOAD DIFFERENT UOMS PER STOCK ON QUOTATION DETAILS
    private IEnumerable<UOMs> GetUOMsForStock(Guid? stockId)
    {
        if (stockId == null || uomsList == null)
            return Enumerable.Empty<UOMs>();
        return uomsList.Where(u => u.StockId == stockId);
    }

    protected async Task GetSystemUserSetting()
    {
        //requestedList = await http.GetFromJsonAsync<List<SecuritySystemUser>>("api/PurchaseRequisitions/GetSystemUserSetting?companyCode=" + CompCode);
        var data = await systemUserServices.GetSystemUserSettings();
        requestedList = data is not null ? data : new List<SecuritySystemUser>();

    }
    protected async Task GetSupplierList()
    {
        //supplieraccountList = await http.GetFromJsonAsync<List<Creditors>>("api/PurchaseRequisitions/GetSupplierLists?companyCode=" + CompCode);
        var data = await suppliersServices.GetSupplierLists();
        supplieraccountList = data is not null ? data : new List<Creditors>();
    }

    protected async Task GetTermList()
    {
        var data = await termService.GetTermsLists();
        termList = data is not null ? data : new List<Terms>();
    }

    protected async Task GetLocationList()
    {
        // stocklocationList = await http.GetFromJsonAsync<List<StockLocations>>("api/PurchaseRequisitions/GetLocationLists?companyCode=" + CompCode);
        var data = await stockItemsService.GetStockLocationList();
        stocklocationList = data is not null ? data : new List<StockLocations>();
    }


    protected async Task GetProjectList()
    {
        var data = await projectService.GetProjectsLists();
        projectList = data is not null ? data : new List<Projects>();
    }

    protected async Task GetPurchaserList()
    {
        var data = await purchaseRequisitionsService.GetPurchaserLists();
        purchaserList = data is not null ? data : new List<Purchasers>();

    }


    //Get Currencies From db.Currencies
    protected async Task GetCurrencyList()
    {
        var data = await currenciesService.GetCurrencies();
        currencyList = data is not null ? data : new List<Currencies>();
    }

    protected void SetDefaultCurrency()
    {
        var selectedCurrency = currencyList.FirstOrDefault(c => c.Id == 1);
        purchaserequisitionModel.CurrencyId = selectedCurrency.Id;
        purchaserequisitionModel.CurrencyRate = selectedCurrency.DefaultPurchaseRate;
    }

    //Get Stock List From db.Stocks
    protected async Task GetStockList()
    {
        var data = await stockItemsService.GetStockList();
        stockList = data is not null ? data : new List<Stocks>();
    }

    protected IEnumerable<StockUnitPrice> lastSellingPrice { get; set; }
    protected async Task GetStocksPriceList()
    {
        var data = await stockItemsService.GetStocksPriceList("PR");
        lastSellingPrice = data is not null ? data : new List<StockUnitPrice>();

    }

    // status =>

    protected void LoadPRStatus()
    {
        // status = purchaserequisitionModel.IsCancelled == true ? "(Cancelled)" : "" && purchaserequisitionModel.IsClosed == true ? "(Closed)" : "" : purchaserequisitionModel.TransferToInfo != null ? ("Transferred") : "";

        var statusList = new List<string>();
        if (purchaserequisitionModel.IsClosed)
            statusList.Add("Closed");

        if (purchaserequisitionModel.IsCancelled)
            statusList.Add("Cancelled");

        if (statusList.Any())
        {
            status = $"({string.Join(", ", statusList)})";
        }
        else if (!string.IsNullOrWhiteSpace(purchaserequisitionModel.TransferToInfo))
        {
            status = "(Transferred)";
        }

        StateHasChanged();


    }

    //Tax Code List
    protected async Task GetTaxCodesList()
    {
        taxCodeFilter.IsOutOrIn = false;
        taxCodeFilter.IsActive = true; // true for Active Tax Codes

        var data = await allTaxCodeService.GetTaxCodes(taxCodeFilter);
        taxCodesList = data is not null ? data : new List<TaxCodes>();
    }

    //FOR WTAXCODE DROPDOWN
    //CreditableAccount != null IS REFERRING TO CREDIABLE ACCOUNT WHICH IS CREDITABLE WTAX ON GLACCOUNT
    // protected IEnumerable<WTaxCodes> FilteredWTaxCodesList => wTaxCodesList?.Where(w => w.CreditableAccount == null) ?? Enumerable.Empty<WTaxCodes>();
    protected async Task GetWTaxCodesList()
    {
        // wTaxCodesList = await http.GetFromJsonAsync<List<WTaxCodes>>("api/AllTaxCodes/GetWTaxCodesList?companyCode=" + CompCode);
        var data = await allTaxCodeService.GetWTaxCodes();
        wTaxCodesList = data is not null ? data : new List<WTaxCodes>();

    }

    protected void OnCreditorChanged(object Id)
    {
        if (Id is not null)
        {
            if (supplieraccountList.FirstOrDefault(sa => sa.Id == (Guid)Id) is var selectedsuppliers && selectedsuppliers != null)
            {
                LoadPurchasingRequisitionModel(selectedsuppliers);
            }
        }
        else
        {
            ClearPurchasingRequisitionModel();
        }

    }
    protected void InitializePurchaseRequisitionDetails()
    {
        // Initialize with 5 rows and set default Pos index
        purchaserequisitionDetailsList = Enumerable.Range(1, 5)
                .Select(i => new PurchaseRequisitionDetails
                {
                    Pos = i,
                    PurchaseRequisitionId = Id ?? purchaserequisitionModel.Id,
                    IsTaxInclusive = purchaserequisitionModel.IsTaxInclusive

                })
                .ToList();
    }



    private async Task OnSwitchChanged(string switchName)
    {
        if (Id is null)
        {
            purchaserequisitionModel.IsCancelled = purchaserequisitionModel.IsClosed = false;
            NotificationHelper.ShowWarning(
                notificationService,
                "",
                "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving."
            );
            return;
        }

        await SetSwitchValue(switchName);
        SetRedText();
    }

    private ForCloseCancelledDocumentsModel forCloseCancelledDocumentsModel = new ForCloseCancelledDocumentsModel();
    private async Task SetSwitchValue(string switchName)
    {

        forCloseCancelledDocumentsModel = new()
        {
            Id = Id,
            TableName = "PurchaseRequisitions",
            SwitchName = switchName,
            IsClosed = purchaserequisitionModel.IsClosed,
            IsCancelled = purchaserequisitionModel.IsCancelled
        };

        await headerSwitchServices.UpdateForCloseOrCancelled(forCloseCancelledDocumentsModel);


    }



    // Helper to reset Pos index after any add/delete
    private void ResetPosIndexes()
    {
        for (int i = 0; i < purchaserequisitionDetailsList.Count; i++)
        {
            purchaserequisitionDetailsList[i].Pos = i + 1;
        }
    }



    protected void IsTaxInclusiveChanged()
    {

        foreach (var row in purchaserequisitionDetailsList)
        {
            row.IsTaxInclusive = purchaserequisitionModel.IsTaxInclusive;

