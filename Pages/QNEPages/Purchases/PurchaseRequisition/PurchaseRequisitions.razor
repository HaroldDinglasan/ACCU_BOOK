    private async Task OnStockChanged(object stockId, PurchaseRequisitionDetails purchaserequisitiondetails)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);
            if (selectedStock != null)
            {
                //if (selectedStock.StockName?.Split(' ')[0] is ("DISCOUNT" or "SUBTOTAL"))
                if (selectedStock.ItemTypeCode is ("T" or "D"))
                {
                    ///INSERT TOTAL OF EACH COLUMN

                    purchaserequisitiondetails.Qty = 0.00000000M;
                    purchaserequisitiondetails.UOMId = null;
                    purchaserequisitiondetails.UnitPrice = 0.00000000M;
                    purchaserequisitiondetails.PurchaseRequisitionId = purchaserequisitionModel.Id;
                    purchaserequisitiondetails.StockId = selectedStock.Id;
                    purchaserequisitiondetails.StockLocationId = purchaserequisitionModel.StockLocationId;
                    purchaserequisitiondetails.Discount = string.Join("/", Regex.Matches(selectedStock.StockName, @"\d+%").Select(m => m.Value));
                    purchaserequisitiondetails.Description = selectedStock.StockName;
                    purchaserequisitiondetails.ItemTypeCode = selectedStock.ItemTypeCode;
                    purchaserequisitiondetails.TaxCodeId = null;
                    purchaserequisitiondetails.WTaxCode = null;
                    //LoadSubtotalRow();
                    purchaserequisitiondetails.Amount = Amount;
                    purchaserequisitiondetails.AmountLocal = AmountLocal;
                    purchaserequisitiondetails.DiscountAmount = DiscountAmount;
                    purchaserequisitiondetails.DiscountAmountLocal = DiscountAmountLocal;
                    purchaserequisitiondetails.NetAmount = NetAmount;
                    purchaserequisitiondetails.NetAmountLocal = NetAmountLocal;
                    purchaserequisitiondetails.TaxAmount = TaxAmount;
                    purchaserequisitiondetails.TaxAmountLocal = TaxAmountLocal;
                    purchaserequisitiondetails.SubAmount = SubAmount;
                    purchaserequisitiondetails.SubAmountLocal = SubAmountLocal;
                    purchaserequisitiondetails.TaxExclusiveAmount = TaxExclusiveAmount;
                    purchaserequisitiondetails.TaxExclusiveAmountLocal = TaxExclusiveAmountLocal;
                    purchaserequisitiondetails.WTaxAmount = WTaxAmount;
                    purchaserequisitiondetails.WTaxAmountLocal = WTaxAmountLocal;

                    /// TransactionNumberHelper.Compute(purchaserequisitiondetails);
                    //if (selectedStock.StockName?.Split(' ')[0] == "DISCOUNT")
                    if (selectedStock.ItemTypeCode is ("D"))
                    {
                        //LoadSubtotalRow();
                        DiscountAndSubtotalHelper.Compute(purchaserequisitiondetails);
                        ///TransactionNumberHelper.Compute(purchaserequisitiondetails);
                    }


                }
                else
                {
                    if (selectedStock.StockName is ("SALES DISCOUNT"))
                    {
                        purchaserequisitiondetails.Qty = 1.00000000M;
                        purchaserequisitiondetails.UOMId = null;
                        //UnitPrice = added.NetAmount,
                        purchaserequisitiondetails.UnitPrice = DiscountAmount;//SUM OF DISCOUNT AMOUNT
                        //Discount = discountDesrciption,
                        purchaserequisitiondetails.PurchaseRequisitionId = purchaserequisitionModel.Id;
                        purchaserequisitiondetails.StockId = selectedStock.Id;
                        purchaserequisitiondetails.StockLocationId = purchaserequisitionModel.StockLocationId;
                        purchaserequisitiondetails.Description = selectedStock.StockName;
                        purchaserequisitiondetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        purchaserequisitiondetails.TaxCodeId = null;
                        purchaserequisitiondetails.WTaxCode = null;


                        purchaserequisitiondetails.Amount = DiscountAmount;
                        purchaserequisitiondetails.AmountLocal = DiscountAmount;
                        //DiscountAmount = DiscountAmount,
                        //DiscountAmountLocal = DiscountAmountLocal,
                        purchaserequisitiondetails.NetAmount = DiscountAmount;
                        purchaserequisitiondetails.NetAmountLocal = DiscountAmount;
                        //TaxAmount = TaxAmount,
                        //TaxAmountLocal = TaxAmountLocal,
                        purchaserequisitiondetails.SubAmount = DiscountAmount;
                        purchaserequisitiondetails.SubAmountLocal = DiscountAmount;
                        purchaserequisitiondetails.TaxExclusiveAmount = DiscountAmount;
                        purchaserequisitiondetails.TaxExclusiveAmountLocal = DiscountAmount;
                    }
                    else
                    {
                        var selectedSupplier = supplieraccountList.FirstOrDefault(c => c.Id == purchaserequisitionModel.CreditorId);
                        //IsDisable = false;
                        purchaserequisitiondetails.PurchaseRequisitionId = purchaserequisitionModel.Id;
                        purchaserequisitiondetails.StockLocationId = purchaserequisitionModel.StockLocationId;
                        // Populate Description
                        purchaserequisitiondetails.Description = selectedStock.StockName;
                        purchaserequisitiondetails.Discount = string.Empty;
                        //Set Tax Code Id
                        purchaserequisitiondetails.TaxCodeId = selectedSupplier?.DefaultTaxCodeId;
                        purchaserequisitiondetails.WTaxCode = selectedSupplier?.DefaultWTaxCodeId;

                        // Default Quantity
                        purchaserequisitiondetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        purchaserequisitiondetails.Qty = 1.0000M;

                        purchaserequisitiondetails.PackingUOM2 = purchaserequisitiondetails.Qty;

                        // Set the base UOM
                        var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStockId && u.UOMCode == selectedStock.BaseUOM);
                        if (baseUOM != null)
                        {
                            purchaserequisitiondetails.UOMId = baseUOM.Id;
                        }
                        // Load Last Price
                        var data = lastSellingPrice.Where(x => x.StockId == selectedStockId).FirstOrDefault();
                        if (data != null)
                        {
                            purchaserequisitiondetails.UnitPrice = data.UnitPrice;
                            TransactionHelper(purchaserequisitiondetails);
                        }
                        else
                        {
                            purchaserequisitiondetails.UnitPrice = 0.00000000M;
                        }
                    }


                }

                // Just trigger state change, don't reload grid
               
                StateHasChanged();
            }
        }
        else
        {

            // Clear fields if no stock is selected
            // purchaserequisitiondetails.Description = string.Empty;
            // purchaserequisitiondetails.Qty = 0;
            // purchaserequisitiondetails.UOMId = null;

            purchaserequisitiondetails.UnitPrice = 0.00000000M;
            purchaserequisitiondetails.StockId = null;
            purchaserequisitiondetails.StockLocationId = null;
            purchaserequisitiondetails.Description = string.Empty;
            purchaserequisitiondetails.Qty = 0.00m;
            purchaserequisitiondetails.UOMId = null;
            purchaserequisitiondetails.Discount = null;
            purchaserequisitiondetails.TaxCodeId = null;
            purchaserequisitiondetails.WTaxCode = null;

            purchaserequisitiondetails.PackingUOM1 = 0.00M;
            purchaserequisitiondetails.PackingUOM2 = 0.00M;
            purchaserequisitiondetails.HighestUOM = null;

            purchaserequisitiondetails.Amount = 0.00M;
            purchaserequisitiondetails.AmountLocal = 0.00M;
            purchaserequisitiondetails.DiscountAmount = 0.00M;
            purchaserequisitiondetails.DiscountAmountLocal = 0.00M;
            purchaserequisitiondetails.NetAmount = 0.00M;
            purchaserequisitiondetails.NetAmountLocal = 0.00M;
            purchaserequisitiondetails.TaxAmount = 0.00M;
            purchaserequisitiondetails.TaxAmountLocal = 0.00M;
            purchaserequisitiondetails.SubAmount = 0.00M;
            purchaserequisitiondetails.SubAmountLocal = 0.00M;
            purchaserequisitiondetails.TaxExclusiveAmount = 0.00M;
            purchaserequisitiondetails.TaxExclusiveAmountLocal = 0.00M;
            purchaserequisitiondetails.WTaxAmount = 0.00M;
            purchaserequisitiondetails.WTaxAmountLocal = 0.00M;
            LoadAllTaxTotalDiscNetAmount();
            StateHasChanged();
        }
    }



