    private async Task OnSubmit()
    {
        if (purchaserequisitionDetailsToInsert.Any() || purchaserequisitionDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details",
                "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        busy = true;
        try
        {
            var data = await purchaseRequisitionsService.SavePurchaseRequisitionHeader(purchaserequisitionModel);

            if (data is not null)
            {
                if (data.Contains("Success"))
                {
                    await purchaseRequisitionsService.SavePurchaseRequisitionDetails(purchaserequisitionDetailsList);
                    btnDiseabled = true;
                }
                await DialogService.Alert(data);
            }
        }
        finally
        {
            busy = false;
        }
    }


