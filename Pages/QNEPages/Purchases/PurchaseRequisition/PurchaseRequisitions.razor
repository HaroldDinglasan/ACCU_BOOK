    private void LoadAllTaxTotalDiscNetAmount()
    {
        ///INCLUDE HERE THE TAX, DISCOUNT, WTAX, AMOUT, ALL QUOTATION DETAILS AMOUNT


        var filteredList = purchaserequisitionDetailsList?.Where(x => (x.Description?.Split(' ')[0] != "SUBTOTAL"));


        purchaserequisitionModel.TotalAmount = filteredList?.Sum(x => x.Amount) ?? 0.00m;
        purchaserequisitionModel.TotalAmountLocal = filteredList?.Sum(x => x.AmountLocal) ?? 0.00m;

        purchaserequisitionModel.DiscountAmount = filteredList?.Sum(x => x.DiscountAmount) ?? 0.00m;
        purchaserequisitionModel.DiscountAmountLocal = filteredList?.Sum(x => x.DiscountAmountLocal) ?? 0.00m;

        purchaserequisitionModel.NetTotalAmount = filteredList?.Sum(x => x.NetAmount) ?? 0.00m;
        purchaserequisitionModel.NetTotalAmountLocal = filteredList?.Sum(x => x.NetAmountLocal) ?? 0.00m;


        purchaserequisitionModel.TaxTotalAmount = filteredList?.Sum(x => x.TaxAmount) ?? 0.00m;
        purchaserequisitionModel.TaxTotalAmountLocal = filteredList?.Sum(x => x.TaxAmountLocal) ?? 0.00m;

        purchaserequisitionModel.SubtotalAmount = filteredList?.Sum(x => x.SubAmount) ?? 0.00m;
        purchaserequisitionModel.SubtotalAmountLocal = filteredList?.Sum(x => x.SubAmountLocal) ?? 0.00m;

        purchaserequisitionModel.TaxExclusiveTotalAmount = filteredList?.Sum(x => x.TaxExclusiveAmount) ?? 0.00m;
        purchaserequisitionModel.TaxExclusiveTotalAmountLocal = filteredList?.Sum(x => x.TaxExclusiveAmountLocal) ?? 0.00m;

        purchaserequisitionModel.WTaxTotalAmount = filteredList?.Sum(x => x.WTaxAmount) ?? 0.00m;
        purchaserequisitionModel.WTaxTotalAmountLocal = filteredList?.Sum(x => x.WTaxAmountLocal) ?? 0.00m;
    }



    private void LoadSubtotalRow()
    {
        ///

        if (purchaserequisitionDetailsList == null || !purchaserequisitionDetailsList.Any())
            return;

        var subtotalRow = purchaserequisitionDetailsList
           .FirstOrDefault(x => x.Description?.StartsWith("SUBTOTAL") == true);

        if (subtotalRow == null)
            return;

        var rows = purchaserequisitionDetailsList
            .Where(x => x.Description?.Split(' ')[0] is not ("SUBTOTAL" or "DISCOUNT" or "SALES DISCOUNT"))
            .ToList();

        subtotalRow.Amount = rows.Sum(x => x.Amount);
        subtotalRow.AmountLocal = rows.Sum(x => x.AmountLocal);

        subtotalRow.DiscountAmount = rows.Sum(x => x.DiscountAmount);
        subtotalRow.DiscountAmountLocal = rows.Sum(x => x.DiscountAmountLocal);

        subtotalRow.NetAmount = rows.Sum(x => x.NetAmount);
        subtotalRow.NetAmountLocal = rows.Sum(x => x.NetAmountLocal);

        subtotalRow.TaxAmount = rows.Sum(x => x.TaxAmount);
        subtotalRow.TaxAmountLocal = rows.Sum(x => x.TaxAmountLocal);

        subtotalRow.SubAmount = rows.Sum(x => x.SubAmount);
        subtotalRow.SubAmountLocal = rows.Sum(x => x.SubAmountLocal);

        subtotalRow.TaxExclusiveAmount = rows.Sum(x => x.TaxExclusiveAmount);
        subtotalRow.TaxExclusiveAmountLocal = rows.Sum(x => x.TaxExclusiveAmountLocal);

        subtotalRow.WTaxAmount = rows.Sum(x => x.WTaxAmount);
        subtotalRow.WTaxAmountLocal = rows.Sum(x => x.WTaxAmountLocal);

    }

