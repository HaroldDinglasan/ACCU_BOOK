    private IEnumerable<StockBatchNumbersModel> GetBatchNumberForStock(Guid? stockId)
    {
        if (stockId == null || stockbatchnumberList == null)
            return Enumerable.Empty<StockBatchNumbersModel>();

        return stockbatchnumberList
            .Where(x => x.StockId == stockId)
            .Where(x =>
                string.IsNullOrWhiteSpace(batchSearchText) ||
                (x.BatchNo?.Contains(batchSearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Description?.Contains(batchSearchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderByDescending(x => x.BalanceQty);
    }

