    private async void OnOkClicked()
    {
        if (selectedPurchaseOrderTransferModel != null && selectedPurchaseOrderTransferModel.Any())
        {
            // collect all Id as comma-separated
            var PODetailsId = string.Join(",", selectedPurchaseOrderTransferModel.Select(x => x.Id));

            if (!string.IsNullOrWhiteSpace(PODetailsId))
            {
                selectedIds = PODetailsId.Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(Guid.Parse)
                        .ToList();
                // SET FIRST ROW DATA OF HIGHEST TAX AMOUNT
                var highestTaxItem = selectedPurchaseOrderTransferModel.OrderByDescending(x => x.TaxTotalAmount).FirstOrDefault();
                await GetPurchaseOrderHeaderById(highestTaxItem.Id.ToString());
                await GetPurchaseOrderDetailsById();
            }
        }
        else
        {
            status = "Please select at least one";
            StateHasChanged();
        }
    }


    protected async Task GetPurchaseOrderHeaderById(string POId)
    {
        await ShowLoading();

        var header = await goodsreceivednotesTransferLinkServices.GetPurchaseOrderHeaderIdForTransfer(POId);

        purchaseOrderHeader = header is not null ? header : new PurchaseOrdersModel();

    }

    protected async Task GetPurchaseOrderDetailsById()
    {
        await ShowLoading();

        var poDetails = new List<PurchaseOrdersDetails>();

        foreach (var PODetailsId in selectedIds)
        {
            var detailsdata = await goodsreceivednotesTransferLinkServices.GetPurchaseOrderDetailsByIdForTransfer(PODetailsId.ToString());
            if (detailsdata != null)
                poDetails.AddRange(detailsdata);
        }

        purchaseOrdersDetails = poDetails;
        LoadForTransferDetails();
    }

