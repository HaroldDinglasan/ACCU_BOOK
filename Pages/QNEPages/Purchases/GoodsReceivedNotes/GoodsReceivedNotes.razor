        if (goodsreceivednotesDetailsToInsert.Any() || goodsreceivednotesDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!goodsreceivednotesDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        goodsreceivednotesDetailsToUpdate.Add(goodsreceivednotesDetails); // Track it as an item being updated
        await goodsreceivednotesDetailsGrid.EditRow(goodsreceivednotesDetails);
        StateHasChanged(); // Ensure UI updates and list is reflected
    }

