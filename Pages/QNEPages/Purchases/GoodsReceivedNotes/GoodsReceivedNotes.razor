        LoadAllTaxTotalDiscNetAmount();
        StateHasChanged();
    }

    private void LoadAllTaxTotalDiscNetAmount()
    {
        ///INCLUDE HERE THE TAX, DISCOUNT, WTAX, AMOUT, ALL QUOTATION DETAILS AMOUNT


        var filteredList = goodsreceivednotesDetails?.Where(x => (x.Description?.Split(' ')[0] != "SUBTOTAL"));


        goodsreceivednotesHeader.TotalAmount = filteredList?.Sum(x => x.Amount) ?? 0.00m;
        goodsreceivednotesHeader.TotalAmountLocal = filteredList?.Sum(x => x.AmountLocal) ?? 0.00m;

        goodsreceivednotesHeader.DiscountAmount = filteredList?.Sum(x => x.DiscountAmount) ?? 0.00m;
        goodsreceivednotesHeader.DiscountAmountLocal = filteredList?.Sum(x => x.DiscountAmountLocal) ?? 0.00m;

        goodsreceivednotesHeader.NetTotalAmount = filteredList?.Sum(x => x.NetAmount) ?? 0.00m;
        goodsreceivednotesHeader.NetTotalAmountLocal = filteredList?.Sum(x => x.NetAmountLocal) ?? 0.00m;

        goodsreceivednotesHeader.TaxTotalAmount = filteredList?.Sum(x => x.TaxAmount) ?? 0.00m;
        goodsreceivednotesHeader.TaxTotalAmountLocal = filteredList?.Sum(x => x.TaxAmountLocal) ?? 0.00m;

        goodsreceivednotesHeader.SubtotalAmount = filteredList?.Sum(x => x.SubAmount) ?? 0.00m;
        goodsreceivednotesHeader.SubtotalAmountLocal = filteredList?.Sum(x => x.SubAmountLocal) ?? 0.00m;

        goodsreceivednotesHeader.TaxExclusiveTotalAmount = filteredList?.Sum(x => x.TaxExclusiveAmount) ?? 0.00m;
        goodsreceivednotesHeader.TaxExclusiveTotalAmountLocal = filteredList?.Sum(x => x.TaxExclusiveAmountLocal) ?? 0.00m;

        goodsreceivednotesHeader.WTaxTotalAmount = filteredList?.Sum(x => x.WTaxAmount) ?? 0.00m;
        goodsreceivednotesHeader.WTaxTotalAmountLocal = filteredList?.Sum(x => x.WTaxAmountLocal) ?? 0.00m;
    }

