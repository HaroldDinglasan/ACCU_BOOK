@* FOR TRANSFER MODAL *@
<RadzenPopup @ref=popuptransfer Lazy=true class="popuptransfer">

    <RadzenCard>
        <RadzenStack Gap="0.2rem">

            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="7">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                        <RadzenTextBox Disabled=@(filteredPurchaseOrderTransferModel == null)
                                       @bind-Value="@searchText"
                                       Placeholder="Search..."
                                       Style="font-size:smaller; width:30rem;"
                                       Change="@(args => ApplyFilter())" />
                        <RadzenButton Disabled=@(filteredPurchaseOrderTransferModel == null) Icon="search" Click="@ApplyFilter" Text="Find" />
                        <RadzenButton Disabled=@(filteredPurchaseOrderTransferModel == null) Icon="delete" Click="@ClearFilter" Text="Find" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenDataGrid @ref="grids"
                            @bind-Value="selectedPurchaseOrderTransferModel"
                            SelectionMode="DataGridSelectionMode.Multiple"
                            TItem="PurchasesTranferList"
                            IsLoading="@isLoading"
                            Sort="@ShowLoading"
                            Group="@ShowLoading"
                            Filter="@ShowLoading"
                            AllowColumnReorder="true"
                            AllowAlternatingRows="false"
                            ColumnWidth="200px"
                            Data="@filteredPurchaseOrderTransferModel"
                            AllowColumnPicking="true"
                            Style="height: 60vh"
                            KeyProperty="Id"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            AllowColumnResize="true"
                            Density="@density"
                            AllowVirtualization="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList"
                            FilterCaseSensitivity="@filter"
                            LogicalFilterOperator="LogicalFilterOperator.Or">

                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                        <span>
                            For Transfer <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                        </span>
                    </RadzenStack>
                </HeaderTemplate>

                <Columns>
                    <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false">
                        <HeaderTemplate>
                            <RadzenCheckBox TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select all items" } })"
                                            Value="@(selectedPurchaseOrderTransferModel == null || selectedPurchaseOrderTransferModel?.Any() != true ? false : !filteredPurchaseOrderTransferModel.All( i => selectedPurchaseOrderTransferModel.Select(e => e.Id).Contains(i.Id)) ? null : filteredPurchaseOrderTransferModel.Any(i => selectedPurchaseOrderTransferModel.Select(e => e.Id).Contains(i.Id)))"
                                            Change="@(args => selectedPurchaseOrderTransferModel = args == true ? (selectedPurchaseOrderTransferModel ?? Enumerable.Empty<PurchasesTranferList>()).Union(filteredPurchaseOrderTransferModel.Where(i => !(selectedPurchaseOrderTransferModel ?? Enumerable.Empty<PurchasesTranferList>()).Select(e => e.Id).Contains(i.Id))).ToList() : null)" />
                        </HeaderTemplate>
                        <Template Context="data">
                            <RadzenCheckBox TriState="false" Value="@(selectedPurchaseOrderTransferModel != null && selectedPurchaseOrderTransferModel.Select(e => e.Id).Contains(data.Id))" TValue="bool" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible="true" Width="8rem" Property="@nameof(PurchasesTranferList.DocCode)" Title="PO #" />
                    <RadzenDataGridColumn Visible="true" Width="8rem" Property="@nameof(PurchasesTranferList.DocDate)" FormatString="{0:MM/dd/yyyy}" Title="Date" />
                    <RadzenDataGridColumn Visible="true" Property="@nameof(PurchasesTranferList.CreditorName)" Title="Account Name" />
                    <RadzenDataGridColumn Visible="true" Width="8rem" Property="@nameof(PurchasesTranferList.Purchaser)" Title="Purchaser" />
                    <RadzenDataGridColumn Visible="true" Width="6rem" Property="@nameof(PurchasesTranferList.Term)" Title="Term" />
                    <RadzenDataGridColumn Visible="true" Width="10rem" TextAlign="TextAlign.Right" Property="@nameof(PurchasesTranferList.TaxTotalAmount)" Title="Tax Total Amount">
                        <Template Context="data">
                            <span>@(data.TaxTotalAmount == 0 ? "" : data.TaxTotalAmount.ToString("#,0.00"))</span>
                        </Template>
                    </RadzenDataGridColumn>
