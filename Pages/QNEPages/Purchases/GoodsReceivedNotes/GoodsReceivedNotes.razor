    async Task DeleteRow(GoodsReceivedNotesDetails row)
    {
        if (goodsreceivednotesDetailsToInsert.Any() || goodsreceivednotesDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (await DialogService.Confirm("You are about to delete records. Do you want to proceed?", "Delete") == true)
        {
            await goodsReceivedNotesService.DeleteGoodsReceivedNotesDetails(row.Id.ToString());

            Reset(row);
            goodsreceivednotesDetails.Remove(row); // ✅ list.Remove(item) — no more ambiguity

            if (row.PurchaseOrderDetailId is not null)
            {
                var poDetail = purchaseOrdersDetails.FirstOrDefault(x => x.Id == row.PurchaseOrderDetailId);
                purchaseOrdersDetails.Remove(poDetail);

                var forTransferDetail = forTransferDetails.FirstOrDefault(x => x.Id == row.PurchaseOrderDetailId);
                forTransferDetails.Remove(forTransferDetail);
            }
            ResetPosIndexes();

            LoadSubtotalRow();
            LoadAllTaxTotalDiscNetAmount();

            await goodsreceivednotesDetailsGrid.Reload();
            StateHasChanged();
        }
    }

