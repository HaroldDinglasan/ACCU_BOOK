    private async Task OnSubmit()
    {
        busy = true;

        if (goodsreceivednotesDetailsToInsert.Any() || goodsreceivednotesDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            busy = false;
            return;
        }

        LoadAllTaxTotalDiscNetAmount();

        if (pendingBatchNumbers.Any())
        {
            var batchResult = await stockItemsService.SaveStockBatchNumbers(pendingBatchNumbers);
            if (!batchResult.StartsWith("Success"))
            {
                await DialogService.Alert(batchResult);
                busy = false;
                return;
            }
            pendingBatchNumbers.Clear();
        }

        var data = await goodsReceivedNotesService.SaveGoodsReceivedNoteWithTransferAsync(goodsreceivednotesHeader, goodsreceivednotesDetails, forTransferHeader, forTransferDetails);

        if (data is not null)
        {
            if (data.Contains("Success"))
            {

                // SYNC TO STOCK TRANSACTIONS SO STOCK INQUIRY REFLECTS QTY/PRICE EDITS
                await goodsReceivedNotesService.SaveGoodsReceivedNoteTransactions(goodsreceivednotesHeader, goodsreceivednotesDetails);

                await DialogService.Alert(data);
                btnDiseabled = true;
                busy = false;
            }
            else
            {
                await DialogService.Alert(data);
            }
        }
                busy = false;
    }

