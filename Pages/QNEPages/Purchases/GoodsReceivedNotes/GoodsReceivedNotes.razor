@page "/GoodsReceivedNotes"
@page "/GoodsReceivedNotes/Edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin, User")]

@if (isLoading)
{
    <Spinner />
}

@* TABLE HEADER *@
<RadzenTemplateForm TItem="GoodsReceivedNotesModel" Data="goodsreceivednotesHeader" Submit="@OnSubmit">

    <RadzenStack Gap="0.2rem">

        <RadzenCard Style="Padding: 0.5rem">

            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">

                <RadzenColumn Size="12" SizeSM="5">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        <RadzenButton Disabled=@(goodsreceivednotesHeader.CreditorId is null || btnDiseabled || !string.IsNullOrWhiteSpace(goodsreceivednotesHeader.TransferToInfo)) 
                                      Size="@smallbtn" 
                                      Icon="save" 
                                      BusyText="Saving..." 
                                      IsBusy=@busy 
                                      ButtonStyle="ButtonStyle.Primary" 
                                      Text="@btnText" 
                                      ButtonType="@Radzen.ButtonType.Submit" />

                        <RadzenButton Visible="@btnDiseabled" Text="New" Icon="add" Size="@smallbtn"
                                      ButtonStyle="ButtonStyle.Success"
                                      ButtonType="@Radzen.ButtonType.Button"
                                      Click="@OnNew" />

                        <RadzenButton Disabled=@(goodsreceivednotesHeader.CreditorId is null || Id is not null || btnDiseabled) Text="Transfer" Size="@smallbtn" ButtonStyle="ButtonStyle.Primary" @ref="@transferbutton" Icon="compare_arrows" Click="@(args => popuptransfer.ToggleAsync(transferbutton.Element))" />
                    </RadzenStack>

                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Disabled="@(permission?.AllowRead != true)" Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Search" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>

        <RadzenCard>

            <div style="margin-bottom: 0.5rem">
                Goods Received Note @goodsreceivednotesHeader.GoodsReceivedNoteCode <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>

                    <RadzenTabsItem Text="Details">
                        <RadzenRow>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Supplier" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        Disabled="@(goodsreceivednotesHeader.IsCancelled != true && goodsreceivednotesHeader.TransferToInfo != null || purchaseOrdersDetails is not null)"
                                                                        @bind-value=goodsreceivednotesHeader.CreditorId
                                                                        Change=@(args => OnCreditorChanged((Guid?)args))
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize="10"
                                                                        Data="@supplieraccountList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CompanyCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="4%" Property="CompanyCode" Title="Supplier #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CompanyName" Title="Name"></RadzenDropDownDataGridColumn>
                                                    </Columns>

                                                </RadzenDropDownDataGrid>

                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width: 100%" Text="From" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="goodsreceivednotesHeader.CreditorName" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width: 100%" Text="Term" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Name="Terms" class="@redtext"
                                                                        @bind-Value="goodsreceivednotesHeader.TermId"
                                                                        Data="@termList"
                                                                        Style="width: 100%;"
                                                                        AllowSorting="false"
                                                                        PageSize="10"
                                                                        AllowVirtualization="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="Term"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Term" Title="Term"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Terms" Text="'Term' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value="@goodsreceivednotesHeader.StockLocationId"
                                                                        Change="@(args => OnStockLocationChanged(args))"
                                                                        Data="@stocklocationList"
                                                                        AllowSorting="false"
                                                                        Style="width: 120%;"
                                                                        PageSize="10"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data"><RadzenCheckBox TValue="bool" Value="data.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value="goodsreceivednotesHeader.ProjectId"
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize="10"
                                                                        Data="@projectList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Currency" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Disabled="true" class="@redtext"
                                                                        @bind-Value=@goodsreceivednotesHeader.CurrencyId
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize=10
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CurrencyCode" Density="@density" Data="@currencyList" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CurrencyCode" Title="CurrencyCode"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Attention" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Attention Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Purchaser" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value=@goodsreceivednotesHeader.PurchaserId
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize=10
                                                                        Data="@purchaserList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="Name"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Name" Title="Purchaser #"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Supplier DO No" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.CreditorDONo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Rate" AllowFloatingLabel="false">
                                                <RadzenNumeric ShowUpDown="false" Disabled="true" class="@redtext" @bind-Value=@goodsreceivednotesHeader.CurrencyRate Style="width: 100%;" Placeholder="Exchange Rate"></RadzenNumeric>
                                                @*   <RadzenTextBox @bind-Value=purchaserequisition.CurrencyRate Style="width: 100%;" Placeholder="Exchange Rate" /> *@
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetGoodsReceivedNotesNo" class="@redtext" @bind-Value="@goodsreceivednotesHeader.GoodsReceivedNoteDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:92%" Text="GRN No." AllowFloatingLabel="false">
                                                @*     <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="width: 90%;" Gap="0.5rem;">
                                                            <RadzenDropDown Change="SetRequisitionNo" SelectedItemsText="" Placeholder="@goodsreceivednotesHeader.PurchaseOrderCode" class="@redtext" @bind-Value=@goodsreceivednotesHeader.PurchaseOrderCode Data=@transactionCodesList TextProperty="@nameof(TransactionsCode.Format)" SelectedItem="0" ValueProperty="@nameof(TransactionsCode.Format)" Style="width: 100%;" />
                                                        </RadzenStack>
                                                        <RadzenButton Click="() => OpenDialog(2)" Icon="more_horiz"></RadzenButton>
                                                    </RadzenStack> *@
                                                <RadzenTextBox class="@redtext" @bind-Value="@goodsreceivednotesHeader.GoodsReceivedNoteCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="width:5%" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@(args => popup.ToggleAsync(button.Element))" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox Name="Reference" class="@redtext" @bind-Value="@goodsreceivednotesHeader.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Reference" Text="'Reference No.' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems" JustifyContent="JustifyContent.Start" Style="margin-top:1rem;">
                                        <RadzenColumn Visible=false" Size="4">
                                            <RadzenSwitch @bind-Value=goodsreceivednotesHeader.IsCancelled Name="Active" />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Cancelled"></RadzenText>
                                        </RadzenColumn>
                                        <RadzenColumn Size="4">
                                            <RadzenSwitch @bind-Value=goodsreceivednotesHeader.IsTaxInclusive Name="Active" Change="@IsTaxInclusiveChanged" />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Tax Inclusive"></RadzenText>
                                        </RadzenColumn>

                                        @if (Id is not null)
                                        {
                                            <RadzenColumn Size="4">
                                                <RadzenSwitch @bind-Value="@goodsreceivednotesHeader.IsCancelled" Change=@(args => OnSwitchChanged("IsCancelled")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Cancelled"></RadzenText>
                                            </RadzenColumn>

                                            <RadzenColumn Size="4">
                                                <RadzenSwitch @bind-Value="@goodsreceivednotesHeader.IsClosed" Change=@(args => OnSwitchChanged("IsClosed")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Closed"></RadzenText>
                                            </RadzenColumn>
                                        }


                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Supplier">
                        <RadzenRow>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Address1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Address2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Address3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Address4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="GST ID" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled="true" class="@redtext" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Delivery Term" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.DeliveryTerm Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenFormField Style="width:100%" Text="Phone" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Phone Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>

                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenFormField Style="width:100%" Text="Fax" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Fax Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Deliver To">
                        <RadzenRow>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.DeliverAddress1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.DeliverAddress2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.DeliverAddress3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.DeliverAddress4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Delivery Contact" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.DeliverContact Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Phone" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.DeliverPhone Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Fax" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.DeliverFax Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Others">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Title" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="width: 90%;" Gap="0.5rem;">
                                                        <RadzenDropDown class="@redtext" @bind-Value=@goodsreceivednotesHeader.Title Data=@descriptionsList TextProperty="@nameof(Descriptions.Description)" SelectedItem="0" ValueProperty="@nameof(Descriptions.Description)" Style="width: 100%;" />
                                                    </RadzenStack>
                                                </RadzenStack>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Transfer From" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@goodsreceivednotesHeader.TransferFromInfo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Transfer To" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@goodsreceivednotesHeader.TransferToInfo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Ref1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Ref2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Remark1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@goodsreceivednotesHeader.Remark2 Style="width: 100%;" />
