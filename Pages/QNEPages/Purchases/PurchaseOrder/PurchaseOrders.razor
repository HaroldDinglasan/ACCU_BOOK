    private void LoadAllTaxTotalDiscNetAmount()
    {
        ///INCLUDE HERE THE TAX, DISCOUNT, WTAX, AMOUT, ALL QUOTATION DETAILS AMOUNT


        var filteredList = purchaseorderDetails?.Where(x => (x.Description?.Split(' ')[0] != "SUBTOTAL"));


        purchaseordersHeader.TotalAmount = filteredList?.Sum(x => x.Amount) ?? 0.00m;
        purchaseordersHeader.TotalAmountLocal = filteredList?.Sum(x => x.AmountLocal) ?? 0.00m;

        purchaseordersHeader.DiscountAmount = filteredList?.Sum(x => x.DiscountAmount) ?? 0.00m;
        purchaseordersHeader.DiscountAmountLocal = filteredList?.Sum(x => x.DiscountAmountLocal) ?? 0.00m;

        purchaseordersHeader.NetTotalAmount = filteredList?.Sum(x => x.NetAmount) ?? 0.00m;
        purchaseordersHeader.NetTotalAmountLocal = filteredList?.Sum(x => x.NetAmountLocal) ?? 0.00m;

        purchaseordersHeader.TaxTotalAmount = filteredList?.Sum(x => x.TaxAmount) ?? 0.00m;
        purchaseordersHeader.TaxTotalAmountLocal = filteredList?.Sum(x => x.TaxAmountLocal) ?? 0.00m;

        purchaseordersHeader.SubtotalAmount = filteredList?.Sum(x => x.SubAmount) ?? 0.00m;
        purchaseordersHeader.SubtotalAmountLocal = filteredList?.Sum(x => x.SubAmountLocal) ?? 0.00m;

        purchaseordersHeader.TaxExclusiveTotalAmount = filteredList?.Sum(x => x.TaxExclusiveAmount) ?? 0.00m;
        purchaseordersHeader.TaxExclusiveTotalAmountLocal = filteredList?.Sum(x => x.TaxExclusiveAmountLocal) ?? 0.00m;

        purchaseordersHeader.WTaxTotalAmount = filteredList?.Sum(x => x.WTaxAmount) ?? 0.00m;
        purchaseordersHeader.WTaxTotalAmountLocal = filteredList?.Sum(x => x.WTaxAmountLocal) ?? 0.00m;
    }

    private void LoadSubtotalRow()
    {
        ///

        if (purchaseorderDetails == null || !purchaseorderDetails.Any())
            return;

        var subtotalRow = purchaseorderDetails
           .FirstOrDefault(x => x.Description?.StartsWith("SUBTOTAL") == true);

        if (subtotalRow == null)
            return;

        var rows = purchaseorderDetails
            .Where(x => x.Description?.Split(' ')[0] is not ("SUBTOTAL" or "DISCOUNT" or "SALES DISCOUNT"))
            .ToList();

        subtotalRow.Amount = rows.Sum(x => x.Amount);
        subtotalRow.AmountLocal = rows.Sum(x => x.AmountLocal);

        subtotalRow.DiscountAmount = rows.Sum(x => x.DiscountAmount);
        subtotalRow.DiscountAmountLocal = rows.Sum(x => x.DiscountAmountLocal);

        subtotalRow.NetAmount = rows.Sum(x => x.NetAmount);
        subtotalRow.NetAmountLocal = rows.Sum(x => x.NetAmountLocal);

        subtotalRow.TaxAmount = rows.Sum(x => x.TaxAmount);
        subtotalRow.TaxAmountLocal = rows.Sum(x => x.TaxAmountLocal);

        subtotalRow.SubAmount = rows.Sum(x => x.SubAmount);
        subtotalRow.SubAmountLocal = rows.Sum(x => x.SubAmountLocal);

        subtotalRow.TaxExclusiveAmount = rows.Sum(x => x.TaxExclusiveAmount);
        subtotalRow.TaxExclusiveAmountLocal = rows.Sum(x => x.TaxExclusiveAmountLocal);

        subtotalRow.WTaxAmount = rows.Sum(x => x.WTaxAmount);
        subtotalRow.WTaxAmountLocal = rows.Sum(x => x.WTaxAmountLocal);

    }


