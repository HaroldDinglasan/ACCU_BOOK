    public decimal DueAmount => (purchaseordersHeader?.NetTotalAmountLocal ?? 0m) - (purchaseordersHeader?.WTaxTotalAmountLocal ?? 0m);

}





@* FOR TRANSFER MODAL *@
<RadzenPopup @ref=popuptransfer Lazy=true class="popuptransfer">

    <RadzenCard>
        <RadzenStack Gap="0.2rem">

            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="7">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                        <RadzenTextBox Disabled=@(filteredPurchasesTranferModel == null)
                                       @bind-Value="@searchText"
                                       Placeholder="Search..."
                                       Style="font-size:smaller; width:30rem;"
                                       Change="@(args => ApplyFilter())" />
                        <RadzenButton Disabled=@(filteredPurchasesTranferModel == null) Icon="search" Click="@ApplyFilter" Text="Find" />
                        <RadzenButton Disabled=@(filteredPurchasesTranferModel == null) Icon="delete" Click="@ClearFilter" Text="Clear" />
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>


            <RadzenDataGrid @ref="grids"
                            @bind-Value=@selectedPurchasesTranferModel
                            SelectionMode="DataGridSelectionMode.Multiple"
                            TItem="PurchasesTranferList"
                            IsLoading=@isLoading
                            Sort="@ShowLoading"
                            Page="@ShowLoading"
                            Group="@ShowLoading"
                            Filter="@ShowLoading"
                            AllowColumnReorder="true"
                            AllowAlternatingRows="false"
                            ColumnWidth="200px"
                            Data="@filteredPurchasesTranferModel"
                            AllowColumnPicking="true"
                            Style="height: 60vh"
                            KeyProperty="Id"
                            PagerHorizontalAlign="HorizontalAlign.Center"
                            AllowColumnResize="true"
                            Density="@density"
                            AllowVirtualization="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList"
                            FilterCaseSensitivity="@filter"
                            LogicalFilterOperator="LogicalFilterOperator.Or">

                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                        <span>
                            For Transfer <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                        </span>
                    </RadzenStack>
                </HeaderTemplate>

                <Columns>
                    <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false">
                        <HeaderTemplate>
                            <RadzenCheckBox TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select all items" } })"
                                            Value="@(selectedPurchasesTranferModel == null || selectedPurchasesTranferModel?.Any() != true ? false : !filteredPurchasesTranferModel.All(i => selectedPurchasesTranferModel.Select(e => e.Id).Contains(i.Id)) ? null : filteredPurchasesTranferModel.Any(i => selectedPurchasesTranferModel.Select(e => e.Id).Contains(i.Id)))"
                                            Change="@(args => selectedPurchasesTranferModel = args == true ? (selectedPurchasesTranferModel ?? Enumerable.Empty<PurchasesTranferList>()).Union(filteredPurchasesTranferModel.Where(i => !(selectedPurchasesTranferModel ?? Enumerable.Empty<PurchasesTranferList>()).Select(e => e.Id).Contains(i.Id))).ToList() : null)" />
                        </HeaderTemplate>
                        <Template Context="data">
                            <RadzenCheckBox TriState="false" Value="@(selectedPurchasesTranferModel != null && selectedPurchasesTranferModel.Select(e => e.Id).Contains(data.Id))" TValue="bool" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible=true Width="8rem" Property="@nameof(PurchasesTranferList.DocCode)" Title="PR #" />
                    <RadzenDataGridColumn Visible=true Width="8rem" Property="@nameof(PurchasesTranferList.DocDate)" FormatString="{0:MM/dd/yyyy}" Title="Date" />
                    <RadzenDataGridColumn Visible=true Property="@nameof(PurchasesTranferList.CreditorName)" Title="Account Name" />
                    <RadzenDataGridColumn Visible=true Width="8rem" Property="@nameof(PurchasesTranferList.Purchaser)" Title="Purchaser" />
                    <RadzenDataGridColumn Visible=true Width="8rem" Property="@nameof(PurchasesTranferList.RequestBy)" Title="Request By" />
                    <RadzenDataGridColumn Visible=true Width="6rem" Property="@nameof(PurchasesTranferList.Term)" Title="Term"></RadzenDataGridColumn>
                    <RadzenDataGridColumn Visible=true Width="10rem" TextAlign="TextAlign.Right" Property="@nameof(PurchasesTranferList.TaxTotalAmount)" Title="Tax Total Amount">
                        <Template Context="data">
                            <span>@(data.TaxTotalAmount == 0 ? "" : data.TaxTotalAmount.ToString("#,0.00"))</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible=true Width="10rem" TextAlign="TextAlign.Right" Property="@nameof(PurchasesTranferList.NetTotalAmount)" Title="Due Amount">
                        <Template Context="data">
                            <span>@(data.NetTotalAmount == 0 ? "" : data.NetTotalAmount.ToString("#,0.00"))</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                        Test Data:
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="5">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right">

                        <RadzenButton Icon="check" Click=@OnOkClicked Text="Ok" /> @* dito is magrereturn sya ng mga naselect na check na data papunt dito NavManager.NavigateTo($"/PurchaseOrders/Transfer/{PRId}"); *@
                        <RadzenButton Icon="cancel" Text="Cancel" Click="async args => { selectedPurchasesTranferModel = null; await popuptransfer.CloseAsync(); }" /> @* then dito magcclose yung dialog *@
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>

        </RadzenStack>
    </RadzenCard>

</RadzenPopup>


