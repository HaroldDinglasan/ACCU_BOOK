    async Task InsertAfterRow(PurchaseOrdersDetails purchaseordersDetails)
    {

        // If there's an active edit, prevent adding another row until it's saved.
        if (purchaseorderDetailsToInsert.Any() || purchaseorderDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!purchaseorderDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }



        var purchOrderDetails = new PurchaseOrdersDetails();

        purchOrderDetails.PurchaseOrderId = Id ?? purchaseordersHeader.Id;
        purchOrderDetails.IsTaxInclusive = purchaseordersHeader.IsTaxInclusive;
        // purchOrderDetails.TaxCodeId = customerList.FirstOrDefault(c => c.Id == quotationHeader.DebtorId)?.DefaultTaxCodeId;

        // Explicitly add the new item to the bound list
        purchaseorderDetailsToInsert.Add(purchOrderDetails);
        var index = purchaseorderDetails.IndexOf(purchaseordersDetails);
        if (index >= 0)
        {
            purchaseorderDetails.Insert(index + 1, purchOrderDetails);
        }
        else
        {
            purchaseorderDetails.Add(purchOrderDetails);
        }

        ResetPosIndexes();
        await purchaseorderDetailsGrid.InsertRow(purchOrderDetails);
        await purchaseorderDetailsGrid.Reload();
        StateHasChanged();
    }

    async Task EditRow(PurchaseOrdersDetails purchaseordersDetails)
    {
        // If there's another row already in edit/insert mode, prevent editing this one.
        if (purchaseorderDetailsToInsert.Any() || purchaseorderDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }


        if (!purchaseorderDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        purchaseorderDetailsToUpdate.Add(purchaseordersDetails); // Track it as an item being updated
        await purchaseorderDetailsGrid.EditRow(purchaseordersDetails);
        StateHasChanged(); // Ensure UI updates and list is reflected
    }


