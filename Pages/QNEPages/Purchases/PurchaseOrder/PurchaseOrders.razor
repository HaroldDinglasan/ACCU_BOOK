        var uomRate = uomsList.FirstOrDefault(u => u.Id == purchaseorderDetails.UOMId && u.IsActive == true);

        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);

            if (selectedStock != null)
            {
                //if (selectedStock.StockName?.Split(' ')[0] is ("DISCOUNT" or "SUBTOTAL"))
                if (selectedStock.ItemTypeCode is ("T" or "D"))
                {
                    purchaseorderDetails.Qty = 0.00000000M;
                    purchaseorderDetails.UOMId = null;
                    purchaseorderDetails.UnitPrice = 0.00000000M;
                    purchaseorderDetails.PurchaseOrderId = purchaseordersHeader.Id;
                    purchaseorderDetails.StockId = selectedStock.Id;
                    purchaseorderDetails.StockLocationId = purchaseordersHeader.StockLocationId;
                    purchaseorderDetails.Discount = string.Join("/", Regex.Matches(selectedStock.StockName, @"\d+%").Select(m => m.Value));
                    purchaseorderDetails.Description = selectedStock.StockName;
                    purchaseorderDetails.ItemTypeCode = selectedStock.ItemTypeCode;
                    purchaseorderDetails.TaxCodeId = null;
                    purchaseorderDetails.WTaxCode = null;
                    //LoadSubtotalRow();
                    purchaseorderDetails.Amount = Amount;
                    purchaseorderDetails.AmountLocal = AmountLocal;
                    purchaseorderDetails.DiscountAmount = DiscountAmount;
                    purchaseorderDetails.DiscountAmountLocal = DiscountAmountLocal;
                    purchaseorderDetails.NetAmount = NetAmount;
                    purchaseorderDetails.NetAmountLocal = NetAmountLocal;
                    purchaseorderDetails.TaxAmount = TaxAmount;
                    purchaseorderDetails.TaxAmountLocal = TaxAmountLocal;
                    purchaseorderDetails.SubAmount = SubAmount;
                    purchaseorderDetails.SubAmountLocal = SubAmountLocal;
                    purchaseorderDetails.TaxExclusiveAmount = TaxExclusiveAmount;
                    purchaseorderDetails.TaxExclusiveAmountLocal = TaxExclusiveAmountLocal;
                    purchaseorderDetails.WTaxAmount = WTaxAmount;
                    purchaseorderDetails.WTaxAmountLocal = WTaxAmountLocal;
                    //if (selectedStock.StockName?.Split(' ')[0] == "DISCOUNT")
                    if (selectedStock.ItemTypeCode is ("D"))
                    {
                        //LoadSubtotalRow();
                        DiscountAndSubtotalHelper.Compute(purchaseorderDetails);
                    }
                }
                else
                {
                    if (selectedStock.StockName is ("SALES DISCOUNT"))
                    {
                        purchaseorderDetails.Qty = 1.00000000M;
                        purchaseorderDetails.UOMId = null;
                        //UnitPrice = added.NetAmount,
                        purchaseorderDetails.UnitPrice = DiscountAmount;//SUM OF DISCOUNT AMOUNT
                        //Discount = discountDesrciption,
                        purchaseorderDetails.PurchaseOrderId = purchaseordersHeader.Id;
                        purchaseorderDetails.StockId = selectedStock.Id;
                        purchaseorderDetails.StockLocationId = purchaseordersHeader.StockLocationId;
                        purchaseorderDetails.Description = selectedStock.StockName;
                        purchaseorderDetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        purchaseorderDetails.TaxCodeId = null;
                        purchaseorderDetails.WTaxCode = null;


                        purchaseorderDetails.Amount = DiscountAmount;
                        purchaseorderDetails.AmountLocal = DiscountAmount;
                        //DiscountAmount = DiscountAmount,
                        //DiscountAmountLocal = DiscountAmountLocal,
                        purchaseorderDetails.NetAmount = DiscountAmount;
                        purchaseorderDetails.NetAmountLocal = DiscountAmount;
                        //TaxAmount = TaxAmount,
                        //TaxAmountLocal = TaxAmountLocal,
                        purchaseorderDetails.SubAmount = DiscountAmount;
                        purchaseorderDetails.SubAmountLocal = DiscountAmount;
                        purchaseorderDetails.TaxExclusiveAmount = DiscountAmount;
                        purchaseorderDetails.TaxExclusiveAmountLocal = DiscountAmount;
                    }
                    else
                    {


                        //       .Select(item =>
                        // {
                        //     var uomRate = uomsList.FirstOrDefault(u => u.Id == item.UOMId);

                        //     return new ForTransferDetails
                        //     {
                        //         PurchaseRequisitionDetailId = item.Id,
                        //         TransferredBaseUnit = item.Qty,
                        //         Transferred = item.Qty * (uomRate?.Rate ?? 1),
                        //         SourceKey = item.Id,
                        //     };
                        // })
                        // .ToList();


                        //IsDisable = false;
                        purchaseorderDetails.PurchaseOrderId = purchaseordersHeader.Id;
                        purchaseorderDetails.StockLocationId = purchaseordersHeader.StockLocationId;

                        // Populate Description
                        purchaseorderDetails.Description = selectedStock.StockName;
                        purchaseorderDetails.Discount = string.Empty;

                        //Set Tax Code Id
                        purchaseorderDetails.TaxCodeId = selectedSupplier?.DefaultTaxCodeId;
                        purchaseorderDetails.WTaxCode = selectedSupplier?.DefaultWTaxCodeId;

                        // Default Quantity
                        purchaseorderDetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        purchaseorderDetails.Qty = 1.0000M;

                        //purchaseorderDetails.PackingUOM2 = purchaseorderDetails.Qty * (uomRate?.Rate ?? 1);

                        // Set the base UOM
                        var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStockId && u.UOMCode == selectedStock.BaseUOM);
                        if (baseUOM != null)
                        {
                            purchaseorderDetails.UOMId = baseUOM.Id;
                        }

                        // Load Last Price
                        var data = lastSellingPrice.Where(x => x.StockId == selectedStockId).FirstOrDefault();
                        if (data != null)
                        {
                            purchaseorderDetails.UnitPrice = data.UnitPrice;
                            TransactionHelper(purchaseorderDetails);
                        }
                        else
                        {
                            purchaseorderDetails.UnitPrice = 0.00000000M;
                        }
                    }
                }

                // Just trigger state change, don't reload grid
                StateHasChanged();
            }
        }
        else
        {

            // Clear fields if no stock is selected
            purchaseorderDetails.UnitPrice = 0.00000000M;
            purchaseorderDetails.StockId = null;
            purchaseorderDetails.StockLocationId = null;
            purchaseorderDetails.Description = string.Empty;
            purchaseorderDetails.Qty = 0.00m;
            purchaseorderDetails.UOMId = null;
