@code {
    [Parameter]
    public Guid? Id { get; set; }

    // [Parameter]
    // public Guid? PRId { get; set; }


    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }

    AlignItems alignItems = AlignItems.Center;
    Density density = Density.Compact;
    TextStyle textStyle = TextStyle.Body2;
    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    ButtonSize smallbtn = ButtonSize.Small;

    //FOR POP UP DIALOG
    RadzenButton button;
    RadzenPopup popup;

    RadzenButton transferbutton;
    RadzenPopup popuptransfer;
    RadzenDataGrid<TransactionsCode> transactionsCodeGrid;
    protected IList<TransactionsCode> selectedtransactionCodesList { get; set; }

    //FOR PROPERTY SET VALUE OF OBJECT
    string btnText = "Save";
    string redtext;
    string status = string.Empty;
    bool busy = false;
    bool btnDiseabled = false;


    //for diseabled purchase order details table
    protected bool IsDisable => purchaseorderDetails.FirstOrDefault()?.StockId == null;

    //FORM MODEL
    private PurchaseOrdersModel purchaseordersHeader { get; set; } = new PurchaseOrdersModel();
    //for loading data
    bool isLoading = true;
    RadzenDataGrid<PurchaseOrdersDetails> purchaseorderDetailsGrid;

    DataGridEditMode editMode = DataGridEditMode.Single;
    List<PurchaseOrdersDetails> purchaseorderDetailsToInsert = new List<PurchaseOrdersDetails>();
    List<PurchaseOrdersDetails> purchaseorderDetailsToUpdate = new List<PurchaseOrdersDetails>();
    protected List<PurchaseOrdersDetails> purchaseorderDetails { get; set; }



    //ALL LIST FOR DROPDOWN BOX INPUT
    protected IEnumerable<Creditors> supplieraccountList { get; set; }
    protected IEnumerable<Terms> termList { get; set; }
    protected IEnumerable<StockLocations> stocklocationList { get; set; }
    protected IEnumerable<Projects> projectList { get; set; }
    protected IEnumerable<Currencies> currencyList { get; set; }
    protected IEnumerable<Purchasers> purchaserList { get; set; }
    protected IEnumerable<Stocks> stockList { get; set; }
    protected IEnumerable<UOMs> uomsList { get; set; }
    protected IEnumerable<SecuritySystemUser> requestedList { get; set; }
    protected IEnumerable<WTaxCodes> wTaxCodesList { get; set; }
    protected IEnumerable<TaxCodes> taxCodesList { get; set; }


    protected TaxCodeFilter taxCodeFilter = new TaxCodeFilter();


    // Page Initialization
    protected async override Task OnInitializedAsync()
    {

        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            //For update

            var RoleId = authState.FindFirst("RoleId").Value;
            GetLoadMenuPermission(RoleId);
        }

    }

    private SystemMenuObjectPermission? permission;
    protected async void GetLoadMenuPermission(string RoleId)
    {
        permission = await permissionService.GetPermissionAsync(
         RoleId,
         "Purchase Orders");

        if (permission is null)
            return;

        SetTransactionCodeData();
        InitializePurchaseOrderDetails();
        await loadAllData();

        if (Id != null)
            await loadAllDataById();

        StateHasChanged();
    }



    private async Task loadAllData()
    {

        await GetTransactionNo();
        await GetSupplierList();
        await GetTermList();
        await GetLocationList();
        await GetProjectList();
        await GetPurchaserList();
        await GetCurrencyList();
        await GetStockList();
        await GetStocksPriceList();
        await GetUOMSList();
        await GetTaxCodesList();
        await GetWTaxCodesList();
        await GetDescriptions();
        await SetPurchaseOrderNo();


        SetDefaultCurrency();
        isLoading = false;
        StateHasChanged();

    }

    private async Task loadAllDataById()
    {
        await GetPurchaseOrdersById();
        await GetPurchaseOrdersDetailById();
        LoadPRStatus();
        isLoading = false;
        StateHasChanged();
    }

    //GET ALL UOMLIST PER STOCK
    protected async Task GetUOMSList()
    {
        var data = await stockItemsService.GetUOMsList();
        uomsList = data is not null ? data : new List<UOMs>();
    }

    // LOAD DIFFERENT UOMS PER STOCK ON QUOTATION DETAILS
    private IEnumerable<UOMs> GetUOMsForStock(Guid? stockId)
    {
        if (stockId == null || uomsList == null)
            return Enumerable.Empty<UOMs>();
        return uomsList.Where(u => u.StockId == stockId);
    }

    protected async Task GetSupplierList()
    {
        var data = await suppliersServices.GetSupplierLists();
        supplieraccountList = data is not null ? data : new List<Creditors>();
    }


    protected async Task GetTermList()
    {
        var data = await termService.GetTermsLists();
        termList = data is not null ? data : new List<Terms>();
    }

    protected async Task GetLocationList()
    {
        var data = await stockItemsService.GetStockLocationList();
        stocklocationList = data is not null ? data : new List<StockLocations>();
    }

    protected async Task GetProjectList()
    {
        var data = await projectService.GetProjectsLists();
        projectList = data is not null ? data : new List<Projects>();
    }

    protected async Task GetPurchaserList()
    {
        var data = await purchaseRequisitionsService.GetPurchaserLists();
        purchaserList = data is not null ? data : new List<Purchasers>();

    }
    //Get Currencies From db.Currencies
    protected async Task GetCurrencyList()
    {
        var data = await currenciesService.GetCurrencies();
        currencyList = data is not null ? data : new List<Currencies>();
    }


    protected void SetDefaultCurrency()
    {
        var selectedCurrency = currencyList.FirstOrDefault(c => c.Id == 1);
        purchaseordersHeader.CurrencyId = selectedCurrency.Id;
        purchaseordersHeader.CurrencyRate = selectedCurrency.DefaultPurchaseRate;
    }


    //Get Stock List From db.Stocks
    protected async Task GetStockList()
    {
        var data = await stockItemsService.GetStockList();
        stockList = data is not null ? data : new List<Stocks>();
    }

    protected IEnumerable<StockUnitPrice> lastSellingPrice { get; set; }
    protected async Task GetStocksPriceList()
    {
        var data = await stockItemsService.GetStocksPriceList("PO");
        lastSellingPrice = data is not null ? data : new List<StockUnitPrice>();
    }

    protected async Task GetDescriptions()
    {
        var data = await descriptionsService.GetDescriptions(descriptionFilter);
        descriptionsList = data is not null ? data : new List<Descriptions>();

        var selected = descriptionsList.FirstOrDefault(sa => sa.IsDefault == true);
        purchaseordersHeader.Title = selected.Description; // Select first item

    }


    protected IEnumerable<Descriptions> descriptionsList { get; set; }
    protected IEnumerable<TransactionsCode> transactionCodesList { get; set; }
    protected DescriptionFilter descriptionFilter { get; set; } = new DescriptionFilter();
    protected TransactionCodesFilter transactionCodesFilter = new TransactionCodesFilter();
    private void SetTransactionCodeData()
    {
        descriptionFilter.OwnerCode = "PurchaseOrders.Title";
        //For Generating Quotations Code Getting Format from db.TransactionCodes
        transactionCodesFilter.TableId = 75;
    }
    //GETTING REQUISITION NUMBER FORMAT FROM db.TransactionCodes
    protected async Task GetTransactionNo()
    {
        var data = await transactionCodeService.GetTransactionNo(transactionCodesFilter);
        transactionCodesList = data is not null ? data.ToList() : new List<TransactionsCode>();
    }

    //FOR RUNNING NUMBERS
    protected TransactionsCode selectedTransacCode => transactionCodesList.FirstOrDefault(sa => sa.IsDefault == true);
    protected RunningNumbers runningNumbers { get; set; } = new RunningNumbers();

    protected async Task SetPurchaseOrderPopup(int Id)
    {
        await SetPurchaseOrderNo();

    }
    protected async Task SetPurchaseOrderNo()
    {
        runningNumbers.DocDate = purchaseordersHeader.PurchaseOrderDate;
        runningNumbers.Format = selectedTransacCode?.Format;
        runningNumbers.ColumnName = "PurchaseOrderCode";
        runningNumbers.TableName = "PurchaseOrders";

        await GetNextQuotationCodeAsync();
        await popup.CloseAsync();

    }


    private async Task GetNextQuotationCodeAsync()
    {
        var data = await runningNumberService.GetNextRunningNumber(runningNumbers);
        purchaseordersHeader.PurchaseOrderCode = data is not null ? data : string.Empty;

    }



    protected void LoadPRStatus()
    {
        var statusList = new List<string>();
        if (purchaseordersHeader.IsClosed)
            statusList.Add("Closed");

        if (purchaseordersHeader.IsCancelled)
            statusList.Add("Cancelled");

        if (statusList.Any())
        {
            status = $"({string.Join(", ", statusList)})";
        }
        else if (!string.IsNullOrWhiteSpace(purchaseordersHeader.TransferToInfo))
        {
            status = "(Transferred)";
        }

        StateHasChanged();
    }

    //Tax Code List
    protected async Task GetTaxCodesList()
    {
        taxCodeFilter.IsOutOrIn = false;// true for Output Tax Codes
