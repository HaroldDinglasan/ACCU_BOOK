@code {

    //TRANSFER FUNCTION


    //bool IsForTransfer = false;

    protected ForTransferHeader forTransferHeader { get; set; } = new ForTransferHeader();
    protected List<ForTransferDetails> forTransferDetails { get; set; }

    //FOR TRANSFER LIST
    private RadzenDataGrid<PurchasesTranferList> grids;
    private IList<PurchasesTranferList> selectedPurchasesTranferModel { get; set; }
    private IEnumerable<PurchasesTranferList> purchasesTranferModelList { get; set; }

    //FOR GETTING PR DETAILS
    private PurchaseRequisitionModel purchaseRequisitionHeader { get; set; }
    protected List<PurchaseRequisitionDetails> purchaseRequisitionDetails { get; set; }
    Variant variant = Variant.Flat;
    int totalPurchaseRequisition = 0;

    public List<Guid> selectedIds = new();
    private string searchText = string.Empty;
    private IEnumerable<PurchasesTranferList> filteredPurchasesTranferModel;

    private async Task LoadfilteredPurchasesTranfer()
    {
        filteredPurchasesTranferModel = purchasesTranferModelList;
    }
    private async Task GetPurchaseRequisitionsListing(string CreditorId)
    {

        var data = await purchaseTransferLinkServices.GetPurchasesTranferLists(CreditorId, "PR");
        purchasesTranferModelList = data is not null ? data : new List<PurchasesTranferList>();
        totalPurchaseRequisition = purchasesTranferModelList.Count();

        await LoadfilteredPurchasesTranfer();
    }


    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredPurchasesTranferModel = purchasesTranferModelList;
        }
        else
        {
            filteredPurchasesTranferModel = purchasesTranferModelList.Where(x =>
                (!string.IsNullOrEmpty(x.DocDate.ToString()) && x.DocDate.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.DocCode) && x.DocCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.CreditorName) && x.CreditorName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Purchaser) && x.Purchaser.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.RequestBy) && x.RequestBy.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            );
        }
        StateHasChanged();
    }

    private void ClearFilter()
    {
        searchText = string.Empty;
        filteredPurchasesTranferModel = purchasesTranferModelList;
        StateHasChanged();
    }

    async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();
    }


    private async void OnOkClicked()
    {
        //DAGDAG TRANSFER DIN PALA YUN HEADER
        if (selectedPurchasesTranferModel != null && selectedPurchasesTranferModel.Any())
        {

            // collect all Ids as comma-separated
            var PRDetailsId = string.Join(",", selectedPurchasesTranferModel.Select(x => x.Id));


            if (!string.IsNullOrWhiteSpace(PRDetailsId))
            {
                selectedIds = PRDetailsId.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                  .Select(Guid.Parse)
                                  .ToList();

                //SET FIRST ROW DATA OF HIGHEST TAX AMOUNT
                var highestTaxItem = selectedPurchasesTranferModel.OrderByDescending(x => x.TaxTotalAmount).FirstOrDefault();
                await GetPurchaseRequisitionHeaderById(highestTaxItem.Id.ToString());
                await GetPurchaseRequisitionDetailsById();

            }

        }
        else
        {
            status = "Please select at least one";
            StateHasChanged();
        }

    }




    protected async Task GetPurchaseRequisitionHeaderById(string PRId)
    {
        await ShowLoading();

        var header = await purchaseTransferLinkServices.GetPurchaseRequisitionsHeaderIdFortransfer(PRId);

        purchaseRequisitionHeader = header is not null ? header : new PurchaseRequisitionModel();

        //await DialogService.Alert("Purchase Requisition Highest Amount " + header.TaxTotalAmount + " loaded successfully.");
    }


    protected async Task GetPurchaseRequisitionDetailsById()
    {
        await ShowLoading();
        var prDetails = new List<PurchaseRequisitionDetails>();

        //purchaseRequisitionHeader
        foreach (var PRDetailsId in selectedIds)
        {
            var detailsdata = await purchaseTransferLinkServices.GetPurchaseRequisitionsDetailByIdFortransfer(PRDetailsId.ToString());
            if (detailsdata != null)
                prDetails.AddRange(detailsdata);
        }

        purchaseRequisitionDetails = prDetails;
        //forTransferHeader.IsForTransfer = true;
        LoadForTransferDetails();


    }

