@page "/PurchaseOrders"
@page "/PurchaseOrders/Edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin,User")]
@using Radzen.Blazor.Rendering


@if (isLoading)
{
    <Spinner />
}


@* TABLE HEADER *@
<RadzenTemplateForm TItem="PurchaseOrdersModel" Data="purchaseordersHeader" Submit="@OnSubmit">

    <RadzenStack Gap="0.2rem">

        <RadzenCard Style="Padding: 0.5rem">

            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">

                <RadzenColumn Size="12" SizeSM="5">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        <RadzenButton Disabled=@(purchaseordersHeader.CreditorId is null || btnDiseabled || !string.IsNullOrWhiteSpace(purchaseordersHeader.TransferToInfo)) 
                                      Size="@smallbtn" 
                                      Icon="save" 
                                      BusyText="Saving..." 
                                      IsBusy=@busy ButtonStyle="ButtonStyle.Primary" 
                                      Text="@btnText" 
                                      ButtonType="@Radzen.ButtonType.Submit" />
                        
                        <RadzenButton Visible="@btnDiseabled" Text="New" Icon="add" Size="@smallbtn"
                                      ButtonStyle="ButtonStyle.Success"
                                      ButtonType="@Radzen.ButtonType.Button"
                                      Click="@OnNew" />


                        <RadzenButton Disabled=@(purchaseordersHeader.CreditorId is null || Id is not null || btnDiseabled) Text="Transfer" Size="@smallbtn" ButtonStyle="ButtonStyle.Primary" @ref="@transferbutton" Icon="compare_arrows" Click="@(args => popuptransfer.ToggleAsync(transferbutton.Element))" />
                        @* <RadzenButton Text="Transfer" Size="@smallbtn" ButtonStyle="ButtonStyle.Primary" Icon="compare_arrows" Click="@Loads" /> *@
                    </RadzenStack>

                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Disabled="@(permission?.AllowRead != true)" Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Search" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>

        <RadzenCard>

            <div style="margin-bottom: 0.5rem">
                Purchase Orders @purchaseordersHeader.PurchaseOrderCode <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>

                    <RadzenTabsItem Text="Details">
                        <RadzenRow>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Supplier" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        Disabled="@(purchaseordersHeader.IsCancelled != true && purchaseordersHeader.TransferToInfo != null || purchaseRequisitionDetails is not null)" @bind-value=purchaseordersHeader.CreditorId
                                                                        Change=@(args => OnCreditorChanged((Guid?)args))
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize="10"
                                                                        Data="@supplieraccountList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CompanyCode"
                                                                        Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="4%" Property="CompanyCode" Title="Supplier #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CompanyName" Title="Name"></RadzenDropDownDataGridColumn>
                                                    </Columns>

                                                </RadzenDropDownDataGrid>

                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="From" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=purchaseordersHeader.CreditorName Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>


                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Term" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Name="Terms" class="@redtext"
                                                                        @bind-Value=@purchaseordersHeader.TermId
                                                                        Style="width: 100%;"
                                                                        AllowSorting="false"
                                                                        PageSize=10
                                                                        Data="@termList"
                                                                        AllowVirtualization="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="Term"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Term" Title="Term"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Terms" Text="'Term' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@purchaseordersHeader.StockLocationId Change="@(args => OnStockLocationChanged(args))" AllowSorting="false"
                                                                        Style="width: 120%;"
                                                                        PageSize=10
                                                                        Data="@stocklocationList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data"><RadzenCheckBox TValue="bool" Value="data.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@purchaseordersHeader.ProjectId
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize=10
                                                                        Data="@projectList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>


                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Currency" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Disabled="true" class="@redtext"
                                                                        @bind-Value=@purchaseordersHeader.CurrencyId
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize=10
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CurrencyCode" Density="@density" Data="@currencyList" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CurrencyCode" Title="CurrencyCode"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Attention" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Attention Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Purchaser" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value=@purchaseordersHeader.PurchaserId
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize=10
                                                                        Data="@purchaserList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="StaffCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="StaffCode" Title="Purchaser #"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Require Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker class="@redtext" DateFormat="MM/dd/yyyy" @bind-Value=@purchaseordersHeader.RequireDate Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Rate" AllowFloatingLabel="false">
                                                <RadzenNumeric ShowUpDown="false" Disabled="true" class="@redtext" @bind-Value=@purchaseordersHeader.CurrencyRate Style="width: 100%;" Placeholder="Exchange Rate"></RadzenNumeric>
                                                @*   <RadzenTextBox @bind-Value=purchaserequisition.CurrencyRate Style="width: 100%;" Placeholder="Exchange Rate" /> *@
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetPurchaseOrderNo" class="@redtext" @bind-Value="@purchaseordersHeader.PurchaseOrderDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:92%" Text="P. Order No." AllowFloatingLabel="false">
                                                @*     <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="width: 90%;" Gap="0.5rem;">
                                                            <RadzenDropDown Change="SetRequisitionNo" SelectedItemsText="" Placeholder="@purchaseordersHeader.PurchaseOrderCode" class="@redtext" @bind-Value=@purchaseordersHeader.PurchaseOrderCode Data=@transactionCodesList TextProperty="@nameof(TransactionsCode.Format)" SelectedItem="0" ValueProperty="@nameof(TransactionsCode.Format)" Style="width: 100%;" />
                                                        </RadzenStack>
                                                        <RadzenButton Click="() => OpenDialog(2)" Icon="more_horiz"></RadzenButton>
                                                    </RadzenStack> *@
                                                <RadzenTextBox class="@redtext" @bind-Value="@purchaseordersHeader.PurchaseOrderCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="width:5%" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@(args => popup.ToggleAsync(button.Element))" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox Name="Reference" class="@redtext" @bind-Value="@purchaseordersHeader.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Reference" Text="'Reference No.' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems" JustifyContent="JustifyContent.Start" Style="margin-top:1rem;">
                                        <RadzenColumn Visible=false" Size="4">
                                            <RadzenSwitch @bind-Value=purchaseordersHeader.IsCancelled Name="Active" />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Cancelled"></RadzenText>
                                        </RadzenColumn>
                                        <RadzenColumn Size="4">
                                            <RadzenSwitch @bind-Value=purchaseordersHeader.IsTaxInclusive Name="Active" Change="@IsTaxInclusiveChanged" />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Tax Inclusive"></RadzenText>
                                        </RadzenColumn>

                                        @if (Id is not null)
                                        {
                                            <RadzenColumn Size="4">
                                                <RadzenSwitch @bind-Value="@purchaseordersHeader.IsCancelled" Change=@(args => OnSwitchChanged("IsCancelled")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Cancelled"></RadzenText>
                                            </RadzenColumn>

                                            <RadzenColumn Size="4">
                                                <RadzenSwitch @bind-Value="@purchaseordersHeader.IsClosed" Change=@(args => OnSwitchChanged("IsClosed")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Closed"></RadzenText>
                                            </RadzenColumn>
                                        }


                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Supplier">
                        <RadzenRow>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Address1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Address2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Address3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Address4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="GST ID" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled="true" class="@redtext" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Delivery Term" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.DeliveryTerm Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenFormField Style="width:100%" Text="Phone" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Phone Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>

                                        <RadzenColumn Size="12" SizeMD="4">
                                            <RadzenFormField Style="width:100%" Text="Fax" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Fax Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Deliver To">
                        <RadzenRow>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.DeliverAddress1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.DeliverAddress2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.DeliverAddress3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.DeliverAddress4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Delivery Contact" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.DeliverContact Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Phone" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.DeliverPhone Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenFormField Style="width:100%" Text="Fax" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.DeliverFax Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Others">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Title" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="width: 90%;" Gap="0.5rem;">
                                                        <RadzenDropDown class="@redtext" @bind-Value=@purchaseordersHeader.Title Data=@descriptionsList TextProperty="@nameof(Descriptions.Description)" SelectedItem="0" ValueProperty="@nameof(Descriptions.Description)" Style="width: 100%;" />
                                                    </RadzenStack>
                                                </RadzenStack>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Transfer From" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@purchaseordersHeader.TransferFromInfo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Transfer To" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@purchaseordersHeader.TransferToInfo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Ref1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Ref2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Remark1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@purchaseordersHeader.Remark2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
