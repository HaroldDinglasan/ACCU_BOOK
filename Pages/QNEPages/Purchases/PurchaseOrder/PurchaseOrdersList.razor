@page "/PurchaseOrdersList"
@attribute [Authorize(Roles = "Admin,User")]


<RadzenStack Gap="0.2rem">
    <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenColumn Size="12" SizeSM="7">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                <RadzenTextBox Disabled=@(filteredpurchaseOrdersList == null) @bind-Value="@searchText"
                               Placeholder="Search..."
                               Style="font-size:smaller; width:30rem;"
                               Change="@(args => ApplyFilter())" />
                <RadzenButton Disabled=@(filteredpurchaseOrdersList == null) Icon="search" Click="@ApplyFilter" Text="Find" />
                <RadzenButton Disabled=@(filteredpurchaseOrdersList == null) Icon="delete" Click="@ClearFilter" Text="Clear" />
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="5">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text="New" Click="@navigate" ButtonStyle="ButtonStyle.Primary" Icon="add"></RadzenButton>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenDataGrid @ref="grids" @bind-Value=@selectedPurchaseOrders RowDoubleClick="() => Edit(selectedPurchaseOrders.FirstOrDefault().Id)"
                    TItem="VW_PurchaseOrdersListing"
                    AllowColumnReorder="true" AllowAlternatingRows="false" ColumnWidth="200px"
                    IsLoading=@isLoading Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading"
                    Data="@filteredpurchaseOrdersList" AllowColumnPicking="true" Style="height: 84vh"
                    ShowMultiColumnSortingIndex="true"
                    KeyProperty="Id" AllowColumnResize="true" Density="@density"
                    AllowSorting="true" AllowVirtualization=true AllowFiltering="true"
                    FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="@filter" LogicalFilterOperator="LogicalFilterOperator.Or">

        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                <span>
                    Purchase Orders
                </span>
            </RadzenStack>

        </HeaderTemplate>

        <Columns>
            <RadzenDataGridColumn Filterable="false" Width="150px" Visible=true Title="Status">

                <Template Context="data">
                    @{
                        var (text, style) = StatusHelper.Get(
                        data.IsClosed,
                        data.IsCancelled,
                        data.TransferToInfo);
                    }

                    <RadzenBadge IsPill="true" Text="@text" BadgeStyle="@style" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Visible=true  TItem="VW_PurchaseOrdersListing" Property="@nameof(VW_PurchaseOrdersListing.PurchaseOrderDate)" FormatString="{0:d}" Title="Date"></RadzenDataGridColumn>
            <RadzenDataGridColumn Visible=true  TItem="VW_PurchaseOrdersListing" Property="@nameof(VW_PurchaseOrdersListing.PurchaseOrderCode)" Title="P. Order #">
                @*    <Template Context="data">
                            <span class="@(data.IsCancelled ? "rz-color-danger-dark" : "")">@data.PurchaseRequisitionCode</span>
                        </Template> *@
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true  TItem="VW_PurchaseOrdersListing" Property="@nameof(VW_PurchaseOrdersListing.CreditorCompanyCode)" Title="Supplier">
                <FooterTemplate>
                    Total: <b>@totalPurchaseOrders</b>
                </FooterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="315px" TItem="VW_PurchaseOrdersListing" Property="@nameof(VW_PurchaseOrdersListing.CreditorCompanyName)" Title="Name"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true  TItem="VW_PurchaseOrdersListing" Property="@nameof(VW_PurchaseOrdersListing.PurchaserCode)" Title="Purchaser"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true  TItem="VW_PurchaseOrdersListing" TextAlign="TextAlign.Right" Property="@nameof(VW_PurchaseOrdersListing.WTaxTotalAmountLocal)" Title="WTax Total Amount">
                <Template Context="data">
                    <span>@(data.WTaxTotalAmount == 0 ? "" : data.WTaxTotalAmount.ToString("#,0.00"))</span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true  TItem="VW_PurchaseOrdersListing" Property="@nameof(VW_PurchaseOrdersListing.CurrencyCode)" Title="Currency"></RadzenDataGridColumn>


            <RadzenDataGridColumn Visible=true  TItem="VW_PurchaseOrdersListing" TextAlign="TextAlign.Right" Property="@nameof(VW_PurchaseOrdersListing.TaxTotalAmountLocal)" Title="Tax">
                <Template Context="data">
                    <span>@(data.TaxTotalAmount == 0 ? "" : data.TaxTotalAmount.ToString("#,0.00"))</span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true  TItem="VW_PurchaseOrdersListing" TextAlign="TextAlign.Right" Property="@nameof(VW_PurchaseOrdersListing.NetTotalAmountLocal)" Title="Net Amount">
                <Template Context="data">
                    <span>@(data.NetTotalAmount == 0 ? "" : data.NetTotalAmount.ToString("#,0.00"))</span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=false  TItem="VW_PurchaseOrdersListing" Property="@nameof(VW_PurchaseOrdersListing.IsCancelled)" Title="Is Cancelled">
                <Template Context="data">
                    <RadzenCheckBox Disabled="true" TValue="bool" @bind-Value="@data.IsCancelled"></RadzenCheckBox>
                </Template>
            </RadzenDataGridColumn>

        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {



    string status = string.Empty;
    private RadzenDataGrid<VW_PurchaseOrdersListing> grids;
    private IList<VW_PurchaseOrdersListing> selectedPurchaseOrders { get; set; }
    private IEnumerable<VW_PurchaseOrdersListing> purchaseOrdersList { get; set; }

    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    Density density = Density.Compact;
    AlignItems alignItems = AlignItems.Center;
    Variant variant = Variant.Flat;

    bool isLoading = true;
    int totalPurchaseOrders = 0;

    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }
    protected async override Task OnInitializedAsync()
    {
        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            var RoleId = authState.FindFirst("RoleId").Value;
            GetLoadMenuPermission(RoleId);
        }

    }


    private SystemMenuObjectPermission? permission;
    protected async void GetLoadMenuPermission(string RoleId)
    {
        permission = await permissionService.GetPermissionAsync(
            RoleId,
            "Purchase Orders");

        if (permission is null)
            return;
        await ShowLoading();
        await loadAllData();
        filteredpurchaseOrdersList = purchaseOrdersList;
        StateHasChanged();
    }


    private string searchText = string.Empty;
    private IEnumerable<VW_PurchaseOrdersListing> filteredpurchaseOrdersList;
    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredpurchaseOrdersList = purchaseOrdersList;
        }
        else
        {
            filteredpurchaseOrdersList = purchaseOrdersList.Where(x =>
                (!string.IsNullOrEmpty(x.PurchaseOrderCode) && x.PurchaseOrderCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.CreditorCompanyCode) && x.CreditorCompanyCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.CreditorCompanyName) && x.CreditorCompanyName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.CreditorName) && x.CreditorName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Ref1) && x.Ref1.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.ReferenceNo) && x.ReferenceNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.ControlAccountCode) && x.ControlAccountCode.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            );
        }
        StateHasChanged();
    }
    private void ClearFilter()
    {
        searchText = string.Empty;
        filteredpurchaseOrdersList = purchaseOrdersList;
        StateHasChanged();
    }




    async Task ShowLoading()
    {
        await Task.Yield();

        isLoading = false;
    }

    private async Task loadAllData()
    {
        await GetPurchaseOrdersListing();
    }

    private async Task GetPurchaseOrdersListing()
    {
        var data = await purchaseOrdersService.GetPurchaseOrdersList();
        purchaseOrdersList = data is not null ? data.ToList() : new List<VW_PurchaseOrdersListing>();
        totalPurchaseOrders = purchaseOrdersList.Count();
    }

    protected void Edit(Guid Id)
    {
        navManager.NavigateTo($"/PurchaseOrders/Edit/{Id}");
    }


    private void navigate()
    {
        navManager.NavigateTo("/PurchaseOrders");
    }



}
