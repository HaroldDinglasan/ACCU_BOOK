    async Task DeleteRow(PurchaseInvoiceDetails row)
    {
        if (purchaseinvoicesDetailsToInsert.Any() || purchaseinvoicesDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (await DialogService.Confirm("You are about to delete records. Do you want to proceed?", "Delete") == true)
        {
            await purchaseInvoicesService.DeletePurchaseInvoiceDetails(row.Id.ToString());

            Reset(row);
            purchaseinvoicesDetails.Remove(row); // ✅ list.Remove(item) — no more ambiguity

            if (row.GoodsReceivedNotesDetailId is not null)
            {
                var grnDetail = goodsReceivedNotesDetails.FirstOrDefault(x => x.Id == row.GoodsReceivedNotesDetailId);
                goodsReceivedNotesDetails.Remove(grnDetail);

                var forTransferDetail = forTransferDetails.FirstOrDefault(x => x.Id == row.GoodsReceivedNotesDetailId);
                forTransferDetails.Remove(forTransferDetail);
            }
            ResetPosIndexes();


            await purchaseinvoicesDetailsGrid.Reload();
            StateHasChanged();
        }
    }

    void Reset(PurchaseInvoiceDetails purchaseinvoicesDetails)
    {
        purchaseinvoicesDetailsToInsert.Remove(purchaseinvoicesDetails);
        purchaseinvoicesDetailsToUpdate.Remove(purchaseinvoicesDetails);
    }

    void Reset()
    {
        purchaseinvoicesDetailsToInsert.Clear();
        purchaseinvoicesDetailsToUpdate.Clear();
    }

    // Helper to reset Pos index after any add/delete
    private void ResetPosIndexes()
    {
        for (int i = 0; i < purchaseinvoicesDetails.Count; i++)
        {
            purchaseinvoicesDetails[i].Pos = i + 1;
        }
    }

    private void OnNew()
    {
        navManager.NavigateTo("/PurchaseInvoices", forceLoad: true);
    }

    private void Navigate()
    {
        navManager.NavigateTo("/PurchaseInvoiceList");
    }

}

