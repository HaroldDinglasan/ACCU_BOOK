    // Opens the combined Stock In / Stock Out dialog
    // ADDED 10/15/2026
    private async Task OpenStockBatchDialog(Guid stockId, PurchaseInvoiceDetails detail, StockBatchNumbersModel? existing = null)
    {
        var parameters = new Dictionary<string, object>
        {
            { "StockId", stockId },
            { "PurchaseInvoiceDetails", detail }
        };

        if (existing != null)
            parameters.Add("ExistingBatch", existing);

        var result = await DialogService.OpenAsync<StockBatchNoInOutModal>(
            "Stock Batch No In Out",
            parameters,
            new DialogOptions
            {
                Width = "900px",
                Height = "600px",
                Resizable = true,
                Draggable = true,
                CloseDialogOnOverlayClick = false
            });

        if (result is StockBatchNumbersModel batch && ApplyBatch(batch))
        {
            if (existing != null)
                Upsert(pendingBatchNumbers, batch);

            detail.StockBatchNumberId = batch.Id;
            stockbatchnumbercode = batch.BatchNo;
        }

        StateHasChanged();
    }

    // Applies whatever the dialog returned.
    // If the batch already exists in stockbatchnumberList, it's an EXISTING batch
    // (picked from the Stock Out grid) — no need to save it again.
    // If it's not in the list yet, it's NEW/EDITED — save it in OnSubmit.
    // ADDED 10/15/2026
    private bool ApplyBatch(StockBatchNumbersModel batch)
    {
        var alreadyExists = stockbatchnumberList.Any(b => b.Id == batch.Id);

        if (!alreadyExists)
        {
            var duplicateBatchNo = stockbatchnumberList.Any(b =>
                b.Id != batch.Id &&
                b.StockId == batch.StockId &&
                string.Equals(b.BatchNo?.Trim(), batch.BatchNo?.Trim(), StringComparison.OrdinalIgnoreCase));

            if (duplicateBatchNo)
            {
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Batch No",
                    Detail = $"Batch No '{batch.BatchNo}' already exists for this stock."
                });
                return false;
            }

            Upsert(pendingBatchNumbers, batch); // needs to be saved on Submit
        }

        Upsert(stockbatchnumberList, batch); // so it shows up in the grid/popup right away
        return true;
    }

    // ADDED 10/15/2026
    private static void Upsert(List<StockBatchNumbersModel> list, StockBatchNumbersModel batch)
    {
        var i = list.FindIndex(b => b.Id == batch.Id);
        if (i >= 0) list[i] = batch; else list.Add(batch);
    }

