    //Has Condition Here cause IF ITEMTYPECODE IS "T" OR "D" IT WILL NOT BE INCLUDED IN TAXABLE AMOUNT
    public decimal Amount => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(x => x.Amount) ?? 0.00m;
    public decimal AmountLocal => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(x => x.AmountLocal) ?? 0.00m;
    public decimal DiscountAmount => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.DiscountAmount) ?? 0.00m;
    public decimal DiscountAmountLocal => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.DiscountAmountLocal) ?? 0.00m;
    public decimal NetAmount => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.NetAmount) ?? 0.00m;
    public decimal NetAmountLocal => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.NetAmountLocal) ?? 0.00m;
    public decimal TaxAmount => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.TaxAmount) ?? 0.00m;
    public decimal TaxAmountLocal => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.TaxAmountLocal) ?? 0.00m;
    public decimal SubAmount => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.SubAmount) ?? 0.00m;
    public decimal SubAmountLocal => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.SubAmountLocal) ?? 0.00m;
    public decimal TaxExclusiveAmount => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.TaxExclusiveAmount) ?? 0.00m;
    public decimal TaxExclusiveAmountLocal => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.TaxExclusiveAmountLocal) ?? 0.00m;
    public decimal WTaxAmount => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.WTaxAmount) ?? 0.00m;
    public decimal WTaxAmountLocal => purchaseinvoicesDetails?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.WTaxAmountLocal) ?? 0.00m;

    public decimal DueAmount => (purchaseinvoicesHeader?.NetTotalAmountLocal ?? 0m) - (purchaseinvoicesHeader?.WTaxTotalAmountLocal ?? 0m);

    private async Task OnSubmit()
    {
        busy = true;

        if (purchaseinvoicesDetailsToInsert.Any() || purchaseinvoicesDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            busy = false;
            return;
        }

        LoadAllTaxTotalDiscNetAmount();

        if (pendingBatchNumbers.Any())
        {
            var batchResult = await stockItemsService.SaveStockBatchNumbers(pendingBatchNumbers);
            if (!batchResult.StartsWith("Success"))
            {
                await DialogService.Alert(batchResult);
                busy = false;
                return;
            }
            pendingBatchNumbers.Clear();
        }


        var data = await purchaseInvoicesService.SavePurchaseInvoiceWithTransferAsync(purchaseinvoicesHeader, purchaseinvoicesDetails, forTransferHeader, forTransferDetails);

        if (data is not null)
        {
            if (data.Contains("Success"))
            {
                await DialogService.Alert(data);
                btnDiseabled = true;
                busy = false;
            }
            else
            {
                await DialogService.Alert(data);
                busy = false;
            }
        }
        else
        {
            busy = false;
        }
    }

