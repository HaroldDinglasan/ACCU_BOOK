        ///INCLUDE HERE THE TAX, DISCOUNT, WTAX, AMOUT, ALL QUOTATION DETAILS AMOUNT


        var filteredList = purchaseinvoicesDetails?.Where(x => (x.Description?.Split(' ')[0] != "SUBTOTAL"));


        purchaseinvoicesHeader.TotalAmount = filteredList?.Sum(x => x.Amount) ?? 0.00m;
        purchaseinvoicesHeader.TotalAmountLocal = filteredList?.Sum(x => x.AmountLocal) ?? 0.00m;

        purchaseinvoicesHeader.DiscountAmount = filteredList?.Sum(x => x.DiscountAmount) ?? 0.00m;
        purchaseinvoicesHeader.DiscountAmountLocal = filteredList?.Sum(x => x.DiscountAmountLocal) ?? 0.00m;

        purchaseinvoicesHeader.NetTotalAmount = filteredList?.Sum(x => x.NetAmount) ?? 0.00m;
        purchaseinvoicesHeader.NetTotalAmountLocal = filteredList?.Sum(x => x.NetAmountLocal) ?? 0.00m;

        purchaseinvoicesHeader.TaxTotalAmount = filteredList?.Sum(x => x.TaxAmount) ?? 0.00m;
        purchaseinvoicesHeader.TaxTotalAmountLocal = filteredList?.Sum(x => x.TaxAmountLocal) ?? 0.00m;

        purchaseinvoicesHeader.SubtotalAmount = filteredList?.Sum(x => x.SubAmount) ?? 0.00m;
        purchaseinvoicesHeader.SubtotalAmountLocal = filteredList?.Sum(x => x.SubAmountLocal) ?? 0.00m;

        purchaseinvoicesHeader.TaxExclusiveTotalAmount = filteredList?.Sum(x => x.TaxExclusiveAmount) ?? 0.00m;
        purchaseinvoicesHeader.TaxExclusiveTotalAmountLocal = filteredList?.Sum(x => x.TaxExclusiveAmountLocal) ?? 0.00m;

        purchaseinvoicesHeader.WTaxTotalAmount = filteredList?.Sum(x => x.WTaxAmount) ?? 0.00m;
        purchaseinvoicesHeader.WTaxTotalAmountLocal = filteredList?.Sum(x => x.WTaxAmountLocal) ?? 0.00m;
    }

