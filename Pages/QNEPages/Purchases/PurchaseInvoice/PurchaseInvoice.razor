                        <HeaderTemplate>
                            <RadzenCheckBox TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select all items" } })"
                                            Value="@(selectedGoodsReceivedNotesTransferModel == null || selectedGoodsReceivedNotesTransferModel?.Any() != true ? false : !filteredGoodReceivedNoteTransferModel.All( i => selectedGoodsReceivedNotesTransferModel.Select(e => e.Id).Contains(i.Id)) ? null : filteredGoodReceivedNoteTransferModel.Any(i => selectedGoodsReceivedNotesTransferModel.Select(e => e.Id).Contains(i.Id)))"
                                            Change="@(args => selectedGoodsReceivedNotesTransferModel = args == true ? (selectedGoodsReceivedNotesTransferModel ?? Enumerable.Empty<PurchasesTranferList>()).Union(filteredGoodReceivedNoteTransferModel.Where(i => !(selectedGoodsReceivedNotesTransferModel ?? Enumerable.Empty<PurchasesTranferList>()).Select(e => e.Id).Contains(i.Id))).ToList() : null)" />
                        </HeaderTemplate>
                        <Template Context="data">
                            <RadzenCheckBox TriState="false" Value="@(selectedGoodsReceivedNotesTransferModel != null && selectedGoodsReceivedNotesTransferModel.Select(e => e.Id).Contains(data.Id))" TValue="bool" />
                        </Template>
