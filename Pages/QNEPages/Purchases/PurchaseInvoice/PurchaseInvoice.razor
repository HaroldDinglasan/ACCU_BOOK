                        <RadzenButton Disabled=@(filteredGoodReceivedNoteTransferModel == null) Icon="search" Click="@ApplyFilter" Text="Find" />
                        <RadzenButton Disabled=@(filteredGoodReceivedNoteTransferModel == null) Icon="delete" Click="@ClearFilter" Text="Find" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

