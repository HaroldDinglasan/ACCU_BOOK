@page "/ABSystemMyDetails"
@attribute [Authorize(Roles = "Admin,User")]
@inject RowDragDropService<SystemRole> RowDragDropService

<RadzenTemplateForm TItem="SystemUser" Data="systemUser" Submit="@OnSubmit">
    <RadzenStack Gap="1rem" class="md-form">

        <!-- TOOLBAR ACTION CARD (hindi ginalaw) -->
   @*      <CrudToolbar Title="@(userId is not null ? "Edit My Details" : "Create System User")"
                     Subtitle="Manage system user information"
                     Icon="badge"
                     ButtonSize="@smallbtn"
                     SaveText="Save"
                     SaveBusy="@busy">
        </CrudToolbar> *@



   

 

        <!-- Profile header -->
        <RadzenCard class="md-card">
            <div class="md-profile">
                <div class="md-avatar" aria-hidden="true">@Initials</div>
                <div class="md-profile-main">
                    <h2 class="md-profile-name">@(string.IsNullOrWhiteSpace(systemUser.FullName) ? "My Details" : systemUser.FullName)</h2>
                    <p class="md-profile-sub">@(string.IsNullOrWhiteSpace(systemUser.UserName) ? "" : "@" + systemUser.UserName)</p>
                    <div class="md-profile-chips">
                        <span class="@(systemUser.IsActive == true ? "md-chip is-ok" : "md-chip is-bad")">
                            <RadzenIcon Icon="@(systemUser.IsActive == true ? "check_circle" : "block")" />@(systemUser.IsActive == true ? "Active" : "Inactive")
                        </span>
                        <span class="md-chip"><RadzenIcon Icon="admin_panel_settings" />@RoleCountText</span>
                        @if (systemUser.ChangePasswordOnFirstLogon == true)
                        {
                            <span class="md-chip is-warn"><RadzenIcon Icon="password" />Password change required</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(systemUser.Email))
                        {
                            <span class="md-chip is-muted"><RadzenIcon Icon="mail" />@systemUser.Email</span>
                        }
                    </div>
                </div>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                             AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">

                    <RadzenButton Size="ButtonSize.Small"
                                  Icon="save"
                                  Text="Save"
                                  BusyText="Saving..."
                                  IsBusy="@busy"
                                  ButtonStyle="ButtonStyle.Primary"
                                  ButtonType="ButtonType.Submit" />

                    <RadzenButton Size="ButtonSize.Small"
                                  Icon="lock_reset"
                                  Text="Change My Password"
                                  Variant="Variant.Outlined"
                                  ButtonType="ButtonType.Button"
                                  Style="white-space:nowrap"
                                  Click="@OnChangePassword" />

                </RadzenStack>
            </div>
        </RadzenCard>

        <RadzenRow Gap="1rem">

            <!-- Personal information (puwedeng i-edit) -->
            <RadzenColumn Size="12" SizeLG="7">
                <RadzenCard class="md-card">
                    <div class="md-card-head">
                        <div class="md-card-icon"><RadzenIcon Icon="person" /></div>
                        <div class="md-card-title">
                            <h3>Personal information</h3>
                            <p>Keep your name and contact details up to date.</p>
                        </div>
                    </div>

                    <RadzenStack Gap="1rem">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="UserName" AllowFloatingLabel="false" Style="width: 100%;">
                                    <ChildContent>
                                        <RadzenTextBox Disabled="true" Name="UserName" Placeholder="e.g. jdelacruz" @bind-Value="@systemUser.UserName" Style="width: 100%;" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="UserName" Text="*UserName Required." />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="FullName" AllowFloatingLabel="false" Style="width: 100%;">
                                    <ChildContent>
                                        <RadzenTextBox Name="FullName" Placeholder="e.g. Juan Dela Cruz" @bind-Value="@systemUser.FullName" Style="width: 100%;" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="FullName" Text="*FullName Required." />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenFormField Text="Email" AllowFloatingLabel="false" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="Email" Placeholder="name@company.com" @bind-Value="@systemUser.Email" Style="width: 100%;" />
                            </ChildContent>
                        </RadzenFormField>

                        <RadzenFormField Text="Remarks" AllowFloatingLabel="false" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextArea Name="Remarks" Rows="3" Placeholder="Notes about you" @bind-Value="@systemUser.Remarks" Style="width: 100%;" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <!-- Account (read-only, inaayos ng admin) -->
            <RadzenColumn Size="12" SizeLG="5">
                <RadzenCard class="md-card">
                    <div class="md-card-head">
                        <div class="md-card-icon"><RadzenIcon Icon="manage_accounts" /></div>
                        <div class="md-card-title">
                            <h3>Account</h3>
                            <p>Your sign-in status and password rules.</p>
                        </div>
                    </div>

                    <div class="md-dl">
                        <div class="md-dl-row">
                            <RadzenIcon Icon="verified_user" />
                            <span class="md-dl-label">Status</span>
                            <span class="md-dl-value">
                                <RadzenBadge BadgeStyle="@(systemUser.IsActive == true ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@(systemUser.IsActive == true ? "Active" : "Inactive")" IsPill="true" />
                            </span>
                        </div>
                        <div class="md-dl-row">
                            <RadzenIcon Icon="password" />
                            <span class="md-dl-label">Change password on first logon</span>
                            <span class="md-dl-value">
                                <RadzenBadge BadgeStyle="@(systemUser.ChangePasswordOnFirstLogon == true ? BadgeStyle.Warning : BadgeStyle.Light)" Text="@(systemUser.ChangePasswordOnFirstLogon == true ? "Required" : "No")" IsPill="true" />
                            </span>
                        </div>
                        <div class="md-dl-row">
                            <RadzenIcon Icon="admin_panel_settings" />
                            <span class="md-dl-label">Roles assigned</span>
                            <span class="md-dl-value">@systemRoleList.Count</span>
                        </div>
                    </div>

                    <p class="md-note"><RadzenIcon Icon="lock" /> Status and password rules are managed by an administrator.</p>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Assigned roles (read-only) -->
        <RadzenCard class="md-card">
            <div class="md-card-head">
                <div class="md-card-icon"><RadzenIcon Icon="admin_panel_settings" /></div>
                <div class="md-card-title">
                    <h3>My roles</h3>
                    <p>@(isAdmin ? "Roles decide what you can access. Double-click a role to open it." : "Roles decide what you can access.")</p>
                </div>
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@RoleCountText" IsPill="true" />
            </div>

            <RadzenDataGrid EditMode="@editMode" @ref="grid" Style="width: 100%;" @bind-Value=@selectedSystemRole
                            Data="@systemRoleList" AllowColumnResize=true RowCreate="@OnCreateRow"
                            RowDoubleClick="@(args => Edit(args.Data.Oid))"
                            AllowAlternatingRows="false" Density="Density.Compact"
                            TItem="SystemRole" RowUpdate="@OnUpdateRow" RowRender="@RowRender">
                <EmptyTemplate>
                    <div class="md-empty">
                        <RadzenIcon Icon="group_off" />
                        <span>No roles are assigned to your account yet.</span>
                    </div>
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="SystemRole" Property="@nameof(SystemRole.Name)" Title="Name" />
                    <RadzenDataGridColumn TItem="SystemRole" Property="@nameof(SystemRole.IsAdministrative)" Title="Administrative" Width="180px">
                        <Template Context="data">
                            @if (data.IsAdministrative)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Yes" IsPill="true" />
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="No" IsPill="true" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    @* Naka-comment: TItem="SecuritySystemRole" ang column na ito pero SystemRole ang grid.
                       Kung may CanEditModel ang SystemRole, palitan ang TItem at i-uncomment.
                    <RadzenDataGridColumn TItem="SystemRole" Property="@nameof(SystemRole.CanEditModel)" Title="Can Edit Model">
                        <Template Context="data">
                            @if (data.CanEditModel)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Yes" IsPill="true" />
                            }
                            else
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="No" IsPill="true" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    *@

                </Columns>
            </RadzenDataGrid>
        </RadzenCard>

    </RadzenStack>
</RadzenTemplateForm>

@if (isloading)
{
    <Spinner Message="Loading your details..." />
}

<style>
    /* ===== My Details: sariling styles ng page na ito (walang kailangang shared css) ===== */
    .md-form {
        --md-line: var(--rz-base-300, rgba(128, 128, 128, 0.3));
        --md-muted: var(--rz-text-secondary-color);
        --md-surface: var(--rz-base-background-color, #fff);
    }

        /* Card */
        .md-form .md-card {
            padding: 1.25rem 1.4rem;
            border: 1px solid var(--md-line);
            border-radius: 10px;
            box-shadow: none;
        }

    .md-card-head {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.1rem;
    }

    .md-card-icon {
        flex: none;
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        color: var(--rz-primary);
        background: color-mix(in srgb, var(--rz-primary) 14%, transparent);
    }

    .md-card-title {
        flex: 1;
        min-width: 0;
    }

        .md-card-title h3 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 700;
        }

        .md-card-title p {
            margin: 0.1rem 0 0;
            color: var(--md-muted);
            font-size: 0.9rem;
        }

    /* Profile header */
    .md-profile {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        flex-wrap: wrap;
    }

    .md-avatar {
        flex: none;
        width: 68px;
        height: 68px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--rz-on-primary, #fff);
        background: linear-gradient(135deg, var(--rz-primary), var(--rz-primary-darker, var(--rz-primary)));
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--rz-primary) 18%, transparent);
    }

    .md-profile-main {
        flex: 1;
        min-width: 0;
    }

    .md-profile-name {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .md-profile-sub {
        margin: 0.15rem 0 0.55rem;
        color: var(--md-muted);
    }

    .md-profile-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    /* Chips */
    .md-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.7rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--rz-primary);
        background: color-mix(in srgb, var(--rz-primary) 12%, transparent);
    }

        .md-chip .rzi {
            font-size: 1.05rem;
        }

        .md-chip.is-ok {
            color: var(--rz-success);
            background: color-mix(in srgb, var(--rz-success) 14%, transparent);
        }

        .md-chip.is-bad {
            color: var(--rz-danger);
            background: color-mix(in srgb, var(--rz-danger) 14%, transparent);
        }

        .md-chip.is-warn {
            color: var(--rz-warning);
            background: color-mix(in srgb, var(--rz-warning) 18%, transparent);
        }

        .md-chip.is-muted {
            color: var(--md-muted);
            background: color-mix(in srgb, var(--md-muted) 12%, transparent);
        }

    /* Read-only key / value list */
    .md-dl {
        display: flex;
        flex-direction: column;
    }

    .md-dl-row {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.75rem 0;
        border-bottom: 1px dashed var(--md-line);
    }

        .md-dl-row:last-child {
            border-bottom: 0;
        }

        .md-dl-row > .rzi {
            color: var(--md-muted);
            font-size: 1.25rem;
        }

    .md-dl-label {
        flex: 1;
        min-width: 0;
        color: var(--md-muted);
        font-size: 0.92rem;
    }

    .md-dl-value {
        font-weight: 600;
    }

    .md-note {
        display: flex;
        align-items: flex-start;
        gap: 0.45rem;
        margin: 0.75rem 0 0;
        color: var(--md-muted);
        font-size: 0.85rem;
    }

        .md-note .rzi {
            font-size: 1rem;
        }

    /* Empty state (roles grid) */
    .md-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 120px;
        padding: 1.5rem;
        color: var(--md-muted);
    }

    @@media (max-width: 768px) {
        .md-form .md-card {
            padding: 1rem;
        }
    }
</style>

