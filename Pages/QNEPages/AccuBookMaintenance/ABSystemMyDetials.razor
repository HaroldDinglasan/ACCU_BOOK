    // ==========================================================================
    // Idagdag sa @code ng page na may "Change My Password" button.
    // ==========================================================================

    protected async Task OnChangePassword()
    {
        // Oid ng naka-login na user (kung ang ibang user ang papalitan, ipasa ang Oid niya)
        var user = (await authenticationState).User;
        var oidClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (oidClaim is null || !Guid.TryParse(oidClaim.Value, out var oid))
            return;

        var result = await DialogService.OpenAsync<ChangePasswordDialog>("Change My Password",
            new Dictionary<string, object> { { "Oid", oid } },
            new DialogOptions()
            {
                Width = "28rem",
                Resizable = false,
                Draggable = true,
                CloseDialogOnOverlayClick = false
            });

        if (result is true)
        {
            await DialogService.Alert("Your password has been changed.", "Password changed!",
                new AlertOptions() { OkButtonText = "Ok" });
        }
    }


}
