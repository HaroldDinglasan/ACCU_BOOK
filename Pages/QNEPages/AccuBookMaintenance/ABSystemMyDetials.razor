            var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
                : parts[0][0].ToString().ToUpperInvariant();
        }
    }

    string RoleCountText => systemUser.RoleType;

    protected async override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            var RoleId = authState.FindFirst("RoleId").Value;
            isAdmin = authState.IsInRole("Admin");

            //USER GUID
            var userguid = authState.FindFirst(x => x.Type == System.Security.Claims.ClaimTypes.NameIdentifier);
            userId = userguid.Value;

            //  GetLoadMenuPermission(RoleId);


            // InitializeDetailsRows();
            // await loadAllData();
            if (userId is not null)
            {
                await loadAllDataById();
            }

