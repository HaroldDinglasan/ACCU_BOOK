@page "/ABSystemUserList"
@attribute [Authorize(Roles = "Admin")]

<RadzenStack Gap="0.2rem">
    <RadzenDataGrid @ref="grid" Visible="true" @bind-Value=@selectedSystemUser
                    IsLoading=@isLoading Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading"
                    Data="@SystemUserList()"
                    TItem="SystemUser"
                    RowDoubleClick="() => Edit(selectedSystemUser.FirstOrDefault().Oid)"
                    AllowVirtualization="true"
                    ColumnWidth="200px"
                    AllowSorting="true"
                    AllowFiltering="true"
                    ShowPagingSummary="true"
                    ShowMultiColumnSortingIndex="true"
                    FilterMode="FilterMode.CheckBoxList"
                    Style="height: 84vh"
                    AllowColumnPicking="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <HeaderTemplate>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center"
                         Style="width: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem;">
               
                    <RadzenButton Size="ButtonSize.Small" Text="New"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Icon="add"
                                  Click="@Add" />

                    <!-- DIVIDER -->
                    <div style="border-left: 2px solid #ccc; height: 2rem; margin: 0 0.5rem;"></div>

                    <RadzenTextBox InputSize="InputSize.Medium" @bind-Value="@searchText"
                                   @ref="textBox"
                                   @oninput="@(args => OnInput(args))"
                                   Placeholder="Search..."
                                   Style="width:30rem;" />

                    <RadzenButton Size="ButtonSize.Small" Icon="delete"
                                  Click="@ClearFilter"
                                  Text="Clear" />
                </RadzenStack>
            </RadzenStack>
        </HeaderTemplate>
        <Columns>

            @*  <RadzenDataGridColumn Filterable="false" Width="150px" Visible=true Title="Status">

                <Template Context="data">
                    @{
                        var (text, style) = StatusHelper.Get(
                        data.IsClosed,
                        data.IsCancelled,
                        data.TransferToInfo);
                    }

                    <RadzenBadge IsPill="true" Text="@text" BadgeStyle="@style" />
                </Template>
            </RadzenDataGridColumn> *@
            <RadzenDataGridColumn Visible=false TItem="SystemUser" Property="@nameof(SystemUser.Oid)" Title="Id" />
            <RadzenDataGridColumn Width="110px" TItem="SystemUser" Property="@nameof(SystemUser.UserName)" Title="User Name" />
            <RadzenDataGridColumn Width="350px" TItem="SystemUser" Title="User">
                <Template Context="data">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0 rz-text-wrap">@data.FullName</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0 rz-text-wrap">@data.Email</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </Template>
                <FooterTemplate>
                    Total: <b>@totalData</b>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SystemUser" Property="@nameof(SystemUser.Remarks)" Title="Remarks" />
            <RadzenDataGridColumn TItem="SystemUser" Property="@nameof(SystemUser.IsActive)" Title="IsActive">
                <Template Context="data">
                    @if (data.IsActive)
                    {
                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Success" Text="Active" />
                    }
                    else
                    {
                        <RadzenBadge IsPill="true" Variant="Variant.Outlined" BadgeStyle="BadgeStyle.Danger" Text="Inactive" />
                    }

                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Visible=false TItem="SystemUser" Property="@nameof(SystemUser.OptimisticLockField)" Title="OptimisticLockField" />

        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }

    RadzenTextBox textBox;
    RadzenDataGrid<SystemUser> grid;
    IEnumerable<SystemUser> systemUserList;
    protected IList<SystemUser> selectedSystemUser { get; set; }

    bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            await ShowLoading();
            await GetSecuritySystemUserList();
            StateHasChanged();
        }
    }

    int totalData = 0;
    private async Task GetSecuritySystemUserList()
    {
        var data = await systemUserServices.GetSystemUserLists();
        systemUserList = data is not null ? data : new List<SystemUser>();
        totalData = systemUserList.Count();
    }

    private string searchText = "";
    private IEnumerable<SystemUser> SystemUserList()
    {
        if (systemUserList == null)
            return Enumerable.Empty<SystemUser>();


        return systemUserList
       .Where(x => string.IsNullOrEmpty(searchText) ||
               (x.UserName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (x.FullName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
               .OrderBy(x => x.UserName);
    }

    async Task OnInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        await grid.Reload();
    }

    private async Task ClearFilter()
    {
        searchText = string.Empty;
        await grid.Reload();
        StateHasChanged();
    }

    protected void Edit(Guid Id)
    {

       // navManager.NavigateTo($"/SecurityUser/Edit/{Id}");
        navManager.NavigateTo($"/ABSystemUser/Edit/{Id}");
        // navManager.NavigateTo("/SecurityUser");
    }

    private void Add()
    {
        navManager.NavigateTo("/ABSystemUser");
    }

    async Task ShowLoading()
    {
        await Task.Yield();

        isLoading = false;
    }

}