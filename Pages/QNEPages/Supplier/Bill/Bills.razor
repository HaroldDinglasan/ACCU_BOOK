    // Helper to reset Pos index after any add/delete
    private void ResetPosIndexes()
    {
        for (int i = 0; i < billDetailsList.Count; i++)
        {
            billDetailsList[i].Pos = i + 1;
        }
    }


    //insert after row
    async Task InsertAfterRow(BillDetails billDetails)
    {
        // If there's an active edit, prevent adding another row until it's saved.

        if (billDetailsToInsert.Any() || billDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }



        if (!grid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var newbillDetails = new BillDetails();

        //Set QuotationId to new inserted row
        newbillDetails.BillId = Id ?? bill.Id;
        newbillDetails.IsTaxInclusive = bill.IsTaxInclusive;
        // Assign a sequential Pos for new rows, inserting after the current row's Pos
        billDetailsToInsert.Add(newbillDetails);
        var index = billDetailsList.IndexOf(billDetails);
        if (index >= 0)
        {
            billDetailsList.Insert(index + 1, newbillDetails); // Insert after selected row
        }
        else
        {
            billDetailsList.Add(newbillDetails);
        }


        ResetPosIndexes();

        if (billDetails is not null)
        {
            await grid.InsertAfterRow(newbillDetails, billDetails);
        }
        else
        {
            await grid.InsertRow(newbillDetails);
        }

        await grid.Reload();
        StateHasChanged();
    }

    async Task EditRow(BillDetails billDetails)
    {
        if (billDetailsToInsert.Any() || billDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!grid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        billDetailsToUpdate.Add(billDetails);
        await grid.EditRow(billDetails);
        StateHasChanged(); // Ensure UI updates and list is reflected
    }

