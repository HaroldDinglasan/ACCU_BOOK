        ///INCLUDE HERE THE TAX, DISCOUNT, WTAX, AMOUT, ALL QUOTATION DETAILS AMOUNT


        var filteredList = billDetailsList?.Where(x => (x.Description?.Split(' ')[0] != "SUBTOTAL"));


        bill.TotalAmount = filteredList?.Sum(x => x.Amount) ?? 0.00m;
        bill.TotalAmountLocal = filteredList?.Sum(x => x.AmountLocal) ?? 0.00m;

        // bill.DiscountAmount = filteredList?.Sum(x => x.DiscountAmount) ?? 0.00m;
        // bill.DiscountAmountLocal = filteredList?.Sum(x => x.DiscountAmountLocal) ?? 0.00m;

        bill.NetTotalAmount = filteredList?.Sum(x => x.NetAmount) ?? 0.00m;
        bill.NetTotalAmountLocal = filteredList?.Sum(x => x.NetAmountLocal) ?? 0.00m;

        bill.TaxTotalAmount = filteredList?.Sum(x => x.TaxAmount) ?? 0.00m;
        bill.TaxTotalAmountLocal = filteredList?.Sum(x => x.TaxAmountLocal) ?? 0.00m;

        bill.SubtotalAmount = filteredList?.Sum(x => x.SubAmount) ?? 0.00m;
        bill.SubtotalAmountLocal = filteredList?.Sum(x => x.SubAmountLocal) ?? 0.00m;

        bill.TaxExclusiveTotalAmount = filteredList?.Sum(x => x.TaxExclusiveAmount) ?? 0.00m;
        bill.TaxExclusiveTotalAmountLocal = filteredList?.Sum(x => x.TaxExclusiveAmountLocal) ?? 0.00m;

        bill.WTaxTotalAmount = filteredList?.Sum(x => x.WTaxAmount) ?? 0.00m;
        bill.WTaxTotalAmountLocal = filteredList?.Sum(x => x.WTaxAmountLocal) ?? 0.00m;
    }



