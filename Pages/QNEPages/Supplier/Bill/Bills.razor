    public async void InsertBundleRow(Stocks selectedStock, BillDetails billDetails, Debtors selectedDebtor)
    {
        if (selectedStock.IsBundled)
        {
            // 1. Hanapin current row index
            var currentIndex = billDetailsList.IndexOf(billDetails);

            if (currentIndex >= 0)
            {
                // 2. Kunin lahat ng bundle items
                var bundleItems = stockbundleDetailList
                    .Where(x => x.StockId == selectedStock.Id)
                    .ToList();

                int insertIndex = currentIndex + 1;

                // 3. Insert child rows kasunod ng parent
                foreach (var item in bundleItems)
                {
                    var newRow = new BillDetails
                    {
                        TaxCodeId = selectedDebtor?.DefaultTaxCodeId,
                        WTaxCode = selectedDebtor?.DefaultWTaxCodeId,
                        // StockId = item.SubItemId,
                        // QuotationId = bill.Id,
                        Description = item.Description,
                        //  Qty = item.Qty,
                        //  StockLocationId = bill.StockLocationId,
                        //  UOMId = item.UOMId,
                        // optional fields
                        //  Discount = string.Empty
                    };

                    billDetailsList.Insert(insertIndex, newRow);
                    insertIndex++;
                }

                // 5. Refresh UI
                await grid.Reload();
                StateHasChanged();
            }
        }
    }



