@page "/Bills"
@page "/Bills/Edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin,User")]


@if (isloading)
{
    <Spinner />
}
<RadzenTemplateForm TItem="Bill" Data="bill" Submit="@OnSubmit">
    <RadzenStack Gap="0.2rem">


        <CrudToolbar Title="@(Id.HasValue ? "Edit Bills" : "Create Bills")"
                     Subtitle="Manage bills information"
                     Icon="badge"
                     ButtonSize="@smallbtn"
                     SaveText="Save"
                     SaveBusy="@busy"
                     SaveDisabled=@(bill.CreditorId is null || btnDiseabled || bill.IsCancelled is true || bill.FromDocId != Guid.Empty || Id.HasValue)
                     BackText="Back to Search"
                     OnBackSearch="@Navigate" />


        <RadzenCard>
            <div style="margin-bottom: 0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        Bills - @bill.BillCode <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                    </RadzenStack>
                    <RadzenButton Visible="Id.HasValue" ButtonStyle="ButtonStyle.Light" Icon="info" Click="@OpenDocumentInfoDialog"></RadzenButton>
                </RadzenStack>
            </div>
            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Bills">
                        <RadzenRow Gap="0.5rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Supplier" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Name="Supplier" class="@redtext" Disabled="@(bill.IsCancelled == true)" @bind-Value=bill.CreditorId
                                                                        Change=@(args => OnCreditorChanged((Guid?)args)) AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@supplieraccountList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CompanyCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="4%" Property="CompanyCode" Title="Supplier #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CompanyName" Title="Name"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Supplier" Text="'Supplier' must not be empty." Style="position: relative"></RadzenRequiredValidator>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Currency" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Disabled="true" class="@redtext" @bind-Value=@bill.CurrencyId AllowSorting="false" Style="width: 100%;" PageSize=10 AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CurrencyCode" Density="@density" Data="@currencyList" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CurrencyCode" Title="CurrencyCode"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Rate" AllowFloatingLabel="false">
                                                <RadzenNumeric ShowUpDown="false" Disabled="@(IsForeignCurrency != true)" class="@redtext" @bind-Value=@bill.CurrencyRate Style="width: 100%;" Placeholder="Exchange Rate"></RadzenNumeric>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Description" AllowFloatingLabel="false">
                                                <RadzenDropDown AllowClear="true" @bind-Value=@bill.Description Data=@descriptionsList TextProperty="Description" ValueProperty="Description" ShowValueTemplateOnEmpty="true" Style="width: 100%" Name="DropDownEdit">
                                                    <ValueTemplate Context="asd">
                                                        <RadzenTextBox @bind-Value=@bill.Description Style="width:120%; height:120%;" />
                                                    </ValueTemplate>
                                                </RadzenDropDown>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Variant="Variant.Outlined" Style="width:100%" Text="From" AllowFloatingLabel="false">
                                                <RadzenTextArea class="@redtext" Style="width: 100%;" @bind-Value=@bill.BillFrom Rows="3" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Purchaser" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@bill.PurchaserId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@purchaserList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="StaffCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="StaffCode" Title="Purchaser #"></RadzenDropDownDataGridColumn>

                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>

                                    </RadzenRow>


                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Term" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Name="Term" class="@redtext" @bind-Value=@bill.TermId Style="width: 100%;" Change="@GetDuedate" AllowSorting="false" PageSize=10 Data="@termList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="Term" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Term" Title="Term"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Term" Text="'Term' must not be empty." Style="position: relative"></RadzenRequiredValidator>

                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetDocumentNo" class="@redtext" @bind-Value="@bill.BillDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:92%" Text="Quotation No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@bill.BillCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="width:5%" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@(args => popup.ToggleAsync(button.Element))" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Supplier INV #" AllowFloatingLabel="false">
                                                <RadzenTextBox Name="SupplierInvNo" class="@redtext" @bind-Value="@bill.CreditorInvNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="SupplierInvNo" Text="'Supplier INV No.' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox Name="Reference" class="@redtext" @bind-Value="@bill.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Reference" Text="'Reference No.' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems" JustifyContent="JustifyContent.Center" Style="margin-top:1rem;">

                                        <RadzenColumn Size="3">
                                            <RadzenSwitch Style="transform: scale(0.7);" @bind-Value=bill.IsDetailPosting />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Detail Posting"></RadzenText>
                                        </RadzenColumn>
                                        <RadzenColumn Size="3">
                                            <RadzenSwitch Style="transform: scale(0.7);" @bind-Value=bill.IsTaxInclusive Change="@IsTaxInclusiveChanged" />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Tax Inclusive"></RadzenText>
                                        </RadzenColumn>
                                        <RadzenColumn Size="3">
                                            <RadzenSwitch Style="transform: scale(0.7);" @bind-Value=bill.IsDeferredVAT />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Deferred VAT"></RadzenText>
                                        </RadzenColumn>

                                        @if (Id is not null)
                                        {
                                            <RadzenColumn Size="3">
                                                <RadzenSwitch Style="transform: scale(0.7);" @bind-Value="@bill.IsCancelled" Change=@(args => OnSwitchChanged("IsCancelled")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Cancelled"></RadzenText>
                                            </RadzenColumn>
                                        }

                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Supplier">
                        <RadzenRow>

                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            @*   <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@bill.ProjectId Style="width: 100%;" />
                                            </RadzenFormField> *@
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@bill.ProjectId AllowSorting="false" Style="width: 100%;"
                                                                        PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id"
                                                                        Change="@(args => OnProjectChanged(args))">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="GST Reg #" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled="true" class="@redtext" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>


                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Notes">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="12">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenTextArea @bind-Value=@bill.Notes Rows="10" Style="width:100%" class="@redtext" aria-label="TextArea" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>

            @* TABLE DETAILS*@
            <br />

            <RadzenDataGrid EditMode="@editMode" @ref="grid" Style="width: 100%;"
                            Data="@billDetailsList" AllowColumnResize=true RowCreate="@OnCreateRow"
                            TItem="BillDetails" Density="@density" RowUpdate="@OnUpdateRow" RowRender="@RowRender">
                @*   <HeaderTemplate>
                        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New Order" Size="ButtonSize.ExtraSmall" Click="@InsertRow" Disabled="@(editMode == DataGridEditMode.Single && quotationsDetailsToInsert.Count() > 0)" />
                    </HeaderTemplate> *@
                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => InsertAfterRow(billDetailsList.LastOrDefault()))" title="Add new row after this row"
                                  Disabled="@(billDetailsToInsert.Any() || billDetailsToUpdate.Any() || bill.IsCancelled is true )" />
                </HeaderTemplate>
                <Columns>


                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="data">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                          Click="@(args => EditRow(data))" title="Edit this row"
                                          Disabled="@(bill.IsCancelled is true || bill.IsReceived is true )" />
                        </Template>
                        <EditTemplate Context="data">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(data))" title="Save" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="BillDetails" Property="@nameof(BillDetails.GLAccountId)" Title="Acct Code" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @{
                                var stock = glaccountlist?.FirstOrDefault(s => s.Id == data.GLAccountId);
                            }
                            @stock?.GLAccountCode
                        </Template>
                        <EditTemplate Context="data">


                            <RadzenDropDownDataGrid @bind-Value="data.GLAccountId" Style="width: 100%; font-size:12px" PageSize="10" Data="@glaccountlist" AllowVirtualization="true" AllowColumnResize="true"
                                                    Change="@(args => OnGLAccountChanged(args, data))"
                                                    AllowClear="true" AllowSorting="false" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="GLAccountCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property=@nameof(GLAccounts.GLAccountCode) Title="Account #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property=@nameof(GLAccounts.Description) Title="Account Name" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BillDetails" Title="Acct Desc" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @{
                                var stock = glaccountlist?.FirstOrDefault(s => s.Id == data.GLAccountId);
                            }
                            @stock?.Description
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="BillDetails" Property="@nameof(BillDetails.Description)" Title="Description" TextAlign="TextAlign.Center">
                        <EditTemplate Context="data">
                            <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="data.Description"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BillDetails" Property="@nameof(BillDetails.ReferenceNo)" Title="Reference No" TextAlign="TextAlign.Center">
                        <EditTemplate Context="data">
                            <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="data.ReferenceNo"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BillDetails" Title="Project" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @{
                                var project = projectList?.FirstOrDefault(s => s.Id == data.ProjectId);
                            }
                            @project?.Description
                        </Template>
                        <EditTemplate Context="data">
                            <RadzenDropDownDataGrid class="@redtext" @bind-Value=@data.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Visible=true TItem="BillDetails" Property="@nameof(BillDetails.Amount)" Title="Amount" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @(data.Amount == 0.0000M ? "" : data.Amount.ToString("N4"))
                        </Template>
                        <EditTemplate Context="data">
                            <RadzenNumeric Style="width: 100%; font-size:12px" Disabled="@IsDisable" Change="@(args => TransactionHelper(data))" TValue="decimal" @bind-Value="data.Amount" Format="#.0000"></RadzenNumeric>
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Visible=true TItem="BillDetails" Property="@nameof(BillDetails.TaxCodeId)" Title="TaxCode" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @{
                                var taxcode = taxCodesList?.FirstOrDefault(t => t.Id == data.TaxCodeId);
                            }
                            @taxcode?.TaxCode
                        </Template>
                        <EditTemplate Context="data">
                            <RadzenDropDownDataGrid Change="@(args => TransactionHelper(data))" Disabled="@IsDisable" @bind-Value="data.TaxCodeId" AllowSorting="false" Style="font-size:12px" PageSize="10" Data="@taxCodesList"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="TaxCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="100px" Property="TaxCode" Title="Vat #" />
                                    <RadzenDropDownDataGridColumn Width="100px" Property="Rate" Title="Rate" />
                                    <RadzenDropDownDataGridColumn Width="100px" Property="VatType" Title="VatType" />
                                    <RadzenDropDownDataGridColumn Width="250px" Property="Description" Title="Description" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible=true TItem="BillDetails" Property="@nameof(BillDetails.TaxAmount)" Title="Tax" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @(data.TaxAmount.GetValueOrDefault() == 0M ? "" : data.TaxAmount?.ToString("N8"))
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible=true TItem="BillDetails" Property="@nameof(BillDetails.WTaxCode)" Title="WTax Code" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @{
                                var wtaxcode = wTaxCodesList?.FirstOrDefault(w => w.Id == data.WTaxCode);
                            }
                            @wtaxcode?.Code
                        </Template>

                        <EditTemplate Context="data">
                            <RadzenDropDownDataGrid Disabled="@IsDisable" @bind-Value="data.WTaxCode" AllowSorting="false" Style="font-size:12px" PageSize="10" Data="@FilteredWTaxCodesList"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="Code" Density="@density" ValueProperty="Id" Change="@(args => TransactionHelper(data))">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="100px" Property="Code" Title="Code" />
                                    <RadzenDropDownDataGridColumn Width="100px" Property="Rate" Title="Rate">
                                        <Template Context="wtaxcode">
                                            @((wtaxcode.Rate * 100).ToString("0.00") + "%")
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="250px" Property="Description" Title="Description" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible=false TItem="BillDetails" Property="@nameof(BillDetails.IsTaxInclusive)" Title="Is TaxInclusive" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn Visible=false TItem="BillDetails" Property="@nameof(BillDetails.SubAmount)" Title="SubAmount" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn Visible=false TItem="BillDetails" Property="@nameof(BillDetails.TaxExclusiveAmount)" Title="TaxExclusiveAmount" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn Visible=false TItem="BillDetails" Property="@nameof(BillDetails.Pos)" Title="Pos" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn Visible=false TItem="BillDetails" Property="@nameof(BillDetails.TaxAmount)" Title="TaxAmount" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn Visible=true TItem="BillDetails" Property="@nameof(BillDetails.NetAmount)" Title="Net" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="data">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" title="Delete" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteRow(data))" Disabled="@(billDetailsList.Count == 1 || bill.IsCancelled is true)" />
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>
            @* END OF TABLE DETAILS*@
        </RadzenCard>
        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="5">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">

                        <RadzenFormField Style="width:100%" Text="Taxable" AllowFloatingLabel="false">
                            <RadzenNumeric Disabled=true Value="@bill.TaxExclusiveTotalAmountLocal" Format="#,0.00" ShowUpDown="false" TextAlign="TextAlign.Right" Style="width: 100%;" Placeholder="" />
                        </RadzenFormField>

                        <RadzenFormField Style="width:100%" Text="Tax" AllowFloatingLabel="false">
                            <RadzenNumeric Disabled=true Value="@bill.TaxTotalAmountLocal" Format="#,0.00" ShowUpDown="false" TextAlign="TextAlign.Right" Style="width: 100%;" Placeholder="" />
                        </RadzenFormField>

                        <RadzenFormField Style="width:100%" Text="Due Amount" AllowFloatingLabel="false">
                            <RadzenNumeric Disabled=true Value="@DueAmount" Format="#,0.00" ShowUpDown="false" TextAlign="TextAlign.Right" Style="width: 100%;" Placeholder="" />
                        </RadzenFormField>

                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>


    </RadzenStack>
    <RadzenPopup @ref=popup Lazy=true class="my-popup">
        <RadzenDataGrid RowDoubleClick="() => SetDocumentNoPopup(selectedtransactionCodesList.FirstOrDefault().Id)"
                        TItem="TransactionsCode"
                        @ref=transactionsCodeGrid
                        @bind-Value="@selectedtransactionCodesList"
                        Data=@transactionCodesList>
            <Columns>
                <RadzenDataGridColumn TItem="TransactionsCode" Property="@nameof(TransactionsCode.Format)" Title="Format" TextAlign="TextAlign.Center" Width="300px">
                    <Template Context="transactionCode">
                        @transactionCode.Format
