@page "/SecurityRole"
@page "/SecurityRole/Edit/{id:guid}"
@attribute [Authorize(Roles = "Admin")]

<RadzenTemplateForm TItem="SecuritySystemRole" Data="securitySystemRole" Submit="@OnSubmit">
    <RadzenStack Gap="0.5rem">
        <!-- TOOLBAR ACTION CARD -->
        <CrudToolbar Title="@(Id.HasValue ? "Edit Security Role" : "Create Security Role")"
                     Subtitle="Manage security role information"
                     Icon="badge"
                     ButtonSize="@smallbtn"
                     SaveText="Save"
                     SaveBusy="@busy"
                     SaveDisabled="@btnDiseabled"
                     BackText="Back to Search"
                     OnBackSearch="@Navigate">
        </CrudToolbar>

        <!-- Form Fields Container -->
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-primary);">
                Security Role @* <RadzenBadge Visible="@(securitySystemRole.IsActive == false)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" /> *@
            </RadzenText>

            <RadzenRow Gap="1rem" AlignItems="AlignItems.End">

                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Name" AllowFloatingLabel="false" Style="width: 100%;">
                        <ChildContent>
                            <RadzenTextBox Name="Name" @bind-Value="@securitySystemRole.Name" Style="width: 100%;" />
                        </ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="Name" Text="*Name Required." />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>

     
                @*     <RadzenColumn Size="12" SizeMD="5">
                    <RadzenFormField Text="Description" AllowFloatingLabel="false" Style="width: 100%;">
                        <ChildContent>
                            <RadzenTextBox @bind-Value="@securitySystemRole.Description" Style="width: 100%;" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn> *@

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="height: 100%; padding-bottom: 0.5rem;">
                        <RadzenSwitch Name="IsActive" Style="transform: scale(0.8);" @bind-Value="@securitySystemRole.IsAdministrative" />
                        <RadzenText Text="Active" Component="IsActive" />

                        <RadzenSwitch Name="Change New Password Every" Style="transform: scale(0.8);" @bind-Value="@IsChangePasswordInDays" />
                        <RadzenText Text="Change New Password Every" />
                        <RadzenNumeric @bind-Value="@securitySystemRole.ChangePasswordInDays" Disabled="@(!IsChangePasswordInDays)" ShowUpDown="false" TValue="int" Style="width: 100%;" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem" AlignItems="AlignItems.End">
                <RadzenColumn Size="12" SizeMD="12">
                    <RadzenFormField Text="Description" AllowFloatingLabel="false" Style="width: 100%;">
                        <ChildContent>
                            <RadzenTextBox Name="Description" @bind-Value="@securitySystemRole.Description" Style="width: 100%;" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem" AlignItems="AlignItems.End">


            </RadzenRow>
            <br />
            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Permissions">
                        <RadzenTabs>
                            <Tabs>
                                <RadzenTabsItem Text="Data Operations">

                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Users">
                                    Orders
                                </RadzenTabsItem>
                                <RadzenTabsItem Text="Roles">
                                    Order Details
                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Users">

                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Roles">

                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>  <!-- Form Fields Container -->

    </RadzenStack>
</RadzenTemplateForm>


@code {
