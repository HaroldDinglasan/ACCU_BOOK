        //         busy = false;
        //     }
        //     else
        //     {
        //         await DialogService.Alert(data);
        //         busy = false;
        //     }
        // }
    }

    protected void Navigate()
    {
        navManager.NavigateTo("/SecurityRoleList");
    }
}
