    private void OnStockChanged(object stockId, SalesOrderDetails salesOrderDetails)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);
            if (selectedStock != null)
            {
                // Description?.Split(' ')[0] == "SUBTOTAL"
                //if (selectedStock.StockName?.Split(' ')[0] is ("DISCOUNT" or "SUBTOTAL"))
                if (selectedStock.ItemTypeCode is ("T" or "D"))
                {

                    ///INSERT TOTAL OF EACH COLUMN
                    //quotationDetails.Amount = quotationsDetailsList?.Where(x => x.ItemTypeCode != "T").Sum(x => x.Amount) ?? 0.00m;

                    salesOrderDetails.Qty = 0.00000000M;
                    salesOrderDetails.UOMId = null;
                    salesOrderDetails.UnitPrice = 0.00000000M;
                    salesOrderDetails.SalesOrderId = salesOrdersHeader.Id;
                    salesOrderDetails.StockId = selectedStock.Id;
                    salesOrderDetails.StockLocationId = salesOrdersHeader.StockLocationId;
                    salesOrderDetails.Discount = string.Join("/", Regex.Matches(selectedStock.StockName, @"\d+%").Select(m => m.Value));
                    salesOrderDetails.Description = selectedStock.StockName;
                    salesOrderDetails.ItemTypeCode = selectedStock.ItemTypeCode;
                    salesOrderDetails.TaxCodeId = null;
                    salesOrderDetails.WTaxCode = null;

                    salesOrderDetails.PackingUOM1 = 0.00M;
                    salesOrderDetails.PackingUOM2 = 0.00M;
                    salesOrderDetails.HighestUOM = null;
                   
                    salesOrderDetails.Amount = Amount;
                    salesOrderDetails.AmountLocal = AmountLocal;
                    salesOrderDetails.DiscountAmount = DiscountAmount;
                    salesOrderDetails.DiscountAmountLocal = DiscountAmountLocal;
                    salesOrderDetails.NetAmount = NetAmount;
                    salesOrderDetails.NetAmountLocal = NetAmountLocal;
                    salesOrderDetails.TaxAmount = TaxAmount;
                    salesOrderDetails.TaxAmountLocal = TaxAmountLocal;
                    salesOrderDetails.SubAmount = SubAmount;
                    salesOrderDetails.SubAmountLocal = SubAmountLocal;
                    salesOrderDetails.TaxExclusiveAmount = TaxExclusiveAmount;
                    salesOrderDetails.TaxExclusiveAmountLocal = TaxExclusiveAmountLocal;
                    salesOrderDetails.WTaxAmount = WTaxAmount;
                    salesOrderDetails.WTaxAmountLocal = WTaxAmountLocal;

                    /// TransactionNumberHelper.Compute(salesOrderDetails);
                    if (selectedStock.ItemTypeCode is ("D"))
                    {
                        //LoadSubtotalRow();
                        DiscountAndSubtotalHelper.Compute(salesOrderDetails);
                        ///TransactionNumberHelper.Compute(salesOrderDetails);
                    }



                }
                else
                {

                    if (selectedStock.StockName is ("SALES DISCOUNT"))
                    {
                        salesOrderDetails.Qty = 1.00000000M;
                        salesOrderDetails.UOMId = null;
                        //UnitPrice = added.NetAmount,
                        salesOrderDetails.UnitPrice = DiscountAmount;//SUM OF DISCOUNT AMOUNT
                        //Discount = discountDesrciption,
                        salesOrderDetails.SalesOrderId = salesOrdersHeader.Id;
                        salesOrderDetails.StockId = selectedStock.Id;
                        salesOrderDetails.StockLocationId = salesOrdersHeader.StockLocationId;
                        salesOrderDetails.Description = selectedStock.StockName;
                        salesOrderDetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        salesOrderDetails.TaxCodeId = null;
                        salesOrderDetails.WTaxCode = null;

                        salesOrderDetails.PackingUOM1 = 0.00M;
                        salesOrderDetails.PackingUOM2 = 0.00M;
                        salesOrderDetails.HighestUOM = null;

                        salesOrderDetails.Amount = DiscountAmount;
                        salesOrderDetails.AmountLocal = DiscountAmount;
                        //DiscountAmount = DiscountAmount,
                        //DiscountAmountLocal = DiscountAmountLocal,
                        salesOrderDetails.NetAmount = DiscountAmount;
                        salesOrderDetails.NetAmountLocal = DiscountAmount;
                        //TaxAmount = TaxAmount,
                        //TaxAmountLocal = TaxAmountLocal,
                        salesOrderDetails.SubAmount = DiscountAmount;
                        salesOrderDetails.SubAmountLocal = DiscountAmount;
                        salesOrderDetails.TaxExclusiveAmount = DiscountAmount;
                        salesOrderDetails.TaxExclusiveAmountLocal = DiscountAmount;
                    }

                    else
                    {
                        var selectedDebtor = debtorsaccountList.FirstOrDefault(c => c.Id == salesOrdersHeader.DebtorId);
                        IsDisable = false;
                        salesOrderDetails.SalesOrderId = salesOrdersHeader.Id;
                        salesOrderDetails.StockLocationId = salesOrdersHeader.StockLocationId;
                        // Populate Description
                        salesOrderDetails.Description = selectedStock.StockName;
                        //RESET Discount string
                        salesOrderDetails.Discount = string.Empty;
                        //Set Tax Code Id
                        salesOrderDetails.TaxCodeId = selectedDebtor?.DefaultTaxCodeId;
                        salesOrderDetails.WTaxCode = selectedDebtor?.DefaultWTaxCodeId;
                        // Default Quantity
                        salesOrderDetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        salesOrderDetails.Qty = 1.0000M;

                        salesOrderDetails.PackingUOM2 = salesOrderDetails.Qty;
                        // Set the base UOM
                        var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStockId && u.UOMCode == selectedStock.BaseUOM);
                        if (baseUOM != null)
                        {
                            salesOrderDetails.UOMId = baseUOM.Id;
                        }
                        // Set the Highest UOM
                        var highestUOM = uomsList?.Where(u => u.StockId == selectedStockId).OrderByDescending(u => u.Rate).FirstOrDefault();
                        if (highestUOM != null)
                        {
                            salesOrderDetails.HighestUOM = highestUOM.UOMCode;
                        }
                        // Load Last Price
                        var data = lastSellingPrice.Where(x => x.StockId == selectedStockId).FirstOrDefault();
                        if (data != null)
                        {
                            salesOrderDetails.UnitPrice = data.UnitPrice;
                            TransactionHelper(salesOrderDetails);
                        }
                        else
                        {
                            salesOrderDetails.UnitPrice = 0.00000000M;
                        }
                    }

                  
                }


                // Just trigger state change, don't reload grid
                StateHasChanged();
            }
        }
        else
        {
            // Clear fields if no stock is selected
            salesOrderDetails.UnitPrice = 0.00000000M;
            salesOrderDetails.StockId = null;
            salesOrderDetails.StockLocationId = null;
            salesOrderDetails.Description = string.Empty;
            salesOrderDetails.Qty = 0.00m;
            salesOrderDetails.UOMId = null;
            salesOrderDetails.Discount = null;
            salesOrderDetails.TaxCodeId = null;
            salesOrderDetails.WTaxCode = null;

            salesOrderDetails.PackingUOM1 = 0.00M;
            salesOrderDetails.PackingUOM2 = 0.00M;
            salesOrderDetails.HighestUOM = null;

            salesOrderDetails.Amount = 0.00M;
            salesOrderDetails.AmountLocal = 0.00M;
            salesOrderDetails.DiscountAmount = 0.00M;
            salesOrderDetails.DiscountAmountLocal = 0.00M;
            salesOrderDetails.NetAmount = 0.00M;
            salesOrderDetails.NetAmountLocal = 0.00M;
            salesOrderDetails.TaxAmount = 0.00M;
            salesOrderDetails.TaxAmountLocal = 0.00M;
            salesOrderDetails.SubAmount = 0.00M;
            salesOrderDetails.SubAmountLocal = 0.00M;
            salesOrderDetails.TaxExclusiveAmount = 0.00M;
            salesOrderDetails.TaxExclusiveAmountLocal = 0.00M;
            salesOrderDetails.WTaxAmount = 0.00M;
            salesOrderDetails.WTaxAmountLocal = 0.00M;

            LoadAllTaxTotalDiscNetAmount();
            IsDisable = true;
            StateHasChanged();
        }
    }

