    //insert after row
    async Task InsertAfterRow(SalesOrderDetails salesOrdersDetails)
    {
        // If there's an active edit, prevent adding another row until it's saved.
        if (salesOrderDetailsToInsert.Any() || salesOrderDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!salesOrderDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var salesorderdetails = new SalesOrderDetails();

        //Set QuotationId to new inserted row
        salesorderdetails.SalesOrderId = Id ?? salesOrdersHeader.Id;
        salesorderdetails.IsTaxInclusive = salesOrdersHeader.IsTaxInclusive;
        // Assign a sequential Pos for new rows, inserting after the current row's Pos
        salesOrderDetailsToInsert.Add(salesorderdetails);
        var index = salesOrderDetails.IndexOf(salesOrdersDetails);
        if (index >= 0)
        {
            salesOrderDetails.Insert(index + 1, salesorderdetails); // Insert after selected row
        }
        else
        {
            salesOrderDetails.Add(salesorderdetails);
        }

        ResetPosIndexes();
      
        if (salesOrdersDetails is not null)
        {
            await salesOrderDetailsGrid.InsertAfterRow(salesorderdetails, salesOrdersDetails);
        }
        else
        {
            await salesOrderDetailsGrid.InsertRow(salesorderdetails);
        }

        await salesOrderDetailsGrid.Reload();
        StateHasChanged();
    }

