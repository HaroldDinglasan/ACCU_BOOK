    //TRANSFER FUNCTION
    //bool IsForTransfer = false;

    protected ForTransferHeader forTransferHeader { get; set; } = new ForTransferHeader();
    protected List<ForTransferDetails> forTransferDetails { get; set; }

    //FOR TRANSFER LIST
    private RadzenDataGrid<SalesTransferList> grids;
    private IList<SalesTransferList> selectedSalesTransferList { get; set; }
    private IEnumerable<SalesTransferList> salesTransferList { get; set; }

    //FOR GETTING QUOTATION HEADER AND DETAILS
    private QuotationsModel quotationsHeader { get; set; }
    protected List<QuotationDetails> quotationDetails { get; set; }
    Variant variant = Variant.Flat;
    int totalQuotation = 0;

    public List<Guid> selectedIds = new();
    private string searchText = string.Empty;
    private IEnumerable<SalesTransferList> filteredSalesTransferList;

    private async Task LoadfilteredSalesTranfer()
    {
        filteredSalesTransferList = salesTransferList;
    }
    private async Task GetSalesTransferListing(string DebtorId)
    {

        var data = await salesTransferLinkServices.GetSalesTransferList(DebtorId, "QT");
        salesTransferList = data is not null ? data : new List<SalesTransferList>();
        totalQuotation = salesTransferList.Count();

        await LoadfilteredSalesTranfer();
    }


    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredSalesTransferList = salesTransferList;
        }
        else
        {
            filteredSalesTransferList = salesTransferList.Where(x =>
                (!string.IsNullOrEmpty(x.DocDate.ToString()) && x.DocDate.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.DocCode) && x.DocCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.DebtorName) && x.DebtorName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Agent) && x.Agent.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.RequestBy) && x.RequestBy.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            );
        }
        StateHasChanged();
    }
    private void ClearFilter()
    {
        searchText = string.Empty;
        filteredSalesTransferList = salesTransferList;
        StateHasChanged();
    }

    async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();
    }


    private async void OnOkClicked()
    {
        //DAGDAG TRANSFER DIN PALA YUN HEADER
        if (selectedSalesTransferList != null && selectedSalesTransferList.Any())
        {

            // collect all Ids as comma-separated
            var PRDetailsId = string.Join(",", selectedSalesTransferList.Select(x => x.Id));


            if (!string.IsNullOrWhiteSpace(PRDetailsId))
            {
                selectedIds = PRDetailsId.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                  .Select(Guid.Parse)
                                  .ToList();

                //SET FIRST ROW DATA OF HIGHEST TAX AMOUNT
                var highestTaxItem = selectedSalesTransferList.OrderByDescending(x => x.TaxTotalAmount).FirstOrDefault();
                await GetQuotaionHeaderById(highestTaxItem.Id.ToString());
                await GetQuotaionDetailsById();

            }

        }
        else
        {
            status = "Please select at least one";
            StateHasChanged();
        }

    }

    protected async Task GetQuotaionHeaderById(string QTId)
    {
        await ShowLoading();

        var header = await quotationsService.GetQuotationsById(QTId);
        quotationsHeader = header is not null ? header : new QuotationsModel();
    }


    protected async Task GetQuotaionDetailsById()
    {
        await ShowLoading();
        var details = new List<QuotationDetails>();

        //purchaseRequisitionHeader
        foreach (var QTDetailsId in selectedIds)
        {
            var fortransferDetails = await salesTransferLinkServices.GetQuotationDetailsByIdFortransfer(QTDetailsId.ToString());
