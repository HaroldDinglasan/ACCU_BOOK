    private void LoadAllTaxTotalDiscNetAmount()
    {
        ///INCLUDE HERE THE TAX, DISCOUNT, WTAX, AMOUT, ALL QUOTATION DETAILS AMOUNT


        var filteredList = salesOrderDetails?.Where(x => (x.Description?.Split(' ')[0] != "SUBTOTAL"));


        salesOrdersHeader.TotalAmount = filteredList?.Sum(x => x.Amount) ?? 0.00m;
        salesOrdersHeader.TotalAmountLocal = filteredList?.Sum(x => x.AmountLocal) ?? 0.00m;

        salesOrdersHeader.DiscountAmount = filteredList?.Sum(x => x.DiscountAmount) ?? 0.00m;
        salesOrdersHeader.DiscountAmountLocal = filteredList?.Sum(x => x.DiscountAmountLocal) ?? 0.00m;

        salesOrdersHeader.NetTotalAmount = filteredList?.Sum(x => x.NetAmount) ?? 0.00m;
        salesOrdersHeader.NetTotalAmountLocal = filteredList?.Sum(x => x.NetAmountLocal) ?? 0.00m;

        salesOrdersHeader.TaxTotalAmount = filteredList?.Sum(x => x.TaxAmount) ?? 0.00m;
        salesOrdersHeader.TaxTotalAmountLocal = filteredList?.Sum(x => x.TaxAmountLocal) ?? 0.00m;

        salesOrdersHeader.SubtotalAmount = filteredList?.Sum(x => x.SubAmount) ?? 0.00m;
        salesOrdersHeader.SubtotalAmountLocal = filteredList?.Sum(x => x.SubAmountLocal) ?? 0.00m;

        salesOrdersHeader.TaxExclusiveTotalAmount = filteredList?.Sum(x => x.TaxExclusiveAmount) ?? 0.00m;
        salesOrdersHeader.TaxExclusiveTotalAmountLocal = filteredList?.Sum(x => x.TaxExclusiveAmountLocal) ?? 0.00m;

        salesOrdersHeader.WTaxTotalAmount = filteredList?.Sum(x => x.WTaxAmount) ?? 0.00m;
        salesOrdersHeader.WTaxTotalAmountLocal = filteredList?.Sum(x => x.WTaxAmountLocal) ?? 0.00m;
    }

    protected void RowRender(RowRenderEventArgs<SalesOrderDetails> args)
    {
        if (args?.Data.StockId == null)
            return;
        args.Attributes["style"] = $"font-weight: {(args.Data.Description?.Split(' ')[0] is ("SALES" or "DISCOUNT" or "SUBTOTAL") ? "bold" : "normal")};";

        LoadAllTaxTotalDiscNetAmount();

    }


    private void LoadSubtotalRow()
    {
        ///

        if (salesOrderDetails == null || !salesOrderDetails.Any())
            return;

        var subtotalRow = salesOrderDetails
           .FirstOrDefault(x => x.Description?.StartsWith("SUBTOTAL") == true);

        if (subtotalRow == null)
            return;

        var rows = salesOrderDetails
            .Where(x => x.Description?.Split(' ')[0] is not ("SUBTOTAL" or "DISCOUNT" or "SALES DISCOUNT"))
            .ToList();

        subtotalRow.Amount = rows.Sum(x => x.Amount);
        subtotalRow.AmountLocal = rows.Sum(x => x.AmountLocal);

        subtotalRow.DiscountAmount = rows.Sum(x => x.DiscountAmount);
        subtotalRow.DiscountAmountLocal = rows.Sum(x => x.DiscountAmountLocal);

        subtotalRow.NetAmount = rows.Sum(x => x.NetAmount);
        subtotalRow.NetAmountLocal = rows.Sum(x => x.NetAmountLocal);

        subtotalRow.TaxAmount = rows.Sum(x => x.TaxAmount);
        subtotalRow.TaxAmountLocal = rows.Sum(x => x.TaxAmountLocal);

        subtotalRow.SubAmount = rows.Sum(x => x.SubAmount);
        subtotalRow.SubAmountLocal = rows.Sum(x => x.SubAmountLocal);

        subtotalRow.TaxExclusiveAmount = rows.Sum(x => x.TaxExclusiveAmount);
        subtotalRow.TaxExclusiveAmountLocal = rows.Sum(x => x.TaxExclusiveAmountLocal);

        subtotalRow.WTaxAmount = rows.Sum(x => x.WTaxAmount);
        subtotalRow.WTaxAmountLocal = rows.Sum(x => x.WTaxAmountLocal);

    }
}


@* FOR TRANSFER MODAL *@
<RadzenPopup @ref=popuptransfer Lazy=true class="popuptransfer">

    <RadzenCard>
        <RadzenStack Gap="0.2rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                        <RadzenTextBox Disabled=@(filteredSalesTransferList == null) @bind-Value="@searchText"
                                       Placeholder="Search..."
                                       Style="font-size:smaller; width:30rem;"
                                       Change="@(args => ApplyFilter())" />
                        <RadzenButton Disabled=@(filteredSalesTransferList == null) Icon="search" Click="@ApplyFilter" Text="Find" />
                        <RadzenButton Disabled=@(filteredSalesTransferList == null) Icon="delete" Click="@ClearFilter" Text="Clear" />
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>



            <RadzenDataGrid @ref="grids" @bind-Value=@selectedSalesTransferList SelectionMode="DataGridSelectionMode.Multiple" TItem="SalesTransferList"
                            IsLoading=@isLoading Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading"
                            AllowColumnReorder="true" AllowAlternatingRows="false" ColumnWidth="200px"
                            Data="@filteredSalesTransferList" AllowColumnPicking="true" Style="height: 60vh"
                            KeyProperty="Id" PagerHorizontalAlign="HorizontalAlign.Center" AllowColumnResize="true" Density="@density"
                            AllowVirtualization="true"
                            AllowSorting="true" AllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="@filter" LogicalFilterOperator="LogicalFilterOperator.Or">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                        <span>
                            For Transfer <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                        </span>
                    </RadzenStack>

                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false">
                        <HeaderTemplate>
                            <RadzenCheckBox TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select all items" } })"
                                            Value="@(selectedSalesTransferList == null || selectedSalesTransferList?.Any() != true ? false : !filteredSalesTransferList.All(i => selectedSalesTransferList.Select(e => e.Id).Contains(i.Id)) ? null : filteredSalesTransferList.Any(i => selectedSalesTransferList.Select(e => e.Id).Contains(i.Id)))"
                                            Change="@(args => selectedSalesTransferList = args == true ? (selectedSalesTransferList ?? Enumerable.Empty<SalesTransferList>()).Union(filteredSalesTransferList.Where(i => !(selectedSalesTransferList ?? Enumerable.Empty<SalesTransferList>()).Select(e => e.Id).Contains(i.Id))).ToList() : null)" />
                        </HeaderTemplate>
                        <Template Context="data">
                            <RadzenCheckBox TriState="false" Value="@(selectedSalesTransferList != null && selectedSalesTransferList.Select(e => e.Id).Contains(data.Id))" TValue="bool" />
                        </Template>
                    </RadzenDataGridColumn>



                    <RadzenDataGridColumn Visible=true Width="8rem" Property="@nameof(SalesTransferList.DocCode)" Title="PR #" />
                    <RadzenDataGridColumn Visible=true Width="8rem" Property="@nameof(SalesTransferList.DocDate)" FormatString="{0:MM/dd/yyyy}" Title="Date" />
                    <RadzenDataGridColumn Visible=true Property="@nameof(SalesTransferList.DebtorName)" Title="Account Name" />
                    <RadzenDataGridColumn Visible=true Width="8rem" Property="@nameof(SalesTransferList.Agent)" Title="Agent" />
                    <RadzenDataGridColumn Visible=true Width="8rem" Property="@nameof(SalesTransferList.RequestBy)" Title="Request By" />
                    <RadzenDataGridColumn Visible=true Width="6rem" Property="@nameof(SalesTransferList.Term)" Title="Term"></RadzenDataGridColumn>
                    <RadzenDataGridColumn Visible=true Width="10rem" TextAlign="TextAlign.Right" Property="@nameof(SalesTransferList.TaxTotalAmount)" Title="Tax Total Amount">
                        <Template Context="data">
                            <span>@(data.TaxTotalAmount == 0 ? "" : data.TaxTotalAmount.ToString("#,0.00"))</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible=true Width="10rem" TextAlign="TextAlign.Right" Property="@nameof(SalesTransferList.NetTotalAmount)" Title="Due Amount">
                        <Template Context="data">
                            <span>@(data.NetTotalAmount == 0 ? "" : data.NetTotalAmount.ToString("#,0.00"))</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                        Test Data:
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeSM="5">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right">

                        <RadzenButton Icon="check" Click=@OnOkClicked Text="Ok" /> @* dito is magrereturn sya ng mga naselect na check na data papunt dito NavManager.NavigateTo($"/PurchaseOrders/Transfer/{PRId}"); *@
                        <RadzenButton Icon="cancel" Text="Cancel" Click="async args => { await popuptransfer.CloseAsync(); }" /> @* then dito magcclose yung dialog *@
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenStack>
    </RadzenCard>

</RadzenPopup>

