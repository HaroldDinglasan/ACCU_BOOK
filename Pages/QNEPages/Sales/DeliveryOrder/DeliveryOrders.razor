    //insert after row
    async Task InsertAfterRow(DeliveryOrderDetails deliveryOrdersDetails)
    {
        // If there's an active edit, prevent adding another row until it's saved.
        if (deliveryOrderDetailsToInsert.Any() || deliveryOrderDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!deliveryOrderDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var deliveryorderdetails = new DeliveryOrderDetails();

        //Set QuotationId to new inserted row
        deliveryorderdetails.DeliveryOrderId = Id ?? deliveryOrdersHeader.Id;
        deliveryorderdetails.IsTaxInclusive = deliveryOrdersHeader.IsTaxInclusive;
        // Assign a sequential Pos for new rows, inserting after the current row's Pos
        deliveryOrderDetailsToInsert.Add(deliveryorderdetails);
        var index = deliveryOrderDetails.IndexOf(deliveryOrdersDetails);
        if (index >= 0)
        {
            deliveryOrderDetails.Insert(index + 1, deliveryorderdetails); // Insert after selected row
        }
        else
        {
            deliveryOrderDetails.Add(deliveryorderdetails);
        }

        ResetPosIndexes();

        if (deliveryOrdersDetails is not null)
        {
            await deliveryOrderDetailsGrid.InsertAfterRow(deliveryorderdetails, deliveryOrdersDetails);
        }
        else
        {
            await deliveryOrderDetailsGrid.InsertRow(deliveryorderdetails);
        }

  
        await deliveryOrderDetailsGrid.Reload();
        StateHasChanged();
    }

