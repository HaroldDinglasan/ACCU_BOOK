    private void OnStockChanged(object stockId, DeliveryOrderDetails deliveryOrderDetails)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);
            if (selectedStock != null)
            {
                // Description?.Split(' ')[0] == "SUBTOTAL"
                //if (selectedStock.StockName?.Split(' ')[0] is ("DISCOUNT" or "SUBTOTAL"))
                if (selectedStock.ItemTypeCode is ("T" or "D"))
                {

                    ///INSERT TOTAL OF EACH COLUMN
                    //quotationDetails.Amount = quotationsDetailsList?.Where(x => x.ItemTypeCode != "T").Sum(x => x.Amount) ?? 0.00m;

                    deliveryOrderDetails.Qty = 0.00000000M;
                    deliveryOrderDetails.UOMId = null;
                    deliveryOrderDetails.UnitPrice = 0.00000000M;
                    deliveryOrderDetails.DeliveryOrderId = deliveryOrdersHeader.Id;
                    deliveryOrderDetails.StockId = selectedStock.Id;
                    deliveryOrderDetails.StockLocationId = deliveryOrdersHeader.StockLocationId;
                    deliveryOrderDetails.Discount = string.Join("/", Regex.Matches(selectedStock.StockName, @"\d+%").Select(m => m.Value));
                    deliveryOrderDetails.Description = selectedStock.StockName;
                    deliveryOrderDetails.ItemTypeCode = selectedStock.ItemTypeCode;
                    deliveryOrderDetails.TaxCodeId = null;
                    deliveryOrderDetails.WTaxCode = null;

                    //LoadSubtotalRow();
                    deliveryOrderDetails.Amount = Amount;
                    deliveryOrderDetails.AmountLocal = AmountLocal;
                    deliveryOrderDetails.DiscountAmount = DiscountAmount;
                    deliveryOrderDetails.DiscountAmountLocal = DiscountAmountLocal;
                    deliveryOrderDetails.NetAmount = NetAmount;
                    deliveryOrderDetails.NetAmountLocal = NetAmountLocal;
                    deliveryOrderDetails.TaxAmount = TaxAmount;
                    deliveryOrderDetails.TaxAmountLocal = TaxAmountLocal;
                    deliveryOrderDetails.SubAmount = SubAmount;
                    deliveryOrderDetails.SubAmountLocal = SubAmountLocal;
                    deliveryOrderDetails.TaxExclusiveAmount = TaxExclusiveAmount;
                    deliveryOrderDetails.TaxExclusiveAmountLocal = TaxExclusiveAmountLocal;
                    deliveryOrderDetails.WTaxAmount = WTaxAmount;
                    deliveryOrderDetails.WTaxAmountLocal = WTaxAmountLocal;

                    /// TransactionNumberHelper.Compute(deliveryOrderDetails);
                    if (selectedStock.ItemTypeCode is ("D"))
                    {
                        //LoadSubtotalRow();
                        DiscountAndSubtotalHelper.Compute(deliveryOrderDetails);
                        ///TransactionNumberHelper.Compute(deliveryOrderDetails);
                    }



                }
                else
                {

                    if (selectedStock.StockName is ("SALES DISCOUNT"))
                    {
                        deliveryOrderDetails.Qty = 1.00000000M;
                        deliveryOrderDetails.UOMId = null;
                        //UnitPrice = added.NetAmount,
                        deliveryOrderDetails.UnitPrice = DiscountAmount;//SUM OF DISCOUNT AMOUNT
                        //Discount = discountDesrciption,
                        deliveryOrderDetails.DeliveryOrderId = deliveryOrdersHeader.Id;
                        deliveryOrderDetails.StockId = selectedStock.Id;
                        deliveryOrderDetails.StockLocationId = deliveryOrdersHeader.StockLocationId;
                        deliveryOrderDetails.Description = selectedStock.StockName;
                        deliveryOrderDetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        deliveryOrderDetails.TaxCodeId = null;
                        deliveryOrderDetails.WTaxCode = null;


                        deliveryOrderDetails.Amount = DiscountAmount;
                        deliveryOrderDetails.AmountLocal = DiscountAmount;
                        //DiscountAmount = DiscountAmount,
                        //DiscountAmountLocal = DiscountAmountLocal,
                        deliveryOrderDetails.NetAmount = DiscountAmount;
                        deliveryOrderDetails.NetAmountLocal = DiscountAmount;
                        //TaxAmount = TaxAmount,
                        //TaxAmountLocal = TaxAmountLocal,
                        deliveryOrderDetails.SubAmount = DiscountAmount;
                        deliveryOrderDetails.SubAmountLocal = DiscountAmount;
                        deliveryOrderDetails.TaxExclusiveAmount = DiscountAmount;
                        deliveryOrderDetails.TaxExclusiveAmountLocal = DiscountAmount;
                    }

                    else
                    {
                        deliveryOrderDetails.UseBatchNo = selectedStock.UseBatchNo;
                        var selectedDebtor = debtorsaccountList.FirstOrDefault(c => c.Id == deliveryOrdersHeader.DebtorId);
                        IsDisable = false;
                        deliveryOrderDetails.DeliveryOrderId = deliveryOrdersHeader.Id;
                        deliveryOrderDetails.StockLocationId = deliveryOrdersHeader.StockLocationId;
                        // Populate Description
                        deliveryOrderDetails.Description = selectedStock.StockName;
                        //RESET Discount string
                        deliveryOrderDetails.Discount = string.Empty;
                        //Set Tax Code Id
                        deliveryOrderDetails.TaxCodeId = selectedDebtor?.DefaultTaxCodeId;
                        deliveryOrderDetails.WTaxCode = selectedDebtor?.DefaultWTaxCodeId;
                        // Default Quantity
                        deliveryOrderDetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        deliveryOrderDetails.Qty = 1.0000M;

                        deliveryOrderDetails.PackingUOM2 = deliveryOrderDetails.Qty;
                        // Set the base UOM
                        var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStockId && u.UOMCode == selectedStock.BaseUOM);
                        if (baseUOM != null)
                        {
                            deliveryOrderDetails.UOMId = baseUOM.Id;
                        }
                        // Load Last Price
                        var data = lastSellingPrice.Where(x => x.StockId == selectedStockId).FirstOrDefault();
                        if (data != null)
                        {
                            deliveryOrderDetails.UnitPrice = data.UnitPrice;
                            TransactionHelper(deliveryOrderDetails);
                        }
                        else
                        {
                            deliveryOrderDetails.UnitPrice = 0.00000000M;
                        }
                    }

                }
                // Just trigger state change, don't reload grid
                StateHasChanged();
            }
        }
        else
        {
            deliveryOrderDetails.UseBatchNo = false;
            // Clear fields if no stock is selected
            deliveryOrderDetails.UnitPrice = 0.00000000M;
            deliveryOrderDetails.StockId = null;
            deliveryOrderDetails.StockLocationId = null;
            deliveryOrderDetails.Description = string.Empty;
            deliveryOrderDetails.Qty = 0.00m;
            deliveryOrderDetails.UOMId = null;
            deliveryOrderDetails.Discount = null;
            deliveryOrderDetails.TaxCodeId = null;
            deliveryOrderDetails.WTaxCode = null;

            deliveryOrderDetails.PackingUOM1 = 0.00M;
            deliveryOrderDetails.PackingUOM2 = 0.00M;
            deliveryOrderDetails.HighestUOM = null;

            deliveryOrderDetails.Amount = 0.00M;
            deliveryOrderDetails.AmountLocal = 0.00M;
            deliveryOrderDetails.DiscountAmount = 0.00M;
            deliveryOrderDetails.DiscountAmountLocal = 0.00M;
            deliveryOrderDetails.NetAmount = 0.00M;
            deliveryOrderDetails.NetAmountLocal = 0.00M;
            deliveryOrderDetails.TaxAmount = 0.00M;
            deliveryOrderDetails.TaxAmountLocal = 0.00M;
            deliveryOrderDetails.SubAmount = 0.00M;
            deliveryOrderDetails.SubAmountLocal = 0.00M;
            deliveryOrderDetails.TaxExclusiveAmount = 0.00M;
            deliveryOrderDetails.TaxExclusiveAmountLocal = 0.00M;
            deliveryOrderDetails.WTaxAmount = 0.00M;
            deliveryOrderDetails.WTaxAmountLocal = 0.00M;

            LoadAllTaxTotalDiscNetAmount();
            IsDisable = true;
            StateHasChanged();
        }
    }

