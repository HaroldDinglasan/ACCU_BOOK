@page "/DeliveryOrders"
@page "/DeliveryOrders/Edit/{id:guid}"
@attribute [Authorize(Roles = "Admin,User")]



@if (isLoading)
{
    <Spinner />
}
<RadzenTemplateForm TItem="DeliveryOrdersHeader" Data="deliveryOrdersHeader" Submit="@OnSubmit">
    <RadzenStack Gap="0.2rem">
        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="5">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        <RadzenButton Disabled=@(deliveryOrdersHeader.IsCancelled is true || deliveryOrdersHeader.IsClosed is true || deliveryOrdersHeader.DebtorId is null || btnDiseabled) Size="@smallbtn" Icon="save" BusyText="Saving..." IsBusy=@busy ButtonStyle="ButtonStyle.Primary" Text="@btnText" ButtonType="@Radzen.ButtonType.Submit" />
                        <RadzenButton Disabled=@(deliveryOrdersHeader.DebtorId is null || Id is not null || btnDiseabled) Text="Transfer" Size="@smallbtn" ButtonStyle="ButtonStyle.Primary" @ref="@transferbutton" Icon="compare_arrows" Click="@(args => popuptransfer.ToggleAsync(transferbutton.Element))" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Search" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>
        <RadzenCard>
            <div style="margin-bottom: 0.5rem">
                Delivery Orders @deliveryOrdersHeader.DeliveryOrderCode <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
            </div>
            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Details">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Customer" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Name="Customer" class="@redtext" Disabled="@(deliveryOrdersHeader.IsCancelled != true && deliveryOrdersHeader.TransferToInfo != null)"
                                                                        @bind-Value=deliveryOrdersHeader.DebtorId
                                                                        Change=@(args => OnDebtorChanged((Guid?)args))
                                                                        AllowSorting="false" Style="width: 100%;" PageSize=10
                                                                        Data="@debtorsaccountList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CompanyCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="4%" Property="@nameof(Debtors.CompanyCode)" Title="Customer #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="@nameof(Debtors.CompanyName)" Title="Name"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Customer" Text="'Customer' must not be empty." Style="position: relative"></RadzenRequiredValidator>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="To" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=deliveryOrdersHeader.DebtorName Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Delivery Term" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=deliveryOrdersHeader.DeliveryTerm Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>


                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Term" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Name="Term" class="@redtext" @bind-Value=@deliveryOrdersHeader.TermId Style="width: 100%;" AllowSorting="false" PageSize=10 Data="@termList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="Term" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Term" Title="Term"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Term" Text="'Term' must not be empty." Style="position: relative"></RadzenRequiredValidator>
                                        </RadzenColumn>
                                    </RadzenRow>


                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@deliveryOrdersHeader.StockLocationId Change="@(args => OnStockLocationChanged(args))"
                                                                        AllowSorting="false" Style="width: 120%;" PageSize=10 Data="@stocklocationList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data"><RadzenCheckBox TValue="bool" Value="data.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>



                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Currency" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid Disabled="true" class="@redtext" @bind-Value=@deliveryOrdersHeader.CurrencyId AllowSorting="false" Style="width: 100%;" PageSize=10 AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="CurrencyCode" Density="@density" Data="@currencyList" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="CurrencyCode" Title="CurrencyCode"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Attention" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Attention Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Agent" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@deliveryOrdersHeader.SalesPersonId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@salespersonList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="StaffCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="StaffCode" Title="Agent #"></RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>

                                    </RadzenRow>



                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@deliveryOrdersHeader.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Rate" AllowFloatingLabel="false">
                                                <RadzenNumeric ShowUpDown="false" Disabled="true" class="@redtext" @bind-Value=@deliveryOrdersHeader.CurrencyRate Style="width: 100%;" Placeholder="Exchange Rate"></RadzenNumeric>
                                                @*   <RadzenTextBox @bind-Value=purchaserequisition.CurrencyRate Style="width: 100%;" Placeholder="Exchange Rate" /> *@
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetDeliveryOrderNo" class="@redtext" @bind-Value="@deliveryOrdersHeader.DeliveryOrderDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:92%" Text="Delivery Order No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@deliveryOrdersHeader.DeliveryOrderCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="width:5%" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@(args => popup.ToggleAsync(button.Element))" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox Name="Reference" class="@redtext" @bind-Value="@deliveryOrdersHeader.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenRequiredValidator Component="Reference" Text="'Reference No.' must be not empty." Style="position: relative" />
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems" JustifyContent="JustifyContent.Center" Style="margin-top:1rem;">

                                        <RadzenColumn Size="3">
                                            <RadzenSwitch Style="transform: scale(0.7);" @bind-Value=deliveryOrdersHeader.IsTaxInclusive Name="Active" Change="@IsTaxInclusiveChanged" />
                                            <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Tax Inclusive"></RadzenText>
                                        </RadzenColumn>

                                        @if (Id is not null)
                                        {
                                            <RadzenColumn Size="3">
                                                <RadzenSwitch Style="transform: scale(0.7);" @bind-Value="@deliveryOrdersHeader.IsCancelled" Change=@(args => OnSwitchChanged("IsCancelled")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Cancelled"></RadzenText>
                                            </RadzenColumn>

                                            <RadzenColumn Size="3">
                                                <RadzenSwitch Style="transform: scale(0.7);" @bind-Value="@deliveryOrdersHeader.IsClosed" Change=@(args => OnSwitchChanged("IsClosed")) />
                                                <RadzenText class="@redtext" TextStyle="@textStyle" Style="" Text="Is Closed"></RadzenText>
                                            </RadzenColumn>
                                        }

                                    </RadzenRow>


                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Customer">
                        <RadzenRow>

                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Address1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Address2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Address3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Address4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>


                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="GST Reg #" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled="true" class="@redtext" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Phone" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Phone Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Fax" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Fax Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>


                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Do Address">
                        <RadzenRow>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOAddress1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOAddress2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOAddress3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Address4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOAddress4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Branch Code" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOBranchCode Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Branch Name" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOBranchName Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Contact" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOContact Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="5">
                                            <RadzenFormField Style="width:100%" Text="Phone" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOPhone Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="5">
                                            <RadzenFormField Style="width:100%" Text="Fax" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DOFax Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>

                                        <RadzenColumn Size="12" SizeMD="5">
                                            <RadzenFormField Style="width:100%" Text="Registration No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.DORegistationNo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Others">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Title" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="width: 90%;" Gap="0.5rem;">
                                                        <RadzenDropDown class="@redtext" @bind-Value=@deliveryOrdersHeader.Title
                                                                        Data=@descriptionsList
                                                                        TextProperty="@nameof(Descriptions.Description)" SelectedItem="0"
                                                                        ValueProperty="@nameof(Descriptions.Description)" Style="width: 100%;" />
                                                    </RadzenStack>
                                                    @* <RadzenButton Click="() => OpenDialog(1)" Icon="more_horiz"></RadzenButton> *@
                                                </RadzenStack>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Transfer To" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@deliveryOrdersHeader.TransferToInfo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Transfer From" AllowFloatingLabel="false">
                                                <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@deliveryOrdersHeader.TransferFromInfo Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Ref1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Ref2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference 3" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Ref3 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference 4" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Ref4 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Reference 5" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Ref5 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>


                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Remark1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@deliveryOrdersHeader.Remark2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
