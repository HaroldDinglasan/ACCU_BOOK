    Variant btnVariantText = Variant.Text;
    ButtonSize smallbtn = ButtonSize.Small;


    //FOR POP UP DIALOG
    RadzenButton button;
    RadzenPopup popup;

    RadzenDataGrid<TransactionsCode> transactionsCodeGrid;
    protected IList<TransactionsCode> selectedtransactionCodesList { get; set; }

    //FOR PROPERTY SET VALUE OF OBJECT
    string btnText = "Save";
    bool busy = false;
    string status = string.Empty;
    string redtext;

    //for diseabled quotatuion details table
    protected bool IsDisable = true;

    //for loading data
    bool isLoading = true;
    bool btnDiseabled = false;


    protected DeliveryOrdersHeader deliveryOrdersHeader { get; set; } = new DeliveryOrdersHeader();

    RadzenDataGrid<DeliveryOrderDetails> deliveryOrderDetailsGrid;
    protected List<DeliveryOrderDetails> deliveryOrderDetails;

    DataGridEditMode editMode = DataGridEditMode.Single;
    List<DeliveryOrderDetails> deliveryOrderDetailsToInsert = new List<DeliveryOrderDetails>();
    List<DeliveryOrderDetails> deliveryOrderDetailsToUpdate = new List<DeliveryOrderDetails>();

    //ALL LIST FOR DROPDOWN BOX INPUT
    protected IEnumerable<Projects> projectList { get; set; }
    protected IEnumerable<Currencies> currencyList { get; set; }
    protected IEnumerable<Debtors> debtorsaccountList { get; set; }
    protected IEnumerable<Terms> termList { get; set; }
    protected IEnumerable<StockLocations> stocklocationList { get; set; }
    protected IEnumerable<SalesPersons> salespersonList { get; set; }
    protected IEnumerable<Stocks> stockList { get; set; }
    protected IEnumerable<UOMs> uomsList { get; set; }
    protected IEnumerable<WTaxCodes> wTaxCodesList { get; set; }
    protected IEnumerable<TaxCodes> taxCodesList { get; set; }


    protected IEnumerable<Descriptions> descriptionsList { get; set; }
    protected IEnumerable<TransactionsCode> transactionCodesList { get; set; }


    protected DescriptionFilter descriptionFilter { get; set; } = new DescriptionFilter();
    protected TransactionCodesFilter transactionCodesFilter = new TransactionCodesFilter();
    protected TaxCodeFilter taxCodeFilter = new TaxCodeFilter();

    //private RunningNumbers runningNumbers;


    protected async override Task OnInitializedAsync()
    {

        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            var RoleId = authState.FindFirst("RoleId").Value;
            GetLoadMenuPermission(RoleId);
        }


    }


    private SystemMenuObjectPermission? permission;
    protected async void GetLoadMenuPermission(string RoleId)
    {
        permission = await permissionService.GetPermissionAsync(
         RoleId,
         "Sales Orders");

        if (permission is null)
            return;

        SetTransactionCodeData();
        InitializeDeliveryOrderDetailsRows();
        await loadAllData();
        if (Id is not null)
        {
            await loadAllDataById();
        }
        StateHasChanged();

        StateHasChanged();
    }

    protected void LoadDeliveryOrderStatus()
    {
        //status = deliveryOrdersHeader.IsCancelled == true ? "(Cancelled)" : deliveryOrdersHeader.TransferToInfo != null ? ("Tranferred") : "";

        var statusList = new List<string>();
        if (deliveryOrdersHeader.IsClosed)
            statusList.Add("Closed");

        if (deliveryOrdersHeader.IsCancelled)
            statusList.Add("Cancelled");

        if (statusList.Any())
        {
            status = $"({string.Join(", ", statusList)})";
        }
        else if (!string.IsNullOrWhiteSpace(deliveryOrdersHeader.TransferToInfo))
        {
            status = "(Transferred)";
        }

        StateHasChanged();
    }

    protected async Task OnSubmit()
    {

        //SAVING
        if (deliveryOrderDetailsToInsert.Any() || deliveryOrderDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            busy = false;
            return;
        }
        var data = await deliveryOrdersService.SaveDeliveryOrderWithTransferAsync(deliveryOrdersHeader, deliveryOrderDetails, forTransferHeader, forTransferDetails);
        if (data is not null)
        {
