    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredSalesTransferList = salesTransferList;
        }
        else
        {
            filteredSalesTransferList = salesTransferList.Where(x =>
                (!string.IsNullOrEmpty(x.DocDate.ToString()) && x.DocDate.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.DocCode) && x.DocCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.DebtorName) && x.DebtorName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Agent) && x.Agent.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.RequestBy) && x.RequestBy.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            );
        }
        StateHasChanged();
    }
    private void ClearFilter()
    {
        searchText = string.Empty;
        filteredSalesTransferList = salesTransferList;
        StateHasChanged();
    }

    async Task ShowLoading()
    {
        isLoading = true;

        await Task.Yield();
    }


    private async void OnOkClicked()
    {
        //DAGDAG TRANSFER DIN PALA YUN HEADER
        if (selectedSalesTransferList != null && selectedSalesTransferList.Any())
        {

            // collect all Ids as comma-separated
            var PRDetailsId = string.Join(",", selectedSalesTransferList.Select(x => x.Id));


            if (!string.IsNullOrWhiteSpace(PRDetailsId))
            {
                selectedIds = PRDetailsId.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                  .Select(Guid.Parse)
                                  .ToList();

                //SET FIRST ROW DATA OF HIGHEST TAX AMOUNT
                var highestTaxItem = selectedSalesTransferList.OrderByDescending(x => x.TaxTotalAmount).FirstOrDefault();
                await GetSalesOrderHeaderById(highestTaxItem.Id.ToString());
                await GetSalesOrderDetailsById();

            }

        }
        else
        {
            status = "Please select at least one";
            StateHasChanged();
        }

    }




