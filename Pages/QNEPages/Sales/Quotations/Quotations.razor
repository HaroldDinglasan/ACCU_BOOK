    public async void InsertBundleRow(Stocks selectedStock, QuotationDetails quotationDetails, Debtors selectedDebtor)
    {
        if (selectedStock.IsBundled)
        {
            // 1. Hanapin current row index
            var currentIndex = quotationsDetailsList.IndexOf(quotationDetails);

            if (currentIndex >= 0)
            {
                // 2. Kunin lahat ng bundle items
                var bundleItems = stockbundleDetailList
                    .Where(x => x.StockId == selectedStock.Id)
                    .ToList();

                int insertIndex = currentIndex + 1;

                // 3. Insert child rows kasunod ng parent
                foreach (var item in bundleItems)
                {
                    var newRow = new QuotationDetails
                    {
                        TaxCodeId = selectedDebtor?.DefaultTaxCodeId,
                        WTaxCode = selectedDebtor?.DefaultWTaxCodeId,
                        StockId = item.SubItemId,
                        QuotationId = quotationsModel.Id,
                        Description = item.Description,
                        Qty = item.Qty,
                        StockLocationId = quotationsModel.StockLocationId,
                        UOMId = item.UOMId,
                        // optional fields
                        Discount = string.Empty
                    };

                    quotationsDetailsList.Insert(insertIndex, newRow);
                    insertIndex++;
                }

                // 5. Refresh UI
                await quotationsDetailsGrid.Reload();
                StateHasChanged();
            }
        }
    }


