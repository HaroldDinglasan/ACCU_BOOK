@code {
    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }
    bool rightSidebarExpanded = false;

    AlignItems alignItems = AlignItems.Center;
    Density density = Density.Compact;
    TextStyle textStyle = TextStyle.Body2;
    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    Variant btnVariantText = Variant.Text;
    ButtonSize smallbtn = ButtonSize.Small;


    //FOR POP UP DIALOG
    RadzenButton button;
    RadzenPopup popup;
    RadzenDataGrid<TransactionsCode> transactionsCodeGrid;
    protected IList<TransactionsCode> selectedtransactionCodesList { get; set; }

    //FOR PROPERTY SET VALUE OF OBJECT
    string btnText = "Save";
    bool busy = false;
    string status = string.Empty;
    string redtext;

    //for diseabled quotatuion details table
    protected bool IsDisable = true;

    //for loading data
    bool isloading = true;
    bool btnDiseabled = false;

   

    protected QuotationsModel quotationsModel { get; set; } = new QuotationsModel();

    //FOR QUOTATION DETAILS GRID
    // Add this after initializing quotationsDetailsList to ensure a first row is loaded by default
    RadzenDataGrid<QuotationDetails> quotationsDetailsGrid;
    DataGridEditMode editMode = DataGridEditMode.Single;
    List<QuotationDetails> quotationsDetailsToInsert = new List<QuotationDetails>();
    List<QuotationDetails> quotationsDetailsToUpdate = new List<QuotationDetails>();
    protected List<QuotationDetails> quotationsDetailsList { get; set; }

    //ALL LIST FOR DROPDOWN BOX INPUT
    protected IEnumerable<Projects> projectList { get; set; }
    protected IEnumerable<Currencies> currencyList { get; set; }
    protected IEnumerable<Debtors> debtorsaccountList { get; set; }
    protected IEnumerable<Terms> termList { get; set; }
    protected IEnumerable<StockLocations> stocklocationList { get; set; }
    protected IEnumerable<SalesPersons> salespersonList { get; set; }
    protected IEnumerable<Stocks> stockList { get; set; }
    protected IEnumerable<UOMs> uomsList { get; set; }
    protected IEnumerable<WTaxCodes> wTaxCodesList { get; set; }
    protected IEnumerable<TaxCodes> taxCodesList { get; set; }

    protected IEnumerable<Descriptions> descriptionsList { get; set; }
    protected IEnumerable<TransactionsCode> transactionCodesList { get; set; }

    protected DescriptionFilter descriptionFilter { get; set; } = new DescriptionFilter();
    protected TransactionCodesFilter transactionCodesFilter = new TransactionCodesFilter();
    protected TaxCodeFilter taxCodeFilter = new TaxCodeFilter();

    string? userId;//USER GUID


    protected async override Task OnInitializedAsync()
    {

        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            var RoleId = authState.FindFirst("RoleId").Value;

            //USER GUID
            var userguid = authState.FindFirst(x => x.Type == System.Security.Claims.ClaimTypes.NameIdentifier);
            userId = userguid.Value;

            GetLoadMenuPermission(RoleId);
        }

    }

    private SystemMenuObjectPermission? permission;
    protected async void GetLoadMenuPermission(string RoleId)
    {
        permission = await permissionService.GetPermissionAsync(
         RoleId,
         "Quotations");

        if (permission is null)
            return;

        SetTransactionCodeData();
        InitializeQuotationDetailsRows();
        await loadAllData();
        if (Id is not null)
        {
            await loadAllDataById();
        }
        StateHasChanged();
    }

    protected void LoadQuotationStatus()
    {
        // status = quotationsModel.IsCancelled == true ? "(Cancelled)" : quotationsModel.TransferToInfo != null ? ("Tranferred") : "";

        var statusList = new List<string>();
        if (quotationsModel.IsClosed)
            statusList.Add("Closed");

        if (quotationsModel.IsCancelled)
            statusList.Add("Cancelled");

        if (statusList.Any())
        {
            status = $"({string.Join(", ", statusList)})";
        }
        else if (!string.IsNullOrWhiteSpace(quotationsModel.TransferToInfo))
        {
            status = "(Transferred)";
        }

        StateHasChanged();
    }
    protected async Task OnSubmit()
    {

        busy = true;
        //SAVING
        if (quotationsDetailsToInsert.Any() || quotationsDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        var data = await quotationServices.SaveQuotationHeaderAndDetails(quotationsModel, quotationsDetailsList);
        if (data is not null)
        {
            if (data.Contains("Success"))
            {
                var info = await documentsInfoService.SaveDocumentInfo(documentInfo);
                await DialogService.Alert(data + info);
                btnDiseabled = true;
                busy = false;
            }
            else
            {
                await DialogService.Alert(data);
            }

        }
    }

    protected void SetTransactionCodeData()
    {
        descriptionFilter.OwnerCode = "Quotations.Title";
        //For Generating Quotations Code Getting Format from db.TransactionCodes
        transactionCodesFilter.TableId = 61;
    }


    DialogPosition position;
    bool closeDialogOnOverlayClick;
    bool showMask;
    bool resizable;
    protected DocumentInfo documentInfo { get; set; } = new DocumentInfo();
    async Task OpenDocumentInfoDialog()
    {
       // await DialogService.OpenSideAsync<DocumentInfoPage>("Document Info", new Dictionary<string, object?> { "Id" , (Guid?)Id }, options: new SideDialogOptions { CloseDialogOnOverlayClick = closeDialogOnOverlayClick, Resizable = resizable, Position = position, ShowMask = showMask, MinHeight = 250.0, MinWidth = 350.0 });
        await DialogService.OpenSideAsync<DocumentInfoPage>(
            "Document Info",
            new Dictionary<string, object?>
            {
            { "Id", (Guid?)Id }
            },
            options: new SideDialogOptions
            {
                CloseDialogOnOverlayClick = closeDialogOnOverlayClick,
                Resizable = resizable,
                Position = position,
                ShowMask = showMask,
                MinHeight = 250.0,
                MinWidth = 350.0
            });
    
    }
    protected void SetDocumentInfo()
    {
        documentInfo.DocumentId = quotationsModel.Id.ToString();
        documentInfo.FirstCreatedUserId = userId;
        documentInfo.LastModifiedUserId = userId;
        documentInfo.DocType = "Quotations";
    }

    protected async Task loadAllData()
    {
        await GetTransactionNo();
        await GetCustomertList();
        await GetTermList();
        await GetCurrencyList();
        SetDefaultCurrency();
        await GetStockList();
        await GetStocksPriceList();
        await GetUOMSList();
        await GetTaxCodesList();
        await GetWTaxCodesList();
        await GetLocationList();
        await GetSalesPersonList();
        await GetDescriptions();
        await GetProjectList();
        await SetQuotationNo();
        await GetStockBundle();
        SetDocumentInfo();

        isloading = false;
    }

    protected async Task loadAllDataById()
    {
        //await GetDocumentInfoById();
        await GetQuotationsById();
        await GetQuotationsDetailById();
        SetDocumentInfo();
        LoadQuotationStatus();
        isloading = false;
    }

    protected async Task GetStockList()
    {
        var data = await stockItemsService.GetStockList();
        stockList = data is not null ? data : new List<Stocks>();

    }

    protected IEnumerable<StockUnitPrice> lastSellingPrice { get; set; }
    protected async Task GetStocksPriceList()
    {
        var data = await stockItemsService.GetStocksPriceList("QT");
        lastSellingPrice = data is not null ? data : new List<StockUnitPrice>();

    }
    //Get Currencies From db.Currencies
    protected async Task GetCurrencyList()
    {
        var data = await currenciesService.GetCurrencies();
        currencyList = data is not null ? data : new List<Currencies>();

    }
    protected void SetDefaultCurrency()
    {
        var selectedcurrency = currencyList.FirstOrDefault(c => c.Id == 1);
        quotationsModel.CurrencyId = selectedcurrency.Id;
        quotationsModel.CurrencyRate = selectedcurrency.DefaultPurchaseRate;
    }

    //GET ALL UOMLIST PER STOCK
    protected async Task GetUOMSList()
    {
        var data = await stockItemsService.GetUOMsList();
        uomsList = data is not null ? data : new List<UOMs>();
