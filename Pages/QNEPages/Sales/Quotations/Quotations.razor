    //insert after row
    async Task InsertAfterRow(QuotationDetails quotationDetails)
    {
        // If there's an active edit, prevent adding another row until it's saved.

        if (quotationsDetailsToInsert.Any() || quotationsDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }



        if (!quotationsDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var quotDetails = new QuotationDetails();

        //Set QuotationId to new inserted row
        quotDetails.QuotationId = Id ?? quotationsModel.Id;
        quotDetails.IsTaxInclusive = quotationsModel.IsTaxInclusive;
        // Assign a sequential Pos for new rows, inserting after the current row's Pos
        quotationsDetailsToInsert.Add(quotDetails);
        var index = quotationsDetailsList.IndexOf(quotationDetails);
        if (index >= 0)
        {
            quotationsDetailsList.Insert(index + 1, quotDetails); // Insert after selected row
        }
        else
        {
            quotationsDetailsList.Add(quotDetails);
        }


        ResetPosIndexes();

        if (quotationDetails is not null)
        {
            await quotationsDetailsGrid.InsertAfterRow(quotDetails, quotationDetails);
        }
        else
        {
            await quotationsDetailsGrid.InsertRow(quotDetails);
        }

        await quotationsDetailsGrid.Reload();
        StateHasChanged();
    }

