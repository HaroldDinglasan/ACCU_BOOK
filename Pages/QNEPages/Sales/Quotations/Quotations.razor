    private void TransactionHelper(QuotationDetails row)
    {
        row.TaxRate = taxCodesList.FirstOrDefault(tax => tax.Id == row.TaxCodeId)?.TaxRate ?? 0;
        row.WTaxRate = wTaxCodesList.FirstOrDefault(tax => tax.Id == row.WTaxCode)?.Rate ?? 0;
        TransactionNumberHelper.Compute(row);
        ConvertPackUOM(row);
    }


    private void ConvertPackUOM(QuotationDetails row)
    {
        // 1. Get the full list of UOMs for this stock item
        var uoms = GetUOMsForStock(row.StockId)?.ToList();

        if (uoms == null || !uoms.Any())
            return;

        // 2. Find the rate of the UOM currently selected by the user
        var selectedUom = uoms.FirstOrDefault(x => x.Id == row.UOMId);

        if (selectedUom == null)
            return;

        // 3. Call the service to get the split values
        var result = UomService.ComputePackingSalesUOM(
            row.Qty,
            selectedUom.Rate,
            uoms
        );

        // 4. Update the UI bound properties
        row.PackingUOM1 = result.uom1;
        row.PackingUOM2 = result.uom2;

        // Note: If you are using an EditForm, you might need to call StateHasChanged()
        // if the update happens inside a custom event.
    }

  
