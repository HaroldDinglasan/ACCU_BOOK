    private async void OnStockChanged(object stockId, QuotationDetails quotationDetails)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);
            if (selectedStock != null)
            {

                // if (selectedStock.StockName?.Split(' ')[0] is ("DISCOUNT" or "SUBTOTAL"))
                if (selectedStock.ItemTypeCode is ("T" or "D"))
                {
                    ///INSERT TOTAL OF EACH COLUMN
                    quotationDetails.Qty = 0.00000000M;
                    quotationDetails.UOMId = null;
                    quotationDetails.UnitPrice = 0.00000000M;
                    quotationDetails.QuotationId = quotationsModel.Id;
                    quotationDetails.StockId = selectedStock.Id;
                    quotationDetails.StockLocationId = quotationsModel.StockLocationId;
                    quotationDetails.Discount = string.Join("/", Regex.Matches(selectedStock.StockName, @"\d+%").Select(m => m.Value));
                    quotationDetails.Description = selectedStock.StockName;
                    quotationDetails.ItemTypeCode = selectedStock.ItemTypeCode;
                    quotationDetails.TaxCodeId = null;
                    quotationDetails.WTaxCode = null;

                    quotationDetails.PackingUOM1 = 0.00M;
                    quotationDetails.PackingUOM2 = 0.00M;
                    quotationDetails.HighestUOM = null;

                    quotationDetails.Amount = Amount;
                    quotationDetails.AmountLocal = AmountLocal;
                    quotationDetails.DiscountAmount = DiscountAmount;
                    quotationDetails.DiscountAmountLocal = DiscountAmountLocal;
                    quotationDetails.NetAmount = NetAmount;
                    quotationDetails.NetAmountLocal = NetAmountLocal;
                    quotationDetails.TaxAmount = TaxAmount;
                    quotationDetails.TaxAmountLocal = TaxAmountLocal;
                    quotationDetails.SubAmount = SubAmount;
                    quotationDetails.SubAmountLocal = SubAmountLocal;
                    quotationDetails.TaxExclusiveAmount = TaxExclusiveAmount;
                    quotationDetails.TaxExclusiveAmountLocal = TaxExclusiveAmountLocal;
                    quotationDetails.WTaxAmount = WTaxAmount;
                    quotationDetails.WTaxAmountLocal = WTaxAmountLocal;

                    /// TransactionNumberHelper.Compute(quotationDetails);
                    //if (selectedStock.StockName?.Split(' ')[0] == "DISCOUNT")
                    if (selectedStock.ItemTypeCode is ("D"))
                    {
                        //LoadSubtotalRow();
                        DiscountAndSubtotalHelper.Compute(quotationDetails);
                        ///TransactionNumberHelper.Compute(quotationDetails);
                    }
                }

                else
                {

                    if (selectedStock.StockName is ("SALES DISCOUNT"))
                    {
                        quotationDetails.Qty = 1.00000000M;
                        quotationDetails.UOMId = null;
                        //UnitPrice = added.NetAmount,
                        quotationDetails.UnitPrice = DiscountAmount;//SUM OF DISCOUNT AMOUNT
                        //Discount = discountDesrciption,
                        quotationDetails.QuotationId = quotationsModel.Id;
                        quotationDetails.StockId = selectedStock.Id;
                        quotationDetails.StockLocationId = quotationsModel.StockLocationId;
                        quotationDetails.Description = selectedStock.StockName;
                        quotationDetails.ItemTypeCode = selectedStock.ItemTypeCode;

                        quotationDetails.TaxCodeId = null;
                        quotationDetails.WTaxCode = null;

                        quotationDetails.PackingUOM1 = 0.00M;
                        quotationDetails.PackingUOM2 = 0.00M;
                        quotationDetails.HighestUOM = null;

                        quotationDetails.Amount = DiscountAmount;
                        quotationDetails.AmountLocal = DiscountAmount;
                        //DiscountAmount = DiscountAmount,
                        //DiscountAmountLocal = DiscountAmountLocal,
                        quotationDetails.NetAmount = DiscountAmount;
                        quotationDetails.NetAmountLocal = DiscountAmount;
                        //TaxAmount = TaxAmount,
                        //TaxAmountLocal = TaxAmountLocal,
                        quotationDetails.SubAmount = DiscountAmount;
                        quotationDetails.SubAmountLocal = DiscountAmount;
                        quotationDetails.TaxExclusiveAmount = DiscountAmount;
                        quotationDetails.TaxExclusiveAmountLocal = DiscountAmount;
                    }
                    else
                    {

                        var selectedDebtor = debtorsaccountList.FirstOrDefault(c => c.Id == quotationsModel.DebtorId);
                        IsDisable = false;
                        // quotationDetails.StockId = selectedStock.Id;
                        quotationDetails.QuotationId = quotationsModel.Id;
                        quotationDetails.StockLocationId = quotationsModel.StockLocationId;
                        // Populate Description
                        quotationDetails.Description = selectedStock.StockName;
                        //RESET Discount string
                        quotationDetails.Discount = string.Empty;
                        //Set Tax Code Id
                        quotationDetails.TaxCodeId = selectedDebtor?.DefaultTaxCodeId;
                        quotationDetails.WTaxCode = selectedDebtor?.DefaultWTaxCodeId;
                        // Default Quantity
                        quotationDetails.ItemTypeCode = selectedStock.ItemTypeCode;
                        quotationDetails.Qty = 1.0000M;
                        quotationDetails.PackingUOM2 = quotationDetails.Qty;
                        // Set the base UOM
                        var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStockId && u.UOMCode == selectedStock.BaseUOM);
                        if (baseUOM != null)
                        {
                            quotationDetails.UOMId = baseUOM.Id;
                        }
                        // Set the Highest UOM
                        var highestUOM = uomsList?.Where(u => u.StockId == selectedStockId).OrderByDescending(u => u.Rate).FirstOrDefault();
                        if (highestUOM != null)
                        {
                            quotationDetails.HighestUOM = highestUOM.UOMCode;
                        }
                        // Load Last Price
                        var data = lastSellingPrice.Where(x => x.StockId == selectedStockId).FirstOrDefault();
                        if (data != null)
                        {
                            quotationDetails.UnitPrice = data.UnitPrice;
                            TransactionHelper(quotationDetails);
                        }
                        else
                        {
                            quotationDetails.UnitPrice = 0.00000000M;
                        }
                        ///dito is ma add ko para mag insert ng new row pag nag select ng bundled item maadd siya kasunod ng item na may bundling
                        if (selectedStock.IsBundled)
                        {
                            InsertBundleRow(selectedStock, quotationDetails, selectedDebtor);
                            //StateHasChanged();
                        }
                    }
                }
                StateHasChanged();
            }
        }
        else
        {
            // Clear fields if no stock is selected
            quotationDetails.UnitPrice = 0.00000000M;
            quotationDetails.StockId = null;
            quotationDetails.StockLocationId = null;
            quotationDetails.Description = string.Empty;
            quotationDetails.Qty = 0.00m;
            quotationDetails.UOMId = null;
            quotationDetails.Discount = null;
            quotationDetails.TaxCodeId = null;
            quotationDetails.WTaxCode = null;

            quotationDetails.PackingUOM1 = 0.00M;
            quotationDetails.PackingUOM2 = 0.00M;
            quotationDetails.HighestUOM = null;

            quotationDetails.Amount = 0.00M;
            quotationDetails.AmountLocal = 0.00M;
            quotationDetails.DiscountAmount = 0.00M;
            quotationDetails.DiscountAmountLocal = 0.00M;
            quotationDetails.NetAmount = 0.00M;
            quotationDetails.NetAmountLocal = 0.00M;
            quotationDetails.TaxAmount = 0.00M;
            quotationDetails.TaxAmountLocal = 0.00M;
            quotationDetails.SubAmount = 0.00M;
            quotationDetails.SubAmountLocal = 0.00M;
            quotationDetails.TaxExclusiveAmount = 0.00M;
            quotationDetails.TaxExclusiveAmountLocal = 0.00M;
            quotationDetails.WTaxAmount = 0.00M;
            quotationDetails.WTaxAmountLocal = 0.00M;
            LoadAllTaxTotalDiscNetAmount();

            IsDisable = true;
            StateHasChanged();
        }
    }

