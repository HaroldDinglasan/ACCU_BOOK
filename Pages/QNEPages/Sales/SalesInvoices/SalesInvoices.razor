    private void OnStockChanged(object stockId, SalesInvoiceDetails details)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var stockglAccount = StockGLAccountsList?.FirstOrDefault(s => s.StockId == selectedStockId); /// OCTOBER 15, 2026
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);
            if (selectedStock != null)
            {
                // Description?.Split(' ')[0] == "SUBTOTAL"
                //if (selectedStock.StockName?.Split(' ')[0] is ("DISCOUNT" or "SUBTOTAL"))
                if (selectedStock.ItemTypeCode is ("T" or "D"))
                {

                    ///INSERT TOTAL OF EACH COLUMN
                    //quotationDetails.Amount = quotationsDetailsList?.Where(x => x.ItemTypeCode != "T").Sum(x => x.Amount) ?? 0.00m;

                    details.Qty = 0.00000000M;
                    details.UOMId = null;
                    details.UnitPrice = 0.00000000M;
                    details.SalesInvoiceId = salesInvoicesHeader.Id;
                    details.StockId = selectedStock.Id;
                    details.StockLocationId = salesInvoicesHeader.StockLocationId;
                    details.Discount = string.Join("/", Regex.Matches(selectedStock.StockName, @"\d+%").Select(m => m.Value));
                    details.Description = selectedStock.StockName;
                    details.ItemTypeCode = selectedStock.ItemTypeCode;
                    details.TaxCodeId = null;
                    details.WTaxCode = null;

                    if (selectedStock.ItemTypeCode is ("D"))
                    { details.GLAccountId = stockglAccount?.SalesAccountId; }
                    

                    //details.GLAccountId = stockglAccount?.SalesAccountId; /// OCTOBER 15, 2026

                    //LoadSubtotalRow();
                    details.Amount = Amount;
                    details.AmountLocal = AmountLocal;
                    details.DiscountAmount = DiscountAmount;
                    details.DiscountAmountLocal = DiscountAmountLocal;
                    details.NetAmount = NetAmount;
                    details.NetAmountLocal = NetAmountLocal;
                    details.TaxAmount = TaxAmount;
                    details.TaxAmountLocal = TaxAmountLocal;
                    details.SubAmount = SubAmount;
                    details.SubAmountLocal = SubAmountLocal;
                    details.TaxExclusiveAmount = TaxExclusiveAmount;
                    details.TaxExclusiveAmountLocal = TaxExclusiveAmountLocal;
                    details.WTaxAmount = WTaxAmount;
                    details.WTaxAmountLocal = WTaxAmountLocal;

                    /// TransactionNumberHelper.Compute(details);
                    if (selectedStock.ItemTypeCode is ("D"))
                    {
                        //LoadSubtotalRow();
                        DiscountAndSubtotalHelper.Compute(details);
                        ///TransactionNumberHelper.Compute(details);
                    }



                }
                else
                {

                    if (selectedStock.StockName is ("SALES DISCOUNT"))
                    {
                        details.Qty = 1.00000000M;
                        details.UOMId = null;
                        //UnitPrice = added.NetAmount,
                        details.UnitPrice = DiscountAmount;//SUM OF DISCOUNT AMOUNT
                        //Discount = discountDesrciption,
                        details.SalesInvoiceId = salesInvoicesHeader.Id;
                        details.StockId = selectedStock.Id;
                        details.StockLocationId = salesInvoicesHeader.StockLocationId;
                        details.Description = selectedStock.StockName;
                        details.ItemTypeCode = selectedStock.ItemTypeCode;

                        details.TaxCodeId = null;
                        details.WTaxCode = null;
                        details.GLAccountId = stockglAccount?.SalesAccountId; /// OCTOBER 15, 2026

                        details.Amount = DiscountAmount;
                        details.AmountLocal = DiscountAmount;
                        //DiscountAmount = DiscountAmount,
                        //DiscountAmountLocal = DiscountAmountLocal,
                        details.NetAmount = DiscountAmount;
                        details.NetAmountLocal = DiscountAmount;
                        //TaxAmount = TaxAmount,
                        //TaxAmountLocal = TaxAmountLocal,
                        details.SubAmount = DiscountAmount;
                        details.SubAmountLocal = DiscountAmount;
                        details.TaxExclusiveAmount = DiscountAmount;
                        details.TaxExclusiveAmountLocal = DiscountAmount;
                    }

                    else
                    {
                        var selectedDebtor = debtorsaccountList.FirstOrDefault(c => c.Id == salesInvoicesHeader.DebtorId);
                        IsDisable = false;
                        details.SalesInvoiceId = salesInvoicesHeader.Id;
                        details.StockLocationId = salesInvoicesHeader.StockLocationId;
                        // Populate Description
                        details.Description = selectedStock.StockName;
                        //RESET Discount string
                        details.Discount = string.Empty;
                        //Set Tax Code Id
                        details.TaxCodeId = selectedDebtor?.DefaultTaxCodeId;
                        details.WTaxCode = selectedDebtor?.DefaultWTaxCodeId;
                        details.GLAccountId = stockglAccount?.SalesAccountId; /// OCTOBER 15, 2026
                        // Default Quantity
                        details.ItemTypeCode = selectedStock.ItemTypeCode;

                        details.Qty = 1.0000M;

                        details.PackingUOM2 = details.Qty;
                        // Set the base UOM
                        var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStockId && u.UOMCode == selectedStock.BaseUOM);
                        if (baseUOM != null)
                        {
                            details.UOMId = baseUOM.Id;
                        }
                        // Load Last Price
                        var data = lastSellingPrice.Where(x => x.StockId == selectedStockId).FirstOrDefault();
                        if (data != null)
                        {
                            details.UnitPrice = data.UnitPrice;
                            TransactionHelper(details);
                        }
                        else
                        {
                            details.UnitPrice = 0.00000000M;
                        }
                    }


                }


                // Just trigger state change, don't reload grid
                StateHasChanged();
            }
        }
        else
        {
            // Clear fields if no stock is selected
            details.UnitPrice = 0.00000000M;
            details.StockId = null;
            details.StockLocationId = null;
            details.Description = string.Empty;
            details.Qty = 0.00m;
            details.UOMId = null;
            details.Discount = null;
            details.TaxCodeId = null;
            details.WTaxCode = null;
            details.GLAccountId = null; /// OCTOBER 15, 2026

            details.PackingUOM1 = 0.00M;
            details.PackingUOM2 = 0.00M;
            details.HighestUOM = null;

            details.Amount = 0.00M;
            details.AmountLocal = 0.00M;
            details.DiscountAmount = 0.00M;
            details.DiscountAmountLocal = 0.00M;
            details.NetAmount = 0.00M;
            details.NetAmountLocal = 0.00M;
            details.TaxAmount = 0.00M;
            details.TaxAmountLocal = 0.00M;
            details.SubAmount = 0.00M;
            details.SubAmountLocal = 0.00M;
            details.TaxExclusiveAmount = 0.00M;
