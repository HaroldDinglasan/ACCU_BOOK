    //insert after row
    async Task InsertAfterRow(SalesInvoiceDetails salesInvoicesDetails)
    {
        // If there's an active edit, prevent adding another row until it's saved.
        if (salesInvoiceDetailsToInsert.Any() || salesInvoiceDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!salesInvoiceDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var salesinvoicedetails = new SalesInvoiceDetails();

        //Set QuotationId to new inserted row
        salesinvoicedetails.SalesInvoiceId = Id ?? salesInvoicesHeader.Id;
        salesinvoicedetails.IsTaxInclusive = salesInvoicesHeader.IsTaxInclusive;
        // Assign a sequential Pos for new rows, inserting after the current row's Pos
        salesInvoiceDetailsToInsert.Add(salesinvoicedetails);
        var index = salesInvoiceDetails.IndexOf(salesInvoicesDetails);
        if (index >= 0)
        {
            salesInvoiceDetails.Insert(index + 1, salesinvoicedetails); // Insert after selected row
        }
        else
        {
            salesInvoiceDetails.Add(salesinvoicedetails);
        }

        ResetPosIndexes();

        if (salesInvoicesDetails is not null)
        {
            await salesInvoiceDetailsGrid.InsertAfterRow(salesinvoicedetails, salesInvoicesDetails);
        }
        else
        {
            await salesInvoiceDetailsGrid.InsertRow(salesinvoicedetails);
        }

  
        await salesInvoiceDetailsGrid.Reload();
        StateHasChanged();
    }

    async Task EditRow(SalesInvoiceDetails salesInvoiceDetails)
