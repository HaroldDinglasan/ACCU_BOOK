@page "/StockAssemblyList"
@inject StockItemsService stockItemsService
@attribute [Authorize(Roles = "Admin,User")]
@inject HttpClient http
@inject NavigationManager navManager
@inject ContextMenuService contextMenuService
@inject IJSRuntime JSRuntime

<RadzenStack Gap="0.2rem">

    <RadzenDataGrid @ref="grids" @bind-Value=@selectedStockAssembly
                    RowDoubleClick="() => Edit(selectedStockAssembly.FirstOrDefault().Id)"
                    TItem="StockAssemblyModel"
                    IsLoading=@isLoading Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading"
                    Data="@filteredStockItemsList"
                    AllowVirtualization="true"
                    ColumnWidth="200px"
                    AllowSorting="true"
                    AllowFiltering="true"
                    ShowPagingSummary="true"
                    ShowMultiColumnSortingIndex="true"
                    RowClick="OnRowClick"
                    CellRender="OnRowRender"
                    FilterMode="FilterMode.CheckBoxList"
                    Style="height: 84vh"
                    AllowColumnPicking="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">

        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Style="width: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem;">
                    <RadzenButton Text="New"
                                  Click="@navigate"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Icon="add" />

                    <!-- DIVIDER -->
                    <div style="border-left: 2px solid #ccc; height: 2rem; margin: 0 0.5rem;"></div>

                    <RadzenTextBox Disabled=@(filteredStockItemsList == null)
                                   @bind-Value="@searchText"
                                   Placeholder="Search..."
                                   Style="width:30rem;"
                                   Change="@(args => ApplyFilter())" />

                    <RadzenButton Disabled=@(filteredStockItemsList == null)
                                  Icon="search"
                                  Click="@ApplyFilter"
                                  Text="Find" />

                    <RadzenButton Disabled=@(filteredStockItemsList == null)
                                  Icon="delete"
                                  Click="@ClearFilter"
                                  Text="Clear" />

                    <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />

                </RadzenStack>
            </RadzenStack>

        </HeaderTemplate>

        <Columns>

            <RadzenDataGridColumn Visible=true Width="90px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.AssemblyDate)"
                                  FormatString="{0:d}" Title="Date"
                                  TextAlign="TextAlign.Center" />

            <RadzenDataGridColumn Visible=true Width="120px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.AssemblyCode)"
                                  Title="Assembly #"
                                  TextAlign="TextAlign.Center" />


            <RadzenDataGridColumn Visible=true Width="160px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.StockCode)"
                                  Title="Stock"
                                  TextAlign="TextAlign.Center" />

            <RadzenDataGridColumn TItem="StockAssemblyModel"
                                  Title="Use Standard Unit Cost"
                                  Width="170px"
                                  TextAlign="TextAlign.Center">

                <Template Context="data">
                    <div style="display:flex; justify-content:center;">
                        <RadzenCheckBox TValue="bool?"
                                        Value="@data.UseStandardUnitCost"
                                        Disabled="true" />
                    </div>
                </Template>

            </RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="160px" TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.Description)" Title="Description"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="160px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.BatchNo)"
                                  Title="Batch No"
                                  TextAlign="TextAlign.Center" />

            <RadzenDataGridColumn Visible=true Width="160px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.TotalCost)"
                                  Title="Total Cost"
                                  TextAlign="TextAlign.Center" />


            <RadzenDataGridColumn Visible=true Width="160px" TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.FirstCreatedUser)"
                                  Title="First Created User"
                                  TextAlign="TextAlign.Center" />


            <RadzenDataGridColumn Visible=true Width="160px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.FirstCreatedDate)"
                                  Title="First Created Date"
                                  FormatString="{0:MM/dd/yyyy}"
                                  TextAlign="TextAlign.Center" />



            <RadzenDataGridColumn Visible=true Width="160px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.LastModifiedUser)"
                                  Title="Last Modified User"
                                  TextAlign="TextAlign.Center" />


            <RadzenDataGridColumn Visible=true Width="160px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.LastModifiedDate)"
                                  Title="Last Modified Date"
                                  FormatString="{0:MM/dd/yyyy}"
                                  TextAlign="TextAlign.Center" />


            <RadzenDataGridColumn Visible=true Width="120px"
                                  TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.PrintCount)"
                                  Title="Doc Info Print Count"
                                  TextAlign="TextAlign.Center" />


            <RadzenDataGridColumn Visible=false Width="100px" TItem="StockAssemblyModel"
                                  Property="@nameof(StockAssemblyModel.IsCancelled)" Title="Is Cancelled">
                <Template Context="data">
                    <RadzenCheckBox Disabled="true" TValue="bool?" @bind-Value="@data.IsCancelled"></RadzenCheckBox>
                </Template>
            </RadzenDataGridColumn>

        </Columns>

    </RadzenDataGrid>
</RadzenStack>


@code {
    string status = string.Empty;
    private RadzenDataGrid<StockAssemblyModel> grids;
    private IList<StockAssemblyModel> selectedStockAssembly { get; set; }

    private IEnumerable<StockAssemblyModel> stockAssemblyList { get; set; }

    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    Density density = Density.Compact;
    AlignItems alignItems = AlignItems.Center;
    Variant variant = Variant.Flat;

    bool isLoading;

    protected async override Task OnInitializedAsync()
    {
        await ShowLoading();
        await loadAllData();
    }

    private async Task loadAllData()
    {
        await GetStockAssemblyList();
    }

    private async Task GetStockAssemblyList()
    {
        var data = await stockItemsService.GetStockAssemblyList();

        stockAssemblyList = data is not null
            ? data
            : new List<StockAssemblyModel>();

        filteredStockItemsList = stockAssemblyList; // enable search filter
    }

    protected void Edit(Guid Id)
    {
        navManager.NavigateTo($"/StockAssemblyList/Edit/{Id}");
    }

    private void OnRowClick(DataGridRowMouseEventArgs<StockAssemblyModel> args)
    {
        // set condition for Cancelled
        status = args.Data.IsCancelled == true ? "(Cancelled)"
        : String.Empty;
    }

    private void OnRowRender(DataGridCellRenderEventArgs<StockAssemblyModel> args)
    {
        args.Attributes.Add("style", $"background-color: {(args.Data.IsCancelled == true ? "var(--rz-danger-lighter)" : "")};");
    }

    // DoubleClick Cell Event
    protected void OnCellContextMenu(DataGridCellMouseEventArgs<StockAssemblyModel> stockItems)
    {
        selectedStockAssembly = new List<StockAssemblyModel>() { stockItems.Data };

        var contextMenuItems = new List<ContextMenuItem>
        {
            new ContextMenuItem() { Text = "New", Value = 1, Icon = "add" },
            new ContextMenuItem() { Text = "Edit", Value = 2, Icon = "edit" },
            new ContextMenuItem() { Text = "Delete", Value = 3, Icon = "delete" }
        };

        contextMenuService.Open(stockItems, contextMenuItems, (e) =>
        {
            switch (e.Value)
            {
                case 1:
                    navigate();
                    break;
                case 2:
                    Edit(stockItems.Data.Id);
                    break;
                case 3:
                    // Delete(stockItems.Data.Id);
                    break;

            }
            contextMenuService.Close();

        });
    }

    private void navigate()
    {
        navManager.NavigateTo("/StockAssembly");
    }

    private string searchText = string.Empty;
    private IEnumerable<StockAssemblyModel> filteredStockItemsList;
    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredStockItemsList = stockAssemblyList;
        }
        else
        {
            string search = searchText.Trim();

            filteredStockItemsList = stockAssemblyList.Where(x =>
                // Date search
                x.AssemblyDate.ToString("MM/dd/yyyy")
                    .Contains(search, StringComparison.OrdinalIgnoreCase) ||

                x.AssemblyDate.ToString("M/d/yyyy")
                    .Contains(search, StringComparison.OrdinalIgnoreCase) ||

                x.AssemblyDate.ToString("MM/yyyy")
                    .Contains(search, StringComparison.OrdinalIgnoreCase) ||

                x.AssemblyDate.ToString("M/yyyy")
                    .Contains(search, StringComparison.OrdinalIgnoreCase) ||

                (!string.IsNullOrEmpty(x.AssemblyCode) && x.AssemblyCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

                (!string.IsNullOrEmpty(x.Description) && x.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase))

            );
        }
        StateHasChanged();
    }

    private void ClearFilter()
    {
        searchText = string.Empty;
        filteredStockItemsList = stockAssemblyList;
        StateHasChanged();
    }

    async Task ShowLoading()
    {
        await Task.Yield();

        isLoading = false;
    }

}
