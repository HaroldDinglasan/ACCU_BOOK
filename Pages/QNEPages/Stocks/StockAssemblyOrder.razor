    // JUNE 17, 2026
    protected void InitializeStockAssemblyOrderRows()
    {
        // Initialize with 5 rows and set default Pos index
        stockAssemblyOrderDetails = Enumerable.Range(1, 5)
            .Select(i => new StockAssemblyOrderDetail
            {
                Id = Guid.NewGuid(),
                Pos = i,
                StockAssemblyOrderId = Id ?? stockassemblyordermodel.Id,
            })
            .ToList();

        RecalculateTotalCost();
    }

    // JUNE 17, 2026
    async Task InsertAfterRow(StockAssemblyOrderDetail currentRow)
    {
        if (stockassemblyorderDetailsToInsert.Any() || stockassemblyorderDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService,
                "Unsaved Details",
                "Save current row first.");
            return;
        }

        var newRow = new StockAssemblyOrderDetail
        {
            Id = Guid.NewGuid(),
            StockAssemblyOrderId = Id ?? stockassemblyordermodel.Id,
            Pos = currentRow?.Pos + 1 ?? 1
        };

        // 🔥 IMPORTANT: insert into actual grid source
        if (currentRow != null)
        {
            var index = stockAssemblyOrderDetails.IndexOf(currentRow);

            if (index >= 0)
                stockAssemblyOrderDetails.Insert(index + 1, newRow);
            else
                stockAssemblyOrderDetails.Add(newRow);
        }
        else
        {
            stockAssemblyOrderDetails.Add(newRow);
        }

        stockassemblyorderDetailsToInsert.Add(newRow);

        await stockadassemblyorderDetailsGrid.Reload();

        // ADDED 10/02/2026
        stockbatchnumbercode = string.Empty;

        await stockadassemblyorderDetailsGrid.EditRow(newRow);

        StateHasChanged();

    }

    // JUNE 17, 2026
    async Task EditRow(StockAssemblyOrderDetail stockassemblyorderDetails)
    {
        if (!stockadassemblyorderDetailsGrid.IsValid)
            return;

        if (stockassemblyorderDetails.UnitCost == null)
        {
            stockassemblyorderDetails.UnitCost = 0.0000m;
        }

        bool anotherRowActive =
            stockassemblyorderDetailsToInsert.Any(x => x != stockassemblyorderDetails) ||
            stockassemblyorderDetailsToUpdate.Any(x => x != stockassemblyorderDetails);

        if (anotherRowActive)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Unsaved Row",
                Detail = "Please save or cancel the current active row before editing another."
            });
            return;
        }

        if (!stockassemblyorderDetailsToUpdate.Contains(stockassemblyorderDetails))
        {
            stockassemblyorderDetailsToUpdate.Add(stockassemblyorderDetails);
        }

        // ADDED 10/02/2026
        stockbatchnumbercode = GetBatchNo(stockassemblyorderDetails.StockBatchNumberId);

        await stockadassemblyorderDetailsGrid.EditRow(stockassemblyorderDetails);
        StateHasChanged();
    }

    void CancelEdit(StockAssemblyOrderDetail stockassemblyorderDetails)
    {
        // If it's a new row that was cancelled, remove it from the list
        if (stockassemblyorderDetailsToInsert.Contains(stockassemblyorderDetails))
        {
            stockAssemblyOrderDetails.Remove(stockassemblyorderDetails);
        }
        Reset(stockassemblyorderDetails);

        stockadassemblyorderDetailsGrid.CancelEditRow(stockassemblyorderDetails);
        // Reload the grid to reflect the removal of a new cancelled row or revert changes visually
        stockadassemblyorderDetailsGrid.Reload();
        StateHasChanged();

    }

    async Task SaveRow(StockAssemblyOrderDetail stockassemblyorderDetails)
    {
        // This method is called when the user clicks the 'Save' (checkmark) button for a row in the grid.
        await stockadassemblyorderDetailsGrid.UpdateRow(stockassemblyorderDetails);
        await stockadassemblyorderDetailsGrid.Reload();
        RecalculateTotalCost();
        StateHasChanged();
    }

    void Reset(StockAssemblyOrderDetail stockassemblyorderDetails)
    {
        stockassemblyorderDetailsToInsert.Remove(stockassemblyorderDetails);
        stockassemblyorderDetailsToUpdate.Remove(stockassemblyorderDetails);
    }

    void Reset()
    {
        stockassemblyorderDetailsToInsert.Clear();
        stockassemblyorderDetailsToUpdate.Clear();
    }

    async Task DeleteRow(StockAssemblyOrderDetail stockassemblyorderDetails)
    {
        Reset(stockassemblyorderDetails);
        stockAssemblyOrderDetails.Remove(stockassemblyorderDetails);
        ResetPosIndexes();

        await stockadassemblyorderDetailsGrid.Reload();
        RecalculateTotalCost();
        StateHasChanged();
    }

    protected async Task RefreshGrid()
    {
        // Refresh the grid
        await stockadassemblyorderDetailsGrid.Reload();
    }

    // Recalculates Header Total Cost = SUM(Qty * UnitCost) across all detail rows
    protected void RecalculateTotalCost()
    {
        stockassemblyordermodel.TotalCost = stockAssemblyOrderDetails
            .Sum(d => (d.Qty ?? 0) * (d.UnitCost ?? 0));

        StateHasChanged();
    }


