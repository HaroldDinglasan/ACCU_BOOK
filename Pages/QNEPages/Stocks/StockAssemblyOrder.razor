    // SAVE HEADER AND DETAILS
    private async Task OnSubmit()
    {
        busy = true;

        // SAVING
        if (stockassemblyorderDetailsToInsert.Any() || stockassemblyorderDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details,", "Please click the 'Save' (checkmark) button");
            busy = false;
            return;
        }

        // ADDED — save new/edited batch numbers (header + details) actually used
        // ADDED 10/02/2026
        var usedBatchIds = stockAssemblyOrderDetails
            .Where(d => d.StockBatchNumberId != null)
            .Select(d => d.StockBatchNumberId!.Value)
            .ToHashSet();

        if (stockassemblyordermodel.StockBatchNumberId != null)
            usedBatchIds.Add(stockassemblyordermodel.StockBatchNumberId.Value);

        
        var batchesToSave = pendingBatchNumbers.Where(b => usedBatchIds.Contains(b.Id)).ToList();

        if (batchesToSave.Any())
        {
            var batchResult = await stockItemsService.SaveStockBatchNumbers(batchesToSave);

            if (batchResult.StartsWith("Error"))
            {
                await DialogService.Alert(batchResult);
                busy = false;
                return;
            }

            pendingBatchNumbers.RemoveAll(b => usedBatchIds.Contains(b.Id));
        }

        var data = await stockItemsService.SaveStockAssemblyOrderHeader(stockassemblyordermodel);

        if (data is not null)
        {
            if (data.Contains("Success"))
            {
                // ASSIGN HEADER ID
                foreach (var item in stockAssemblyOrderDetails)
                {
                    item.StockAssemblyOrderId = stockassemblyordermodel.Id;
                }

                var datadetails = await stockItemsService.SaveStockAssemblyOrderDetails(stockAssemblyOrderDetails);

                btnDiseabled = true;

                busy = false;

                await DialogService.Alert(data);
            }
            else
            {
                await DialogService.Alert(data);
                btnDiseabled = false;
                busy = false;
            }
        }
    }


