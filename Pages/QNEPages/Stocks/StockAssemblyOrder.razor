    private async Task OnStockChanged(object stockId, StockAssemblyOrderDetail stockassemblyorderdetails)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);

            if (selectedStock != null)
            {
                IsDisable = false;

                // ADDED 10/02/2026
                stockassemblyorderdetails.StockBatchNumberId = null;
                stockbatchnumbercode = string.Empty;

                // Populate Description
                stockassemblyorderdetails.Description = selectedStock.StockName;

                if (selectedStock.ItemTypeCode is "T" or "D")
                {
                    stockassemblyorderdetails.Qty = 0.00m;
                }
                else
                {
                    stockassemblyorderdetails.Qty = 1.00m;
                }

                // Set the base UOM
                var baseUOM = uomsList?
                    .FirstOrDefault(u =>
                        u.StockId == selectedStockId &&
                        u.UOMCode == selectedStock.BaseUOM);
                if (baseUOM != null)
                {
                    stockassemblyorderdetails.UOMId = baseUOM.Id;
                }

                // Auto fill Location when selecting stock code
                if (selectedStock.DefaultLocationId != null)
                {
                    stockassemblyorderdetails.StockLocationId = selectedStock.DefaultLocationId;
                }

                // Auto fill Unit Cost from most recent Stock In Details Price
                stockassemblyorderdetails.UnitCost = await stockItemsService.GetLatestUnitCostStockInDetails(selectedStockId);

                // ADDED SEPT 4, 2026
                RecalculateTotalCost();

                // ADDED - opens Stock In create form; Cancel opens Stock Out select grid
                // ADDED 10/02/2026
                await OpenDetailBatchDialog(selectedStockId, stockassemblyorderdetails, "AutoChain");

                // Just trigger state change, don't reload grid
                StateHasChanged();
            }
        }
        else
        {
            IsDisable = true;

            // Clear fields if no stock is selected
            stockassemblyorderdetails.Description = string.Empty;
            stockassemblyorderdetails.Qty = 0;
            stockassemblyorderdetails.UOMId = null;
            stockassemblyorderdetails.UnitCost = null;

            RecalculateTotalCost();

            StateHasChanged();
        }
    }

    private async Task OnBOMChanged(object value)
    {
        // AUTO FILL LOCATION FROM THE SELECTED BOM (same as QNE)
        // ADDED 10/02/2026
        if (value is Guid selectedBomId)
        {
            var selectedBOM = stockBOMList?.FirstOrDefault(b => b.Id == selectedBomId);

            if (selectedBOM?.StockLocationId != null)
            {
                stockassemblyordermodel.StockLocationId = selectedBOM.StockLocationId;
            }
        }

        if (stockassemblyorderDetailsToInsert.Any() || stockassemblyorderDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details",
                "Please save or cancel the current row before selecting a BOM.");
            return;
        }

        if (value is Guid bomId)
        {
            var bomDetails = await stockItemsService.GetStockBOMDetailsByIdSAO(bomId.ToString());

            if (bomDetails != null && bomDetails.Any())
            {
                stockAssemblyOrderDetails = bomDetails
                    .OrderBy(d => d.Pos)
                    .Select((detail, index) => new StockAssemblyOrderDetail
                    {
                        Id = Guid.NewGuid(),
                        StockAssemblyOrderId = Id ?? stockassemblyordermodel.Id,
                        Pos = index + 1,
                        StockId = detail.StockId,
                        Description = !string.IsNullOrWhiteSpace(detail.Description)
                            ? detail.Description
                            : stockList?.FirstOrDefault(s => s.Id == detail.StockId)?.StockName,
                        UOMId = detail.UOMId,
                        Qty = detail.Qty,
                        UnitCost = detail.UnitCost,
                        StockLocationId = detail.StockLocationId
                    })
                    .ToList();

                // ADDDED - rows came from a BOM and already have selected,
                // so fields (including Batch No) should be editable
                // ADDED 10/02/2026
                IsDisable = false;
            }
            else
            {
                // No BOM details found — fall back to blank rows
                InitializeStockAssemblyOrderRows();
                IsDisable = false;
            }
        }
        else
        {
            // BOM cleared
            InitializeStockAssemblyOrderRows();
        }

        Reset(); // clears stockassemblyorderDetailsToInsert / ToUpdate

        if (stockadassemblyorderDetailsGrid != null)
        {
            await stockadassemblyorderDetailsGrid.Reload();
        }

        RecalculateTotalCost();

        StateHasChanged();
    }

