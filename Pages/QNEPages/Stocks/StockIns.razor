    // Put the batch in the local list (so it shows in the grid/popup) and in the pending list (saved on Save)
    @*MODIFIED 09/28/2026 *@
    private bool ApplyBatch(StockBatchNumbersModel batch)
    {
        var duplicate = stockbatchnumberList.Any(b =>
            b.Id != batch.Id &&
            b.StockId == batch.StockId &&
            string.Equals(b.BatchNo?.Trim(), batch.BatchNo?.Trim(), StringComparison.OrdinalIgnoreCase));

        if (duplicate)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Batch No",
                Detail = $"Batch No '{batch.BatchNo}' already exists for this stock."
            });
            return false;
        }

        Upsert(stockbatchnumberList, batch);
        Upsert(pendingBatchNumbers, batch);
        return true;
    }

    @*MODIFIED 09/28/2026 *@
    private static void Upsert(List<StockBatchNumbersModel> list, StockBatchNumbersModel batch)
    {
        var i = list.FindIndex(b => b.Id == batch.Id);
        if (i >= 0) list[i] = batch; else list.Add(batch);
    }

    private string GetBatchNo(Guid? batchId) =>
    batchId == null ? string.Empty
    : stockbatchnumberList?.FirstOrDefault(b => b.Id == batchId)?.BatchNo ?? string.Empty;


    // SAVE HEADER AND DETAILS
    private async Task OnSubmit()
    {
        if (btnDiseabled) return; // already saved

        busy = true;

        // COMPUTE TOTAL AMOUNT
        stockInsmodel.TotalAmount = TotalAmount;

        // SAVING
        if (stockinDetailsToInsert.Any() || stockinDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details,", "Please click the 'Save' (checkmark) button");
            busy = false;
            return;
        }

        // SAVE NEW / EDITED BATCH NUMBERS (only the ones used in the details)
        // ADDED 09/28/2026
        var usedBatchIds = stockInsDetails
            .Where(d => d.StockBatchNumberId != null)
            .Select(d => d.StockBatchNumberId!.Value)
            .ToHashSet();

        var batchesToSave = pendingBatchNumbers.Where(b => usedBatchIds.Contains(b.Id)).ToList();

        if (batchesToSave.Any())
        {
            var batchResult = await stockItemsService.SaveStockBatchNumbers(batchesToSave);

            if (batchResult.StartsWith("Error"))
            {
                await DialogService.Alert(batchResult);
                busy = false;
                return;
            }

            pendingBatchNumbers.RemoveAll(b => usedBatchIds.Contains(b.Id));
        }

        // JUNE 18, 2026
        var data = await stockItemsService.SaveStockInsHeader(stockInsmodel);

        if (data is not null)
        {
            if (data.Contains("Success"))
            {
                // ASSIGN HEADER ID
                foreach (var item in stockInsDetails)
                {
                    item.StockInId = stockInsmodel.Id;
                }

                var datadetails = await stockItemsService.SaveStockInDetails(stockInsDetails);

                // New: sync ledger
                var txResult = await stockItemsService.SaveStockInTransactions(stockInsmodel, stockInsDetails);

                if (txResult.StartsWith("Error"))
                {
                    await DialogService.Alert(txResult);
                }

                btnDiseabled = true;   // Save disabled, New appears
                busy = false;

                await DialogService.Alert(data);
            }
            else
            {
                await DialogService.Alert(data);
                btnDiseabled = false;
                busy = false;           // header save returned null
            }
        }
    }

