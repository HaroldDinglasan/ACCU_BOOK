@* FOR TRANSFER MODAL *@
<RadzenPopup @ref=popuptransfer Lazy=true class="popuptransfer">

    <div class="pt-header">
        <RadzenIcon Icon="compare_arrows" class="pt-header-icon" />
        <span>Transfer from Stock Out</span>
        <span class="pt-count">@(filteredStockOutTransferList?.Count() ?? 0) records</span>
    </div>

    <div class="pt-toolbar">
        <RadzenTextBox Disabled=@(filteredStockOutTransferList == null) @bind-Value="@searchText"
                       Placeholder="Search Stock Out #..."
                       Style="font-size:smaller; width:24rem;"
                       Change="@(args => ApplyFilter())" />
        <RadzenButton Disabled=@(filteredStockOutTransferList == null) Icon="search" Click="@ApplyFilter" Text="Find" Size="ButtonSize.Small" />
        <RadzenButton Disabled=@(filteredStockOutTransferList == null) Icon="close" Click="@ClearFilter" Text="Clear"
                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
    </div>

    <RadzenDataGrid @ref="transferGrid" @bind-Value=@selectedStockOutTransferList SelectionMode="DataGridSelectionMode.Multiple" TItem="StockOutTransferList"
                    IsLoading=@isloading Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading"
                    AllowColumnReorder="true" AllowAlternatingRows="false" ColumnWidth="200px"
                    Data="@filteredStockOutTransferList" AllowColumnPicking="true" Style="height: 55vh"
                    KeyProperty="Id" PagerHorizontalAlign="HorizontalAlign.Center" AllowColumnResize="true" Density="@density"
                    AllowVirtualization="true"
                    AllowSorting="true" AllowFiltering="true"
                    FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="@filter" LogicalFilterOperator="LogicalFilterOperator.Or"
                    class="pt-grid">
        <Columns>
            <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false">
                <HeaderTemplate>
                    <RadzenCheckBox TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select all items" } })"
                                    Value="@(selectedStockOutTransferList == null || selectedStockOutTransferList?.Any() != true ? false : !filteredStockOutTransferList.All(i => selectedStockOutTransferList.Select(e => e.Id).Contains(i.Id)) ? null : filteredStockOutTransferList.Any(i => selectedStockOutTransferList.Select(e => e.Id).Contains(i.Id)))"
                                    Change="@(args => selectedStockOutTransferList = args == true ? (selectedStockOutTransferList ?? Enumerable.Empty<StockOutTransferList>()).Union(filteredStockOutTransferList.Where(i => !(selectedStockOutTransferList ?? Enumerable.Empty<StockOutTransferList>()).Select(e => e.Id).Contains(i.Id))).ToList() : null)" />
                </HeaderTemplate>
                <Template Context="data">
                    <RadzenCheckBox TriState="false" Value="@(selectedStockOutTransferList != null && selectedStockOutTransferList.Select(e => e.Id).Contains(data.Id))" TValue="bool" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Property="StockOutDate" Title="Date" FormatString="{0:MM/dd/yyyy}" Width="130px" />

            <RadzenDataGridColumn Property="StockOutCode" Title="Stock Out #" Width="130px">
                <Template Context="row">
                    <span class="pt-code-chip">@row.StockOutCode</span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn Property="Description" Title="Description" />
            <RadzenDataGridColumn Property="ReferenceNo" Title="Ref #" Width="130px" />

            <RadzenDataGridColumn Property="TotalAmount" Title="Total Amount" Width="130px"
                                  TextAlign="TextAlign.Right" FormatString="{0:N2}" />

            <RadzenDataGridColumn Property="FullName" Title="First Created User" Width="150px" />
            <RadzenDataGridColumn Property="LastModifiedUser" Title="Last Modified User" Width="150px" />
            <RadzenDataGridColumn Property="FirstCreatedDate" Title="First Created Date" FormatString="{0:MM/dd/yyyy}" Width="130px" />
            <RadzenDataGridColumn Property="LastModifiedDate" Title="Last Modified Date" FormatString="{0:MM/dd/yyyy}" Width="130px" />
            <RadzenDataGridColumn Property="PrintCount" Title="Doc Info Print" Width="130px" />
        </Columns>
    </RadzenDataGrid>

    <div class="pt-footer">
        <div class="pt-selected">
            <RadzenIcon Icon="check_circle" Style="font-size:16px" />
            <span>@(selectedStockOutTransferList?.Count ?? 0) selected</span>
        </div>
        <div class="pt-actions">
            <RadzenButton Icon="check" Click=@OnOkClicked Text="Ok" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Disabled="@(selectedStockOutTransferList == null || selectedStockOutTransferList.Count == 0)" />
            <RadzenButton Icon="cancel" Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="async args => { await popuptransfer.CloseAsync(); }" />
        </div>
    </div>

</RadzenPopup>

