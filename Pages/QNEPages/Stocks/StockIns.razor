    private async Task OnStockChanged(object stockId, StockInDetailsModel stockindetails)
    {
        if (stockId is not Guid selectedStockId)
        {
            IsDisable = true;
            stockindetails.Description = string.Empty;
            stockindetails.Qty = 0;
            stockindetails.UOMId = null;
            stockindetails.StockLocationId = null; // Dinagdag
            return;
        }

        var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);
        if (selectedStock == null) return;

        IsDisable = false;

        // ADDED 09/28/2026
        stockindetails.StockBatchNumberId = null;
        stockbatchnumbercode = string.Empty;

        // Populate fields
        stockindetails.StockId = selectedStockId;
        stockindetails.Description = selectedStock.StockName;
        stockindetails.ItemTypeCode = selectedStock.ItemTypeCode;

        // Auto set Project from Header
        if (stockInsmodel.ProjectId.HasValue)
        {
            stockindetails.ProjectId = stockInsmodel.ProjectId.Value;
        }

        stockindetails.Qty = selectedStock.ItemTypeCode is "T" or "D" ? 0.00m : 1.00m;

        // Auto set Location: header location first, then fall back to the stock's default location
        if (stockInsmodel.StockLocationId.HasValue)
        {
            stockindetails.StockLocationId = stockInsmodel.StockLocationId.Value;
        }
        else if (selectedStock.DefaultLocationId.HasValue)
        {
            stockindetails.StockLocationId = selectedStock.DefaultLocationId.Value;
        }

        var baseUOM = uomsList?.FirstOrDefault(
            u => u.StockId == selectedStockId &&
            u.UOMCode == selectedStock.BaseUOM);

        if (baseUOM != null)
            stockindetails.UOMId = baseUOM.Id;

        // AUTO POPULATE UNIT PRICE
        var latestUnitPrice = await stockItemsService.GetLatestUnitPrice(selectedStockId);

        stockindetails.UnitPrice = latestUnitPrice ?? 0;

        stockindetails.Price = stockindetails.UnitPrice;

        StockTransactionNumberHelper.Compute(stockindetails);

        // OPEN BATCH MODAL
        if (ShouldOpenBatchDialog(selectedStock))
        {
            await OpenStockBatchDialog(selectedStockId, stockindetails);
        }

        StateHasChanged();
    }

