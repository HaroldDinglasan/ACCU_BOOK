    // HELPER METHOD TO OPEN STOCK BACTH NO IN OUT
    private bool ShouldOpenBatchDialog(Stocks stock)
    {
        if (stock == null || string.IsNullOrWhiteSpace(stock.StockCode))
            return false;

        var code = stock.StockCode.Trim().ToUpper();

        // If stock code starts with IM or SC → The modal will not open
        if (code.StartsWith("IM") || code.StartsWith("SC"))
            return false;

        return true;
    }

    @*MODIFIED 09/28/2026 *@
    private async Task OpenStockBatchDialog(Guid stockId, StockInDetailsModel detail, StockBatchNumbersModel? existing = null)
    {
        var parameters = new Dictionary<string, object>
        {
            { "StockId", stockId },
            { "StockInDetailsModel", detail }
        };
        if (existing != null)
            parameters.Add("ExistingBatch", existing);

        var result = await DialogService.OpenAsync<StockBatchNoInModal>(
            existing == null ? "New Batch No" : "Edit Batch No",
            parameters,
            new DialogOptions
            {
                Width = "900px",
                Height = "600px",
                Resizable = true,
                Draggable = true,
                CloseDialogOnOverlayClick = false
            });

        if (result is StockBatchNumbersModel batch && ApplyBatch(batch))
        {
            detail.StockBatchNumberId = batch.Id;
            stockbatchnumbercode = batch.BatchNo;
        }

        StateHasChanged();
    }

