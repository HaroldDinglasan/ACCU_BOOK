    // JUNE 17, 2026
    async Task InsertAfterRow(StockInDetailsModel currentRow)
    {
        if (stockinDetailsToInsert.Any() || stockinDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService,
                "Unsaved Details",
                "Save current row first.");
            return;
        }

        var newRow = new StockInDetailsModel

        {
            Id = Guid.NewGuid(),
            StockInId = Id ?? stockInsmodel.Id,
            Pos = currentRow?.Pos + 1 ?? 1
        };

        // 🔥 IMPORTANT: insert into actual grid source
        if (currentRow != null)
        {
            var index = stockInsDetails.IndexOf(currentRow);

            if (index >= 0)
                stockInsDetails.Insert(index + 1, newRow);
            else
                stockInsDetails.Add(newRow);
        }
        else
        {
            stockInsDetails.Add(newRow);
        }

        stockinDetailsToInsert.Add(newRow);

        await stockinsDetailsGrid.Reload();

        // ADDED 09/28/2026
        stockbatchnumbercode = string.Empty;
        batchSearchText = string.Empty;
        await stockinsDetailsGrid.EditRow(newRow);

        StateHasChanged();

    }

    // JUNE 17, 2026
    async Task EditRow(StockInDetailsModel stockinDetails)
    {
        if (!stockinsDetailsGrid.IsValid)
            return;

        bool anotherRowActive =
            stockinDetailsToInsert.Any(x => x != stockinDetails) ||
            stockinDetailsToUpdate.Any(x => x != stockinDetails);

        if (anotherRowActive)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Unsaved Row",
                Detail = "Please save or cancel the current active row before editing another."
            });
            return;
        }

        if (!stockinDetailsToUpdate.Contains(stockinDetails))
        {
            stockinDetailsToUpdate.Add(stockinDetails);
        }

        // ADDED 09/28/2026
        stockbatchnumbercode = GetBatchNo(stockinDetails.StockBatchNumberId);
        batchSearchText = string.Empty;

        await stockinsDetailsGrid.EditRow(stockinDetails);
        StateHasChanged();
    }

    void CancelEdit(StockInDetailsModel stockinDetails)
    {
        // If it's a new row that was cancelled, remove it from the list
        if (stockinDetailsToInsert.Contains(stockinDetails))
        {
            stockInsDetails.Remove(stockinDetails);
        }
        Reset(stockinDetails);

        stockinsDetailsGrid.CancelEditRow(stockinDetails);
        // Reload the grid to reflect the removal of a new cancelled row or revert changes visually
        stockinsDetailsGrid.Reload();
        StateHasChanged();
    }

    async Task SaveRow(StockInDetailsModel stockinDetails)
    {
        // This method is called when the user clicks the 'Save' (checkmark) button for a row in the grid.
        await stockinsDetailsGrid.UpdateRow(stockinDetails);
        await stockinsDetailsGrid.Reload();
        StateHasChanged();
    }

    void Reset(StockInDetailsModel stockinDetails)
    {
        stockinDetailsToInsert.Remove(stockinDetails);
        stockinDetailsToUpdate.Remove(stockinDetails);
    }

    void Reset()
    {
        stockinDetailsToInsert.Clear();
        stockinDetailsToUpdate.Clear();
    }

    async Task DeleteRow(StockInDetailsModel stockinDetails)
    {
        Reset(stockinDetails);
        stockInsDetails.Remove(stockinDetails);

        ResetPosIndexes();

        await stockinsDetailsGrid.Reload();
        StateHasChanged();
    }

