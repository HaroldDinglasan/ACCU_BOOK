@page "/StockIns"
@page "/StockIns/{RunningNumberId:int}"
@page "/StockInsList/Edit/{id:guid}"

@using Accounting_V4.Dialog.Stocks
@using Radzen.Blazor.Rendering
@attribute [Authorize(Roles = "Admin,User")]
@inject HttpClient http
@inject NavigationManager navManager
@inject NotificationService notificationService
@inject IJSRuntime JSRuntime

@if (isloading)
{
    <Spinner />
}
<RadzenTemplateForm TItem="StockInsModel" Data="stockInsmodel" Submit="@OnSubmit" InvalidSubmit="@OnInvalidSubmit">
    <RadzenStack Gap="0.2rem">
        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="5">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        @*MODIFIED 09/28/2026*@
                        <RadzenButton Size="@smallbtn" Icon="save" BusyText="Saving..." IsBusy=@busy
                                      Disabled="@btnDiseabled"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Text="@btnText"
                                      ButtonType="@Radzen.ButtonType.Submit" />

                        <RadzenButton Text="Transfer" Size="@smallbtn" ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@btnDiseabled"
                                      @ref="@transferbutton"
                                      Icon="compare_arrows"
                                      Click="@(args => popuptransfer.ToggleAsync(transferbutton.Element))" />

                        <RadzenButton Visible="@btnDiseabled" Text="New" Icon="add" Size="@smallbtn"
                                      ButtonStyle="ButtonStyle.Success"
                                      ButtonType="@Radzen.ButtonType.Button"
                                      Click="@OnNew" />

                    </RadzenStack>

                </RadzenColumn>
                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Seach" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenCard>

            <div style="margin-bottom: 0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        Stock Ins <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                    </RadzenStack>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="info" Click="@OpenDocumentInfoDialog"></RadzenButton>
                </RadzenStack>
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Details">
                        <RadzenRow>
                            <!-- LEFT SIDE -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">

                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value=@stockInsmodel.StockLocationId
                                                                        Change="@OnHeaderLocationChanged"
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize=10
                                                                        Data="@stocklocationList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data">
                                                                <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                                            </Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>


                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@stockInsmodel.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">

                                            <RadzenFormField Style="width:100%" Text="Description" AllowFloatingLabel="false">
                                                <RadzenAutoComplete Style="width:100%"
                                                                    Data="@stocklocationList"
                                                                    TextProperty="LocationCode"
                                                                    @bind-Value="stockInsmodel.Description"
                                                                    Placeholder="Select or type description..."
                                                                    AllowCustom="true"
                                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <!-- RIGHT SIDE -->
                            <RadzenColumn Size="12" SizeMD="6" Style="text-align:right">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetStockInsNo"
                                                                  @bind-Value="@stockInsmodel.StockInDate"
                                                                  DateFormat="MM/dd/yyyy"
                                                                  Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" Style="display:flex; align-items:center;">
                                            <RadzenFormField Style="flex:1" Text="Stock In #" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockInsmodel.StockInCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="margin-left:5px" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@OpenRunningNumberModal" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockInsmodel.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Others">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Title 1" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenTextBox class="@redtext" @bind-Value=@stockInsmodel.Title Style="width: 100%;" />
                                                </RadzenStack>
                                            </RadzenFormField>

                                            <RadzenFormField Style="width:100%" Text="Title 2" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenTextBox class="@redtext" @bind-Value=@stockInsmodel.Title2 Style="width: 100%;" />
                                                </RadzenStack>
                                            </RadzenFormField>

                                            <RadzenColumn Size="12" SizeMD="12">
                                                <RadzenFormField Style="width:100%" Text="Transfer From" AllowFloatingLabel="false">
                                                    <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@stockInsmodel.TransferFromInfo Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>

                                        </RadzenColumn>
                                    </RadzenRow>


                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockInsmodel.Ref1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockInsmodel.Ref2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockInsmodel.Remark1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockInsmodel.Remark2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Notes">
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenTextArea @bind-Value=@stockInsmodel.Notes
                                                            Rows="10"
                                                            Style="width:100%"
                                                            class="@redtext"
                                                            aria-label="TextArea" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    @* <RadzenTabsItem Text="Info">
                        @documentInfo.Id
                        @documentInfo.DocumentId
                        @documentInfo.DocType
                    </RadzenTabsItem> *@

                </Tabs>
            </RadzenTabs>

            @* TABLE DETAILS*@
            <br />
            <RadzenDataGrid EditMode="@editMode" @ref="stockinsDetailsGrid"
                            Style="width: 100%; height:45vh; font-size:12px;"
                            AllowVirtualization="true"
                            Data="@stockInsDetails"
                            KeyProperty="Id"
                            AllowColumnResize=true
                            RowCreate="@OnCreateRow"
                            TItem="StockInDetailsModel"
                            Density="@density"
                            RowUpdate="@OnUpdateRow">

                @*JUNE 17 2026*@
                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New" Size="ButtonSize.ExtraSmall" Click="@(() => InsertAfterRow(stockInsDetails.LastOrDefault()))" title="Add new row after this row" Disabled="@(stockinDetailsToInsert.Any() || stockinDetailsToUpdate.Any())" />
                </HeaderTemplate>

                <Columns>

                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="stockindetails">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => EditRow(stockindetails))" title="Edit this row" />

                        </Template>
                        <EditTemplate Context="stockindetails">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(stockindetails))" title="Save" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible=false Width="4rem" TItem="StockInDetailsModel" Property="@nameof(StockInDetailsModel.Pos)" Title="Pos" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn Width="9rem" TItem="StockInDetailsModel" Property="@nameof(StockInDetailsModel.StockId)" Title="Stock Code" TextAlign="TextAlign.Center">
                        <Template Context="stockindetails">
                            @{
                                var stock = stockList?.FirstOrDefault(s => s.Id == stockindetails.StockId);
                            }
                            @stock?.StockCode
                        </Template>
                        <EditTemplate Context="stockindetails">
                            <RadzenDropDownDataGrid @bind-Value="stockindetails.StockId"
                                                    Change="@(args => OnStockChanged(args, stockindetails))"
                                                    Style="width: 100%; font-size:12px"
                                                    PageSize="10"
                                                    Data="@stockList"
                                                    AllowVirtualization="true"
                                                    AllowColumnResize="true"
                                                    AllowClear="true"
                                                    AllowSorting="false"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="StockCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="StockCode" Title="Stock #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="StockName" Title="StockName" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="10rem" TItem="StockInDetailsModel" Property="@nameof(StockInDetailsModel.Description)" Title="Description" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockindetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width: 100%; font-size:12px" @bind-Value="stockindetails.Description"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockInDetailsModel" Property="@nameof(StockInDetailsModel.SerialNumber)" Title="Serial No" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockindetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width: 100%; font-size:12px" @bind-Value="stockindetails.SerialNumber"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    @* BATCH NO DROPDOWN *@
                    <RadzenDataGridColumn Width="160px" TItem="StockInDetailsModel" Property="@nameof(StockInDetailsModel.StockBatchNumberId)" Title="Batch No" TextAlign="TextAlign.Center">
                        <Template Context="stockindetails">
                            @{
                                var batchcode = stockbatchnumberList?.FirstOrDefault(t => t.Id == stockindetails.StockBatchNumberId);
                            }
                            @batchcode?.BatchNo
                        </Template>
                        <EditTemplate Context="stockindetails">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                                <RadzenTextBox @ref="textBox" Value="@stockbatchnumbercode" Style="width: 100%; font-size:12px"
                                               @oninput="@(args => OnInput(args, stockindetails))"
                                               @onclick="@(args => batchnumberpopup.ToggleAsync(textBox.Element))" />

                                <RadzenPopup @ref=batchnumberpopup id="batchnumberpopup" AutoFocusFirstElement="false" class="batchnumber-popup">

                                    @*MODIFIED 09/28/2026 *@
                                    <RadzenDataGrid @ref=stockbatchnumbergrid id="stockbatchnumbergrid"
                                                    RowSelect="@(item => OnRowSelect(item, stockindetails))"
                                                    Density="Density.Compact"
                                                    TItem="StockBatchNumbersModel"
                                                    Data="@GetBatchNumberForStock(stockindetails.StockId)"
                                                    AllowSorting="true" Style="height:360px">

                                        <HeaderTemplate>
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                                <span>Stock Batch Numbers</span>
                                                <RadzenButton Icon="add" Text="New" Size="ButtonSize.ExtraSmall"
                                                              ButtonStyle="ButtonStyle.Success"
                                                              Click="@(() => NewBatch(stockindetails))" />
                                            </RadzenStack>
                                        </HeaderTemplate>

                                        <EmptyTemplate>
                                            <p class="rz-m-4">No batch numbers for this stock yet. Click <b>New</b> to create one.</p>
                                        </EmptyTemplate>

                                        <Columns>
                                            <RadzenDataGridColumn Width="45px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                                <Template Context="batch">
                                                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                                  ButtonStyle="ButtonStyle.Secondary" title="Edit batch"
                                                                  Click="@(args => EditBatch(batch, stockindetails))"
                                                                  @onclick:stopPropagation="true" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn Property="BatchNo" Width="75px" Title="Batch #" />
                                            <RadzenDataGridColumn Property="Description" Width="160px" Title="Description" />
                                            <RadzenDataGridColumn Property="BatchNoManufacturingDate" Width="100px" Title="Manufacturing Date" FormatString="{0:MM/dd/yyyy}" />
                                            <RadzenDataGridColumn Property="BatchNoExpiryDate" Width="100px" Title="Expiry Date" FormatString="{0:MM/dd/yyyy}" />
                                            <RadzenDataGridColumn Property="BalanceQty" Width="100px" Title="Balance">
                                                <Template Context="item">
                                                    @(item.BalanceQty == 0 ? "" : item.BalanceQty?.ToString("N4"))
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>

                                    </RadzenDataGrid>
                                </RadzenPopup>

                                <RadzenButton Icon="more_horiz" ButtonStyle="ButtonStyle.Primary" />
                            </RadzenStack>

                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockInDetailsModel"
                                          Width="7rem"
                                          Property="@nameof(StockInDetailsModel.Qty)"
                                          Title="Qty"
                                          TextAlign="TextAlign.Center">

                        <Template Context="stockindetails">
                            @(stockindetails.Qty.HasValue ? stockindetails.Qty.Value.ToString("N4") : "")
                        </Template>

                        <EditTemplate Context="stockindetails">
                            <RadzenNumeric Disabled="@IsDisable"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           @bind-Value="stockindetails.Qty"
                                           Change="@(args => OnQtyChanged(stockindetails, args))"
                                           Format="N4" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="5rem" TItem="StockInDetailsModel" Property="@nameof(StockInDetailsModel.UOMId)" Title="UOM" TextAlign="TextAlign.Center">
                        <Template Context="stockindetails">
                            @{
                                var uoms = uomsList?.FirstOrDefault(u => u.Id == stockindetails.UOMId);
                            }
                            @uoms?.UOMCode
                        </Template>
                        <EditTemplate Context="stockindetails">
                            <RadzenDropDownDataGrid Disabled="@IsDisable" @bind-Value="stockindetails.UOMId" Style="width: 100%; font-size:12px" PageSize="10" Data="@GetUOMsForStock(stockindetails.StockId)" AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" AllowSorting="false" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="UOMCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="UOMCode" Title="UOM #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockInDetailsModel" Property="@nameof(StockInDetailsModel.UnitPrice)" Title="Unit Price" TextAlign="TextAlign.Center">
                        <Template Context="stockindetails">
                            @(stockindetails.UnitPrice.HasValue ? stockindetails.UnitPrice.Value.ToString("N8") : "")
                        </Template>
                        <EditTemplate Context="stockindetails">
                            <RadzenNumeric Disabled="@IsDisable"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           @bind-Value="stockindetails.Price"
                                           Change="@(args => OnUnitPriceChanged(stockindetails, args))"
                                           Format="#.00000000" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem"
                                          TItem="StockInDetailsModel"
                                          Property="@nameof(StockInDetailsModel.Amount)"
                                          Title="Amount"
                                          TextAlign="TextAlign.Center">

                        <Template Context="d">
                            @if (d.Amount.HasValue)
                            {
                                var amount = d.Amount.Value;

                                @((amount < 0) ? $"({Math.Abs(amount):N2})" : amount.ToString("N2"))
                            }
                        </Template>

                        <EditTemplate Context="stockindetails">
                            <RadzenNumeric Disabled="true"
                                           TValue="decimal?"
                                           Value="stockindetails.Amount"
                                           Style="width: 100%; font-size:12px"
                                           Format="N2" />
                        </EditTemplate>

                        <FooterTemplate>
                            <b>
                                @((stockinsDetailsGrid.View.Sum(x => x.Amount) ?? 0).ToString("N2"))
                            </b>
                        </FooterTemplate>

                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockInDetailsModel"
                                          Width="7rem"
                                          Property="@nameof(StockInDetailsModel.ProjectId)"
                                          Title="Project"
                                          TextAlign="TextAlign.Center">

                        <Template Context="stockindetails">
                            @{
                                var project = projectList?
                                    .FirstOrDefault(p => p.Id == stockindetails.ProjectId);
                            }
                            @project?.ProjectCode
                        </Template>

                        <EditTemplate Context="stockindetails">
                            <RadzenDropDownDataGrid class="@redtext"
                                                    @bind-Value="stockindetails.ProjectId"
                                                    AllowSorting="false"
                                                    Style="width: 100%;" PageSize="10"
                                                    Data="@projectList" AllowVirtualization="true"
                                                    AllowColumnResize="true" AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="ProjectCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code" />
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data2">
                                            <RadzenCheckBox TValue="bool" Value="data2.IsActive" />
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="11rem" TItem="StockInDetailsModel"
                                          Property="@nameof(StockInDetailsModel.StockLocationId)"
                                          Title="Location" TextAlign="TextAlign.Center">

                        <!-- Display Location Code -->
                        <Template Context="stockindetails">
                            @{
                                var location = stocklocationList?.FirstOrDefault(l => l.Id == stockindetails.StockLocationId);
                            }
                            @location?.LocationCode
                        </Template>

                        <EditTemplate Context="stockindetails">
                            <RadzenDropDownDataGrid class="@redtext"
                                                    @bind-Value="stockindetails.StockLocationId"
                                                    AllowSorting="false"
                                                    Style="width: 120%;" PageSize="10"
                                                    Data="@stocklocationList" AllowVirtualization="true"
                                                    AllowColumnResize="true" AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="LocationCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data">
                                            <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="100px" TextAlign="TextAlign.Center" Property="Action" Title="Action">
                        <Template Context="stockindetails">
                            <RadzenButton Icon="delete" Text="Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(stockindetails))" />
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>
            @* END OF TABLE DETAILS*@

        </RadzenCard>

        <RadzenCard Style="Padding: 0.5rem">
