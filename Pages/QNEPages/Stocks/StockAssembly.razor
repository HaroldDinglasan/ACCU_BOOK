    // ADDED 10/02/2026
    private async Task OpenHeaderBatchDialog(Guid stockId, StockBatchNumbersModel? existing = null)
    {
        var parameters = new Dictionary<string, object> { { "StockId", stockId } };
        if (existing != null) parameters.Add("ExistingBatch", existing);

        var result = await DialogService.OpenAsync<StockBatchNoInModal>(
            existing == null ? "New Batch No" : "Edit Batch No",
            parameters,
            new DialogOptions { Width = "900px", Height = "600px", Resizable = true, Draggable = true, CloseDialogOnOverlayClick = false });

        if (result is StockBatchNumbersModel batch && !IsDuplicateBatchNo(headerBatchNoList, batch))
        {
            Upsert(headerBatchNoList, batch);
            Upsert(stockbatchnumberList, batch);
            Upsert(pendingBatchNumbers, batch);
            stockassemblymodel.StockBatchNumberId = batch.Id;
            previousHeaderBatchNoId = batch.Id;   // keep your revert-tracking field in sync
        }

        StateHasChanged();
    }

