    // Header Qty changed -> propagate to every detail row's Qty, then recompute TotalCost from the rows
    private async Task OnHeaderQtyChanged()
    {
        foreach (var detail in stockAssemblyDetails)
        {
            detail.Qty = stockassemblymodel.Qty;
        }

        RecalculateTotalCost();

        if (stockassemblyDetailsGrid is not null)
            await stockassemblyDetailsGrid.Reload();

        StateHasChanged();
    }

    // Header Cost changed -> simple multiply, doesn't touch detail rows
    private void OnHeaderCostChanged()
    {
        stockassemblymodel.TotalCost = (stockassemblymodel.Qty ?? 0) * (stockassemblymodel.Cost ?? 0);
        StateHasChanged();
    }

    private async Task OnBOMChanged(object value)
    {
        // Don't allow replacing the grid while a row is mid-edit
        if (stockassemblyDetailsToInsert.Any() || stockassemblyDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details",
                "Please save or cancel the current row before selecting a BOM.");
            return;
        }

        // ADDED 10/05/2026
        // ADDED — auto fill Location from the selected BOM
        if (value is Guid selectedBomId)
        {
            var selectedBOM = stockBOMList?.FirstOrDefault(b => b.Id == selectedBomId);

            if (selectedBOM?.StockLocationId != null)
            {
                stockassemblymodel.StockLocationId = selectedBOM.StockLocationId;
            }
        }

        if (value is Guid bomId)
        {
            var bomDetails = await stockItemsService.GetStockBOMDetailsByIdSAO(bomId.ToString());

            if (bomDetails != null && bomDetails.Any())
            {
                stockAssemblyDetails = bomDetails
                    .OrderBy(d => d.Pos)
                    .Select((detail, index) => new StockAssemblyDetail
                    {
                        Id = Guid.NewGuid(),
                        StockAssemblyId = Id ?? stockassemblymodel.Id,
                        Pos = index + 1,
                        StockId = detail.StockId,
                        Description = !string.IsNullOrWhiteSpace(detail.Description)
                            ? detail.Description
                            : stockList?.FirstOrDefault(s => s.Id == detail.StockId)?.StockName,
                        UOMId = detail.UOMId,
                        Qty = detail.Qty,
                        UnitCost = detail.UnitCost,
                        StockLocationId = detail.StockLocationId
                    })
                    .ToList();
            }
            else
            {
                // No BOM details found — fall back to blank rows
                InitializeStockAssemblyRows();
            }
        }
        else
        {
            // BOM cleared
            InitializeStockAssemblyRows();
        }

        Reset(); // clears stockassemblyorderDetailsToInsert / ToUpdate

        if (stockassemblyDetailsGrid != null)
        {
            await stockassemblyDetailsGrid.Reload();
        }

        RecalculateTotalCost();

        StateHasChanged();
    }

    // JUNE 17, 2026
    protected void InitializeStockAssemblyRows()
    {
        // Initialize with 5 rows and set default Pos index
        stockAssemblyDetails = Enumerable.Range(1, 5)
            .Select(i => new StockAssemblyDetail
            {
                Id = Guid.NewGuid(),
                Pos = i,
                StockAssemblyId = Id ?? stockassemblymodel.Id,
            })
            .ToList();

        RecalculateTotalCost();
    }

    // Helper method para mag recalculate at lumabas ang value sa Total Cost
    // QTY X UNIT COST = SUM
    // SUM + ILANG STOCKS = TOTAL COST
    private void RecalculateTotalCost()
    {
        stockassemblymodel.TotalCost = stockAssemblyDetails.Sum(x => (x.Qty ?? 0) * (x.UnitCost ?? 0));

        // Keep unit Cost in sync with the new total (mirrors LoadStockAssemblyOrderTransferDetails)
        stockassemblymodel.Cost = stockassemblymodel.Qty is decimal q && q != 0
            ? stockassemblymodel.TotalCost / q
            : 0;

        StateHasChanged();
    }

