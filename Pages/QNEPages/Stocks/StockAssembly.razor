    protected async Task OnSubmit()
    {
        if (stockassemblyDetailsToInsert.Any() || stockassemblyDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(
                notificationService,
                "Unsaved Details",
                "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (stockassemblymodel.StockId is null)
        {
            NotificationHelper.ShowWarning(
                notificationService,
                "Validation",
                "Stock is required.");
            return;
        }

        if (!stockAssemblyDetails.Any(d => d.StockId != null))
        {
            NotificationHelper.ShowWarning(
                notificationService,
                "Validation",
                "At least one detail row with a Stock must be entered.");
            return;
        }

        // Block save if any detail row has a negative Qty
        if (stockAssemblyDetails.Any(d => d.StockId != null && d.Qty is decimal q && q < 0))
        {
            NotificationHelper.ShowWarning(
                notificationService,
                "Validation",
                "Negative quantity is not allowed. Please correct the Qty in the detail rows.");
            return;
        }

        // ADDED 10/05/2026
        // ADDED — save new/edited batch numbers (header + details) actually used
        var usedBatchIds = stockAssemblyDetails
            .Where(d => d.StockBatchNumberId != null)
            .Select(d => d.StockBatchNumberId!.Value)
            .ToHashSet();

        if (stockassemblymodel.StockBatchNumberId != null)
            usedBatchIds.Add(stockassemblymodel.StockBatchNumberId.Value);

        var batchesToSave = pendingBatchNumbers.Where(b => usedBatchIds.Contains(b.Id)).ToList();

        if (batchesToSave.Any())
        {
            var batchResult = await stockItemsService.SaveStockBatchNumbers(batchesToSave);

            if (batchResult.StartsWith("Error"))
            {
                await DialogService.Alert(batchResult);
                return;
            }

            pendingBatchNumbers.RemoveAll(b => usedBatchIds.Contains(b.Id));
        }

        // STOCK QUANTITY CONTROL - block the save if any component would go negative
        negativeInventoryLines = await stockItemsService.CheckNegativeInventory(stockassemblymodel, stockAssemblyDetails);

        if (negativeInventoryLines.Any())
        {
            StateHasChanged();
            await negativeInventoryPopup.ToggleAsync(negativeInventoryAnchor.Element);
            return; // // hindi tuloy yung save
        }

        // STOCK QUANTITY CONTROL - block the save if any batch would go negative
        negativeBatchNoLines = await stockItemsService.CheckNegativeBatchNo(stockassemblymodel, stockAssemblyDetails);

        if (negativeBatchNoLines.Any())
        {
            StateHasChanged();
            await negativeBatchNoPopup.ToggleAsync(negativeBatchNoAnchor.Element);
            return;
        }

        busy = true;

        // Ensure header/detail ids exist before saving
        if (stockassemblymodel.Id == Guid.Empty)
            stockassemblymodel.Id = Id ?? Guid.NewGuid();

        foreach (var detail in stockAssemblyDetails)
        {
            if (detail.Id == Guid.Empty)
                detail.Id = Guid.NewGuid();

            detail.StockAssemblyId = stockassemblymodel.Id;
        }

        // Only treat as a transfer save if we actually loaded a source order
        var isTransfer = stockAssemblyOrderHeader?.Id != null
            && stockAssemblyOrderHeader.Id != Guid.Empty
            && !string.IsNullOrWhiteSpace(stockassemblymodel.TransferFromInfo);

        var headerForTransfer = isTransfer ? stockAssemblyOrderForTransferHeader : null;
        var detailsForTransfer = isTransfer ? stockAssemblyOrderForTransferDetailsList : new List<StockAssemblyOrderForTransferDetails>();

        var data = await stockItemsService.SaveStockAssemblyWithTransfer(stockassemblymodel, stockAssemblyDetails, headerForTransfer, detailsForTransfer);

        if (data is not null && data.Contains("Success"))
        {
            var syncResult = await stockItemsService.SaveStockAssemblyTransactions(stockassemblymodel, stockAssemblyDetails);

            if (syncResult is null || !syncResult.Contains("Success"))
            {
                // Header/details saved, but ledger sync failed — surface it instead of hiding it
                await DialogService.Alert($"Saved, but ledger sync failed: {syncResult}");
            }

            await DialogService.Alert(data);
            btnDiseabled = true;
            Id ??= stockassemblymodel.Id;
            SetDocumentInfo();
            LoadAssemblyStatus();
        }
        else
        {
            await DialogService.Alert(data);
        }

        busy = false;
        StateHasChanged();

    }

    async Task LoadStockAssemblyOrderTransferDetails()
    {
        // TRANSFER HEADER
        stockassemblymodel.StockId = stockAssemblyOrderHeader.StockId;
        stockassemblymodel.StockLocationId = stockAssemblyOrderHeader.StockLocationId;
        stockassemblymodel.ProjectId = stockAssemblyOrderHeader.ProjectId;
        stockassemblymodel.Description = stockAssemblyOrderHeader.Description;
        stockassemblymodel.ReferenceNo = stockAssemblyOrderHeader.ReferenceNo;

        // Combine the codes of every selected assembly order for traceability
        var codes = selectedStockAssemblyOrderTransferList?.Select(x => x.AssemblyOrderCode);
        stockassemblymodel.TransferFromInfo = string.Join(", ", codes ?? Enumerable.Empty<string>());

        // Re-trigger the same cascade the dropdown's Change handler does,
        // so BOM/Batch/UOM lists get loaded for the transferred stock
        if (stockassemblymodel.StockId is Guid stockId)
        {
            await OnHeaderStockChanged(stockId);

            // OnHeaderStockChanged clears BOM/Batch after loading the lists — restore from source
            stockassemblymodel.BOMId = stockAssemblyOrderHeader.BOMId;
            stockassemblymodel.StockBatchNumberId = stockAssemblyOrderHeader.StockBatchNumberId;

            if (stockAssemblyOrderHeader.UOMId != null)
                stockassemblymodel.UOMId = stockAssemblyOrderHeader.UOMId;
        }

        // TRANSFER DETAILS
        // Every detail row's Qty is set to the source order's batch Qty
        // (not the per-ingredient recipe amount), matching QNE's behavior.
        stockAssemblyDetails = stockAssemblyOrderDetailsForTransfer.Select((item, index) => new StockAssemblyDetail
        {
            Id = Guid.NewGuid(),
            StockAssemblyId = Id ?? stockassemblymodel.Id,
            Pos = index + 1,
            StockId = item.StockId,
            Description = item.Description,
            Qty = item.Qty,      // AUG 13, 2026 — use the original per-ingredient Qty from StockAssemblyOrderDetail, not the header batch Qty
            // Qty = stockAssemblyOrderHeader.Qty,      ← now uses the batch Qty, same on every row
            UOMId = item.UOMId,
            UnitCost = item.UnitCost,
            StockLocationId = item.StockLocationId,
            StockBatchNumberId = item.StockBatchNumberId,
            SerialNumber = item.SerialNumber
        })
        .ToList();

        // BUILD TRANSFER LINK OBJECTS — paired by index with the source order details
        // AUG 13, 2026
        stockAssemblyOrderForTransferDetailsList = stockAssemblyOrderDetailsForTransfer
            .Select((sourceItem, index) => new StockAssemblyOrderForTransferDetails
            {
                Id = Guid.NewGuid(),
                SourceKey = sourceItem.Id,
                StockAssemblyOrderDetailId = sourceItem.Id,
                StockAssemblyDetailId = stockAssemblyDetails[index].Id,
                TransferredBaseUnit = stockAssemblyOrderHeader.Qty ?? 0,
                Transferred = stockAssemblyOrderHeader.Qty ?? 0
            })
            .ToList();

        // HEADER TRANSFER LINK OBJECT
        // AUG 13, 2026
        stockAssemblyOrderForTransferHeader = new StockAssemblyOrderForTransferHeader
        {
            Id = Guid.NewGuid(),
            StockAssemblyOrderHeaderId = stockAssemblyOrderHeader.Id,
            TransferToInfo = stockassemblymodel.AssemblyCode,
            TransferToMasterInfo = stockassemblymodel.AssemblyCode,
            TransferQty = stockAssemblyOrderHeader.Qty
        };

        // RECOMPUTE HEADER TOTAL FROM DETAILS
        // Qty must come from the SOURCE ORDER HEADER's batch quantity —
        // NOT summed from the ingredient rows, which is meaningless (mixes different units of raw materials)
        stockassemblymodel.Qty = stockAssemblyOrderHeader.Qty;

        RecalculateTotalCost();

        // Reset any pending row edits so the grid isn't left in a stale insert/update state
        Reset();

        await popuptransfer.CloseAsync();
        isloading = false;

        if (stockassemblyDetailsGrid is not null)
            await stockassemblyDetailsGrid.Reload();

        StateHasChanged();
    }

