    // mode: "New" / "Edit" (popup grid buttons) or "AutoChain" (fired right after selecting a stock —
    // opens Stock In create form; Cancel there opens Stock Out select grid)
    private async Task OpenDetailBatchDialog(Guid stockId, StockAssemblyDetail detail, string mode, StockBatchNumbersModel? existing = null)
    {
        if (mode == "AutoChain")
        {
            var inResult = await DialogService.OpenAsync<StockBatchNoInModal>(
                "Stock Batch No In Out",
                new Dictionary<string, object> { { "StockId", stockId } },
                new DialogOptions { Width = "900px", Height = "600px", Resizable = true, Draggable = true, CloseDialogOnOverlayClick = false });

            if (inResult is StockBatchNumbersModel newBatch)
            {
                if (!IsDuplicateBatchNo(stockbatchnumberList, newBatch))
                {
                    Upsert(stockbatchnumberList, newBatch);
                    Upsert(pendingBatchNumbers, newBatch);

                    detail.StockBatchNumberId = newBatch.Id;
                    stockbatchnumbercode = newBatch.BatchNo;
                }

                StateHasChanged();
                return;
            }

            // Cancelled Stock In -> fall through to Stock Out (pick an existing batch)
            var outResult = await DialogService.OpenAsync<StockBatchNoOutModal>(
                "Stock Batch No In Out",
                new Dictionary<string, object>
                {
                    { "StockId", stockId },
                    { "StockLocationId", detail.StockLocationId ?? Guid.Empty },
                    { "UOMId", detail.UOMId ?? Guid.Empty }
                },
                new DialogOptions { Width = "900px", Height = "600px", Resizable = true, Draggable = true, CloseDialogOnOverlayClick = false });

            if (outResult is StockBatchNumbersModel pickedBatch)
            {
                Upsert(stockbatchnumberList, pickedBatch);

                detail.StockBatchNumberId = pickedBatch.Id;
                detail.Qty = pickedBatch.BalanceQty;
                detail.StockLocationId = pickedBatch.StockLocationId;
                detail.UOMId = pickedBatch.UOMId;
                stockbatchnumbercode = pickedBatch.BatchNo;
            }

            StateHasChanged();
            return;
        }

        // "New" / "Edit" from the popup grid buttons
        var parameters = new Dictionary<string, object> { { "StockId", stockId } };
        if (existing != null) parameters.Add("ExistingBatch", existing);

        var result = await DialogService.OpenAsync<StockBatchNoInModal>(
            mode == "New" ? "New Batch No" : "Edit Batch No",
            parameters,
            new DialogOptions { Width = "900px", Height = "600px", Resizable = true, Draggable = true, CloseDialogOnOverlayClick = false });

        if (result is StockBatchNumbersModel batch && !IsDuplicateBatchNo(stockbatchnumberList, batch))
        {
            Upsert(stockbatchnumberList, batch);
            Upsert(pendingBatchNumbers, batch);
            detail.StockBatchNumberId = batch.Id;
            stockbatchnumbercode = batch.BatchNo;
        }

        StateHasChanged();
    }

