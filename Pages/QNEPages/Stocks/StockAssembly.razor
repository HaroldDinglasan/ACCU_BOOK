    private async Task OnBatchRowSelect(StockBatchNumbersModel batch, StockAssemblyDetail detail)
    {
        if (batch?.BatchNoExpiryDate != null
            && stockassemblymodel.AssemblyDate != null
            && batch.BatchNoExpiryDate.Date < stockassemblymodel.AssemblyDate.Date)
        {
            var confirmed = await DialogService.Confirm(
                "Expiry Date is earlier than transaction date. Do you want to continue?",
                "Batch No Validation",
            new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });

            if (confirmed != true)
            {
                // Don't apply this batch — close the popup and leave the row as-is
                await batchnumberpopup.CloseAsync();
                StateHasChanged();
                return;
            }
        }

        detail.StockBatchNumberId = batch.Id;

        stockbatchnumbercode = batch.BatchNo;

        // Keep the values synchronized
        detail.Qty = batch.BalanceQty;
        detail.StockLocationId = batch.StockLocationId;
        detail.UOMId = batch.UOMId;

        await batchnumberpopup.CloseAsync();
        StateHasChanged();
    }

