@page "/StockAssembly"
@page "/StockAssemblyList/Edit/{id:guid}"
@inject StockItemsService stockItemsService
@inject ProjectService projectService
@inject DescriptionsService descriptionsService
@inject RunningNumberService runningNumberService
@inject TransactionCodeService transactionCodeService

@using Accounting_V4.Model.QNEModels.StocksForTransferModels
@using Microsoft.AspNetCore.Components.Authorization
@using Radzen.Blazor.Rendering
@attribute [Authorize(Roles = "Admin,User")]
@inject HttpClient http
@inject NavigationManager navManager
@inject DialogService DialogService
@inject NotificationService notificationService
@inject IJSRuntime JSRuntime

<RadzenTemplateForm TItem="StockAssemblyModel" Data="stockassemblymodel" Submit="@OnSubmit" InvalidSubmit="@OnInvalidSubmit">
    <RadzenStack Gap="0.2rem">
        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="5">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        @*MODIFIED 10/02/2026*@
                        <RadzenButton Size="@smallbtn" Icon="save" BusyText="Saving..." IsBusy=@busy
                                      Disabled="@btnDiseabled"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Text="@btnText"
                                      ButtonType="@Radzen.ButtonType.Submit" />

                        <RadzenButton Visible="@btnDiseabled" Text="New" Icon="add" Size="@smallbtn"
                                      ButtonStyle="ButtonStyle.Success"
                                      ButtonType="@Radzen.ButtonType.Button"
                                      Click="@OnNew" />

                        <RadzenButton Text="Transfer" Size="@smallbtn" ButtonStyle="ButtonStyle.Primary" @ref="@transferbutton" Icon="compare_arrows" Click="@(async args => { await GetStockAssemblyOrderTransferList(); await popuptransfer.ToggleAsync(transferbutton.Element); })" />
                    </RadzenStack>

                </RadzenColumn>
                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Seach" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenCard>

            <div style="margin-bottom: 0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        Stock Assembly @stockassemblymodel.AssemblyCode <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                    </RadzenStack>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="info" Click="@OpenDocumentInfoDialog"></RadzenButton>
                </RadzenStack>
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Details">
                        <RadzenRow>
                            <!-- LEFT SIDE -->
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">

                                            <RadzenFormField Style="width:100%" Text="Stock" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value="stockassemblymodel.StockId"
                                                                        Change="OnHeaderStockChanged"
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize="10"
                                                                        Data="@stockList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="StockCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">

                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="6%" Property="StockCode" Title="Stock #" />
                                                        <RadzenDropDownDataGridColumn Width="10%" Property="StockName" Title="Stock Name" />
                                                    </Columns>

                                                </RadzenDropDownDataGrid>

                                            </RadzenFormField>

                                            <RadzenFormField Style="width:100%" Text="BOM" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid AllowClear="true"
                                                                        @bind-Value="stockassemblymodel.BOMId"
                                                                        Change="OnBOMChanged"
                                                                        Data="@stockBOMList"
                                                                        TextProperty="BOMCode"
                                                                        ValueProperty="Id"
                                                                        AllowVirtualization="true"
                                                                        AllowFiltering="true">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Property="BOMCode" Title="BOM Code" />
                                                        <RadzenDropDownDataGridColumn Property="Description" Title="Description" />
                                                    </Columns>

                                                </RadzenDropDownDataGrid>

                                            </RadzenFormField>


                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value="@stockassemblymodel.StockLocationId"
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize="10"
                                                                        Data="@stocklocationList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">


                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data">
                                                                <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                                            </Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>



                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@stockassemblymodel.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Description" AllowFloatingLabel="false">
                                                <RadzenTextBox @bind-Value="stockassemblymodel.Description"
                                                               Style="width:100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenColumn Size="12" SizeMD="2">
                                        <small>Use Standard Unit Cost</small>
                                        <RadzenSwitch TValue="bool"
                                                      Value="@stockassemblymodel.UseStandardUnitCost.GetValueOrDefault()"
                                                      Change="@(args => stockassemblymodel.UseStandardUnitCost = (bool)args)"
                                                      Name="UseStandardUnitCost" />
                                    </RadzenColumn>

                                </RadzenStack>
                            </RadzenColumn>

                            <!-- MIDDLE -->
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenFormField Style="width:100%" Text="Batch No" AllowFloatingLabel="false">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                            <RadzenDropDownDataGrid @bind-Value="stockassemblymodel.StockBatchNumberId"
                                                                    Change="OnHeaderBatchNoChanged"
                                                                    Data="@headerBatchNoList"
                                                                    TextProperty="BatchNo"
                                                                    ValueProperty="Id"
                                                                    AllowFiltering="true"
                                                                    AllowClear="true"
                                                                    Style="flex:1"
                                                                    AllowVirtualization="true">
                                                <Columns>
                                                    <RadzenDropDownDataGridColumn Property="BatchNo" Title="Batch No" />
                                                    <RadzenDropDownDataGridColumn Property="Description" Title="Description" />
                                                    <RadzenDropDownDataGridColumn Property="BatchNoManufacturingDate" Title="Mfg Date" FormatString="{0:MM/dd/yyyy}" />
                                                    <RadzenDropDownDataGridColumn Property="BatchNoExpiryDate" Title="Expiry Date" FormatString="{0:MM/dd/yyyy}" />
                                                    <RadzenDropDownDataGridColumn Property="BalanceQty" Title="Balance" />
                                                </Columns>
                                            </RadzenDropDownDataGrid>
                                            <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success"
                                                          Click="@NewHeaderBatch" title="New Batch No" />
                                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                                          Disabled="@(stockassemblymodel.StockBatchNumberId == null)"
                                                          Click="@EditHeaderBatch" title="Edit Batch No" />
                                        </RadzenStack>
                                    </RadzenFormField>

                                    <RadzenFormField Style="width:100%"
                                                     Text="UOM"
                                                     AllowFloatingLabel="false">

                                        <RadzenDropDownDataGrid @bind-Value="stockassemblymodel.UOMId"
                                                                Data="@headerUOMCodeList"
                                                                TextProperty="UOMCode"
                                                                ValueProperty="Id"
                                                                AllowFiltering="true"
                                                                AllowClear="true"
                                                                AllowVirtualization="true">

                                            <Columns>

                                                <RadzenDropDownDataGridColumn Property="UOMCode"
                                                                              Title="UOM Code" />
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>

                                    <RadzenFormField Style="width:100%" Text="Qty" AllowFloatingLabel="false">
                                        <RadzenNumeric @bind-Value="stockassemblymodel.Qty"
                                                       TValue="decimal?"
                                                       Change="@(args => OnHeaderQtyChanged())"
                                                       Style="width:100%"
                                                       Format="N4" />
                                    </RadzenFormField>

                                    <RadzenFormField Style="width:100%" Text="Cost" AllowFloatingLabel="false">
                                        <RadzenNumeric @bind-Value="stockassemblymodel.Cost"
                                                       TValue="decimal?"
                                                       Change="@(args => OnHeaderCostChanged())"
                                                       Style="width:100%"
                                                       Format="N4" />
                                    </RadzenFormField>

                                </RadzenStack>
                            </RadzenColumn>

                            <!-- RIGHT SIDE -->
                            <RadzenColumn Size="12" SizeMD="4" Style="text-align:right">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetStockAssemblyNo"
                                                                  @bind-Value="@stockassemblymodel.AssemblyDate"
                                                                  DateFormat="MM/dd/yyyy"
                                                                  Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" Style="display:flex; align-items:center;">
                                            <RadzenFormField Style="flex:1" Text="Assembly #" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockassemblymodel.AssemblyCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="margin-left:5px" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@(args => popup.ToggleAsync(button.Element))" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Total Cost" AllowFloatingLabel="false">
                                                <RadzenNumeric @bind-Value="stockassemblymodel.TotalCost"
                                                               TValue="decimal?"
                                                               Disabled="true"
                                                               Style="width:100%"
                                                               Format="N4" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockassemblymodel.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Transfer From" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockassemblymodel.TransferFromInfo" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Info">
                        @documentInfo.Id
                        @documentInfo.DocumentId
                        @documentInfo.DocType
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>

            @* TABLE DETAILS*@
            <br />
            <RadzenDataGrid EditMode="@editMode" @ref="stockassemblyDetailsGrid"
                            Style="width: 100%; height:45vh; font-size:12px;"
                            AllowVirtualization="true"
                            Data="@stockAssemblyDetails"
                            KeyProperty="Id"
                            AllowColumnResize=true
                            RowCreate="@OnCreateRow"
                            TItem="StockAssemblyDetail"
                            Density="@density"
                            RowUpdate="@OnUpdateRow">

                @*JUNE 17 2026*@
                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New" Size="ButtonSize.ExtraSmall" Click="@(() => InsertAfterRow(stockAssemblyDetails.LastOrDefault()))" title="Add new row after this row" Disabled="@(stockassemblyDetailsToInsert.Any() || stockassemblyDetailsToUpdate.Any())" />
                </HeaderTemplate>

                <Columns>

                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="stockassemblydetails">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => EditRow(stockassemblydetails))" title="Edit this row" />

                        </Template>
                        <EditTemplate Context="stockassemblydetails">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(stockassemblydetails))" title="Save" />
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn Visible=false Width="5rem" TItem="StockAssemblyDetail" Property="@nameof(StockAssemblyDetail.Pos)" Title="Pos" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn Width="9rem" TItem="StockAssemblyDetail" Property="@nameof(StockAssemblyDetail.StockId)" Title="Stock Code" TextAlign="TextAlign.Center">
                        <Template Context="stockassemblydetails">
                            @{
                                var stock = stockList?.FirstOrDefault(s => s.Id == stockassemblydetails.StockId);
                            }
                            @stock?.StockCode
                        </Template>
                        <EditTemplate Context="stockassemblydetails">
                            <RadzenDropDownDataGrid @bind-Value="stockassemblydetails.StockId"
                                                    Change="@(args => OnStockChanged(args, stockassemblydetails))"
                                                    Style="width: 100%; font-size:12px" PageSize="10" Data="@stockList"
                                                    AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" AllowSorting="false"
                                                    FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="StockCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="StockCode" Title="Stock #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="StockName" Title="StockName" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    @* BATCH NO DROPDOWN *@
                    <RadzenDataGridColumn Width="160px" TItem="StockAssemblyDetail" Property="@nameof(StockAssemblyDetail.StockBatchNumberId)" Title="Batch No" TextAlign="TextAlign.Center">
                        <Template Context="stockassemblydetails">
                            @{
                                var batchNumber = stockbatchnumberList?.FirstOrDefault(x => x.Id == stockassemblydetails.StockBatchNumberId);
                            }
                            @batchNumber?.BatchNo
                        </Template>
                        <EditTemplate Context="stockassemblydetails">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                                <RadzenTextBox @ref="textBox" Value="@stockbatchnumbercode" Style="width:100%; font-size:12px"
                                               @onclick="@(args => batchnumberpopup.ToggleAsync(textBox.Element))" />

                                <RadzenPopup @ref="batchnumberpopup" id="batchnumberpopup" AutoFocusFirstElement="false" class="batchnumber-popup">
                                    <RadzenDataGrid @ref="stockbatchnumbergrid" Density="Density.Compact"
                                                    Data="@GetBatchNumberForStock(stockassemblydetails.StockId)"
                                                    TItem="StockBatchNumbersModel"
                                                    RowSelect="@(item => OnBatchRowSelect(item, stockassemblydetails))"
                                                    AllowSorting="true" Style="height:360px">

                                        <HeaderTemplate>
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                                <span>Stock Batch Numbers</span>
                                                <RadzenButton Icon="add" Text="New" Size="ButtonSize.ExtraSmall"
                                                              ButtonStyle="ButtonStyle.Success"
                                                              Click="@(() => NewDetailBatch(stockassemblydetails))" />
                                            </RadzenStack>
                                        </HeaderTemplate>

                                        <EmptyTemplate>
                                            <p class="rz-m-4">No batch numbers for this stock yet. Click <b>New</b> to create one.</p>
                                        </EmptyTemplate>

                                        <Columns>
                                            <RadzenDataGridColumn Width="45px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                                <Template Context="batch">
                                                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                                  ButtonStyle="ButtonStyle.Secondary" title="Edit batch"
                                                                  Click="@(args => EditDetailBatch(batch, stockassemblydetails))"
                                                                  @onclick:stopPropagation="true" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn Property="BatchNo" Width="100px" Title="Batch #" />
                                            <RadzenDataGridColumn Property="Description" Width="150px" Title="Description" />
                                            <RadzenDataGridColumn Property="BatchNoManufacturingDate" Width="120px" Title="Manufacturing Date" FormatString="{0:MM/dd/yyyy}" />
                                            <RadzenDataGridColumn Property="BatchNoExpiryDate" Width="120px" Title="Expiry Date" FormatString="{0:MM/dd/yyyy}" />
                                            <RadzenDataGridColumn Property="BalanceQty" Width="100px" Title="Balance">
                                                <Template Context="item">
                                                    @(item.BalanceQty == 0 ? "" : item.BalanceQty?.ToString("N4"))
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </RadzenPopup>

                                <RadzenButton Icon="more_horiz" ButtonStyle="ButtonStyle.Primary" />
                            </RadzenStack>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="10rem" TItem="StockAssemblyDetail" Property="@nameof(StockAssemblyDetail.Description)" Title="Description" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockassemblydetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width: 100%; font-size:12px" @bind-Value="stockassemblydetails.Description"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockAssemblyDetail"
                                          Width="7rem"
                                          Property="@nameof(StockAssemblyDetail.Qty)"
                                          Title="Qty"
                                          TextAlign="TextAlign.Center">

                        @* Show both positive and negative numbers *@
                        <Template Context="stockassemblydetails">
                            @(stockassemblydetails.Qty?.ToString("N4"))
                        </Template>

                        <EditTemplate Context="stockassemblydetails">
                            <RadzenNumeric Disabled="@(stockassemblydetails.StockId == null)"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           Min="0"
                                           @bind-Value="stockassemblydetails.Qty"
                                           Change="@(args => RecalculateTotalCost())"
                                           Format="N4" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="5rem" TItem="StockAssemblyDetail" Property="@nameof(StockAssemblyDetail.UOMId)" Title="UOM" TextAlign="TextAlign.Center">
                        <Template Context="stockassemblydetails">
                            @{
                                var uoms = uomsList?.FirstOrDefault(u => u.Id == stockassemblydetails.UOMId);
                            }
                            @uoms?.UOMCode
                        </Template>
                        <EditTemplate Context="stockassemblydetails">
                            <RadzenDropDownDataGrid @bind-Value="stockassemblydetails.UOMId"
                                                    Style="width:100%; font-size:12px"
                                                    PageSize="10"
                                                    Data="@GetUOMsForStock(stockassemblydetails.StockId)"
                                                    AllowVirtualization="true"
                                                    AllowColumnResize="true"
                                                    AllowClear="true"
                                                    AllowSorting="false"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="UOMCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="UOMCode" Title="UOM #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description" />
                                </Columns>

                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockAssemblyDetail"
                                          Width="7rem"
                                          Property="@nameof(StockAssemblyDetail.UnitCost)"
                                          Title="UnitCost"
                                          TextAlign="TextAlign.Center">

                        @* Show both positive and negative numbers *@
                        <Template Context="stockassemblydetails">
                            @(stockassemblydetails.UnitCost?.ToString("N4"))
                        </Template>

                        <EditTemplate Context="stockassemblydetails">
                            <RadzenNumeric Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           @bind-Value="stockassemblydetails.UnitCost"
                                           Change="@(args => RecalculateTotalCost())"
                                           Format="N4" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockAdjustmentDetails" Property="@nameof(StockAdjustmentDetails.UOMId)" Title="UOM" TextAlign="TextAlign.Center">
                        <Template Context="stockadjustmentdetails">
                            @{
                                var uoms = uomsList?.FirstOrDefault(u => u.Id == stockadjustmentdetails.UOMId);
                            }
                            @uoms?.UOMCode
                        </Template>
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenDropDownDataGrid Disabled="@IsDisable" @bind-Value="stockadjustmentdetails.UOMId" Style="width: 100%; font-size:12px" PageSize="10" Data="@GetUOMsForStock(stockadjustmentdetails.StockId)" AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" AllowSorting="false" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="UOMCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="UOMCode" Title="UOM #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockAssemblyDetail" Property="@nameof(StockAssemblyDetail.SerialNumber)" Title="Serial No" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockassemblydetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width: 100%; font-size:12px" @bind-Value="stockassemblydetails.SerialNumber"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Title="Action">
                        <Template Context="stockassemblydetails">
                            <RadzenButton Icon="delete" Text="Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(stockassemblydetails))" />
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>
            @* END OF TABLE DETAILS*@

        </RadzenCard>

    </RadzenStack>

</RadzenTemplateForm>

<RadzenPopup @ref=popup Lazy=true class="my-popup">
    <RadzenDataGrid RowDoubleClick="() => SetStockAssemblyNoPopup(selectedtransactionCodesList.FirstOrDefault().Id)"
                    TItem="TransactionsCode"
                    @ref=transactionsCodeGrid
                    @bind-Value="@selectedtransactionCodesList"
                    Data=@transactionCodesList>
        <Columns>
            <RadzenDataGridColumn TItem="TransactionsCode" Property="@nameof(TransactionsCode.Format)" Title="Format" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="transactionCode">
                    @transactionCode.Format
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</RadzenPopup>


@* FOR TRANSFER MODAL *@
<RadzenPopup @ref=popuptransfer Lazy=true class="popuptransfer">

    <RadzenCard>
        <RadzenStack Gap="0.2rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                        <RadzenTextBox Disabled=@(filteredStockAsseblyOrderTransferList == null) @bind-Value="@searchText"
                                       Placeholder="Search..."
                                       Style="font-size:smaller; width:30rem;"
                                       Change="@(args => ApplyFilter())" />
