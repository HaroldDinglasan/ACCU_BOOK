    // JUNE 17, 2026
    async Task InsertAfterRow(StockAssemblyDetail currentRow)
    {
        if (stockassemblyDetailsToInsert.Any() || stockassemblyDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService,
                "Unsaved Details",
                "Save current row first.");
            return;
        }

        var newRow = new StockAssemblyDetail
        {
            Id = Guid.NewGuid(),
            StockAssemblyId = Id ?? stockassemblymodel.Id,
            Pos = currentRow?.Pos + 1 ?? 1
        };

        // 🔥 IMPORTANT: insert into actual grid source
        if (currentRow != null)
        {
            var index = stockAssemblyDetails.IndexOf(currentRow);

            if (index >= 0)
                stockAssemblyDetails.Insert(index + 1, newRow);
            else
                stockAssemblyDetails.Add(newRow);
        }
        else
        {
            stockAssemblyDetails.Add(newRow);
        }

        stockassemblyDetailsToInsert.Add(newRow);

        await stockassemblyDetailsGrid.Reload();

        // ADDED 10/5/2026
        stockbatchnumbercode = string.Empty;

        await stockassemblyDetailsGrid.EditRow(newRow);

        StateHasChanged();

    }

    // JUNE 17, 2026
    async Task EditRow(StockAssemblyDetail stockassemblyDetails)
    {
        if (!stockassemblyDetailsGrid.IsValid)
            return;

        if (stockassemblyDetails.UnitCost == null)
        {
            stockassemblyDetails.UnitCost = 0.0000m;
        }

        bool anotherRowActive =
            stockassemblyDetailsToInsert.Any(x => x != stockassemblyDetails) ||
            stockassemblyDetailsToUpdate.Any(x => x != stockassemblyDetails);

        if (anotherRowActive)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Unsaved Row",
                Detail = "Please save or cancel the current active row before editing another."
            });
            return;
        }

        if (!stockassemblyDetailsToUpdate.Contains(stockassemblyDetails))
        {
            stockassemblyDetailsToUpdate.Add(stockassemblyDetails);
        }

        // ADDED 10/05/2026
        stockbatchnumbercode = GetBatchNo(stockassemblyDetails.StockBatchNumberId);

        await stockassemblyDetailsGrid.EditRow(stockassemblyDetails);
        StateHasChanged();
    }

