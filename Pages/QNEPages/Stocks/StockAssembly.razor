    private async Task OnStockChanged(object stockId, StockAssemblyDetail stockassemblydetails)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);

            if (selectedStock != null)
            {

                // ADDED 10/05/2026
                stockassemblydetails.StockBatchNumberId = null;
                stockbatchnumbercode = string.Empty;

                // Populate Description
                stockassemblydetails.Description = selectedStock.StockName;

                if (selectedStock.ItemTypeCode is "T" or "D")
                {
                    stockassemblydetails.Qty = 0.00m;
                }
                else
                {
                    stockassemblydetails.Qty = 1.00m;
                }

                // Set the base UOM
                var baseUOM = uomsList?
                    .FirstOrDefault(u =>
                        u.StockId == selectedStockId &&
                        u.UOMCode == selectedStock.BaseUOM);
                if (baseUOM != null)
                {
                    stockassemblydetails.UOMId = baseUOM.Id;
                }

                // Auto fill Location when selecting stock code
                if (selectedStock.DefaultLocationId != null)
                {
                    stockassemblydetails.StockLocationId = selectedStock.DefaultLocationId;
                }

                // ADDED SEPT 4, 2026
                RecalculateTotalCost();

                // ADDED 10/05/2026
                // ADDED — opens Stock In create form; Cancel opens Stock Out select grid
                await OpenDetailBatchDialog(selectedStockId, stockassemblydetails, "AutoChain");

                // Just trigger state change, don't reload grid
                StateHasChanged();
            }
        }
        else
        {
            IsDisable = true;

            // Clear fields if no stock is selected
            stockassemblydetails.Description = string.Empty;
            stockassemblydetails.Qty = 0;
            stockassemblydetails.UOMId = null;

            RecalculateTotalCost();

            StateHasChanged();
        }
    }

    // Tracks the last valid header Batch No selection so we can revert if the
    // user cancels the expiry-date confirmation.
    private Guid? previousHeaderBatchNoId = null;

    private async Task OnHeaderBatchNoChanged(object value)
    {
        if (value is Guid batchId)
        {
            var batch = headerBatchNoList?.FirstOrDefault(b => b.Id == batchId);

            if (batch?.BatchNoExpiryDate != null
                && stockassemblymodel.AssemblyDate != null
                && batch.BatchNoExpiryDate.Date < stockassemblymodel.AssemblyDate.Date)
            {
                var confirmed = await DialogService.Confirm(
                    "Expire Date is earlier than transaction date. Do you want to continue?",
                    "Batch No Validation",
                    new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });

                if (confirmed != true)
                {
                    // Revert to the previous selection (or clear it)
                    stockassemblymodel.StockBatchNumberId = previousHeaderBatchNoId;
                    StateHasChanged();
                    return;
                }
            }

            previousHeaderBatchNoId = batchId;
        }
        else
        {
            // Cleared
            previousHeaderBatchNoId = null;
        }
    }

