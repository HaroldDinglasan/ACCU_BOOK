@page "/StockOuts"
@page "/StockOuts/{RunningNumberId:int}"
@page "/StockOutsList/Edit/{Id:guid}"

@using Accounting_V4.Dialog.Stocks
@using Radzen.Blazor.Rendering
@attribute [Authorize(Roles = "Admin,User")]
@inject HttpClient http
@inject NavigationManager navManager
@inject NotificationService notificationService
@inject IJSRuntime JSRuntime

<RadzenTemplateForm TItem="StockOutsModel" Data="stockOutsmodel" Submit="@OnSubmit">

    <RadzenStack Gap="0.2rem">

        <RadzenCard Style="padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">

                <RadzenColumn Size="12" SizeSM="5">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        @*MODIFIED 09/30/2026*@
                        <RadzenButton Size="@smallbtn" Icon="save" BusyText="Saving..." IsBusy=@busy
                                      Disabled="@btnDiseabled"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Text="@btnText"
                                      ButtonType="@Radzen.ButtonType.Submit" />

                        <RadzenButton Visible="@btnDiseabled" Text="New" Icon="add" Size="@smallbtn"
                                      ButtonStyle="ButtonStyle.Success"
                                      ButtonType="@Radzen.ButtonType.Button"
                                      Click="@OnNew" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Seach" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>


        <RadzenCard>

            <div style="margin-bottom: 0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        Stock Outs <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                    </RadzenStack>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="info" Click="@OpenDocumentInfoDialog"></RadzenButton>
                </RadzenStack>
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Details">
                        <RadzenRow>

                            <!-- LEFT SIDE -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">

                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value="@stockOutsmodel.StockLocationId"
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize="10"
                                                                        Data="@stocklocationList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">

                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data">
                                                                <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                                            </Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>


                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@stockOutsmodel.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">

                                            <RadzenFormField Style="width:100%" Text="Description" AllowFloatingLabel="false">
                                                <RadzenAutoComplete Style="width:100%"
                                                                    Data="@stocklocationList"
                                                                    TextProperty="LocationCode"
                                                                    @bind-Value="stockOutsmodel.Description"
                                                                    Placeholder="Select or type description..."
                                                                    AllowCustom="true"
                                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>


                            <!-- RIGHT SIDE -->
                            <RadzenColumn Size="12" SizeMD="6" Style="text-align:right">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetStockOutsNo"
                                                                  @bind-Value="@stockOutsmodel.StockOutDate"
                                                                  DateFormat="MM/dd/yyyy"
                                                                  Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" Style="display: flex; align-items: center;">

                                            <RadzenFormField Style="flex:1" Text="Stock Out #" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockOutsmodel.StockOutCode" Style="width: 100%;" />
                                            </RadzenFormField>

                                            <RadzenFormField Style="margin-left:5px" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@OpenRunningNumberModal" />
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="stockOutsmodel.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Others">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Title 1" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenTextBox class="@redtext" @bind-Value=@stockOutsmodel.Title Style="width: 100%;" />
                                                </RadzenStack>
                                            </RadzenFormField>

                                            <RadzenFormField Style="width:100%" Text="Title 2" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenTextBox class="@redtext" @bind-Value=@stockOutsmodel.Title2 Style="width: 100%;" />
                                                </RadzenStack>
                                            </RadzenFormField>

                                            <RadzenColumn Size="12" SizeMD="12">
                                                <RadzenFormField Style="width:100%" Text="Transfer To" AllowFloatingLabel="false">
                                                    <RadzenTextBox Disabled=true class="@redtext" @bind-Value=@stockOutsmodel.TransferToInfo Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>

                                        </RadzenColumn>
                                    </RadzenRow>


                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockOutsmodel.Ref1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockOutsmodel.Ref2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockOutsmodel.Remark1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockOutsmodel.Remark2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Notes">
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenTextArea @bind-Value=@stockOutsmodel.Notes
                                                            Rows="10"
                                                            Style="width:100%"
                                                            class="@redtext"
                                                            aria-label="TextArea" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>

            @* TABLE DETAILS *@
            <br />
            <RadzenDataGrid EditMode="@editMode" @ref="stockoutsDetailsGrid"
                            Style="width:100%; height:45vh; font-size:12px;"
                            AllowVirtualization="true"
                            Data="@stockOutDetails"
                            AllowColumnResize="true"
                            RowCreate="@OnCreateRow"
                            TItem="StockOutDetails"
                            Density="@density"
                            RowUpdate="@OnUpdateRow">

                
                @*JUNE 17 2026*@
                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New" Size="ButtonSize.ExtraSmall" Click="@(() => InsertAfterRow(stockOutDetails.LastOrDefault()))" title="Add new row after this row" Disabled="@(stockoutDetailsToInsert.Any() || stockoutDetailsToUpdate.Any())" />
                </HeaderTemplate>

                <Columns>

                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="stockoutdetails">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => EditRow(stockoutdetails))" title="Edit this row" />

                        </Template>
                        <EditTemplate Context="stockoutdetails">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(stockoutdetails))" title="Save" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible="false" Width="4rem" TItem="StockOutDetails" Property="@nameof(StockOutDetails.Pos)" Title="Pos" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn Width="9rem" TItem="StockOutDetails" Property="@nameof(StockOutDetails.StockId)" Title="Stock Code" TextAlign="TextAlign.Center">
                        <Template Context="stockoutdetails">
                            @{
                                var stock = stockList?.FirstOrDefault(s => s.Id == stockoutdetails.StockId);
                            }
                            @stock?.StockCode
                        </Template>
                        <EditTemplate Context="stockoutdetails">
                            <RadzenDropDownDataGrid @bind-Value="stockoutdetails.StockId"
                                                    Change="@(args => OnStockChanged(args, stockoutdetails))"
                                                    Style="width:100%; font-size:12px"
                                                    PageSize="10"
                                                    Data="@stockList"
                                                    AllowVirtualization="true"
                                                    AllowColumnResize="true"
                                                    AllowClear="true"
                                                    AllowSorting="false"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="StockCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="StockCode" Title="Stock #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="StockName" Title="Stock Name" />
                                </Columns>

                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="10rem" TItem="StockOutDetails" Property="@nameof(StockOutDetails.Description)" Title="Description" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockoutdetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width:100%; font-size:12px" @bind-Value="stockoutdetails.Description"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockOutDetails" Property="@nameof(StockOutDetails.SerialNumber)" Title="Serial No" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockoutdetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width:100%; font-size:12px" @bind-Value="stockoutdetails.SerialNumber"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    @* BATCH NO DROPDOWN *@
                    <RadzenDataGridColumn Width="160px" TItem="StockOutDetails" Property="@nameof(StockOutDetails.StockBatchNumberId)" Title="Batch No" TextAlign="TextAlign.Center">
                        <Template Context="stockoutdetails">
                            @{
                                var batchNumber = stockbatchnumberList?.FirstOrDefault(x => x.Id == stockoutdetails.StockBatchNumberId);
                            }
                            @batchNumber?.BatchNo
                        </Template>
                        <EditTemplate Context="stockoutdetails">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                                <RadzenTextBox @ref="textBox" Value="@stockbatchnumbercode" Style="width:100%; font-size:12px"
                                               @oninput="@(args => OnInput(args, stockoutdetails))"
                                               @onclick="@(args => batchnumberpopup.ToggleAsync(textBox.Element))" />

                                <RadzenPopup @ref="batchnumberpopup" id="batchnumberpopup" AutoFocusFirstElement="false" class="batchnumber-popup">
                                    <RadzenDataGrid @ref="stockbatchnumbergrid" id="stockbatchnumbergrid"
                                                    RowSelect="@(item => OnBatchRowSelect(item, stockoutdetails))"
                                                    Density="Density.Compact"
                                                    TItem="StockBatchNumbersModel"
                                                    Data="@GetBatchNumberForStock(stockoutdetails.StockId)"
                                                    AllowSorting="true" Style="height:360px">

                                        <HeaderTemplate>
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                                <span>Stock Batch Numbers</span>
                                                <RadzenButton Icon="add" Text="New" Size="ButtonSize.ExtraSmall"
                                                              ButtonStyle="ButtonStyle.Success"
                                                              Click="@(() => NewBatch(stockoutdetails))" />
                                            </RadzenStack>
                                        </HeaderTemplate>

                                        <EmptyTemplate>
                                            <p class="rz-m-4">No batch numbers for this stock yet. Click <b>New</b> to create one.</p>
                                        </EmptyTemplate>

                                        <Columns>
                                            <RadzenDataGridColumn Width="45px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                                <Template Context="batch">
                                                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                                  ButtonStyle="ButtonStyle.Secondary" title="Edit batch"
                                                                  Click="@(args => EditBatch(batch, stockoutdetails))"
                                                                  @onclick:stopPropagation="true" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn Property="BatchNo" Width="100px" Title="Batch #" />
                                            <RadzenDataGridColumn Property="Description" Width="150px" Title="Description" />
                                            <RadzenDataGridColumn Property="BatchNoManufacturingDate" Width="120px" Title="Manufacturing Date" FormatString="{0:MM/dd/yyyy}" />
                                            <RadzenDataGridColumn Property="BatchNoExpiryDate" Width="120px" Title="Expiry Date" FormatString="{0:MM/dd/yyyy}" />
                                            <RadzenDataGridColumn Property="BalanceQty" Width="100px" Title="Balance">
                                                <Template Context="item">
                                                    @(item.BalanceQty == 0 ? "" : item.BalanceQty?.ToString("N4"))
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </RadzenPopup>

                                <RadzenButton Icon="more_horiz" ButtonStyle="ButtonStyle.Primary" />
                            </RadzenStack>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockOutDetails"
                                          Width="7rem"
                                          Property="@nameof(StockOutDetails.Qty)"
                                          Title="Qty"
                                          TextAlign="TextAlign.Center">

                        <Template Context="stockoutdetails">
                            @(stockoutdetails.Qty.HasValue ? stockoutdetails.Qty.Value.ToString("N4") : "")
                        </Template>

                        <EditTemplate Context="stockoutdetails">
                            <RadzenNumeric Disabled="@IsDisable"
                                           Style="width:100%; font-size:12px"
                                           TValue="decimal?"
                                           @bind-Value="stockoutdetails.Qty"
                                           Change="@(args => OnQtyChanged(stockoutdetails, args))"
                                           Format="N4" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="5rem" TItem="StockOutDetails" Property="@nameof(StockOutDetails.UOMId)" Title="UOM" TextAlign="TextAlign.Center">
                        <Template Context="stockoutdetails">
                            @{
                                var uoms = uomsList?.FirstOrDefault(u => u.Id == stockoutdetails.UOMId);
                            }
                            @uoms?.UOMCode
                        </Template>
                        <EditTemplate Context="stockoutdetails">
                            <RadzenDropDownDataGrid Disabled="@IsDisable"
                                                    @bind-Value="stockoutdetails.UOMId"
                                                    Style="width:100%; font-size:12px"
                                                    PageSize="10"
                                                    Data="@GetUOMsForStock(stockoutdetails.StockId)"
                                                    AllowVirtualization="true"
                                                    AllowColumnResize="true"
                                                    AllowClear="true"
                                                    AllowSorting="false"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="UOMCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="UOMCode" Title="UOM #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description" />
                                </Columns>

                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockOutDetails" Property="@nameof(StockOutDetails.Price)" Title="Unit Price" TextAlign="TextAlign.Center">
                        <Template Context="stockoutdetails">
                            @(stockoutdetails.Price.HasValue ? stockoutdetails.Price.Value.ToString("N8") : "")
                        </Template>
                        <EditTemplate Context="stockoutdetails">
                            <RadzenNumeric Disabled="@IsDisable"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           @bind-Value="stockoutdetails.Price"
                                           Change="@(args => OnUnitPriceChanged(stockoutdetails, args))"
                                           Format="#.00000000" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem"
                                          TItem="StockOutDetails"
                                          Property="@nameof(StockOutDetails.Amount)"
                                          Title="Amount"
                                          TextAlign="TextAlign.Center">

                        <Template Context="d">
                            @if (d.Amount.HasValue)
                            {
                                var amount = d.Amount.Value;

                                @((amount < 0) ? $"({Math.Abs(amount):N2})" : amount.ToString("N2"))
                            }
                        </Template>

                        <EditTemplate Context="stockoutdetails">
                            <RadzenNumeric Disabled="true"
                                           TValue="decimal?"
                                           Value="stockoutdetails.Amount"
                                           Style="width: 100%; font-size:12px"
                                           Format="N2" />
                        </EditTemplate>

                        <FooterTemplate>
                            <b>
                                @((stockoutsDetailsGrid.View.Sum(x => x.Amount) ?? 0).ToString("N2"))
                            </b>
                        </FooterTemplate>

                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem"
                                          TItem="StockOutDetails"
                                          Property="@nameof(StockOutDetails.Ref1)"
                                          Title="Ref 1"
                                          TextAlign="TextAlign.Center">

                        <EditTemplate Context="stockoutdetails">
                            <RadzenTextBox class="@redtext"
                                           Style="width:100%; font-size:12px"
                                           @bind-Value="stockoutdetails.Ref1" />
                        </EditTemplate>

                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem"
                                          TItem="StockOutDetails"
                                          Property="@nameof(StockOutDetails.Ref2)"
                                          Title="Ref 2"
                                          TextAlign="TextAlign.Center">

                        <EditTemplate Context="stockoutdetails">
                            <RadzenTextBox class="@redtext"
                                           Style="width:100%; font-size:12px"
                                           @bind-Value="stockoutdetails.Ref2" />
                        </EditTemplate>

                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockOutDetails"
                                          Width="7rem"
                                          Property="@nameof(StockOutDetails.ProjectId)"
                                          Title="Project"
                                          TextAlign="TextAlign.Center">

                        <Template Context="stockoutdetails">
                            @{
                                var project = projectList?
                                    .FirstOrDefault(p => p.Id == stockoutdetails.ProjectId);
                            }
                            @project?.ProjectCode
                        </Template>

                        <EditTemplate Context="stockoutdetails">
                            <RadzenDropDownDataGrid class="@redtext"
                                                    @bind-Value="stockoutdetails.ProjectId"
                                                    AllowSorting="false"
                                                    Style="width:100%;"
                                                    PageSize="10"
                                                    Data="@projectList"
                                                    AllowVirtualization="true"
                                                    AllowColumnResize="true"
                                                    AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="ProjectCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code" />
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data2">
                                            <RadzenCheckBox TValue="bool" Value="data2.IsActive" />
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>

                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="11rem" TItem="StockOutDetails"
                                          Property="@nameof(StockOutDetails.StockLocationId)"
                                          Title="Location"
                                          TextAlign="TextAlign.Center">

                        <!-- Display Location Code -->
                        <Template Context="stockoutdetails">
                            @{
                                var location = stocklocationList?.FirstOrDefault(l => l.Id == stockoutdetails.StockLocationId);
                            }
                            @location?.LocationCode
                        </Template>

                        <EditTemplate Context="stockoutdetails">
                            <RadzenDropDownDataGrid class="@redtext"
                                                    @bind-Value="stockoutdetails.StockLocationId"
                                                    AllowSorting="false"
                                                    Style="width:120%;"
                                                    PageSize="10"
                                                    Data="@stocklocationList"
                                                    AllowVirtualization="true"
                                                    AllowColumnResize="true"
                                                    AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="LocationCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data">
                                            <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>

                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="100px" TextAlign="TextAlign.Center" Property="Action" Title="Action">
                        <Template Context="stockoutdetails">
