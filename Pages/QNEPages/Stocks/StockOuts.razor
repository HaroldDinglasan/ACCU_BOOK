        }

        // Auto set Location when selecting stock code
        if (selectedStock.DefaultLocationId.HasValue)
        {
            stockoutdetails.StockLocationId = selectedStock.DefaultLocationId.Value;
        }

        var baseUOM = uomsList?.FirstOrDefault(
            u => u.StockId == selectedStockId &&
            u.UOMCode == selectedStock.BaseUOM);

        if (baseUOM != null)
            stockoutdetails.UOMId = baseUOM.Id;

        // AUTO POPULATE UNIT PRICE
        var latestUnitPrice = await stockItemsService.GetLatestUnitPriceStockOut(selectedStockId);

        stockoutdetails.UnitPrice = latestUnitPrice ?? 0;
        stockoutdetails.Price = stockoutdetails.UnitPrice;

        StockTransactionNumberHelper.Compute(stockoutdetails);

        // BUNDLE: show the sub items (from StockBundles) under this row
        if (selectedStock.IsBundled == true)
        {
            await ExpandBundle(selectedStockId, stockoutdetails);
        }
        else
        {
            // user changed from a bundle to a normal stock -> clear old sub items
            stockoutdetails.IsBundled = false;
            RemoveSubItems(stockoutdetails);

            // OPEN BATCH MODAL
            if (ShouldOpenBatchDialog(selectedStock))
            {
                await OpenStockBatchDialog(selectedStockId, stockoutdetails);
            }
        }

        StateHasChanged();
    }

