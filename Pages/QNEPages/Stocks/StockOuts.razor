    private void OnQtyChanged(StockOutDetails item, object value)
    {
        if (value is decimal newQty)
        {
            item.Qty = newQty;
            StockTransactionNumberHelper.Compute(item);
        }

        // if this is a bundle parent, rescale its sub items (bundle Qty x parent Qty)
        if (item.IsBundled == true && item.IsSubItem != true && item.StockId != null
            && bundleCache.TryGetValue(item.StockId.Value, out var defs))
        {
            foreach (var child in stockOutDetails
                         .Where(x => x.IsSubItem == true && x.BundledTransactionId == item.Id))
            {
                var def = defs.FirstOrDefault(d => d.SubItemId == child.StockId);
                if (def == null) continue;

                child.Qty = ((decimal?)def.Qty ?? 0m) * (item.Qty ?? 0m);
                StockTransactionNumberHelper.Compute(child);
            }
        }

        stockoutsDetailsGrid?.Reload();
    }

