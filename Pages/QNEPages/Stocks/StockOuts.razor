        if (stockoutDetailsToInsert.Any() || stockoutDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService,
                "Unsaved Details",
                "Save current row first.");
            return;
        }

        var newRow = new StockOutDetails

        {
            Id = Guid.NewGuid(),
            StockOutId = Id ?? stockOutsmodel.Id,
            Pos = currentRow?.Pos + 1 ?? 1
        };

        // 🔥 IMPORTANT: insert into actual grid source
        if (currentRow != null)
        {
            var index = stockOutDetails.IndexOf(currentRow);

            if (index >= 0)
                stockOutDetails.Insert(index + 1, newRow);
            else
                stockOutDetails.Add(newRow);
        }
        else
        {
            stockOutDetails.Add(newRow);
        }

        stockoutDetailsToInsert.Add(newRow);

        await stockoutsDetailsGrid.Reload();

        // ADDED 09/30/2026
        stockbatchnumbercode = string.Empty;
        batchSearchText = string.Empty;

        await stockoutsDetailsGrid.EditRow(newRow);

        StateHasChanged();

    }

    // JUNE 17, 2026
    async Task EditRow(StockOutDetails stockoutDetails)
    {
        if (!stockoutsDetailsGrid.IsValid)
            return;

        bool anotherRowActive =
             stockoutDetailsToInsert.Any(x => x != stockoutDetails) ||
            stockoutDetailsToUpdate.Any(x => x != stockoutDetails);

        if (anotherRowActive)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Unsaved Row",
                Detail = "Please save or cancel the current active row before editing another."
            });
            return;
        }

        if (!stockoutDetailsToUpdate.Contains(stockoutDetails))
        {
            stockoutDetailsToUpdate.Add(stockoutDetails);
        }

        // ADDED 09/30/2026
        stockbatchnumbercode = GetBatchNo(stockoutDetails.StockBatchNumberId);
        batchSearchText = string.Empty;

        await stockoutsDetailsGrid.EditRow(stockoutDetails);
        StateHasChanged();
    }

    async Task SaveRow(StockOutDetails stockoutDetails)
    {
        // This method is called when the user clicks the 'Save' (checkmark) button for a row in the grid
        await stockoutsDetailsGrid.UpdateRow(stockoutDetails);
        await stockoutsDetailsGrid.Reload();
        StateHasChanged();
    }

    void Reset(StockOutDetails stockoutDetails)
    {
        stockoutDetailsToInsert.Remove(stockoutDetails);
        stockoutDetailsToUpdate.Remove(stockoutDetails);
    }

    void Reset()
    {
        stockoutDetailsToInsert.Clear();
        stockoutDetailsToUpdate.Clear();
    }

    // OCTOBER 22 2026
    // MODIFIED
    async Task DeleteRow(StockOutDetails stockoutDetails)
    {
        Reset(stockoutDetails);

        if (stockoutDetails.IsBundled == true && stockoutDetails.IsSubItem != true)
            RemoveSubItems(stockoutDetails);

        stockOutDetails.Remove(stockoutDetails);
        ResetPosIndexes();

        await stockoutsDetailsGrid.Reload();
        StateHasChanged();
    }

    protected async Task RefreshGrid()
    {
        // Refresh the grid
        await stockoutsDetailsGrid.Reload();
    }

    // Computation of Amount (QTY * UNIT PRICE)
    private void OnAmountChanged(StockOutDetails row)
    {
        StockTransactionNumberHelper.Compute(row);
    }

    // OCTOBER 22 2026
    // bundle definitions cache: parent StockId -> its sub items from StockBundles
    private Dictionary<Guid, List<StockBundlesModel>> bundleCache = new();

    private async Task<List<StockBundlesModel>> GetBundleItems(Guid stockId)
    {
        if (!bundleCache.TryGetValue(stockId, out var items))
        {
            var data = await stockItemsService.GetStockBundlesById(stockId.ToString());
            items = data?.ToList() ?? new List<StockBundlesModel>();
            bundleCache[stockId] = items;
        }
        return items;
    }

    // OCTOBER 22 2026
    // remove sub items that belong to this parent row
    private void RemoveSubItems(StockOutDetails parent)
    {
        stockOutDetails.RemoveAll(x => x.IsSubItem == true && x.BundledTransactionId == parent.Id);
    }

    // OCTOBER 22 2026
    // insert the bundle's sub items directly under the parent row
    private async Task ExpandBundle(Guid stockId, StockOutDetails parent)
    {
        RemoveSubItems(parent);

        var items = await GetBundleItems(stockId);
        if (!items.Any())
        {
            parent.IsBundled = false;
            return;
        }

        parent.IsBundled = true;
        var index = stockOutDetails.IndexOf(parent);

        foreach (var b in items.OrderBy(x => x.Pos))
        {
            var subStock = stockList?.FirstOrDefault(s => s.Id == b.SubItemId);
            var cost = (decimal?)b.UnitCost ?? 0m;

            var child = new StockOutDetails
            {
                Id = Guid.NewGuid(),
                StockOutId = Id ?? stockOutsmodel.Id,
                StockId = b.SubItemId,
                Description = string.IsNullOrWhiteSpace(b.Description) ? subStock?.StockName : b.Description,
                ItemTypeCode = subStock?.ItemTypeCode,
                UOMId = b.UOMId,
                StockLocationId = b.StockLocationId ?? parent.StockLocationId ?? stockOutsmodel.StockLocationId,
                ProjectId = b.ProjectId ?? parent.ProjectId,
                Price = cost,
                UnitPrice = cost,
                Qty = ((decimal?)b.Qty ?? 0m) * (parent.Qty ?? 1m),
                IsSubItem = true,
                IsBundled = true,
                BundledTransactionId = parent.Id
            };

            StockTransactionNumberHelper.Compute(child);
            stockOutDetails.Insert(++index, child);
        }

        ResetPosIndexes();
        await stockoutsDetailsGrid.Reload();
    }




