    private async Task LoadTaxCodes()
    {
        try
        {
            var taxResult = await taxCodeService.GetFilteredTaxCodes();

            if (taxResult != null)
            {
                filterTaxCodeResult = taxResult;
                inputTaxCodesList = taxResult.InputTaxCodes ?? new List<TaxCodes>();
                outputTaxCodesList = taxResult.OutputTaxCodes ?? new List<TaxCodes>();

                isDataLoaded = true;
                await InvokeAsync(StateHasChanged);

                Console.WriteLine($"✅ Input Tax Codes loaded: {inputTaxCodesList.Count}");
                Console.WriteLine($"✅ Output Tax Codes loaded: {outputTaxCodesList.Count}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading tax codes: {ex.Message}");
            inputTaxCodesList = new List<TaxCodes>
            ();
            outputTaxCodesList = new List<TaxCodes>
            ();
        }
    }

