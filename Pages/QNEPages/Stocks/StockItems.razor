    // INSERT ROW
    async Task InsertUOMRow(UOMs uoms)
    {
        if (uomsDetailsToInsert.Any() || uomsDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }
        if (!uomsDetailsGrid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var uomsnew = new UOMs();
        uomsnew.StockId = Id ?? stockitemsmodel.Id;
        uomsDetailsToInsert.Add(uomsnew);

        var index = multiuomsList.IndexOf(uoms);
        if (index >= 0)
        {

            multiuomsList.Insert(index + 1, uomsnew); // Insert after selected row
        }
        else
        {
            uomsnew.UOMCode = stockitemsmodel.BaseUOM;
            // uomsnew.IsBaseUOM = true;
            // uomsnew.Description = "--BASE UOM--";
            multiuomsList.Add(uomsnew);
        }
        ResetPosIndexes();
        await uomsDetailsGrid.InsertAfterRow(uomsnew, uoms);
        await uomsDetailsGrid.Reload();
        StateHasChanged();


    }


    // Helper to reset Pos index after any add/delete
    private void ResetPosIndexes()
    {
        for (int i = 0; i < multiuomsList.Count; i++)
        {
            multiuomsList[i].Pos = i + 1;
        }
    }

