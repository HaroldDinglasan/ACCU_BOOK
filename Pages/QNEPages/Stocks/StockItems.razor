        new ModuleOption { Text = "Stock", Value = "Stock" },
        new ModuleOption { Text = "POS", Value = "POS" }
    };


    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }
    protected override async Task OnInitializedAsync()
    {

        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            //For update

            var RoleId = authState.FindFirst("RoleId").Value;
            GetLoadMenuPermission(RoleId);
        }


    }



    private SystemMenuObjectPermission? permission;
    protected async void GetLoadMenuPermission(string RoleId)
    {
        isloading = true;
        permission = await permissionService.GetPermissionAsync(
         RoleId,
         "Stock Items");

        if (permission is null)
            return;




        InitializeUOMsRows();
        await loadAllData();
        if (Id is not null)
        {
            await loadAllDataById();
        }
        else
        {
            selectedModules = new List<string>();
        }


        StateHasChanged();
    }



    private IEnumerable<string> selectedModules = new List<string>();

    public class ModuleOption
    {
        public string Text { get; set; }
        public string Value { get; set; }
    }

    // Multiple Selection Dropdown for Display In Modules (Others Tab))
    private void OnModulesChanged(object value)
    {
        if (value is IEnumerable<string> modules)
        {
            var modulesList = modules.ToList();

            if (modulesList.Contains("SelectAll"))
            {
                // If "Select All" is selected, select all other modules
                selectedModules = moduleOptions.Where(m => m.Value != "SelectAll").Select(m => m.Value).ToList();
            }
            else
            {
                // If "Select All" is not selected, use the selected modules
                selectedModules = modulesList;
            }

            // comma for slected modules
            stockitemsmodel.DisplayInModules = string.Join(",", selectedModules);
        }
    }

    // Batch No Check Box
    private void OnUseBatchNoChanged(bool value)
    {
        stockitemsmodel.UseBatchNo = value;

        if (value)
        {
            // When Use Batch No is checked, automatically check Use Default Unsalable Period
            stockitemsmodel.UseDefaultUnsalablePeriod = true;
            stockitemsmodel.UnsalablePeriod = 0;
        }
        else
        {
            // When Use Batch No is unchecked, uncheck Use Default Unsalable Period
            stockitemsmodel.UseDefaultUnsalablePeriod = false;
            stockitemsmodel.UnsalablePeriod = 0;
        }
    }

    // Batch No (Use Default Unsalable Period Check Box)
    private void OnUseDefaultUnsalablePeriodChanged(bool value)
    {
        stockitemsmodel.UseDefaultUnsalablePeriod = value;

        if (value)
        {
            // Reset UnsalablePeriod if user chooses default
            stockitemsmodel.UnsalablePeriod = 0;
        }
        else
        {
            stockitemsmodel.UnsalablePeriod = 0;
        }
    }

    private async Task OnStockBundleChanged(object stockId, StockBundlesModel stockBundlesModel)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);
            if (selectedStock is not null)
            {
                // // Set Description to StockName
                // stockBundlesModel.Description = selectedStock.StockName;
                // stockBundlesModel.StockId = selectedStockId;
                // // Set Qty to default 1.0000
                // stockBundlesModel.Qty = 1.0000m;

                // // Set the base UOM for the selected stock
                // var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStockId && u.UOMCode == selectedStock?.BaseUOM);
                // if (baseUOM != null)
                // {
                //     stockBundlesModel.UOMId = baseUOM.Id;
                // }


                stockBundlesModel.Description = selectedStock.StockName;
                stockBundlesModel.StockId = stockitemsmodel.Id;
                stockBundlesModel.SubItemId = selectedStock.Id;
                // Set Qty to default 1.0000
                stockBundlesModel.Qty = 1.0000m;

                // Set the base UOM for the selected stock
                var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStock.Id && u.UOMCode == selectedStock.BaseUOM);
                if (baseUOM != null)
                {
                    stockBundlesModel.UOMId = baseUOM.Id;
                }


            }
        }
        else
        {
            stockBundlesModel.Description = string.Empty;
            stockBundlesModel.SubItemId = Guid.Empty;
            stockBundlesModel.UOMId = null;
            stockBundlesModel.Qty = 0.0000M;
            stockBundlesModel.UnitPrice = 0.0000M;
            stockBundlesModel.UnitCost = 0.0000M;
            stockBundlesModel.SalesPrice = 0.0000M;
            stockBundlesModel.PurchasesCost = 0.0000M;
            stockBundlesModel.ProjectId = null;
            stockBundlesModel.StockLocationId = null;

        }

        StateHasChanged();
    }



