@page "/StockItems"
@page "/StockItemsList/Edit/{id:guid}"

@attribute [Authorize(Roles = "Admin,User")]
 

@if (isloading)
{
    <Spinner />
}



<RadzenTemplateForm TItem="Stocks" Data="@stockitemsmodel" Submit="@OnSubmit">
    <RadzenStack Gap="0.5rem">
        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">

                <RadzenColumn Size="12" SizeSM="5">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        <RadzenButton Size="ButtonSize.Small" Disabled="@isDisable" IsBusy="@isBusy" ButtonType="ButtonType.Submit" BusyText="Saving..." Text="Save" Icon="save"></RadzenButton>

                        <RadzenButton Visible="@btnDiseabled" Text="New" Icon="add" Size="@smallbtn"
                                      ButtonStyle="ButtonStyle.Success"
                                      ButtonType="@Radzen.ButtonType.Button"
                                      Click="@OnNew" />

                        <RadzenButton Size="ButtonSize.Small" Visible="@isVisible" ButtonStyle="ButtonStyle.Danger" Click="@navigate" Text="Cancel" Icon="cancel"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@navigate" Text="Search" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>

        <RadzenCard>

            <RadzenStack Gap="0.5rem">

                <RadzenRow AlignItems="@alignItems">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Stock #" Style="width: 100%;" AllowFloatingLabel="false">
                            <RadzenTextBox Name="StockCode"
                                           Change="@CheckCodeIsExist"
                                           @bind-Value=@stockitemsmodel.StockCode
                                           Disabled=@(Id is not null)
                                           Style=" width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="StockCode" Text="Stock # must be not empty" Popup="false" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <small>Stock Control</small>
                        @* <RadzenCheckBox @bind-Value=@stockitemsmodel.StockControl Name="Stock Control"></RadzenCheckBox>  *@
                        <RadzenSwitch Style="transform: scale(0.7);" @bind-Value=@stockitemsmodel.StockControl Name="Stock Control" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="2">
                        <small>Active</small>
                        @*  <RadzenCheckBox @bind-Value=@stockitemsmodel.IsActive Name="Active"></RadzenCheckBox>  *@
                        <RadzenSwitch Style="transform: scale(0.7);" @bind-Value=@stockitemsmodel.IsActive Name="Active" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                            <RadzenDropDownDataGrid class="@redtext" @bind-Value=@stockitemsmodel.DefaultLocationId AllowSorting="false" Style="width: 120%;" PageSize=10 Data="@stocklocationList" AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="LocationCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data"><RadzenCheckBox TValue="bool" Value="data.IsActive"></RadzenCheckBox></Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </RadzenFormField>
                    </RadzenColumn>


                </RadzenRow>

                <RadzenRow AlignItems="@alignItems">
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="Stock Name" Style="width: 100%;" AllowFloatingLabel="false">
                            <RadzenTextBox Name="StockName"
                                           @bind-Value=@stockitemsmodel.StockName
                                           Style=" width: 100%;" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="StockName" Text="StockName must be not empty" Popup="false" />
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Category" Style="width: 100%;" AllowFloatingLabel="false">
                            <RadzenDropDownDataGrid @bind-Value=@stockitemsmodel.CategoryId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@stockCategoryList"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true" AllowVirtualization="true"
                                                    TextProperty="CategoryCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="4%" Property="CategoryCode" Title="Category #"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>

                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>


                <RadzenRow AlignItems="@alignItems">
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Style="width: 100%;">
                            <RadzenTextBox @bind-Value=@stockitemsmodel.StockName2 Style=" width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Group" Style="width: 100%;" AllowFloatingLabel="false">
                            <RadzenDropDownDataGrid @bind-Value=@stockitemsmodel.GroupId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@stockGroupsList"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true" AllowVirtualization="true"
                                                    TextProperty="GroupCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="4%" Property="GroupCode" Title="Group #"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow AlignItems="@alignItems">
                    <RadzenColumn Size="12" SizeMD="8">
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Class" Style="width: 100%;" AllowFloatingLabel="false">
                            <RadzenDropDownDataGrid @bind-Value=@stockitemsmodel.ClassId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@stockClassesList"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true" AllowVirtualization="true"
                                                    TextProperty="ClassCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="4%" Property="ClassCode" Title="Class #"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>

                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow AlignItems="@alignItems">
                    <RadzenColumn Size="12" SizeMD="1">
                        <RadzenText TextStyle="@textStyle" Text="Created Date" AllowFloatingLabel="false"></RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenDatePicker Style=" width: 100%;" DateFormat="MM/dd/yyyy" @bind-Value=@stockitemsmodel.CreateDate></RadzenDatePicker>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="3">
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Preset Code" Style="width: 100%;" AllowFloatingLabel="false">
                            <RadzenDropDownDataGrid Name="PresetCode"
                                                    @bind-Value=@stockitemsmodel.StockAccountPresetId
                                                    AllowSorting="false" Style="width: 100%;"
                                                    PageSize=10 Data="@stockAccountPresetsList"
                                                    AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    AllowVirtualization="true"
                                                    TextProperty="PresetCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="4%" Property="PresetCode" Title="Preset #"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="PresetCode" Text="PresetCode must be not empty" Popup="false" />
                    </RadzenColumn>

                </RadzenRow>

                <RadzenTabs RenderMode="TabRenderMode.Client">
                    <Tabs>
                        <RadzenTabsItem Text="Details">
                            <RadzenRow AlignItems="AlignItems.Normal">

                                <RadzenColumn Size="12" SizeMD="6">


                                    <RadzenStack Gap="0.1rem">
                                        <RadzenFormField Text="UOM #" Style="width: 100%;">
                                            <RadzenTextBox Change="@ChangeUOMCode" @bind-Value=@stockitemsmodel.BaseUOM Style=" width: 100%;"></RadzenTextBox>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Sales Price" Style="width: 100%;">
                                            <RadzenNumeric ShowUpDown="false" @bind-Value=@stockitemsmodel.ListPrice Format="@formatnumber" Style=" width: 100%;"></RadzenNumeric>

                                        </RadzenFormField>
                                        <RadzenFormField Text="Sales Discount" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value=@stockitemsmodel.SalesDiscount Style=" width: 100%;"></RadzenTextBox>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Last Selling Price" Style="width: 100%;">
                                            <RadzenNumeric Disabled=true ShowUpDown="false" @bind-Value=@stockPurchasePrice.Price Format="@formatnumber" Style=" width: 100%;"></RadzenNumeric>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Volume" Style="width: 100%;">
                                            <RadzenNumeric ShowUpDown="false" @bind-Value=@stockitemsmodel.Volumn Style=" width: 100%;"></RadzenNumeric>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Floor Price" Style="width: 100%;">
                                            <RadzenNumeric ShowUpDown="false" @bind-Value=@stockitemsmodel.FloorPrice Format="@formatnumber" Style=" width: 100%;"></RadzenNumeric>
                                        </RadzenFormField>


                                    </RadzenStack>

                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.1rem">
                                        <RadzenFormField Text="Min Price" Style="width: 100%;">
                                            <RadzenNumeric ShowUpDown="false" @bind-Value=@stockitemsmodel.MinPrice Format="@formatnumber" Style=" width: 100%;"></RadzenNumeric>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Purchase Price" Style="width: 100%;">
                                            <RadzenNumeric ShowUpDown="false" @bind-Value=@stockitemsmodel.PurchasePrice Format="@formatnumber" Style=" width: 100%;"></RadzenNumeric>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Purchase Discount" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value=@stockitemsmodel.PurchaseDiscount Style=" width: 100%;"></RadzenTextBox>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Last Purchase Price" Style="width: 100%;">
                                            <RadzenNumeric Disabled=true ShowUpDown="false" @bind-Value=@stockSellingPrice.Price Format="@formatnumber" Style=" width: 100%;"></RadzenNumeric>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Weight" Style="width: 100%;">
                                            <RadzenNumeric ShowUpDown="false" @bind-Value=@stockitemsmodel.Weight Format="@formatnumber" Style=" width: 100%;"></RadzenNumeric>
                                        </RadzenFormField>
                                    </RadzenStack>
                                </RadzenColumn>

                                @*   Continuation--------- *@
                            </RadzenRow>
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Multi-UOMs">

                            <RadzenDataGrid EditMode="@editMode" @ref="uomsDetailsGrid" Style="width: 100%; font-size:12px"
                                            Data="@multiuomsList" AllowColumnResize=true RowCreate="@OnCreateUOMRow"
                                            TItem="UOMs" Density="@density" RowUpdate="@OnUpdateUOMRow"
                                            CellDoubleClick="@(args => EditUOMRow(args.Data))">

                                <HeaderTemplate>
                                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add UOMs" Size="ButtonSize.ExtraSmall" Click="@(() => InsertUOMRow(multiuomsList.LastOrDefault()))" Disabled="@(uomsDetailsToUpdate.Any())" />
                                    @* <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" Text="Search" Icon="search" />
                                        <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" Text="Print" Icon="print" /> *@
                                </HeaderTemplate>

                                <Columns>

                                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                                        <Template Context="uom">
                                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => EditUOMRow(uom))" title="Edit this row" />
                                           
                                        </Template>
                                        <EditTemplate Context="uom">
                                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" class="rz-my-1 rz-ms-1" Click="@((args) => SaveUOMRow(uom))" title="Save" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Visible=false Width="9rem" TItem="UOMs" Property="@nameof(UOMs.Id)" Title="Id" TextAlign="TextAlign.Center" />
                                    <RadzenDataGridColumn Visible=false Width="9rem" TItem="UOMs" Property="@nameof(UOMs.StockId)" Title="StockId" TextAlign="TextAlign.Center" />
                                    <RadzenDataGridColumn Width="9rem" TItem="UOMs" Property="@nameof(UOMs.UOMCode)" Title="UOM Code" TextAlign="TextAlign.Center">
                                        <EditTemplate Context="uom">
                                            <RadzenTextBox Style="width: 100%; font-size:12px" Change=@ChangeUOMCode @bind-Value="uom.UOMCode"></RadzenTextBox>
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Visible=false Width="9rem" TItem="UOMs" Property="@nameof(UOMs.BarCode)" Title="Bar Code" TextAlign="TextAlign.Center">
                                        <EditTemplate Context="uom">
                                            <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="uom.BarCode"></RadzenTextBox>
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="8rem" TItem="UOMs" Property="@nameof(UOMs.Rate)" TextAlign="TextAlign.Right" Title="Rate">
                                        <Template Context="uom">
                                            @(uom.Rate == 0 ? "" : uom.Rate.ToString("#,0.0000")) @stockitemsmodel.BaseUOM
                                        </Template>
                                        <EditTemplate Context="uom">
                                            <RadzenNumeric Style="width: 100%; font-size:12px" TValue="decimal" @bind-Value="uom.Rate" Format="#0.0000" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="9rem" TItem="UOMs" Property="@nameof(UOMs.Description)" Title="Description" TextAlign="TextAlign.Center">
                                        <EditTemplate Context="uom">
                                            <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="uom.Description"></RadzenTextBox>
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="9rem" TItem="UOMs" Property="@nameof(UOMs.SalesPrice)" Title="Sales Price" TextAlign="TextAlign.Center">
                                        <Template Context="uom">
                                            @(uom.SalesPrice == 0 ? "" : uom.SalesPrice.ToString(formatnumber))
                                        </Template>
                                        <EditTemplate Context="uom">
                                            <RadzenNumeric Style="width: 100%; font-size:12px" TValue="decimal" @bind-Value="uom.SalesPrice" Format="#0.00000000" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="9rem" TItem="UOMs" Property="@nameof(UOMs.PurchasePrice)" Title="Purchase Price" TextAlign="TextAlign.Center">
                                        <Template Context="uom">
                                            @(uom.PurchasePrice == 0 ? "" : uom.PurchasePrice.ToString(formatnumber))
                                        </Template>
                                        <EditTemplate Context="uom">
                                            <RadzenNumeric Style="width: 100%; font-size:12px" TValue="decimal" @bind-Value="uom.PurchasePrice" Format="#0.00000000" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="8rem" TItem="UOMs" Property="@nameof(UOMs.SalesDiscount)" Title="Sales Discount" TextAlign="TextAlign.Center">
                                        <EditTemplate Context="uom">
                                            <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="uom.SalesDiscount"></RadzenTextBox>
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="8rem" TItem="UOMs" Property="@nameof(UOMs.PurchaseDiscount)" Title="Purchase Discount" TextAlign="TextAlign.Center">
                                        <EditTemplate Context="uom">
                                            <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="uom.PurchaseDiscount"></RadzenTextBox>
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="9rem" TItem="UOMs" Property="@nameof(UOMs.MinSalesPrice)" Title="Min Sales Price" TextAlign="TextAlign.Center">
                                        <Template Context="uom">
                                            @(uom.MinSalesPrice == 0 ? "" : uom.MinSalesPrice.ToString(formatnumber))
                                        </Template>
                                        <EditTemplate Context="uom">
                                            <RadzenNumeric Style="width: 100%; font-size:12px" TValue="decimal" @bind-Value="uom.MinSalesPrice" Format="#0.00000000" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="6rem" TItem="UOMs" Property="@nameof(UOMs.IsActive)" Title="Active" TextAlign="TextAlign.Center">
                                        <Template Context="uom">
                                            <RadzenCheckBox Disabled=true @bind-Value="uom.IsActive"></RadzenCheckBox>
                                        </Template>
                                        <EditTemplate Context="uom">
                                            <RadzenCheckBox @bind-Value="uom.IsActive"></RadzenCheckBox>
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Title="Actions" FrozenPosition="FrozenColumnPosition.Right">
                                        <Template Context="uom">
                                            <RadzenButton Icon="delete" title="Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteUOMRow(uom))" Disabled="@(multiuomsList.Count == 1 || stockitemsmodel.IsActive is false)" />
                                        </Template>
                                     
                                    </RadzenDataGridColumn>

                                </Columns>
                            </RadzenDataGrid>

                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Stock Control">
                            <div class="p-3" style="display: grid; grid-template-columns: 150px 1fr 150px 1fr; gap: 10px; align-items: center;">

                                <RadzenLabel Text="Min Qty" />
                                <RadzenNumeric Disabled=@(!stockitemsmodel.StockControl) @bind-Value="stockitemsmodel.MinQty" TValue="decimal" Style="width: 100%;" Format="#0.0000" />


                                <RadzenLabel Text="Max Qty" />
                                <RadzenNumeric Disabled=@(!stockitemsmodel.StockControl) @bind-Value="stockitemsmodel.MaxQty" TValue="decimal" Style="width: 100%;" Format="#0.0000" />


                                <RadzenLabel Text="Reorder Level" />
                                <RadzenNumeric Disabled=@(!stockitemsmodel.StockControl) @bind-Value="stockitemsmodel.ReorderLevel" TValue="decimal" Style="width: 100%;" Format="#0.0000" />


                                <RadzenLabel Text="Reorder Qty" />
                                <RadzenNumeric Disabled=@(!stockitemsmodel.StockControl) @bind-Value="stockitemsmodel.ReorderQty" TValue="decimal" Style="width: 100%;" Format="#0.0000" />


                                <RadzenLabel Text="Stock Control by Location" />
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <RadzenButton Text="Setting" ButtonStyle="ButtonStyle.Secondary" Disabled="true" />
                                    <RadzenCheckBox @bind-Value="stockitemsmodel.AllowNegativeStock" TValue="bool" />
                                    <RadzenLabel Text="Allow Negative Stock" />
                                </div>


                                <RadzenLabel Text="Balance" />
                                <RadzenNumeric @bind-Value="stockitemsmodel.CurrentBalance" TValue="decimal" Style="width: 100%;" Format="#0.0000" Disabled="false" />

                            </div>
                        </RadzenTabsItem>

                        @* <RadzenTabsItem Text="Serial No">
                            <div class="p-3" style="display: grid; grid-template-columns: 150px 1fr; gap: 10px; align-items: center;">


                                <RadzenLabel Text="Use Serial No" />
                                <RadzenCheckBox @bind-Value="stockItems.UseSerialNo" TValue="bool" />


                                <RadzenLabel Text="Serial No Prefix" />
                                <RadzenTextBox @bind-Value="stockItems.SerialNoPrefix"
                                               Style="width: 100%;"
                                               Disabled="@(stockItems.UseSerialNo == false)" />

                                <RadzenLabel Text="Serial No Suffix" />
                                <RadzenTextBox @bind-Value="stockItems.SerialNoSuffix"
                                               Style="width: 100%;"
                                               Disabled="@(stockItems.UseSerialNo == false)" />

                            </div>
                        </RadzenTabsItem> *@

                        <RadzenTabsItem Text="Batch No">
                            <div class="p-3" style="display: grid; grid-template-columns: 150px 1fr; gap: 10px; align-items: center;">

                                <RadzenLabel Text="Use Batch No" />
                                <RadzenCheckBox @bind-Value="stockitemsmodel.UseBatchNo" TValue="bool"
                                                Change="@(args => OnUseBatchNoChanged(args))" />

                                <RadzenLabel Text="Use Default Unsalable Period" />
                                <RadzenCheckBox @bind-Value="stockitemsmodel.UseDefaultUnsalablePeriod" TValue="bool"
                                                Disabled="!stockitemsmodel.UseBatchNo"
                                                Change="@(args => OnUseDefaultUnsalablePeriodChanged(args))" />

                                <RadzenLabel Text="Unsalable Period (days)" />
                                <RadzenNumeric @bind-Value="stockitemsmodel.UnsalablePeriod"
                                               TValue="int"
                                               Disabled="!stockitemsmodel.UseBatchNo || stockitemsmodel.UseDefaultUnsalablePeriod"
                                               Style="width:100%;"
                                               ShowUpDown="false" />
                            </div>
                        </RadzenTabsItem>


                        <RadzenTabsItem Text="Default VAT">

                            <!-- Input Tax Dropdown -->
                            <RadzenRow AlignItems="@alignItems">
                                <RadzenColumn Size="12" SizeMD="6" Style="margin-bottom:20px;">
                                    <RadzenFormField Style="width:100%" Text="Input Tax" AllowFloatingLabel="false">
                                        <RadzenDropDownDataGrid class="@redtext"
                                                                @bind-Value="@taxCodesModel.InputTaxCodeId"
                                                                Data="@inputTaxCodesList"
                                                                TextProperty="TaxCode"
                                                                ValueProperty="Id"
                                                                AllowSorting="false"
                                                                Style="width: 100%;"
                                                                PageSize="10"
                                                                AllowVirtualization="true"
                                                                AllowColumnResize="true"
                                                                AllowClear="true"
                                                                FilterCaseSensitivity="@filter"
                                                                AllowFilteringByAllStringColumns="true"
                                                                Density="@density"
                                                                Placeholder="Select Input Tax Code">

                                            <Columns>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="TaxCode" Title="VAT #"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="Rate" Title="Rate"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="VatType" Title="VAT Type"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="30%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>
                                </RadzenColumn>


                                <!-- Output Tax Dropdown -->
                                <RadzenColumn Size="12" SizeMD="6" Style="margin-bottom:20px;">
                                    <RadzenFormField Style="width:100%" Text="Output Tax" AllowFloatingLabel="false">
                                        <RadzenDropDownDataGrid class="@redtext"
                                                                @bind-Value="@taxCodesModel.OutputTaxCodeId"
                                                                Data="@outputTaxCodesList"
                                                                TextProperty="TaxCode"
                                                                ValueProperty="Id"
                                                                AllowSorting="false"
                                                                Style="width: 100%;"
                                                                PageSize="10"
                                                                AllowVirtualization="true"
                                                                AllowColumnResize="true"
                                                                AllowClear="true"
                                                                FilterCaseSensitivity="@filter"
                                                                AllowFilteringByAllStringColumns="true"
                                                                Density="@density"
                                                                Placeholder="Select Output Tax Code">

                                            <Columns>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="TaxCode" Title="VAT #"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="Rate" Title="Rate"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="VatType" Title="VAT Type"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="30%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>

                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenTabsItem>


                        <RadzenTabsItem Text="Stock Bundle">


                            <div style="margin-bottom: 10px;">
                                <RadzenLabel Text="Bundled" style="margin-right: 10px;" />
                                <RadzenSwitch Disabled="@(Id is not null)" Style="transform: scale(0.7);" @bind-Value="stockitemsmodel.IsBundled" Name="Bundled" />
                                @*   <RadzenCheckBox @bind-Value="stockitemsmodel.IsBundled" TValue="bool" /> *@
                            </div>


