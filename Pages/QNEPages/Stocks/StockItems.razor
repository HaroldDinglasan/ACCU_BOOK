    //LOAD DIFFERENT UOMS PER STOCK ON QUOTATION DETAILS
    private IEnumerable<UOMs> GetUOMsForStock(Guid? stockId)
    {
        if (stockId == null || uomsList == null)
            return Enumerable.Empty<UOMs>();
        return uomsList
            .Where(u => u.StockId == stockId)
            .OrderByDescending(u => u.IsBaseUOM);
    }
    private async Task OnSubmit()
    {
        if (isBusy) return;

        try
        {
            isBusy = true;

            var data = await stockItemsService.SaveStockHeader(stockitemsmodel);

            // Validate result agad
            if (string.IsNullOrEmpty(data) || !int.TryParse(data, out int result) || result <= 0)
            {
                await DialogService.Alert($"Error: {data}");
                return;
            }

            // Run dependent saves
            var uomTask = SaveUOMsList();
            var uomLinksTask = SaveStockUOMsLink();
            Task<string>? bundleTask = null;

            if (stockitemsmodel.IsBundled)
            {
                bundleTask = SaveStockBundleList();
            }

            // Await all tasks
            var uom = await uomTask;
            var uomlinks = await uomLinksTask;
            var stockbundle = bundleTask != null ? await bundleTask : "N/A";

            NotificationHelper.ShowInfo(notificationService, "Success", "Data Save!");
            // await DialogService.Alert($"{data}, {uom}, {uomlinks}, {stockbundle} and stock added!");

            isDisable = true;
        }
        catch (Exception ex)
        {
            await DialogService.Alert($"Unexpected error: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    
    }


