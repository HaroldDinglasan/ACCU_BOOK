    protected async Task loadAllDataById()
    {
        await GetStockItemsById();
        await GetLastSellingPriceById();
        await GetLastPurchasePriceById();
        await GetMultiUOMsById();
        await GetStockBundleById();

        if (!string.IsNullOrEmpty(stockitemsmodel.DisplayInModules))
        {
            selectedModules = stockitemsmodel.DisplayInModules.Split(',').Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
        }
        else
        {
            selectedModules = new List<string>();
        }

        isloading = false;
    }

    protected async Task loadAllData()
    {
        await GetStockList(); // This gets the stock list data from API
        await GetUOMSList();
        await GetStockCategory();
        await GetStockGroups();
        await GetStockClass();
        await GetLocationList();
        await GetProjectList();
        await GetStockAccountPresets();
        InitializeStockModel();
        await LoadTaxCodes();

        isloading = false;
    }



