@page "/StockOpeningBalance"
@page "/StockOpeningBalanceList/Edit/{id:guid}"
@attribute [Authorize(Roles = "Admin,User")]
@using Radzen.Blazor.Rendering

<RadzenTemplateForm TItem="StockOpeningBalanceModel" Data="stockopeningbalanceModel" Submit="@OnSubmit" InvalidSubmit="@OnInvalidSubmit">
    <RadzenStack Gap="0.2rem">
        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">

                <RadzenColumn Size="12" SizeSM="5">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                        <RadzenButton Size="@smallbtn" Icon="save" BusyText="Saving..." IsBusy=@busy ButtonStyle="ButtonStyle.Primary" Text="@btnText" ButtonType="@Radzen.ButtonType.Submit" />
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Seach" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>

            </RadzenRow>
        </RadzenCard>

        <RadzenCard>

            <div style="margin-bottom: 0.5rem">
                Stock Opening Balance @stockopeningbalanceModel.StockOBCode <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Details">
                        <RadzenRow>
                            <!-- LEFT SIDE -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value=@stockopeningbalanceModel.StockLocationId
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize=10
                                                                        Data="@stocklocationList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data">
                                                                <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                                            </Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Description" AllowFloatingLabel="false">
                                                <RadzenTextBox @bind-Value="stockopeningbalanceModel.Description"
                                                               Style="width:100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <!-- RIGHT SIDE -->
                            <RadzenColumn Size="12" SizeMD="6" Style="text-align:right">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetStockOpeningBalanceNo"
                                                                  @bind-Value="@stockopeningbalanceModel.StockOBDate"
                                                                  DateFormat="MM/dd/yyyy"
                                                                  Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" Style="display:flex; align-items:center;">
                                            <RadzenFormField Style="flex:1" Text="Stock OB #" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockopeningbalanceModel.StockOBCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="margin-left:5px" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@(args => popup.ToggleAsync(button.Element))" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockopeningbalanceModel.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Notes">
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenTextArea @bind-Value=@stockopeningbalanceModel.Notes
                                                            Rows="10"
                                                            Style="width:100%"
                                                            class="@redtext"
                                                            aria-label="TextArea" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>


            @* TABLE DETAILS*@
            <br />
            <RadzenDataGrid EditMode="@editMode" @ref="stockopeningbalanceDetailsGrid" 
                            Style="width: 100%; height:45vh; font-size:12px;"
                            AllowVirtualization="true"
                            Data="@stockOpeningBalanceDetails"
                            KeyProperty="Id"
                            AllowColumnResize=true 
                            RowCreate="@OnCreateRow"
                            TItem="StockOpeningBalanceDetails" 
                            Density="@density" 
                            RowUpdate="@OnUpdateRow">

                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New" Size="ButtonSize.ExtraSmall" Click="@(() => InsertAfterRow(stockOpeningBalanceDetails.LastOrDefault()))" title="Add new row after this row" Disabled="@(stockopeningbalanceDetailsToInsert.Any() || stockopeningbalanceDetailsToUpdate.Any())" />
                </HeaderTemplate>

                <Columns>

                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="stockopeningbalancedetails">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => EditRow(stockopeningbalancedetails))" title="Edit this row"/>

                        </Template>
                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(stockopeningbalancedetails))" title="Save" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible=false Width="5rem" TItem="StockOpeningBalanceDetails" Property="@nameof(StockOpeningBalanceDetails.Pos)" Title="Pos" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn Width="9rem" TItem="StockOpeningBalanceDetails" Property="@nameof(StockOpeningBalanceDetails.StockId)" Title="Stock Code" TextAlign="TextAlign.Center">
                        <Template Context="stockopeningbalancedetails">
                            @{
                                var stock = stockList?.FirstOrDefault(s => s.Id == stockopeningbalancedetails.StockId);
                            }
                            @stock?.StockCode
                        </Template>
                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenDropDownDataGrid @bind-Value="stockopeningbalancedetails.StockId"
                                                    Change="@(args => OnStockChanged(args, stockopeningbalancedetails))"
                                                    Style="width: 100%; font-size:12px" PageSize="10" Data="@stockList"
                                                    AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" AllowSorting="false"
                                                    FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="StockCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="StockCode" Title="Stock #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="StockName" Title="StockName" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="10rem" TItem="StockOpeningBalanceDetails" Property="@nameof(StockOpeningBalanceDetails.Description)" Title="Description" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width: 100%; font-size:12px" @bind-Value="stockopeningbalancedetails.Description"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockOpeningBalanceDetails" Property="@nameof(StockOpeningBalanceDetails.SerialNumber)" Title="Serial No" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width: 100%; font-size:12px" @bind-Value="stockopeningbalancedetails.SerialNumber"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn Width="7rem" TItem="StockOpeningBalanceDetails" Property="@nameof(StockOpeningBalanceDetails.UOMId)" Title="UOM" TextAlign="TextAlign.Center">
                        <Template Context="stockopeningbalancedetails">
                            @{
                                var uoms = uomsList?.FirstOrDefault(u => u.Id == stockopeningbalancedetails.UOMId);
                            }
                            @uoms?.UOMCode
                        </Template>
                        <EditTemplate Context="stockopeningbalancedetails">

                            <RadzenDropDownDataGrid Disabled="@IsDisable" @bind-Value="stockopeningbalancedetails.UOMId" Style="width: 100%; font-size:12px" PageSize="10" Data="@GetUOMsForStock(stockopeningbalancedetails.StockId)" AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" AllowSorting="false" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="UOMCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="UOMCode" Title="UOM #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn Width="11rem"
                                          TItem="StockOpeningBalanceDetails"
                                          Property="@nameof(StockOpeningBalanceDetails.Amount)"
                                          Title="Amount"
                                          TextAlign="TextAlign.Center">
                        <Template Context="stockopeningbalancedetails">
                            @(stockopeningbalancedetails.Amount == 0 ? "" : stockopeningbalancedetails.Amount.ToString("N2"))
                        </Template>
                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenNumeric Disabled="true"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal"
                                           Value="stockopeningbalancedetails.Amount"
                                           Format="N2" />
                        </EditTemplate>
                        <FooterTemplate>
                            <b>@stockopeningbalanceDetailsGrid.View.Sum(x => x.Amount).ToString("N2")</b>
                        </FooterTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="StockOpeningBalanceDetails"
                                          Width="8rem"
                                          Property="@nameof(StockOpeningBalanceDetails.Price)"
                                          Title="Cost"
                                          TextAlign="TextAlign.Center">
                        <Template Context="stockopeningbalancedetails">
                            @(stockopeningbalancedetails.Price == 0 ? "" : stockopeningbalancedetails.Price?.ToString("N2"))
                        </Template>
                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenNumeric Disabled="@IsDisable"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           @bind-Value="stockopeningbalancedetails.Price"
                                           Change="@(args => OnCostChanged(stockopeningbalancedetails, args))"
                                           Format="N2" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    @* BATCH NO DROPDOWN *@
                    <RadzenDataGridColumn Width="8rem" TItem="StockOpeningBalanceDetails" Property="@nameof(StockOpeningBalanceDetails.StockBatchNumberId)" Title="Batch No" TextAlign="TextAlign.Center">
                        <Template Context="stockopeningbalancedetails">
                            @{
                                var batchNumber = GetBatchNumberForDetail(stockopeningbalancedetails.StockBatchNumberId);
                            }
                            @batchNumber?.BatchNo
                        </Template>
                        <EditTemplate Context="stockopeningbalancedetails">
                            @if (IsBatchNoDisabled(stockopeningbalancedetails.StockId))
                            {

                            }
                            else
                            {
                                <RadzenDropDownDataGrid @bind-Value="stockopeningbalancedetails.StockId"
                                                        Change="@(args => OnBatchNumberChanged(args, stockopeningbalancedetails))"
                                                        Style="width: 100%; font-size:12px" PageSize="10"
                                                        Data="@GetBatchNumbersForStock(stockopeningbalancedetails.StockId)"
                                                        AllowVirtualization="true" AllowColumnResize="true"
                                                        AllowClear="true" AllowSorting="false"
                                                        FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                        TextProperty="BatchNo" Density="@density" ValueProperty="Id">
                                    <Columns>
                                        <RadzenDropDownDataGridColumn Width="100px" Property="BatchNo" Title="Batch No" />
                                        <RadzenDropDownDataGridColumn Width="150px" Property="Description" Title="Description" />
                                        <RadzenDropDownDataGridColumn Width="100px" Property="BatchNoManufacturingDate" Title="Mfg Date" FormatString="{0:dd/MM/yyyy}" />
                                        <RadzenDropDownDataGridColumn Width="100px" Property="BatchNoExpiryDate" Title="Exp Date" FormatString="{0:dd/MM/yyyy}" />
                                        <RadzenDropDownDataGridColumn Width="100px" Property="BalanceQty" Title="Balance" FormatString="{0:N2}" />
                                    </Columns>
                                </RadzenDropDownDataGrid>
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="StockOpeningBalanceDetails"
                                          Width="7rem"
                                          Property="@nameof(StockOpeningBalanceDetails.Qty)"
                                          Title="Qty"
                                          TextAlign="TextAlign.Center">
                        <Template Context="stockopeningbalancedetails">
                            @(stockopeningbalancedetails.Qty == 0 ? "" : stockopeningbalancedetails.Qty.ToString("N4"))
                        </Template>
                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenNumeric Disabled="@IsDisable"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal"
                                           @bind-Value="stockopeningbalancedetails.Qty"
                                           Change="@(args => OnQtyChanged(stockopeningbalancedetails, args))"
                                           Format="N4" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockOpeningBalanceDetails"
                                          Width="9rem"
                                          Property="@nameof(StockOpeningBalanceDetails.ProjectId)"
                                          Title="Project" 
                                          TextAlign="TextAlign.Center">

                        <Template Context="stockopeningbalancedetails">
                            @{
                                var project = projectList?
                                    .FirstOrDefault(p => p.Id == stockopeningbalancedetails.ProjectId);
                            }
                            @project?.ProjectCode
                        </Template>

                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenDropDownDataGrid class="@redtext"
                                                    @bind-Value="stockopeningbalancedetails.ProjectId"
                                                    AllowSorting="false"
                                                    Style="width: 100%;" PageSize="10"
                                                    Data="@projectList" AllowVirtualization="true"
                                                    AllowColumnResize="true" AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="ProjectCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code" />
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data2">
                                            <RadzenCheckBox TValue="bool" Value="data2.IsActive" />
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="11rem" TItem="StockOpeningBalanceDetails"
                                          Property="@nameof(StockOpeningBalanceDetails.StockLocationId)"
                                          Title="Location" TextAlign="TextAlign.Center">

                        <!-- Display Location Code -->
                        <Template Context="stockopeningbalancedetails">
                            @{
                                var location = stocklocationList?.FirstOrDefault(l => l.Id == stockopeningbalancedetails.StockLocationId);
                            }
                            @location?.LocationCode
                        </Template>

                        <EditTemplate Context="stockopeningbalancedetails">
                            <RadzenDropDownDataGrid class="@redtext"
                                                    @bind-Value="stockopeningbalancedetails.StockLocationId"
                                                    AllowSorting="false"
                                                    Style="width: 120%;" PageSize="10"
                                                    Data="@stocklocationList" AllowVirtualization="true"
                                                    AllowColumnResize="true" AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="LocationCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data">
                                            <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Title="Action">
                        <Template Context="stockopeningbalancedetails">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(stockopeningbalancedetails))" />
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>
            @* END OF TABLE DETAILS*@

        </RadzenCard>

        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="5">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenFormField Style="width:50%" Text="Total Amount"
                                         AllowFloatingLabel="false">
                            <RadzenNumeric Disabled=true
                                           Value="@TotalAmount"
                                           Format="#,0.00"
                                           ShowUpDown="false"
                                           TextAlign="TextAlign.Right"
                                           Style="width: 100%;"
                                           Placeholder="" />
                        </RadzenFormField>
                    </RadzenStack>

                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

    </RadzenStack>

</RadzenTemplateForm>

<RadzenPopup @ref=popup Lazy=true class="my-popup">
    <RadzenDataGrid RowDoubleClick="() => SetStockOpeningBalanceNoPopup(selectedtransactionCodesList.FirstOrDefault().Id)"
                    TItem="TransactionsCode"
                    @ref=transactionsCodeGrid
                    @bind-Value="@selectedtransactionCodesList"
                    Data=@transactionCodesList>
        <Columns>
            <RadzenDataGridColumn TItem="TransactionsCode" Property="@nameof(TransactionsCode.Format)" Title="Format" TextAlign="TextAlign.Center" Width="100px">
                <Template Context="transactionCode">
                    @transactionCode.Format
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</RadzenPopup>

@code {
    [Parameter]
    public Guid? Id { get; set; }
    bool rightSidebarExpanded = false;


    AlignItems alignItems = AlignItems.Center;
    Density density = Density.Compact;
    TextStyle textStyle = TextStyle.Body2;
    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    Variant btnVariantText = Variant.Text;
    ButtonSize smallbtn = ButtonSize.Small;

    //FOR POP UP DIALOG
    RadzenButton button;
    RadzenPopup popup;

    //FOR PROPERTY SET VALUE OF OBJECT
    Guid defaultvalue;
    string btnText = "Save";
    string value = "N/A";
    bool busy = false;
    bool istrue = true;
    string status = string.Empty;
    bool IsDisable = true;
    string redtext;

    //for loading data
    bool isloading = true;


    //FORM MODEL
    // JUNE 16, 2026
    protected StockOpeningBalanceModel stockopeningbalanceModel { get; set; } = new StockOpeningBalanceModel();
    RadzenDataGrid<StockOpeningBalanceDetails> stockopeningbalanceDetailsGrid;
    protected List<StockOpeningBalanceDetails> stockOpeningBalanceDetails = new List<StockOpeningBalanceDetails>();

    private Dictionary<Guid, bool> stockBatchRequirements = new Dictionary<Guid, bool>();
    private Dictionary<Guid, List<StockBatchNumbersModel>> stockBatchNumbers = new Dictionary<Guid, List<StockBatchNumbersModel>>();

    bool isAddingNew = false;

    DataGridEditMode editMode = DataGridEditMode.Single;
    List<StockOpeningBalanceDetails> stockopeningbalanceDetailsToInsert = new List<StockOpeningBalanceDetails>();
    List<StockOpeningBalanceDetails> stockopeningbalanceDetailsToUpdate = new List<StockOpeningBalanceDetails>();

    //ALL LIST FOR DROPDOWN BOX INPUT
    protected IEnumerable<StockLocations> stocklocationList { get; set; }
    protected IEnumerable<Projects> projectList { get; set; }
    protected IEnumerable<Stocks> stockList { get; set; }
    protected IEnumerable<UOMs> uomsList { get; set; }
    protected IEnumerable<Descriptions> descriptionsList { get; set; }
    protected IEnumerable<TransactionsCode> transactionCodesList { get; set; }

    protected IList<TransactionsCode> selectedtransactionCodesList { get; set; }
    RadzenDataGrid<TransactionsCode> transactionsCodeGrid;

    //FOR DATAGRID STAGGING
    protected StockOpeningBalanceDetails stockopeningbalanceDetail { get; set; } = new StockOpeningBalanceDetails();
    protected StockOpeningBalanceDetails editstockopeningbalanceDetail = null;

    // DTO for header save request
    public class SaveStockOpeningBalanceHeaderRequest
    {
        public StockOpeningBalanceModel Header { get; set; }
        public string CompanyCode { get; set; }
    }
    // DTO for details save request
    public class SaveStockOpeningBalanceDetailsRequest
    {
        public List<StockOpeningBalanceDetails> Details { get; set; }
        public string CompanyCode { get; set; }
    }
    // DTO for response from the API
    public class SaveStockOpeningBalanceResponse
    {
        public Guid Id { get; set; }
    }

    protected UOMs UOMsCode { get; set; } = new UOMs();
    protected DescriptionFilter descriptionFilter { get; set; } = new DescriptionFilter();
    protected TransactionCodesFilter transactionCodesFilter = new TransactionCodesFilter();
    protected List<StockOpeningBalanceDetails> stockItems = new List<StockOpeningBalanceDetails>();

    // component hold the Total Amount
    private decimal TotalAmount => stockOpeningBalanceDetails?.Sum(x => x.Amount) ?? 0;

    protected async override Task OnInitializedAsync()
    {
        SetTransactionCodeData();
        await loadAllData();

        if (Id is not null)
        {
            await loadAllDataById();
        }
        else
        {
            // Set default date to 04/30/2021 for new records
            stockopeningbalanceModel.StockOBDate = new DateTime(2021, 4, 30);

            // JUNE 16, 2026
            InitializeStockOpeningBalanceRows();
        }

    }

    protected void SetTransactionCodeData()
    {
        //For Generating Requisition Code Getting Format from db.TransactionCodes
        // descriptionFilter.OwnerCode = "PurchaseRequisitions.Title";
        transactionCodesFilter.TableId = 93;
        isloading = true;
    }

    protected string GetStockCode(Guid stockId)
    {
        var stock = stockList.FirstOrDefault(s => s.Id == stockId);
        return stock?.StockCode ?? string.Empty;
    }

    protected async Task loadAllData()
    {
        await GetTransactionNo();
        await GetLocationList();
        await GetProjectList();
        await GetStockList();
        await GetUOMSList();
        await GetDescriptions();
        await SetStockOpeningBalanceNo();

        isloading = false;

    }

    protected async Task loadAllDataById()
    {
        await GetStockOpeningBalanceById();
        await GetStockOpeningBalanceDetailById();

        isloading = false;
    }



    //GET ALL UOMLIST PER STOCK
    protected async Task GetUOMSList()
    {
        var data = await stockItemsService.GetUOMsList();
        uomsList = data is not null ? data : new List<UOMs>();
    }

    //LOAD DIFFERENT UOMS PER STOCK
    private IEnumerable<UOMs> GetUOMsForStock(Guid? stockId)
    {
        if (stockId == null || uomsList == null)
            return Enumerable.Empty<UOMs>();
        return uomsList.Where(u => u.StockId == stockId);
    }

    protected async Task GetLocationList()
    {
        var data = await stockItemsService.GetStockLocationList();
        stocklocationList = data is not null ? data : new List<StockLocations>();
    }

    protected async Task GetProjectList()
    {
        var data = await projectService.GetProjectsLists();
        projectList = data is not null ? data : new List<Projects>();
    }


    //Get Stock List From db.Stocks
    protected async Task GetStockList()
    {
        var data = await stockItemsService.GetStockList();
        stockList = data is not null ? data : new List<Stocks>();
    }
    //Form Model
    protected async Task GetStockOpeningBalanceById()
    {
        var data = await stockItemsService.GetStockOpeningBalanceById(Id.ToString());
        stockopeningbalanceModel = data is not null ? data : new StockOpeningBalanceModel();
    }

