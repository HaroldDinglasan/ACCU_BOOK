    // JUNE 16, 2026
    async Task InsertAfterRow(StockOpeningBalanceDetails currentRow)
    {
        if (stockopeningbalanceDetailsToInsert.Any() || stockopeningbalanceDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService,
                "Unsaved Details",
                "Save current row first.");
            return;
        }

        var newRow = new StockOpeningBalanceDetails
        {
            Id = Guid.NewGuid(),
            StockOBId = Id ?? stockopeningbalanceModel.Id,
            Pos = currentRow?.Pos + 1 ?? 1
        };

        // 🔥 IMPORTANT: insert into actual grid source
        if (currentRow != null)
        {
            var index = stockOpeningBalanceDetails.IndexOf(currentRow);

            if (index >= 0)
                stockOpeningBalanceDetails.Insert(index + 1, newRow);
            else
                stockOpeningBalanceDetails.Add(newRow);
        }
        else
        {
            stockOpeningBalanceDetails.Add(newRow);
        }

        stockopeningbalanceDetailsToInsert.Add(newRow);

        await stockopeningbalanceDetailsGrid.Reload();

        await stockopeningbalanceDetailsGrid.EditRow(newRow);

        StateHasChanged();
    }

    // JUNE 16, 2026
    async Task EditRow(StockOpeningBalanceDetails stockopeningbalancesDetails)
    {
        if (!stockopeningbalanceDetailsGrid.IsValid)
            return;

        bool anotherRowActive =
            stockopeningbalanceDetailsToInsert.Any(x => x != stockopeningbalancesDetails) ||
            stockopeningbalanceDetailsToUpdate.Any(x => x != stockopeningbalancesDetails);

        if (anotherRowActive)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Unsaved Row",
                Detail = "Please save or cancel the current active row before editing another."
            });
            return;
        }

        if (!stockopeningbalanceDetailsToUpdate.Contains(stockopeningbalancesDetails))
        {
            stockopeningbalanceDetailsToUpdate.Add(stockopeningbalancesDetails);
        }

        await stockopeningbalanceDetailsGrid.EditRow(stockopeningbalancesDetails);
        StateHasChanged();
    }

    void CancelEdit(StockOpeningBalanceDetails stockopeningbalancesDetails)
    {
        // If it's a new row that was cancelled, remove it from the list
        if (stockopeningbalanceDetailsToInsert.Contains(stockopeningbalancesDetails))
        {
            stockOpeningBalanceDetails.Remove(stockopeningbalancesDetails);
        }
        Reset(stockopeningbalancesDetails);

        stockopeningbalanceDetailsGrid.CancelEditRow(stockopeningbalancesDetails);
        // Reload the grid to reflect the removal of a new cancelled row or revert changes visually
        stockopeningbalanceDetailsGrid.Reload();
        StateHasChanged();

    }

    async Task SaveRow(StockOpeningBalanceDetails stockopeningbalancesDetails)
    {
        // This method is called when the user clicks the 'Save' (checkmark) button for a row in the grid.
        await stockopeningbalanceDetailsGrid.UpdateRow(stockopeningbalancesDetails);
        await stockopeningbalanceDetailsGrid.Reload();
        StateHasChanged();
    }

    void Reset(StockOpeningBalanceDetails stockopeningbalancesDetails)
    {
        stockopeningbalanceDetailsToInsert.Remove(stockopeningbalancesDetails);
        stockopeningbalanceDetailsToUpdate.Remove(stockopeningbalancesDetails);
    }

    void Reset()
    {
        stockopeningbalanceDetailsToInsert.Clear();
        stockopeningbalanceDetailsToUpdate.Clear();
    }

    async Task DeleteRow(StockOpeningBalanceDetails stockopeningbalancesDetails)
    {
        Reset(stockopeningbalancesDetails);
        stockOpeningBalanceDetails.Remove(stockopeningbalancesDetails);

        ResetPosIndexes();

        await stockopeningbalanceDetailsGrid.Reload();
        StateHasChanged();
    }

    protected async Task RefreshGrid()
    {
        // Refresh the grid
        await stockopeningbalanceDetailsGrid.Reload();
    }

