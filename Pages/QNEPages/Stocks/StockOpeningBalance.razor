    private async Task OnStockChanged(object stockId, StockOpeningBalanceDetails stockopeningbalancedetails)
    {
        if (stockId != null && stockId is Guid selectedStockId)
        {
            var selectedStock = stockList?.FirstOrDefault(s => s.Id == selectedStockId);
            if (selectedStock != null)
            {
                IsDisable = false;
                // Populate Description
                stockopeningbalancedetails.Description = selectedStock.StockName;

                // Default Quantity
                stockopeningbalancedetails.ItemTypeCode = selectedStock.ItemTypeCode;

                if (selectedStock.ItemTypeCode is "T" or "D")
                {
                    stockopeningbalancedetails.Qty = 0.00m;
                }
                else
                {
                    stockopeningbalancedetails.Qty = 1.00m;
                }

                // Set the base UOM
                var baseUOM = uomsList?.FirstOrDefault(u => u.StockId == selectedStockId && u.UOMCode == selectedStock.BaseUOM);
                if (baseUOM != null)
                {
                    stockopeningbalancedetails.UOMId = baseUOM.Id;
                }

                // Just trigger state change, don't reload grid
                StateHasChanged();
            }
        }
        else
        {
            IsDisable = true;
            // Clear fields if no stock is selected
            stockopeningbalancedetails.Description = string.Empty;
            stockopeningbalancedetails.Qty = 0;
            stockopeningbalancedetails.UOMId = null;
            StateHasChanged();
        }
    }

