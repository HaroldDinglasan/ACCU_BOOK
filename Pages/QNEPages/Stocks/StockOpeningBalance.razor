    // SAVE HEADER AND DETAILS
    private async Task OnSubmit()
    {
        try
        {
            // Ito ay nag ccheck kapag nag lagay ka ng items sa details
            // tapos hindi mo ni click yung save sa action button
            // tapos pinindot mo yung main save button at nag skip sa save ng action details
            if (stockopeningbalanceDetailsToInsert.Any() || stockopeningbalanceDetailsToUpdate.Any())
            {
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Unsaved Details",
                    Detail = "Please save all active or new rows before saving the Stock Opening Balance."
                });
                busy = false;
                return;
            }

            // validation when details are empty
            if (stockOpeningBalanceDetails == null ||
                !stockOpeningBalanceDetails.Any() ||
                !stockOpeningBalanceDetails.Any(d => d.StockId != null && d.StockId != Guid.Empty))
            {
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Validation Error",
                    Detail = "Stock Opening Balance Details must not be empty"
                });
                busy = false;
                return;
            }

            // <CHANGE> Validate that Stock Opening Date is not later than 04/30/2021
            var maxAllowedDate = new DateTime(2021, 4, 30);
            if (stockopeningbalanceModel.StockOBDate > maxAllowedDate)
            {
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Validation Error",
                    Detail = "Stock Opening Date can not be later than 04/30/2021"
                });
                busy = false;
                return;
            }

            // Ensure header ID is set for new orders
            if (Id == null || Id == Guid.Empty)
            {
                stockopeningbalanceModel.Id = Guid.NewGuid();
            }
            else
            {
                stockopeningbalanceModel.Id = Id.Value;
            }

            // Save Header First
            var headerRequest = new SaveStockOpeningBalanceHeaderRequest
            {
                Header = stockopeningbalanceModel,
            };
            var headerResponse = await http.PostAsJsonAsync("api/Stocks/SaveStocksOpeningBalanceHeader", headerRequest);
            if (!headerResponse.IsSuccessStatusCode)
            {
                var headerErrorContent = await headerResponse.Content.ReadAsStringAsync();
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Failed to save Stock Opening Balance Header: {headerErrorContent}"
                });
                return;
            }
            var headerResult = await headerResponse.Content.ReadFromJsonAsync<SaveStockOpeningBalanceResponse>();

            // Chinecheck kung may laman yung ibabato na data yung details
            Console.WriteLine($"Stock Opening Balance Details List Count before sending to API: {stockOpeningBalanceDetails?.Count ?? 0}");
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Debug Info",
                Detail = $"Details count before API call: {stockOpeningBalanceDetails?.Count ?? 0}"
            });

            // Save Details After Header
            if (stockOpeningBalanceDetails != null && stockOpeningBalanceDetails.Any())
            {
                // Link details to the header ID and assign new GUIDs for new detail rows
                foreach (var detail in stockOpeningBalanceDetails)
                {
                    detail.StockOBId = headerResult.Id;
                    // Only assign new GUID if it's a truly new detail (Id is default/empty)
                    if (detail.Id == Guid.Empty)
                    {
                        detail.Id = Guid.NewGuid();
                    }
                }

                var detailsRequest = new SaveStockOpeningBalanceDetailsRequest
                {
                    Details = stockOpeningBalanceDetails,
                };
                var detailsResponse = await http.PostAsJsonAsync("api/Stocks/SaveStocksOpeningBalanceDetails", detailsRequest);
                if (!detailsResponse.IsSuccessStatusCode)
                {
                    var detailsErrorContent = await detailsResponse.Content.ReadAsStringAsync();
                    notificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = $"Failed to save Stock Opening Balance Details: {detailsErrorContent}"
                    });
                    return;
                }
            }
            else
            {
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Info",
                    Detail = "No stock opening balance details were found to save."
                });
            }

            // SUCCESS: Both header and details saved successfully
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = "Stock Opening Balance saved successfully!"
            });

            // If it was a new order, navigate to the edit page with the new ID
            if (Id == null || Id == Guid.Empty)
            {
                navManager.NavigateTo($"/StockOpeningBalanceList/Edit/{headerResult.Id}");
            }
            else
            {
                // Reload data if update to reflect server-side changes
                await loadAllDataById();
            }
        }
        catch (Exception ex)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"An unexpected error occurred: {ex.Message}"
            });
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }


