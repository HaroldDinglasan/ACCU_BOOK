    private StockBatchNumbersModel GetBatchNumberForDetail(Guid? batchNumberId)
    {
        if (batchNumberId == null) return null;

        foreach (var stockBatches in stockBatchNumbers.Values)
        {
            var batch = stockBatches.FirstOrDefault(b => b.Id == batchNumberId.Value);
            if (batch != null) return batch;
        }

        return null;
    }

    private bool IsBatchNoDisabled(Guid? stockId)
    {
        if (stockId == null) return true;

        if (stockBatchRequirements.ContainsKey(stockId.Value))
        {
            return !stockBatchRequirements[stockId.Value]; // Disabled if UseBatchNo is false
        }
        return true; // Default to disabled if not checked yet
    }

    private void OnBatchNumberChanged(object value, StockOpeningBalanceDetails stockopeningbalancedetails)
    {
        if (value != null && Guid.TryParse(value.ToString(), out Guid batchId))
        {
            var selectedBatch = GetBatchNumberForDetail(batchId);
            if (selectedBatch != null)
            {
                stockopeningbalancedetails.StockBatchNumberId = batchId;

            }
        }
        else
        {
            stockopeningbalancedetails.StockBatchNumberId = null;
        }
    }

    private List<StockBatchNumbersModel> GetBatchNumbersForStock(Guid? stockId)
    {
        if (stockId == null) return new List<StockBatchNumbersModel>();

        if (stockBatchNumbers.ContainsKey(stockId.Value))
        {
            return stockBatchNumbers[stockId.Value];
        }

        return new List<StockBatchNumbersModel>();
    }

