    {
        CustomNotificationMessage.Message(notificationService, true);
    }


    protected void Navigate()
    {
        navManager.NavigateTo("/StockAdjustmentsList");
    }

    // CREATE ROW
    void OnCreateRow(StockAdjustmentDetails stockadjustmentDetails)
    {
        // This method is called * after * the new row has been added to purchase requisition DetailsList
        stockadjustmentDetailsToInsert.Remove(stockadjustmentDetails);
    }

    //UPDATE ROW
    void OnUpdateRow(StockAdjustmentDetails stockadjustmentDetails)
    {
        // This method is called *after* the row has been updated in purchase requisition DetailsList
        Reset(stockadjustmentDetails);
    }

    // JUNE 17, 2026
    protected void InitializeStockAdjustmentRows()
    {
        // Initialize with 5 rows and set default Pos index
        stockAdjustmentDetails = Enumerable.Range(1, 5)
            .Select(i => new StockAdjustmentDetails
            {
                Id = Guid.NewGuid(),
                Pos = i,
                StockAdjustmentId = Id ?? stockadjustmentmodel.Id,
            })
            .ToList();
    }

    // JUNE 17, 2026
    async Task InsertAfterRow(StockAdjustmentDetails currentRow)
    {
        if (stockadjustmentDetailsToInsert.Any() || stockadjustmentDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService,
                "Unsaved Details",
                "Save current row first.");
            return;
        }

        var newRow = new StockAdjustmentDetails
        {
            Id = Guid.NewGuid(),
            StockAdjustmentId = Id ?? stockadjustmentmodel.Id,
            Pos = currentRow?.Pos + 1 ?? 1
        };

        // 🔥 IMPORTANT: insert into actual grid source
        if (currentRow != null)
        {
            var index = stockAdjustmentDetails.IndexOf(currentRow);

            if (index >= 0)
                stockAdjustmentDetails.Insert(index + 1, newRow);
            else
                stockAdjustmentDetails.Add(newRow);
        }
        else
        {
            stockAdjustmentDetails.Add(newRow);
        }

        stockadjustmentDetailsToInsert.Add(newRow);

        await stockadjustmentDetailsGrid.Reload();

        // ADDED 09/29/2026
        stockbatchnumbercode = string.Empty;
        batchSearchText = string.Empty;

        await stockadjustmentDetailsGrid.EditRow(newRow);

        StateHasChanged();

    }

    // JUNE 17, 2026
    async Task EditRow(StockAdjustmentDetails stockadjustmentDetails)
    {
        if (!stockadjustmentDetailsGrid.IsValid)
            return;

        bool anotherRowActive =
            stockadjustmentDetailsToInsert.Any(x => x != stockadjustmentDetails) ||
            stockadjustmentDetailsToUpdate.Any(x => x != stockadjustmentDetails);

        if (anotherRowActive)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Unsaved Row",
                Detail = "Please save or cancel the current active row before editing another."
            });
            return;
        }

        if (!stockadjustmentDetailsToUpdate.Contains(stockadjustmentDetails))
        {
            stockadjustmentDetailsToUpdate.Add(stockadjustmentDetails);
        }

        // ADDED 09/29/2026
        stockbatchnumbercode = GetBatchNo(stockadjustmentDetails.StockBatchNumberId);
        batchSearchText = string.Empty;

        await stockadjustmentDetailsGrid.EditRow(stockadjustmentDetails);
        StateHasChanged();
    }

    void CancelEdit(StockAdjustmentDetails stockadjustmentDetails)
    {
        // If it's a new row that was cancelled, remove it from the list
        if (stockadjustmentDetailsToInsert.Contains(stockadjustmentDetails))
        {
            stockAdjustmentDetails.Remove(stockadjustmentDetails);
        }
        Reset(stockadjustmentDetails);

        stockadjustmentDetailsGrid.CancelEditRow(stockadjustmentDetails);
        // Reload the grid to reflect the removal of a new cancelled row or revert changes visually
        stockadjustmentDetailsGrid.Reload();
        StateHasChanged();

    }

    async Task SaveRow(StockAdjustmentDetails stockadjustmentDetails)
    {
        // This method is called when the user clicks the 'Save' (checkmark) button for a row in the grid.
        await stockadjustmentDetailsGrid.UpdateRow(stockadjustmentDetails);
        await stockadjustmentDetailsGrid.Reload();
        StateHasChanged();
    }

    void Reset(StockAdjustmentDetails stockadjustmentDetails)
    {
        stockadjustmentDetailsToInsert.Remove(stockadjustmentDetails);
        stockadjustmentDetailsToUpdate.Remove(stockadjustmentDetails);
    }

    void Reset()
    {
        stockadjustmentDetailsToInsert.Clear();
        stockadjustmentDetailsToUpdate.Clear();
    }

    async Task DeleteRow(StockAdjustmentDetails stockadjustmentDetails)
    {
        Reset(stockadjustmentDetails);

        // OCTOBER 22 2026
        if (stockadjustmentDetails.IsBundled == true && stockadjustmentDetails.IsSubItem != true)
            RemoveSubItems(stockadjustmentDetails);

        stockAdjustmentDetails.Remove(stockadjustmentDetails);

        ResetPosIndexes();

        await stockadjustmentDetailsGrid.Reload();
        StateHasChanged();
    }

    protected async Task RefreshGrid()
    {
        // Refresh the grid
        await stockadjustmentDetailsGrid.Reload();
    }

    private void OnQtyOrPriceChanged(StockAdjustmentDetails row)
    {
        StockTransactionNumberHelper.Compute(row);

        // if this is a bundle parent, rescale its sub items (bundle Qty x parent Qty)
        if (row.IsBundled == true && row.IsSubItem != true && row.StockId != null
            && bundleCache.TryGetValue(row.StockId.Value, out var defs))
        {
            foreach (var child in stockAdjustmentDetails
                         .Where(x => x.IsSubItem == true && x.BundledTransactionId == row.Id))
            {
                var def = defs.FirstOrDefault(d => d.SubItemId == child.StockId);
                if (def == null) continue;

                child.Qty = ((decimal?)def.Qty ?? 0m) * (row.Qty ?? 0m);
                StockTransactionNumberHelper.Compute(child);
            }
        }
    }

    // OCTOBER 22, 2026
    private Dictionary<Guid, List<StockBundlesModel>> bundleCache = new();

    private async Task<List<StockBundlesModel>> GetBundleItems(Guid stockId)
    {
        if (!bundleCache.TryGetValue(stockId, out var items))
        {
            var data = await stockItemsService.GetStockBundlesById(stockId.ToString());
            items = data?.ToList() ?? new List<StockBundlesModel>();
            bundleCache[stockId] = items;
        }
        return items;
    }

    // OCTOBER 22, 2026
    // remove sub items that  belong to this parent row
    private void RemoveSubItems(StockAdjustmentDetails parent)
    {
        stockAdjustmentDetails.RemoveAll(x => x.IsSubItem == true && x.BundledTransactionId == parent.Id);
    }

    // OCTOBER 22, 2026
    // insert the bundle's sub items directly under the parent row
    private async Task ExpandBundle(Guid stockId, StockAdjustmentDetails parent)
    {
        RemoveSubItems(parent);

        var items = await GetBundleItems(stockId);
        if (!items.Any())
        {
            parent.IsBundled = false;
            return;
        }

        parent.IsBundled = true;
        var index = stockAdjustmentDetails.IndexOf(parent);

        foreach (var b in items.OrderBy(x => x.Pos))
        {
            var subStock = stockList?.FirstOrDefault(s => s.Id == b.SubItemId);

            var child = new StockAdjustmentDetails
            {
                Id = Guid.NewGuid(),
                StockAdjustmentId = Id ?? stockadjustmentmodel.Id,
                StockId = b.SubItemId,
                Description = string.IsNullOrWhiteSpace(b.Description) ? subStock?.StockName : b.Description,
                ItemTypeCode = subStock?.ItemTypeCode,
                UOMId = b.UOMId,
                StockLocationId = b.StockLocationId ?? parent.StockLocationId,
                ProjectId = b.ProjectId ?? parent.ProjectId,
                Price = (decimal?)b.UnitCost ?? 0m,
                Qty = ((decimal?)b.Qty ?? 0m) * (parent.Qty ?? 1m),
                IsSubItem = true,
                IsBundled = true,
                BundledTransactionId = parent.Id
            };

            StockTransactionNumberHelper.Compute(child);
            stockAdjustmentDetails.Insert(++index, child);
        }

        ResetPosIndexes();
        await stockadjustmentDetailsGrid.Reload();
    }


