@page "/StockAdjustments"
@page "/StockAdjustmentsList/Edit/{id:guid}"
@inject StockItemsService stockItemsService
@inject ProjectService projectService
@inject DescriptionsService descriptionsService
@inject RunningNumberService runningNumberService
@inject TransactionCodeService transactionCodeService

@using Microsoft.AspNetCore.Components.Authorization

@using Radzen.Blazor.Rendering
@attribute [Authorize(Roles = "Admin,User")]
@inject HttpClient http
@inject NavigationManager navManager
@inject DialogService DialogService
@inject NotificationService notificationService
@inject IJSRuntime JSRuntime

<RadzenTemplateForm TItem="StockAdjustmentsModel" Data="stockadjustmentmodel" Submit="@OnSubmit" InvalidSubmit="@OnInvalidSubmit">
    <RadzenStack Gap="0.2rem">
        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="5">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">

                        @*MODIFIED 09/29/2026*@
                        <RadzenButton Size="@smallbtn" Icon="save" BusyText="Saving..." IsBusy=@busy
                                      Disabled="@btnDiseabled"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Text="@btnText"
                                      ButtonType="@Radzen.ButtonType.Submit" />

                        <RadzenButton Visible="@btnDiseabled" Text="New" Icon="add" Size="@smallbtn"
                                      ButtonStyle="ButtonStyle.Success"
                                      ButtonType="@Radzen.ButtonType.Button"
                                      Click="@OnNew" />
                    </RadzenStack>

                </RadzenColumn>
                <RadzenColumn Size="12" SizeSM="7">
                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenButton Size="@smallbtn" ButtonStyle="ButtonStyle.Light" Click="@Navigate" Text="Seach" Icon="search"></RadzenButton>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenCard>

            <div style="margin-bottom: 0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Orientation.Horizontal">
                        Stock Adjustment @stockadjustmentmodel.StockAdjustmentCode <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                    </RadzenStack>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="info" Click="@OpenDocumentInfoDialog"></RadzenButton>
                </RadzenStack>
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Details">
                        <RadzenRow>
                            <!-- LEFT SIDE -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">

                                            <RadzenFormField Style="width:100%" Text="Location" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext"
                                                                        @bind-Value=@stockadjustmentmodel.StockLocationId
                                                                        AllowSorting="false"
                                                                        Style="width: 100%;"
                                                                        PageSize=10
                                                                        Data="@stocklocationList"
                                                                        AllowVirtualization="true"
                                                                        AllowColumnResize="true"
                                                                        AllowClear="true"
                                                                        FilterCaseSensitivity="@filter"
                                                                        AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="LocationCode"
                                                                        Density="@density"
                                                                        ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data">
                                                                <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                                            </Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>

                                            <RadzenFormField Style="width:100%" Text="Project" AllowFloatingLabel="false">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@stockadjustmentmodel.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Description" AllowFloatingLabel="false">
                                                <RadzenTextBox @bind-Value="stockadjustmentmodel.Description"
                                                               Style="width:100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <!-- RIGHT SIDE -->
                            <RadzenColumn Size="12" SizeMD="6" Style="text-align:right">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Doc Date" AllowFloatingLabel="false">
                                                <RadzenDatePicker Change="SetStockAdjustmentNo"
                                                                  @bind-Value="@stockadjustmentmodel.StockAdjustmentDate"
                                                                  DateFormat="MM/dd/yyyy"
                                                                  Style="width:100%" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" Style="display:flex; align-items:center;">
                                            <RadzenFormField Style="flex:1" Text="Stock Adj #" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockadjustmentmodel.StockAdjustmentCode" Style="width: 100%;" />
                                            </RadzenFormField>
                                            <RadzenFormField Style="margin-left:5px" AllowFloatingLabel="false">
                                                <RadzenButton @ref=@button Icon="list" Click="@(args => popup.ToggleAsync(button.Element))" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Style="width:100%" Text="Reference No." AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value="@stockadjustmentmodel.ReferenceNo" Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Others">
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">

                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">

                                            <RadzenFormField Style="width:100%" Text="Title 1" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenTextBox class="@redtext" @bind-Value=@stockadjustmentmodel.Title Style="width: 100%;" />
                                                </RadzenStack>
                                            </RadzenFormField>

                                            <RadzenFormField Style="width:100%" Text="Title 2" AllowFloatingLabel="false">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0rem;" Wrap="FlexWrap.Wrap">
                                                    <RadzenTextBox class="@redtext" @bind-Value=@stockadjustmentmodel.Title2 Style="width: 100%;" />
                                                </RadzenStack>
                                            </RadzenFormField>

                                        </RadzenColumn>
                                    </RadzenRow>

                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockadjustmentmodel.Ref1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Ref 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockadjustmentmodel.Ref2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 1" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockadjustmentmodel.Remark1 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenFormField Style="width:100%" Text="Remark 2" AllowFloatingLabel="false">
                                                <RadzenTextBox class="@redtext" @bind-Value=@stockadjustmentmodel.Remark2 Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Notes">
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenStack Gap="0.2rem">
                                    <RadzenRow AlignItems="@alignItems">
                                        <RadzenColumn Size="12">
                                            <RadzenTextArea @bind-Value=@stockadjustmentmodel.Notes
                                                            Rows="10"
                                                            Style="width:100%"
                                                            class="@redtext"
                                                            aria-label="TextArea" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Info">
                        @documentInfo.Id
                        @documentInfo.DocumentId
                        @documentInfo.DocType
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>

            @* TABLE DETAILS*@
            <br />
            <RadzenDataGrid EditMode="@editMode" @ref="stockadjustmentDetailsGrid"
                            Style="width: 100%; height:45vh; font-size:12px;"
                            AllowVirtualization="true"
                            Data="@stockAdjustmentDetails"
                            KeyProperty="Id"
                            AllowColumnResize=true
                            RowCreate="@OnCreateRow"
                            TItem="StockAdjustmentDetails"
                            Density="@density"
                            RowUpdate="@OnUpdateRow">

                @*JUNE 17 2026*@
                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New" Size="ButtonSize.ExtraSmall" Click="@(() => InsertAfterRow(stockAdjustmentDetails.LastOrDefault()))" title="Add new row after this row" Disabled="@(stockadjustmentDetailsToInsert.Any() || stockadjustmentDetailsToUpdate.Any())" />
                </HeaderTemplate>

                <Columns>

                    <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                        <Template Context="stockadjustmentdetails">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => EditRow(stockadjustmentdetails))" title="Edit this row" />

                        </Template>
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(stockadjustmentdetails))" title="Save" />
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn Visible=false Width="5rem" TItem="StockAdjustmentDetails" Property="@nameof(StockAdjustmentDetails.Pos)" Title="Pos" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn Width="9rem" TItem="StockAdjustmentDetails" Property="@nameof(StockAdjustmentDetails.StockId)" Title="Stock Code" TextAlign="TextAlign.Center">
                        <Template Context="stockadjustmentdetails">
                            @{
                                var stock = stockList?.FirstOrDefault(s => s.Id == stockadjustmentdetails.StockId);
                            }
                            @stock?.StockCode
                        </Template>
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenDropDownDataGrid @bind-Value="stockadjustmentdetails.StockId"
                                                    Change="@(args => OnStockChanged(args, stockadjustmentdetails))"
                                                    Style="width: 100%; font-size:12px" PageSize="10" Data="@stockList"
                                                    AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" AllowSorting="false"
                                                    FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="StockCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="StockCode" Title="Stock #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="StockName" Title="StockName" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="10rem" TItem="StockAdjustmentDetails" Property="@nameof(StockAdjustmentDetails.Description)" Title="Description" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width: 100%; font-size:12px" @bind-Value="stockadjustmentdetails.Description"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockAdjustmentDetails" Property="@nameof(StockAdjustmentDetails.SerialNumber)" Title="Serial No" TextAlign="TextAlign.Center">
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenTextBox Disabled="@IsDisable" Style="width: 100%; font-size:12px" @bind-Value="stockadjustmentdetails.SerialNumber"></RadzenTextBox>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    @* BATCH NO DROPDOWN *@
                    @* ADDED 09/29/2026 *@
                    <RadzenDataGridColumn Width="160px" TItem="StockAdjustmentDetails" Property="@nameof(StockAdjustmentDetails.StockBatchNumberId)" Title="Batch No" TextAlign="TextAlign.Center">
                        <Template Context="stockadjustmentdetails">
                            @{
                                var batchcode = stockbatchnumberList?.FirstOrDefault(b => b.Id == stockadjustmentdetails.StockBatchNumberId);
                            }
                            @batchcode?.BatchNo
                        </Template>
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                                <RadzenTextBox @ref="textBox" Value="@stockbatchnumbercode" Style="width: 100%; font-size:12px"
                                               @oninput="@(args => OnInput(args, stockadjustmentdetails))"
                                               @onclick="@(args => batchnumberpopup.ToggleAsync(textBox.Element))" />

                                <RadzenPopup @ref=batchnumberpopup id="batchnumberpopup" AutoFocusFirstElement="false" class="batchnumber-popup">
                                    <RadzenDataGrid @ref=stockbatchnumbergrid id="stockbatchnumbergrid"
                                                    RowSelect="@(item => OnRowSelect(item, stockadjustmentdetails))"
                                                    Density="Density.Compact"
                                                    TItem="StockBatchNumbersModel"
                                                    Data="@GetBatchNumberForStock(stockadjustmentdetails.StockId)"
                                                    AllowSorting="true" Style="height:360px">

                                        <HeaderTemplate>
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                                <span>Stock Batch Numbers</span>
                                                <RadzenButton Icon="add" Text="New" Size="ButtonSize.ExtraSmall"
                                                              ButtonStyle="ButtonStyle.Success"
                                                              Click="@(() => NewBatch(stockadjustmentdetails))" />
                                            </RadzenStack>
                                        </HeaderTemplate>

                                        <EmptyTemplate>
                                            <p class="rz-m-4">No batch numbers for this stock yet. Click <b>New</b> to create one.</p>
                                        </EmptyTemplate>

                                        <Columns>
                                            <RadzenDataGridColumn Width="45px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                                <Template Context="batch">
                                                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                                  ButtonStyle="ButtonStyle.Secondary" title="Edit batch"
                                                                  Click="@(args => EditBatch(batch, stockadjustmentdetails))"
                                                                  @onclick:stopPropagation="true" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn Property="BatchNo" Width="75px" Title="Batch #" />
                                            <RadzenDataGridColumn Property="Description" Width="160px" Title="Description" />
                                            <RadzenDataGridColumn Property="BatchNoManufacturingDate" Width="100px" Title="Mfg Date" FormatString="{0:MM/dd/yyyy}" />
                                            <RadzenDataGridColumn Property="BatchNoExpiryDate" Width="100px" Title="Exp Date" FormatString="{0:MM/dd/yyyy}" />
                                            <RadzenDataGridColumn Property="BalanceQty" Width="100px" Title="Balance">
                                                <Template Context="item">
                                                    @(item.BalanceQty == 0 ? "" : item.BalanceQty?.ToString("N4"))
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </RadzenPopup>

                                <RadzenButton Icon="more_horiz" ButtonStyle="ButtonStyle.Primary" />
                            </RadzenStack>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockAdjustmentDetails"
                                          Width="7rem"
                                          Property="@nameof(StockAdjustmentDetails.Qty)"
                                          Title="Qty"
                                          TextAlign="TextAlign.Center">
                        @* Show both positive and negative numbers *@
                        <Template Context="stockadjustmentdetails">
                            @(stockadjustmentdetails.Qty?.ToString("N4"))
                        </Template>

                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenNumeric Disabled="@IsDisable"
                                           Change="@(args => OnQtyOrPriceChanged(stockadjustmentdetails))"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           @bind-Value="stockadjustmentdetails.Qty"
                                           Format="N4" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockAdjustmentDetails" Property="@nameof(StockAdjustmentDetails.UOMId)" Title="UOM" TextAlign="TextAlign.Center">
                        <Template Context="stockadjustmentdetails">
                            @{
                                var uoms = uomsList?.FirstOrDefault(u => u.Id == stockadjustmentdetails.UOMId);
                            }
                            @uoms?.UOMCode
                        </Template>
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenDropDownDataGrid Disabled="@IsDisable" @bind-Value="stockadjustmentdetails.UOMId" Style="width: 100%; font-size:12px" PageSize="10" Data="@GetUOMsForStock(stockadjustmentdetails.StockId)" AllowVirtualization="true" AllowColumnResize="true"
                                                    AllowClear="true" AllowSorting="false" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="UOMCode" Density="@density" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="6%" Property="UOMCode" Title="UOM #" />
                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="7rem" TItem="StockAdjustmentDetails" Property="@nameof(StockAdjustmentDetails.Price)" Title="Unit Price" TextAlign="TextAlign.Center">
                        <Template Context="stockadjustmentdetails">
                            @(stockadjustmentdetails.Price.HasValue ? stockadjustmentdetails.Price.Value.ToString("N8") : "")
                        </Template>
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenNumeric Change="@(args => OnQtyOrPriceChanged(stockadjustmentdetails))"
                                           Disabled="@IsDisable"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           @bind-Value="stockadjustmentdetails.Price"
                                           Format="#.00000000" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="8rem"
                                          TItem="StockAdjustmentDetails"
                                          Property="@nameof(StockAdjustmentDetails.Amount)"
                                          Title="Amount"
                                          TextAlign="TextAlign.Center">

                        @* Show positive format (like QNE style)*@
                        <Template Context="stockadjustmentdetails">
                            @(stockadjustmentdetails.Amount != null
                                                        ? (stockadjustmentdetails.Amount < 0
                                                        ? $"({Math.Abs(stockadjustmentdetails.Amount.Value):N2})"
                                                        : stockadjustmentdetails.Amount.Value.ToString("N2"))
                                                        : "")
                        </Template>

                        @* EDIT *@
                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenNumeric Disabled="true"
                                           Style="width: 100%; font-size:12px"
                                           TValue="decimal?"
                                           Value="stockadjustmentdetails.Amount"
                                           Format="N2" />
                        </EditTemplate>

                        <!-- FOOTER -->
                        <FooterTemplate>
                            @{
                                var total = stockadjustmentDetailsGrid.View.Sum(x => x.Amount) ?? 0;
                            }
                            <b>
                                @(total < 0
                                                                ? $"({Math.Abs(total):N2})"
                                                                : total.ToString("N2"))
                            </b>
                        </FooterTemplate>

                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="StockAdjustmentDetails"
                                          Width="9rem"
                                          Property="@nameof(StockAdjustmentDetails.ProjectId)"
                                          Title="Project"
                                          TextAlign="TextAlign.Center">

                        <Template Context="stockadjustmentdetails">
                            @{
                                var project = projectList?
                                    .FirstOrDefault(p => p.Id == stockadjustmentdetails.ProjectId);
                            }
                            @project?.ProjectCode
                        </Template>

                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenDropDownDataGrid class="@redtext"
                                                    @bind-Value="stockadjustmentdetails.ProjectId"
                                                    AllowSorting="false"
                                                    Style="width: 100%;"
                                                    PageSize="10"
                                                    Data="@projectList"
                                                    AllowVirtualization="true"
                                                    AllowColumnResize="true"
                                                    AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="ProjectCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code" />
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data2">
                                            <RadzenCheckBox TValue="bool" Value="data2.IsActive" />
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="11rem" TItem="StockAdjustmentDetails"
                                          Property="@nameof(StockAdjustmentDetails.StockLocationId)"
                                          Title="Location" TextAlign="TextAlign.Center">

                        <!-- Display Location Code -->
                        <Template Context="stockadjustmentdetails">
                            @{
                                var location = stocklocationList?.FirstOrDefault(l => l.Id == stockadjustmentdetails.StockLocationId);
                            }
                            @location?.LocationCode
                        </Template>

                        <EditTemplate Context="stockadjustmentdetails">
                            <RadzenDropDownDataGrid class="@redtext"
                                                    @bind-Value="stockadjustmentdetails.StockLocationId"
                                                    AllowSorting="false"
                                                    Style="width: 120%;" PageSize="10"
                                                    Data="@stocklocationList" AllowVirtualization="true"
                                                    AllowColumnResize="true" AllowClear="true"
                                                    FilterCaseSensitivity="@filter"
                                                    AllowFilteringByAllStringColumns="true"
                                                    TextProperty="LocationCode"
                                                    Density="@density"
                                                    ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="15%" Property="LocationCode" Title="Location #" />
                                    <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description" />
                                    <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                        <Template Context="data">
                                            <RadzenCheckBox TValue="bool" Value="data.IsActive" />
                                        </Template>
                                    </RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn Width="80px" TextAlign="TextAlign.Center" Property="Action" Title="Action">
                        <Template Context="stockadjustmentdetails">
                            <RadzenButton Icon="delete" Text="Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(stockadjustmentdetails))" />
                        </Template>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>
            @* END OF TABLE DETAILS*@

        </RadzenCard>

        <RadzenCard Style="Padding: 0.5rem">
            <RadzenRow JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenColumn Size="12" SizeSM="5">

                    <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <RadzenFormField Style="width:50%" Text="Total Amount"
                                         AllowFloatingLabel="false">
                            <RadzenTextBox Disabled="true"
                                           Style="width: 100%; text-align: right;"
