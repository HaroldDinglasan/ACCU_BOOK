    // Opens the combined Stock In / Stock Out dialog
    // ADDED 09/29/2026
    private async Task OpenStockBatchDialog(Guid stockId, StockAdjustmentDetails detail, StockBatchNumbersModel? existing = null)
    {
        var parameters = new Dictionary<string, object>
    {
        { "StockId", stockId },
        { "StockAdjustmentDetail", detail }
    };
        if (existing != null)
            parameters.Add("ExistingBatch", existing);

        var result = await DialogService.OpenAsync<StockBatchNoInOutModal>(
            "Stock Batch No In Out",
            parameters,
            new DialogOptions
            {
                Width = "900px",
                Height = "600px",
                Resizable = true,
                Draggable = true,
                CloseDialogOnOverlayClick = false
            });

        if (result is StockBatchNumbersModel batch && ApplyBatch(batch))
        {
            detail.StockBatchNumberId = batch.Id;
            stockbatchnumbercode = batch.BatchNo;
        }

        StateHasChanged();
    }

