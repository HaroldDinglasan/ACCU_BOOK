    // SAVE HEADER AND DETAILS
    private async Task OnSubmit()
    {
        @*MODIFIED 09/28/2026 *@
        if (btnDiseabled) return; // already saved

        busy = true;

        // COMPUTE TOTAL AMOUNT
        stockadjustmentmodel.TotalAmount = TotalAmount;

        // SAVING
        if (stockadjustmentDetailsToInsert.Any() || stockadjustmentDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details,", "Please click the 'Save' (checkmark) button");
            busy = false;
            return;
        }

        // SAVE NEW / EDITED BATCH NUMBERS (only the ones actually used in the details)
        var usedBatchIds = stockAdjustmentDetails
            .Where(d => d.StockBatchNumberId != null)
            .Select(d => d.StockBatchNumberId!.Value)
            .ToHashSet();

        var batchesToSave = pendingBatchNumbers.Where(b => usedBatchIds.Contains(b.Id)).ToList();

        if (batchesToSave.Any())
        {
            var batchResult = await stockItemsService.SaveStockBatchNumbers(batchesToSave);

            if (batchResult.StartsWith("Error"))
            {
                await DialogService.Alert(batchResult);
                busy = false;
                return;
            }

            pendingBatchNumbers.RemoveAll(b => usedBatchIds.Contains(b.Id));
        }

        // SAVE STOCK ADJUSTMENT HEADER
        var data = await stockItemsService.SaveStockAdjustmentHeader(stockadjustmentmodel, CurrentUserId);

        if (data is not null)
        {
            if (data.Contains("Success"))
            {
                // ASSIGN HEADER ID
                foreach (var item in stockAdjustmentDetails)
                {
                    item.StockAdjustmentId = stockadjustmentmodel.Id;
                }

                // SAVE STOCK ADJUSTMENT DETAILS
                var datadetails = await stockItemsService.SaveStockAdjustmentDetails(stockAdjustmentDetails);

                // SAVE STOCK ADJUSTMENT TRANSACTION
                var txResult = await stockItemsService.SaveStockAdjustmentTransactions(
                    stockadjustmentmodel, stockAdjustmentDetails, CurrentUserId);

                if (txResult.StartsWith("Error"))
                {
                    await DialogService.Alert(txResult);
                }

                btnDiseabled = true;   // Save disabled, New appears
                busy = false;

                await DialogService.Alert(data);
            }
            else
            {
                await DialogService.Alert(data);
                btnDiseabled = false;
                busy = false;           // header save returned null
            }
        }
    }

