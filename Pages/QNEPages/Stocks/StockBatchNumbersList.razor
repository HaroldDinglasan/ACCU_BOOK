@page "/StockBatchNumbersList"
@attribute [Authorize(Roles = "Admin,User")]


<RadzenStack Gap="0.2rem">

    <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenColumn Size="12" SizeSM="7">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                <RadzenTextBox Disabled=@(filteredStockItemsList == null) @bind-Value="@searchText"
                               Placeholder="Search..."
                               Style="font-size:smaller; width:30rem;"
                               Change="@(args => ApplyFilter())" />
                <RadzenButton Disabled=@(filteredStockItemsList == null) Icon="search" Click="@ApplyFilter" Text="Find" />
                <RadzenButton Disabled=@(filteredStockItemsList == null) Icon="delete" Click="@ClearFilter" Text="Clear" />
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="5">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text="New" Click="@navigate" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Icon="add"></RadzenButton>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenDataGrid @ref="grids" @bind-Value=@selectedStockBatchNumbers RowDoubleClick="() => Edit(selectedStockBatchNumbers.FirstOrDefault().Id)" TItem="StockBatchNumbersModel" AllowPaging="true" PageSize="30"
                    AllowColumnReorder="true" AllowAlternatingRows="false"
                    Data="@filteredStockItemsList" AllowColumnPicking="true" Style="height: 85vh; overflow: hidden;"
                    KeyProperty="Id" PagerHorizontalAlign="HorizontalAlign.Center" AllowColumnResize="true" Density="@density"
                    AllowSorting="true" ShowPagingSummary="true" AllowFiltering="true"
                    FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="@filter" LogicalFilterOperator="LogicalFilterOperator.Or">

        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                <span>
                    Stock Batch Numbers <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                </span>
            </RadzenStack>
        </HeaderTemplate>

        <Columns>

            <RadzenDataGridColumn Visible=true Width="120px" TItem="StockBatchNumbersModel" Property="@nameof(StockBatchNumbersModel.BatchNo)" Title="Batch No"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="160px" TItem="StockBatchNumbersModel" Property="@nameof(StockBatchNumbersModel.Description)" Title="Description"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="160px" TItem="StockBatchNumbersModel" Property="@nameof(StockBatchNumbersModel.StockCode)" Title="Stock Code"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="100px" TItem="StockBatchNumbersModel" Property="@nameof(StockBatchNumbersModel.BatchNoManufacturingDate)" FormatString="{0:d}" Title="Manufacturing Date"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="100px" TItem="StockBatchNumbersModel" Property="@nameof(StockBatchNumbersModel.BatchNoExpiryDate)" FormatString="{0:d}" Title="Expiry Date"></RadzenDataGridColumn>

        </Columns>

    </RadzenDataGrid>

</RadzenStack>


@code {
    string status = string.Empty;
    private RadzenDataGrid<StockBatchNumbersModel> grids;
    private IList<StockBatchNumbersModel> selectedStockBatchNumbers { get; set; }
    private IEnumerable<StockBatchNumbersModel> stockBatchNoList { get; set; }

    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    Density density = Density.Compact;
    AlignItems alignItems = AlignItems.Center;
    Variant variant = Variant.Flat;

    bool isloading;

    protected async override Task OnInitializedAsync()
    {
        await loadAllData();
    }

    private async Task loadAllData()
    {
        await GetStockBatchNumberList();
        isloading = false;
    }

    private async Task GetStockBatchNumberList()
    {
        var data = await stockItemsService.GetStockBatchNumberList();
        stockBatchNoList = data is not null ? data : new List<StockBatchNumbersModel>();
        filteredStockItemsList = stockBatchNoList; // enable search filter
    }

    protected void Edit(Guid Id)
    {
        navManager.NavigateTo($"/StockBatchNumbersList/Edit/{Id}");
    }

    //DoubleClick Cell Event
    protected void OnCellContextMenu(DataGridCellMouseEventArgs<StockBatchNumbersModel> stockItems)
    {
        selectedStockBatchNumbers = new List<StockBatchNumbersModel>() { stockItems.Data };

        var contextMenuItems = new List<ContextMenuItem>
    {
        new ContextMenuItem() { Text = "New", Value = 1, Icon = "add" },
        new ContextMenuItem() { Text = "Edit", Value = 2, Icon = "edit" },
        new ContextMenuItem() { Text = "Delete", Value = 3, Icon = "delete" }
    };

        contextMenuService.Open(stockItems, contextMenuItems, (e) =>
        {
            switch (e.Value)
            {
                case 1:
                    navigate();
                    break;
                case 2:
                    Edit(stockItems.Data.Id);
                    // Edit(stockItems.Data.Id);

                    //await AddUpdateGLAccountDialog(stockItems.Data.Id, false);
                    break;
                case 3:
                    // Delete(stockItems.Data.Id);
                    break;

            }
            contextMenuService.Close();

        });
    }

    private void navigate()
    {
        navManager.NavigateTo("/StockBatchNumbers");
    }

    private string searchText = string.Empty;
    private IEnumerable<StockBatchNumbersModel> filteredStockItemsList;
    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredStockItemsList = stockBatchNoList;
        }
        else
        {
            filteredStockItemsList = stockBatchNoList.Where(x =>
                (!string.IsNullOrEmpty(x.BatchNo) && x.BatchNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Description) && x.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.StockCode) && x.StockCode.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            );
        }
        StateHasChanged();
    }
    private void ClearFilter()
    {
        searchText = string.Empty;
        filteredStockItemsList = stockBatchNoList;
        StateHasChanged();
    }

}
