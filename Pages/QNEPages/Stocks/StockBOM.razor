    // CREATE ROW
    void OnCreateRow(StockBOMDetailModel stockbomDetails)
    {
        // This method is called * after * the new row has been added to DetailsList
        stockbomDetailsToInsert.Remove(stockbomDetails);
    }

    // UPDATE ROW
    void OnUpdateRow(StockBOMDetailModel stockbomDetails)
    {
        // This method is called *after* the row has been updated in DetailsList
