    }


    // JUNE 18, 2026
    protected void InitializeStockOutRows()
    {
        // Initialize with 5 rows and set default Pos index
        stockBOMDetails = Enumerable.Range(1, 5)
            .Select(i => new StockBOMDetailModel
            {
                Id = Guid.NewGuid(),
                Pos = i,
                BOMId = Id ?? stockbomModel.Id,
            })
            .ToList();
    }

    // JUNE 17, 2026
    async Task InsertAfterRow(StockBOMDetailModel currentRow)
    {
        if (stockbomDetailsToInsert.Any() || stockbomDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService,
                "Unsaved Details",
                "Save current row first.");
            return;
        }

        var newRow = new StockBOMDetailModel

        {
            Id = Guid.NewGuid(),
            BOMId = Id ?? stockbomModel.Id,
            Pos = currentRow?.Pos + 1 ?? 1
        };

        // 🔥 IMPORTANT: insert into actual grid source
        if (currentRow != null)
        {
            var index = stockBOMDetails.IndexOf(currentRow);

            if (index >= 0)
                stockBOMDetails.Insert(index + 1, newRow);
            else
                stockBOMDetails.Add(newRow);
        }
        else
        {
            stockBOMDetails.Add(newRow);
        }

        stockbomDetailsToInsert.Add(newRow);

        await stockoutsDetailsGrid.Reload();

        await stockoutsDetailsGrid.EditRow(newRow);

        StateHasChanged();

    }

    // JUNE 17, 2026
    async Task EditRow(StockBOMDetailModel stockbomDetails)
    {
        if (!stockoutsDetailsGrid.IsValid)
            return;

        bool anotherRowActive =
             stockbomDetailsToInsert.Any(x => x != stockbomDetails) ||
            stockbomDetailsToUpdate.Any(x => x != stockbomDetails);

        if (anotherRowActive)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Unsaved Row",
                Detail = "Please save or cancel the current active row before editing another."
            });
            return;
        }

        if (!stockbomDetailsToUpdate.Contains(stockbomDetails))
        {
            stockbomDetailsToUpdate.Add(stockbomDetails);
        }

        await stockoutsDetailsGrid.EditRow(stockbomDetails);
        StateHasChanged();
    }

    async Task SaveRow(StockBOMDetailModel stockbomDetails)
    {
        // This method is called when the user clicks the 'Save' (checkmark) button for a row in the grid
        await stockoutsDetailsGrid.UpdateRow(stockbomDetails);
        await stockoutsDetailsGrid.Reload();
        StateHasChanged();
    }

    void Reset(StockBOMDetailModel stockbomDetails)
    {
        stockbomDetailsToInsert.Remove(stockbomDetails);
        stockbomDetailsToUpdate.Remove(stockbomDetails);
    }

    void Reset()
    {
        stockbomDetailsToInsert.Clear();
        stockbomDetailsToUpdate.Clear();
    }

    async Task DeleteRow(StockBOMDetailModel stockbomDetails)
    {
        Reset(stockbomDetails);
        stockBOMDetails.Remove(stockbomDetails);

        ResetPosIndexes();

        await stockoutsDetailsGrid.Reload();
        StateHasChanged();
    }

    protected async Task RefreshGrid()
    {
        // Refresh the grid
        await stockoutsDetailsGrid.Reload();
    }

    // AUTO GENERATE BOM CODE ON STOCK SELECTION (NEW RECORDS ONLY)
    // AUTO FILL DESCRIPTION WITH STOCK NAME (ALWAYS, STILL EDITABLE)
    private async Task OnHeaderStockChanged(object value)
    {
        if (value is Guid selectedStockId)
        {
            // Find the selected stock
            var selectedStock = stockList?.FirstOrDefault(x => x.Id == selectedStockId);

            if (selectedStock != null)
            {
                // Auto fill Description with the Stock Name (still editable)
                stockbomModel.Description = selectedStock.StockName;
            }

            // Only auto-generate BOM Code for NEW BOM headers, not when editing an existing one
            if (Id is null)
            {
                stockbomModel.BOMCode = await stockItemsService.GetNextBOMCode(selectedStockId);
            }

            StateHasChanged();
        }
        else
        {
            // Stock was cleared
            stockbomModel.Description = string.Empty;

            if (Id is null)
            {
                stockbomModel.BOMCode = string.Empty;
            }
        }
    }

