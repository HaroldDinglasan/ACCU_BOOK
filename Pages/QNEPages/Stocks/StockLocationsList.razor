@page "/LocationsList"
@attribute [Authorize(Roles = "Admin,User")]


<RadzenStack Gap="0.2rem">

    <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenColumn Size="12" SizeSM="7">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal">
                <RadzenTextBox Disabled=@(filteredStockItemsList == null) @bind-Value="@searchText"
                               Placeholder="Search..."
                               Style="font-size:smaller; width:30rem;"
                               Change="@(args => ApplyFilter())" />
                <RadzenButton Disabled=@(filteredStockItemsList == null) Icon="search" Click="@ApplyFilter" Text="Find" />
                <RadzenButton Disabled=@(filteredStockItemsList == null) Icon="delete" Click="@ClearFilter" Text="Clear" />
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="5">
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text="New" Click="@navigate" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Icon="add"></RadzenButton>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenDataGrid @ref="grids" @bind-Value=@selectedStockLocations RowDoubleClick="() => Edit(selectedStockLocations.FirstOrDefault().Id)" TItem="VW_StockLocationsListing" AllowPaging="true" PageSize="30"
                    AllowColumnReorder="true" AllowAlternatingRows="false"
                    Data="@filteredStockItemsList" AllowColumnPicking="true" Style="height: 85vh; overflow: hidden;"
                    KeyProperty="Id" PagerHorizontalAlign="HorizontalAlign.Center" AllowColumnResize="true" Density="@density"
                    AllowSorting="true" ShowPagingSummary="true" AllowFiltering="true"
                    FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="@filter" LogicalFilterOperator="LogicalFilterOperator.Or">

        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                <span>
                    Stock Location <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" class="rz-ms-2" />
                </span>
            </RadzenStack>
        </HeaderTemplate>

        <Columns>

            <RadzenDataGridColumn Visible=true Width="120px" TItem="VW_StockLocationsListing" Property="@nameof(VW_StockLocationsListing.LocationCode)" Title="Location Code"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="160px" TItem="VW_StockLocationsListing" Property="@nameof(VW_StockLocationsListing.Description)" Title="Description"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="160px" TItem="VW_StockLocationsListing" Property="@nameof(VW_StockLocationsListing.Contact)" Title="Contact"></RadzenDataGridColumn>

            <RadzenDataGridColumn Visible=true Width="160px" TItem="VW_StockLocationsListing" Property="@nameof(VW_StockLocationsListing.PhoneNo)" Title="Phone"></RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="VW_StockLocationsListing" Property="@nameof(VW_StockLocationsListing.IsActive)" Title="Active" Width="100px">
                <Template Context="data">
                    <RadzenCheckBox Value="data.IsActive" TValue="bool" Disabled="true" />
                </Template>
            </RadzenDataGridColumn>

        </Columns>
    </RadzenDataGrid>
</RadzenStack>


@code {
    string status = string.Empty;
    private RadzenDataGrid<VW_StockLocationsListing> grids;
    private IList<VW_StockLocationsListing> selectedStockLocations { get; set; }
    private IEnumerable<VW_StockLocationsListing> stockLocationsList { get; set; }

    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    Density density = Density.Compact;
    AlignItems alignItems = AlignItems.Center;
    Variant variant = Variant.Flat;

    bool isloading;


    protected async override Task OnInitializedAsync()
    {

        await loadAllData();

    }

    private async Task loadAllData()
    {
        await GetStocksLocationList();
    }

    private async Task GetStocksLocationList()
    {
        var data = await stockItemsService.GetStocksLocationList();
        stockLocationsList = data is not null ? data : new List<VW_StockLocationsListing>();
        filteredStockItemsList = stockLocationsList; // enable search filter
    }

    protected void Edit(Guid Id)
    {
        navManager.NavigateTo($"/LocationsList/Edit/{Id}");
    }

    //DoubleClick Cell Event
    protected void OnCellContextMenu(DataGridCellMouseEventArgs<VW_StockLocationsListing> stockItems)
    {
        selectedStockLocations = new List<VW_StockLocationsListing>() { stockItems.Data };

        var contextMenuItems = new List<ContextMenuItem>
    {
        new ContextMenuItem() { Text = "New", Value = 1, Icon = "add" },
        new ContextMenuItem() { Text = "Edit", Value = 2, Icon = "edit" },
        new ContextMenuItem() { Text = "Delete", Value = 3, Icon = "delete" }
    };

        contextMenuService.Open(stockItems, contextMenuItems, (e) =>
        {
            switch (e.Value)
            {
                case 1:
                    navigate();
                    break;
                case 2:
                    Edit(stockItems.Data.Id);
                    // Edit(stockItems.Data.Id);

                    //await AddUpdateGLAccountDialog(stockItems.Data.Id, false);
                    break;
                case 3:
                    // Delete(stockItems.Data.Id);
                    break;

            }
            contextMenuService.Close();

        });
    }

    private void navigate()
    {
        navManager.NavigateTo("/Locations");
    }


    private string searchText = string.Empty;
    private IEnumerable<VW_StockLocationsListing> filteredStockItemsList;
    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredStockItemsList = stockLocationsList;
        }
        else
        {
            filteredStockItemsList = stockLocationsList.Where(x =>
                (!string.IsNullOrEmpty(x.LocationCode) && x.LocationCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Description) && x.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Contact) && x.Contact.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.PhoneNo) && x.PhoneNo.Contains(searchText, StringComparison.OrdinalIgnoreCase))

            );
        }
        StateHasChanged();
    }
    private void ClearFilter()
    {
        searchText = string.Empty;
        filteredStockItemsList = stockLocationsList;
        StateHasChanged();
    }

}
