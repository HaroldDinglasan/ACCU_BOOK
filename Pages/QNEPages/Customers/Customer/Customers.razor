@page "/Customers"
@page "/Customers/Edit/{id:guid}"
@attribute [Authorize(Roles = "Admin,User")]
@inject HttpClient http
@inject CustomersServices customerServices
@inject CurrenciesService currenciesService
@inject MiscService miscService
@inject DialogService DialogService
@inject AllTaxCodeService allTaxCodeService
@inject RequestMessageHandler requestMessageHandler
@inject DialogService dialogService
@inject ContextMenuService contextMenuService
@inject NavigationManager NavManager
@inject MenuService menuService

<RadzenTemplateForm TItem="Debtors" Data="customers" Submit="@OnSubmit">
    <RadzenStack Gap="1rem" class="sr">

        <!-- TOOLBAR ACTION CARD (hindi ginalaw) -->

        <CrudToolbar Title="@(Id.HasValue ? "Edit Customer" : "Create Customer")"
                     Subtitle="Manage customer information"
                     Icon="badge"
                     ButtonSize="@smallbtn"
                     SaveText="Save"
                     SaveBusy="@isBusy"
                     BackText="Back to Search"
                     OnBackSearch="@navigate">
        </CrudToolbar>

        <RadzenRow Gap="1rem">

            <!-- Customer information -->
            <RadzenColumn Size="12" SizeLG="8">
                <RadzenCard class="sr-card">
                    <div class="sr-card-head">
                        <div class="sr-card-icon"><RadzenIcon Icon="business" /></div>
                        <div class="sr-card-title">
                            <h3>Customer information</h3>
                            <p>Name, customer number and tax identification.</p>
                        </div>
                        @if (!string.IsNullOrEmpty(customers.Status))
                        {
                            <RadzenBadge BadgeStyle="@StatusBadge" Text="@customers.Status" IsPill="true" />
                        }
                    </div>

                    <RadzenStack Gap="1rem">
                        <RadzenFormField Style="width:100%;" Text="Customer Name*" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox Name="CustomerName" Style="width: 100%;" @bind-Value=@customers.CompanyName />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="CustomerName" Text="'Customer Name' must be not empty." />
                            </Helper>
                        </RadzenFormField>

                        <RadzenFormField Style="width:100%;" Text="Customer Name 2" AllowFloatingLabel="false">
                            <RadzenTextBox Style="width: 100%;" @bind-Value=@customers.CompanyName2 />
                        </RadzenFormField>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Style="width:100%;" Text="Customer #*" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox Name="CustomerNo" Placeholder="--Auto Generate--" @bind-Value=@customers.CompanyCode Style="width: 100%;" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="CustomerNo" Text="'Customer No' must be not empty." />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Style="width:100%;" Text="Start Date" AllowFloatingLabel="false">
                                    <RadzenDatePicker Style="width: 100%;" @bind-Value=@customers.StartDate DateFormat="MM/dd/yyyy" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Style="width:100%;" Text="TIN No" AllowFloatingLabel="false">
                                    <RadzenMask Mask="***-***-***" CharacterPattern="[0-9]" @bind-Value=@customers.RegistrationNo Placeholder="000-000-000" Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                @* wala pang bind data (kagaya ng dati) *@
                                <RadzenFormField Style="width:100%;" Text="Branch Code" AllowFloatingLabel="false">
                                    <RadzenMask Mask="*****" CharacterPattern="[0-9]" Placeholder="00000" Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <!-- Status & options -->
            <RadzenColumn Size="12" SizeLG="4">
                <RadzenCard class="sr-card">
                    <div class="sr-card-head">
                        <div class="sr-card-icon"><RadzenIcon Icon="tune" /></div>
                        <div class="sr-card-title">
                            <h3>Status &amp; options</h3>
                            <p>Account status and special handling.</p>
                        </div>
                    </div>

                    <RadzenStack Gap="0.75rem">
                        <RadzenFormField Style="width:100%;" Text="Status" AllowFloatingLabel="false">
                            <RadzenDropDown TValue="string" @bind-Value=@customers.Status ValueProperty="Status" Data="@status" TextProperty="Status" Style="width: 100%" />
                        </RadzenFormField>

                        @* wala pang bind data (kagaya ng dati) *@
                        <div class="sr-option">
                            <RadzenCheckBox Value="false" Name="GroupCompany" />
                            <div class="sr-option-grow">
                                <RadzenLabel Text="Group company" Component="GroupCompany" class="sr-option-title" />
                                <div class="sr-option-hint">This customer belongs to a company group.</div>
                                <RadzenTextBox Disabled="true" Placeholder="Group Company" Style="width: 100%; margin-top: 0.5rem;" />
                            </div>
                        </div>

                        <div class="sr-option @(customers.IsDeferredVAT == true ? "is-on" : null)">
                            <RadzenCheckBox @bind-Value=@customers.IsDeferredVAT Name="IsDeferredVAT" />
                            <div>
                                <RadzenLabel Text="Deferred VAT" Component="IsDeferredVAT" class="sr-option-title" />
                                <div class="sr-option-hint">Use deferred VAT treatment for this customer.</div>
                            </div>
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Customer details -->
        <RadzenCard class="sr-card">
            <div class="sr-card-head">
                <div class="sr-card-icon"><RadzenIcon Icon="contacts" /></div>
                <div class="sr-card-title">
                    <h3>Customer details</h3>
                    <p>Address, contact, sales terms and accounting setup.</p>
                </div>
            </div>

            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="Details" Icon="description">
                        <RadzenRow Gap="1.5rem" Style="padding-top: 0.5rem;">

                            <!-- Address -->
                            <RadzenColumn Size="12" SizeMD="6" SizeXL="3">
                                <div class="sr-sub"><RadzenIcon Icon="home" /><span>Address</span></div>
                                <RadzenStack Gap="1rem">
                                    <RadzenFormField Text="Substreet,Street" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.Address1 Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="Barangay,District/Municipality" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.Address2 Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="City/Province" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.Address3 Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="Country" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.Address4 Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="Zip Code" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.ZipCode Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenColumn>

                            <!-- Contact -->
                            <RadzenColumn Size="12" SizeMD="6" SizeXL="3">
                                <div class="sr-sub"><RadzenIcon Icon="call" /><span>Contact</span></div>
                                <RadzenStack Gap="1rem">
                                    <RadzenFormField Text="Contact Person" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.ContactPerson Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="Email" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.Email Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="Phone #" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.PhoneNo1 Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="Phone 2 #" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.PhoneNo2 Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="Fax #" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.FaxNo1 Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenFormField Text="Fax # 2" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.FaxNo2 Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenColumn>

                            <!-- Sales & terms -->
                            <RadzenColumn Size="12" SizeMD="6" SizeXL="3">
                                <div class="sr-sub"><RadzenIcon Icon="storefront" /><span>Sales &amp; terms</span></div>
                                <RadzenStack Gap="1rem">
                                    <RadzenFormField Text="Business Nature" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value=@customers.BusinessNature Style="width: 100%;" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Areas" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenDropDownDataGrid @bind-Value=customers.AreaId Style="width: 100%;" AllowSorting="false" PageSize=10 Data="@areasList" AllowVirtualization="true" AllowColumnResize="true"
                                                                AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                TextProperty="AreaCode" Density="@density" ValueProperty="Id">
                                            <Columns>
                                                <RadzenDropDownDataGridColumn Width="10%" Property="AreaCode" Title="Area Code"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Term*" Style="width: 100%;" AllowFloatingLabel="false">
                                        <ChildContent>
                                            <RadzenDropDownDataGrid Name="Terms" @bind-Value=customers.TermId Style="width: 100%;" AllowSorting="false" PageSize=10 Data="@termList" AllowVirtualization="true" AllowColumnResize="true"
                                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                    TextProperty="Term" Density="@density" ValueProperty="Id">
                                                <Columns>
                                                    <RadzenDropDownDataGridColumn Width="10%" Property="Term" Title="Term"></RadzenDropDownDataGridColumn>
                                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                </Columns>
                                            </RadzenDropDownDataGrid>
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="Terms" Text="'Term' must be not empty." />
                                        </Helper>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Agent" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenDropDownDataGrid @bind-Value=customers.SalesPersonId Style="width: 100%;" AllowSorting="false" PageSize=10 Data="@salesPersonList" AllowVirtualization="true" AllowColumnResize="true"
                                                                AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                TextProperty="StaffCode" Density="@density" ValueProperty="Id">
                                            <Columns>
                                                <RadzenDropDownDataGridColumn Width="10%" Property="StaffCode" Title="Staff Code"></RadzenDropDownDataGridColumn>
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>

                                    @* wala pang bind data (kagaya ng dati) *@
                                    <RadzenFormField Text="Price Group" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenColumn>

                            <!-- Accounting & tax -->
                            <RadzenColumn Size="12" SizeMD="6" SizeXL="3">
                                <div class="sr-sub"><RadzenIcon Icon="account_balance" /><span>Accounting &amp; tax</span></div>
                                <RadzenStack Gap="1rem">
                                    <RadzenFormField Text="Control Account*" Style="width: 100%;" AllowFloatingLabel="false">
                                        <ChildContent>
                                            <RadzenDropDownDataGrid Name="ControlAccount" @bind-Value=@customers.ControlAccountId Style="width: 100%;" PageSize=10 AllowColumnResize="true"
                                                                    AllowClear="true" AllowVirtualization="true" AllowFilteringByAllStringColumns="true"
                                                                    TextProperty="GLAccountCode" Density="@density" Data="@filteredControlAccountList" ValueProperty="Id">
                                                <Columns>
                                                    <RadzenDropDownDataGridColumn Property="GLAccountCode" Title="GL Account Code"></RadzenDropDownDataGridColumn>
                                                    <RadzenDropDownDataGridColumn Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                </Columns>
                                            </RadzenDropDownDataGrid>
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="ControlAccount" Text="'Control Account' must be not empty." />
                                        </Helper>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Category" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenDropDownDataGrid @bind-Value=@customers.CategoryId Style="width: 100%;" PageSize=10 AllowColumnResize="true"
                                                                AllowClear="true" AllowVirtualization="true" AllowFilteringByAllStringColumns="true"
                                                                TextProperty="CategoryCode" Density="@density" Data="@debtorsCategoryList" ValueProperty="Id">
                                            <Columns>
                                                <RadzenDropDownDataGridColumn Property="CategoryCode" Title="Category #"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Currency*" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenDropDownDataGrid Placeholder="" @bind-Value=@customers.CurrencyId Style="width: 100%;" PageSize=10 AllowColumnResize="true"
                                                                AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                TextProperty="CurrencyCode" Density="@density" Data="@currencyList" ValueProperty="Id">
                                            <Columns>
                                                <RadzenDropDownDataGridColumn Property="CurrencyCode" Title="CurrencyCode"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Default VAT Code" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenDropDownDataGrid @bind-Value=@customers.DefaultTaxCodeId Style="width: 100%;" AllowColumnResize="true" PageSize=10
                                                                FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                AllowClear="true" Data="@defaultVATCodeList" AllowFiltering=false
                                                                TextProperty="TaxCode" Density="@density" ValueProperty="Id">
                                            <Columns>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="TaxCode" Title="Vat #"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="Rate" Title="Rate"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="20%" Property="VatType" Title="Vat Type"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Default WTax Code" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenDropDownDataGrid @bind-Value=@customers.DefaultWTaxCodeId AllowSorting="false" Style="width: 100%" PageSize=10 AllowVirtualization="true" Data="@defaulWVaTCodeList" AllowColumnResize="true"
                                                                AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                TextProperty="Code" Density="@density" ValueProperty="Id">
                                            <Columns>
                                                <RadzenDropDownDataGridColumn Width="5%" Property="Code" Title="Code"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="5%" Property="Rates" Title="Rate"></RadzenDropDownDataGridColumn>
                                                <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                            </Columns>
                                        </RadzenDropDownDataGrid>
                                    </RadzenFormField>

                                    @* no bind data yet *@
                                    <RadzenFormField Text="Default WVaT Code" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox Disabled="true" Style="width: 100%;" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Current Balance" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenNumeric Disabled="true" ShowUpDown="false" @bind-Value=@customers.CurrentBalance Format="#,0.00" Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenColumn>

                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Credit Control" Icon="credit_score">
                        @EmptyState("Credit control settings will appear here.")
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Others" Icon="more_horiz">
                        @EmptyState("Additional customer fields will appear here.")
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>

    </RadzenStack>
</RadzenTemplateForm>

@if (isloading)
{
    <Spinner Message="Loading customer..." />
}



@code {
    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }

    bool isloading;
    bool isBusy;
    bool isVisible = false;
    bool isDisable = false;
    public string CompCode { get; set; }

    protected Debtors customers { get; set; } = new Debtors();
    IList<Debtors> selectedCustomer { get; set; }
    IEnumerable<Debtors> customerList { get; set; }
    AlignItems alignItems = AlignItems.Center;
    TextStyle textStyle = TextStyle.Body2;
    ButtonSize smallbtn = ButtonSize.Small;
    Density density = Density.Compact;
    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;

    private IEnumerable<GLAccounts> controlAccountList { get; set; } //Get GLAccount
    private IEnumerable<DebtorCategory> debtorsCategoryList { get; set; } //Get DebtorCategory
    private IEnumerable<Terms> termList { get; set; }
    //bind at Dropdownbox Currencies
    private IEnumerable<Currencies> currencyList { get; set; }
    private IEnumerable<Areas> areasList { get; set; }
    private IEnumerable<SalesPersons> salesPersonList { get; set; }
    private IEnumerable<TaxCodes> defaultVATCodeList { get; set; }
    private IEnumerable<WTaxCodes> defaulWVaTCodeList { get; set; }


    private TaxCodeFilter taxCodefilter { get; set; } = new TaxCodeFilter();

    // Placeholder para sa mga tab na wala pang laman
    RenderFragment<string> EmptyState => text => @<div class="sr-empty"><RadzenIcon Icon="construction" /><span>@text</span></div>;

    // Kulay ng status badge
    BadgeStyle StatusBadge => customers.Status switch
    {
        "ACTIVE" => BadgeStyle.Success,
        "INACTIVE" => BadgeStyle.Danger,
        "SUSPENDED" => BadgeStyle.Warning,
        "PROSPECT" => BadgeStyle.Info,
        _ => BadgeStyle.Light
    };

    protected async override Task OnInitializedAsync()
    {
        isloading = true;   // lalabas agad ang spinner habang naglo-load

        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            var RoleId = authState.FindFirst("RoleId").Value;
            await GetLoadMenuPermission(RoleId);
        }

        isloading = false;
    }


    public IEnumerable<SystemMenuObjectPermission> systemMenuObjectPermissionList;
    protected async Task GetLoadMenuPermission(string RoleId)
    {

        var data = await menuService.GetSystemMenuObjectPermissionId(RoleId);
        if (data is not null)
            systemMenuObjectPermissionList = data;

        var result = systemMenuObjectPermissionList?.FirstOrDefault(x => x.MenuName == "Customers");
        if (result?.AllowNavigate == true)
        {
            await loadAllData();
            ApplyFilters();
            loadStatus();
            if (Id is not null)
            {
                await GetCustomersById();
            }
        }
        else
        {
            NavManager.NavigateTo("/NotAuthorized");
        }

    }


    void navigate()
    {
        NavManager.NavigateTo("/CustomersList");
    }


    protected async Task loadAllData()
    {
        await LoadControlAccount();
        await LoadDebtorCategory();
        await GetTermList();
        await GetCurrencies();
        await GetAreas();
        await GetAgents();
        await GetDefaultVATCodes();
        await GetDefaulWVaTCodes();
    }

    protected async Task OnSubmit()
    {
        isBusy = true;
        if (Id is not null)
        {
            await UpdateDebtors();
        }
        else
        {
            await AddDebtors();
        }
    }


    protected async Task AddDebtors()
    {
        var data = await customerServices.InsertCustomer(customers);
        if (data is not null)
        {
            // await DialogService.Alert(data);
            // isDisable = true;
            // isBusy = false;

            if (data.Contains("must be unique"))
            {
                await DialogService.Alert(data);
                isDisable = false;
                isBusy = false;
            }
            else
            {
                //requestMessageHandler.isSucccess(true);
                await DialogService.Alert(data);
                isBusy = false;
                isDisable = true;
            }
        }


        else { requestMessageHandler.isSucccess(false); isBusy = false; }

    }

    protected async Task UpdateDebtors()
    {

        var data = await customerServices.UpdateCustomer(customers);
        if (data > 0)
        {
            requestMessageHandler.isSucccess(true);
            isDisable = true;
            isBusy = false;
        }


        else { requestMessageHandler.isSucccess(false); isBusy = false; }
    }


    //Get Customer From db.Debtors By Id
    protected async Task GetCustomersById()
    {
        var data = await customerServices.GetCustomerById(Id.ToString());
        customers = data is not null ? data : new Debtors();
    }


    //Load control account from GLAccounts
    protected async Task LoadControlAccount()
    {
        var data = await customerServices.GetControlAccounts();
        controlAccountList = data is not null ? data : new List<GLAccounts>();
    }


    private IEnumerable<GLAccounts> filteredControlAccountList;
    private void ApplyFilters()
    {
        if (controlAccountList != null)
        {
            ///Special Account Id number 8 is for Special Account type = Debtors Control Account
            filteredControlAccountList = controlAccountList.Where(account => account.SpecialAccountId == 8).ToList();
        }
    }


    //Load Category from DebtorCategory
    protected async Task LoadDebtorCategory()
    {
        var data = await customerServices.GetDebtorCategory();
        debtorsCategoryList = data is not null ? data : new List<DebtorCategory>();
    }
    protected async Task GetTermList()
    {
        var data = await miscService.GetTerms();
        termList = data is not null ? data : new List<Terms>();
    }

    //Get Currencies From db.Currencies
    protected async Task GetCurrencies()
    {

        var data = await currenciesService.GetCurrencies();
        currencyList = data is not null ? data : new List<Currencies>();
    }

    //Get Areas List From db.Areas
    protected async Task GetAreas()
    {
        var data = await miscService.GetAreas();
        areasList = data is not null ? data : new List<Areas>();
    }

    //Get Areas List From db.Areas
    protected async Task GetAgents()
    {

        var data = await customerServices.GetSalesPersons();
        salesPersonList = data is not null ? data : new List<SalesPersons>();
    }

    //Get Areas List From db.Areas
    protected async Task GetDefaulWVaTCodes()
    {

        var data = await customerServices.GetDefaulWVaTCode();
        defaulWVaTCodeList = data is not null ? data : new List<WTaxCodes>();
    }

    protected async Task GetDefaultVATCodes()
    {
        // For Output Tax Dropdownbox
        defaultVATCodeList = await GetDefaultTaxCodes(taxCodefilter = new TaxCodeFilter { IsOutOrIn = true, IsActive = true }); // For Output Tax
    }

    //GET LIST DEFAULTTAXCODELINKS from dbo.GLTaxCodelInks
    private async Task<IEnumerable<TaxCodes>> GetDefaultTaxCodes(TaxCodeFilter taxCodefilter)
    {
        var data = (await allTaxCodeService.GetTaxCodes(taxCodefilter)).ToList();

        if (data is not null)
        {
            return data;
        }
        return new List<TaxCodes>();
    }



    private async void DeleteCustomer()
    {
        if (await DialogService.Confirm("You are about to delete record(s). Do you want to proceed?", "Delete") == true)
        {
            var data = await customerServices.DeleteCustomer(customers.Id.ToString());
            if (data is not null)
            {
                await DialogService.Alert(data);
                NavManager.NavigateTo("CustomersList");
                StateHasChanged();
            }
            else
            {
                requestMessageHandler.isSucccess(false);
            }
        }

    }


    private List<StatusOption> status;
    protected void loadStatus()
    {
        status = new List<StatusOption>
        {
            new StatusOption { Status = "ACTIVE" },
            new StatusOption { Status = "INACTIVE" },
            new StatusOption { Status = "PROSPECT" },
            new StatusOption { Status = "SUSPENDED" }
        };
        customers.Status = "ACTIVE";
    }

    private class StatusOption
    {
        public string Status { get; set; }
    }
}
