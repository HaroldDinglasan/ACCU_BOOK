    private void LoadAllTaxTotalNet()
    {


        ///INCLUDE HERE THE TAX, WTAX, AMOUT, ALL DETAILS AMOUNT
        var receiptDetail = receiptDetailsList;

        receipts.TotalAmount = receiptDetail?.Sum(x => x.Amount) ?? 0.00m;
        receipts.TotalAmountLocal = receiptDetail?.Sum(x => x.AmountLocal) ?? 0.00m;

        receipts.NetTotalAmount = receiptDetail?.Sum(x => x.NetAmount) ?? 0.00m;
        receipts.NetTotalAmountLocal = receiptDetail?.Sum(x => x.NetAmountLocal) ?? 0.00m;

        receipts.TaxTotalAmount = receiptDetail?.Sum(x => x.TaxAmount) ?? 0.00m;
        receipts.TaxTotalAmountLocal = receiptDetail?.Sum(x => x.TaxAmountLocal) ?? 0.00m;

        receipts.SubtotalAmount = receiptDetail?.Sum(x => x.SubAmount) ?? 0.00m;
        receipts.SubtotalAmountLocal = receiptDetail?.Sum(x => x.SubAmountLocal) ?? 0.00m;

        receipts.TaxExclusiveTotalAmount = receiptDetail?.Sum(x => x.TaxExclusiveAmount) ?? 0.00m;
        receipts.TaxExclusiveTotalAmountLocal = receiptDetail?.Sum(x => x.TaxExclusiveAmountLocal) ?? 0.00m;

        receipts.WTaxTotalAmount = receiptDetail?.Sum(x => x.WTaxAmount) ?? 0.00m;
        receipts.WTaxTotalAmountLocal = receiptDetail?.Sum(x => x.WTaxAmountLocal) ?? 0.00m;

    }

    protected void RowRender(RowRenderEventArgs<ReceiptDetails> args)
    {
        LoadAllTaxTotalNet();

    }


    protected async void OpenDescriptionDialog()
    {
        var result = await DialogService.OpenAsync<DescriptionsDialog>("Descriptions",
            new Dictionary<string, object> { { "OwnerCode", descriptionFilter.OwnerCode } },
            new DialogOptions() { Width = "60rem", Height = "54rem", Resizable = true, Draggable = true });
        if (result == true)
        {
            await GetDescriptions();
            StateHasChanged();
        }
    }


    protected BankCharges bankCharges { get; set; } = new BankCharges();

    protected async Task GetBankChargesById()
    {
        var data = await bankChargesServices.GetBankChargesById(receipts.BankCharges.ToString());
        bankCharges = data is not null ? data : new BankCharges();
    }

    protected async void OpenBankChargesDialog()
    {
        var result = await DialogService.OpenAsync<BankChargesDialog>("Bank Charges Info",
            new Dictionary<string, object> { { "BankCharges", bankCharges } },
            new DialogOptions() { Width = "40rem", Height = "auto", Resizable = true, Draggable = true });
        if (result is BankCharges updatedBankCharges)
        {
            bankCharges = updatedBankCharges;

            StateHasChanged();
        }
    }

