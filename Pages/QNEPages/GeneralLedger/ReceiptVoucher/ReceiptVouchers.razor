    protected void InitializeDetailsRows()
    {// Initialize with 5 rows and set default Pos index
        receiptDetailsList = Enumerable.Range(1, 1)
           .Select(i => new ReceiptDetails
           {
               Pos = i,
               ReceiptId = Id ?? receipts.Id,
               IsTaxInclusive = receipts.IsTaxInclusive
           })
           .ToList();
    }


    // Helper to reset Pos index after any add/delete
    private void ResetPosIndexes()
    {
        for (int i = 0; i < receiptDetailsList.Count; i++)
        {
            receiptDetailsList[i].Pos = i + 1;
        }
    }


    //insert after row
    async Task InsertAfterRow(ReceiptDetails receiptDetails)
    {
        // If there's an active edit, prevent adding another row until it's saved.

        if (receiptDetailsToInsert.Any() || receiptDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }



        if (!grid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var newreceiptDetails = new ReceiptDetails();

        //Set QuotationId to new inserted row
        newreceiptDetails.ReceiptId = Id ?? receipts.Id;
        newreceiptDetails.IsTaxInclusive = receipts.IsTaxInclusive;
        // Assign a sequential Pos for new rows, inserting after the current row's Pos
        receiptDetailsToInsert.Add(newreceiptDetails);
        var index = receiptDetailsList.IndexOf(receiptDetails);
        if (index >= 0)
        {
            receiptDetailsList.Insert(index + 1, newreceiptDetails); // Insert after selected row
        }
        else
        {
            receiptDetailsList.Add(newreceiptDetails);
        }


        ResetPosIndexes();

        if (receiptDetails is not null)
        {
            await grid.InsertAfterRow(newreceiptDetails, receiptDetails);
        }
        else
        {
            await grid.InsertRow(newreceiptDetails);
        }

        await grid.Reload();
        StateHasChanged();
    }

    async Task EditRow(ReceiptDetails receiptDetails)
    {
        if (receiptDetailsToInsert.Any() || receiptDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!grid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        receiptDetailsToUpdate.Add(receiptDetails);
        await grid.EditRow(receiptDetails);
        StateHasChanged(); // Ensure UI updates and list is reflected
    }

