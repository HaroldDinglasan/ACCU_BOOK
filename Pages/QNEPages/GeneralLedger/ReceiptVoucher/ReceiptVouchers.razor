    public decimal WTaxAmount => receiptDetailsList?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.WTaxAmount) ?? 0.00m;
    public decimal WTaxAmountLocal => receiptDetailsList?.Where(x => x.ItemTypeCode != "D" && x.ItemTypeCode != "T").Sum(p => p.WTaxAmountLocal) ?? 0.00m;

    public decimal DueAmount => (receipts?.NetTotalAmountLocal ?? 0m) - (receipts?.WTaxTotalAmountLocal ?? 0m);
