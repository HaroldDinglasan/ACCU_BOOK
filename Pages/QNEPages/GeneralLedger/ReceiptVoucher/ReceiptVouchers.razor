    protected async Task OnSubmit()
    {
        busy = true;
        try
        {
            if (receiptDetailsToInsert.Any() || receiptDetailsToUpdate.Any())
            {
                NotificationHelper.ShowWarning(notificationService, "Unsaved Details",
                    "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
                return;
            }

            if (!receiptDetailsList.Any(x => x.Description != null))
            {
                NotificationHelper.ShowError(notificationService, "Unsaved Details",
                    "Please insert at least one data on details before saving.");
                return;
            }

            await bankChargesServices.SaveBankCharges(bankCharges);
            var data = await receiptServices.SaveReceiptHeaderAndDetails(receipts, receiptDetailsList);

            if (data is null)
            {
                btnDiseabled = false;
                return;
            }

            if (!data.Contains("Success"))
            {
                await DialogService.Alert(data);
                btnDiseabled = false;
                return;
            }

            // Success na ang save, saka lang mag-delete
            var deleteResult = string.Empty;
            if (deleteModels.Any())
            {
                deleteResult = await deleteServices.DeleteReceiptDetailRows(deleteModels);
                deleteModels.Clear();
            }

            var info = await documentsInfoService.SaveDocumentInfo(documentInfo);
            await DialogService.Alert($"{data} {info} {deleteResult}".Trim());
            btnDiseabled = true;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }


