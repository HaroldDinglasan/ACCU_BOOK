@page "/ReceiptVouchers"
@page "/ReceiptVouchers/Edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin,User")]


<RadzenTemplateForm TItem="Receipts" Data="receipts" Submit="@OnSubmit">
    <RadzenStack Gap="0.5rem" class="gl-form gl-flow">

        <!-- TOOLBAR -->
        <CrudToolbar Title="@(Id.HasValue ? "Edit Receipt Vouchers" : "Create Receipt Vouchers")"
                     Subtitle="Manage receipt voucher information"
                     Icon="badge"
                     ButtonSize="@smallbtn"
                     SaveText="Save"
                     SaveBusy="@busy"
                     SaveDisabled=@(btnDiseabled || receipts.IsCancelled is true )
                     BackText="Back to Search"
                     OnBackSearch="@Navigate" />

        <!-- HEADER: 3 grupo (Document / Payment / Cheque & tax) -->
        <RadzenCard class="gl-card is-compact">
            <div class="gl-doc-head">
                <div class="gl-card-icon is-sm"><RadzenIcon Icon="receipt_long" /></div>
                <div class="gl-doc-title"><h2>Receipt Voucher</h2></div>
                @if (!string.IsNullOrEmpty(receipts.ReceiptCode))
                {
                    <span class="gl-doc-code">@receipts.ReceiptCode</span>
                }
                <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" IsPill="true" />
                <span class="gl-spacer"></span>
                <RadzenButton Visible="Id.HasValue" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Size="ButtonSize.Small" Icon="info" Text="Document info" Click="@OpenDocumentInfoDialog" />
            </div>

            <div class="gl-groups">

                <!-- ============ GROUP 1: DOCUMENT ============ -->
                <div class="gl-group">
                    <div class="gl-group-title"><RadzenIcon Icon="description" /> Document</div>

                    <div class="gl-pair">
                        <div class="gl-field">
                            <RadzenLabel Text="Doc Date" Component="DocDate" class="gl-flabel" />
                            <RadzenDatePicker Name="DocDate" Change="SetDocumentNo" class="@redtext" @bind-Value="@receipts.ReceiptDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                        </div>
                        <div class="gl-field">
                            <RadzenLabel Text="Receipt #" Component="ReceiptNo" class="gl-flabel" />
                            <div class="gl-field-row">
                                <RadzenTextBox Name="ReceiptNo" class="@redtext" @bind-Value="@receipts.ReceiptCode" Style="width:100%;" />
                                <RadzenButton @ref=@receiptNoButton class="gl-icon-btn" Icon="format_list_numbered" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                              title="Choose number format" Click="@(args => popup.ToggleAsync(receiptNoButton.Element))" />
                            </div>
                        </div>
                    </div>

                    <div class="gl-field">
                        <RadzenLabel Text="Received From*" Component="ReceivedFrom" class="gl-flabel" />
                        <RadzenDropDown AllowClear="true" Name="ReceivedFrom" AllowFiltering="true" @bind-Value=@receipts.PaymentReceiptInfoId
                                        Data=@paymentReceiptInfoList TextProperty="Description" ValueProperty="Id" Change="@(args => OnReceivedFromChange(args))"
                                        ShowValueTemplateOnEmpty="true" Style="width:100%" />
                        <RadzenRequiredValidator Component="ReceivedFrom" Text="'Received From' must not be empty." Popup="true" />
                    </div>

                    <div class="gl-field">
                        <RadzenLabel Text="Project" Component="Project" class="gl-flabel" />
                        <RadzenDropDownDataGrid Name="Project" class="@redtext" @bind-Value=@receipts.ProjectId AllowSorting="false" Style="width:100%;"
                                                PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                TextProperty="ProjectCode" Density="@density" ValueProperty="Id"
                                                Change="@(args => OnProjectChanged(args))">
                            <Columns>
                                <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                    <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                </RadzenDropDownDataGridColumn>
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </div>

                    <div class="gl-field">
                        <RadzenLabel Text="Options" class="gl-flabel" />
                        <div class="gl-opts-row">
                            <div class="gl-opt">
                                <RadzenSwitch Name="IsDetailPosting" @bind-Value=receipts.IsDetailPosting />
                                <RadzenLabel Text="Detail posting" Component="IsDetailPosting" />
                            </div>
                            <div class="gl-opt">
                                <RadzenSwitch Name="IsTaxInclusive" @bind-Value=receipts.IsTaxInclusive Change="@IsTaxInclusiveChanged" />
                                <RadzenLabel Text="Tax inclusive" Component="IsTaxInclusive" />
                            </div>
                            @if (Id is not null)
                            {
                                <div class="@(receipts.IsCancelled == true ? "gl-opt is-danger" : "gl-opt")">
                                    <RadzenSwitch Name="IsCancelled" @bind-Value="@receipts.IsCancelled" Change=@(args => OnSwitchChanged("IsCancelled")) />
                                    <RadzenLabel Text="Cancelled" Component="IsCancelled" />
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ============ GROUP 2: PAYMENT ============ -->
                <div class="gl-group">
                    <div class="gl-group-title"><RadzenIcon Icon="account_balance_wallet" /> Payment</div>

                    <div class="gl-field">
                        <RadzenLabel Text="Description*" Component="Description" class="gl-flabel" />
                        <div class="gl-field-row">
                            <RadzenDropDown AllowClear="true" Name="Description" @bind-Value=@receipts.Description Data=@descriptionsList
                                            class="gl-edit-dd" TextProperty="Description" Change="@InitializedDetailsDescription"
                                            ValueProperty="Description" ShowValueTemplateOnEmpty="true" Style="width:100%">
                                <ValueTemplate Context="data">
                                    <RadzenTextBox @bind-Value=@receipts.Description Style="width:100%;" />
                                </ValueTemplate>
                            </RadzenDropDown>
                            <RadzenButton class="gl-icon-btn" Icon="edit_note" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                          title="Manage descriptions" Click="@OpenDescriptionDialog" />
                        </div>
                        <RadzenRequiredValidator Component="Description" Text="'Description' must not be empty." Popup="true" />
                    </div>

                    <div class="gl-field">
                        <RadzenLabel Text="Deposit To*" Component="DepositTo" class="gl-flabel" />
                        <RadzenDropDown AllowClear="true" AllowFiltering="true" Name="DepositTo" @bind-Value=@receipts.GLAccountId
                                        Data=@depositAccountList TextProperty="Description" ValueProperty="Id" Change="@InitializedDetailsDescription"
                                        ShowValueTemplateOnEmpty="true" Style="width:100%" />
                        <RadzenRequiredValidator Component="DepositTo" Text="'Deposit To' must not be empty." Popup="true" />
                    </div>

                    <div class="gl-pair is-wide-left">
                        <div class="gl-field">
                            <RadzenLabel Text="Currency*" Component="Currency" class="gl-flabel" />
                            <RadzenDropDownDataGrid Name="Currency" class="@redtext" @bind-Value=@receipts.CurrencyId AllowSorting="false" Style="width:100%;" PageSize=10 AllowColumnResize="true"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="CurrencyCode" Density="@density" Data="@currencyList" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="10%" Property="CurrencyCode" Title="CurrencyCode"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                            <RadzenRequiredValidator Component="Currency" Text="'Currency' must not be empty." Popup="true" />
                        </div>
                        <div class="gl-field">
                            <RadzenLabel Text="Rate" Component="Rate" class="gl-flabel" />
                            <RadzenNumeric Name="Rate" ShowUpDown="false" Disabled="@(IsForeignCurrency != true)" class="@redtext" @bind-Value=@receipts.CurrencyRate Style="width:100%;" Placeholder="Exchange Rate"></RadzenNumeric>
                        </div>
                    </div>

                    <div class="gl-field">
                        <RadzenLabel Text="Bank Charges" Component="BankCharges" class="gl-flabel" />
                        <div class="gl-field-row">
                            <RadzenNumeric Name="BankCharges" ShowUpDown="false" class="@redtext" @bind-Value=@bankCharges.Amount Format="#.00" Style="width:100%;"></RadzenNumeric>
                            <RadzenButton class="gl-icon-btn" Icon="account_balance" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                          title="Bank charges info" Click="@OpenBankChargesDialog" />
                        </div>
                    </div>
                </div>

                <!-- ============ GROUP 3: CHEQUE & TAX ============ -->
                <div class="gl-group">
                    <div class="gl-group-title"><RadzenIcon Icon="event_note" /> Cheque &amp; tax</div>

                    <div class="gl-field">
                        <RadzenLabel Text="Cheque/Ref No." Component="ChequeRefNo" class="gl-flabel" />
                        <RadzenTextBox Name="ChequeRefNo" class="@redtext" @bind-Value="@receipts.ReferenceNo" Style="width:100%;" />
                    </div>

                    <div class="gl-pair">
                        <div class="gl-field">
                            <RadzenLabel Text="Cheque Received" Component="ChequeReceivedDate" class="gl-flabel" />
                            <RadzenDatePicker Name="ChequeReceivedDate" class="@redtext" @bind-Value="@receipts.ChequeReceivedDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                        </div>
                        <div class="gl-field">
                            <RadzenLabel Text="Cheque Date" Component="ChequeDate" class="gl-flabel" />
                            <RadzenDatePicker Name="ChequeDate" class="@redtext" @bind-Value="@receipts.ChequeDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                        </div>
                    </div>

                    <div class="gl-field">
                        <RadzenLabel Text="Tax Date" Component="TaxDate" class="gl-flabel" />
                        <RadzenDatePicker Name="TaxDate" class="@redtext" @bind-Value="@receipts.TaxDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                    </div>
                </div>

            </div>
        </RadzenCard>

        <!-- DETAILS + NOTES (tabs). Ang grid lang ang nagsi-scroll -->
        <RadzenCard class="gl-card is-compact gl-grid-card">
            <RadzenTabs class="gl-tabs" RenderMode="TabRenderMode.Client">
                <Tabs>

                    <RadzenTabsItem Text="Receipt details" Icon="list_alt">
                        <div class="gl-tab-body">
                            <div class="gl-tab-toolbar">
                                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New" Size="ButtonSize.Small"
                                              Click="@(() => InsertAfterRow(receiptDetailsList.LastOrDefault()))" title="Add new row after this row"
                                              Disabled="@(receiptDetailsToInsert.Any() || receiptDetailsToUpdate.Any() || receipts.IsCancelled is true )" />
                            </div>

                            @* TABLE DETAILS *@
                            <div class="gl-grid-wrap">
                                <RadzenDataGrid class="gl-detail-grid" Density="Density.Compact" EmptyText="No details yet. Click Add New to start." EditMode="@editMode" @ref="grid"
                                                Data="@receiptDetailsList" AllowColumnResize=true RowCreate="@OnCreateRow" RowRender="@RowRender"
                                                TItem="ReceiptDetails" RowUpdate="@OnUpdateRow">
                                    <Columns>

                                        <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                                            <Template Context="data">
                                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                              Click="@(args => EditRow(data))" title="Edit this row"
                                                              Disabled="@(receipts.IsCancelled is true )" />
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(data))" title="Save" />
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.GLAccountId)" Title="Account" FrozenPosition="FrozenColumnPosition.Left" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var stock = glaccountlist?.FirstOrDefault(s => s.Id == data.GLAccountId);
                                                }
                                                @stock?.GLAccountCode
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenDropDownDataGrid @bind-Value="data.GLAccountId" Style="width: 100%; font-size:12px" PageSize="10" Data="@glaccountlist" AllowVirtualization="true" AllowColumnResize="true"
                                                                        Change="@(args => OnGLAccountChanged(args, data))"
                                                                        AllowClear="true" AllowSorting="false" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="GLAccountCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="6%" Property=@nameof(GLAccounts.GLAccountCode) Title="Account #" />
                                                        <RadzenDropDownDataGridColumn Width="10%" Property=@nameof(GLAccounts.Description) Title="Account Name" />
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn Width="15rem" TItem="ReceiptDetails" Title="Account Name" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var stock = glaccountlist?.FirstOrDefault(s => s.Id == data.GLAccountId);
                                                }
                                                @stock?.Description
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="17rem" TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.Description)" Title="Description" TextAlign="TextAlign.Center">
                                            <EditTemplate Context="data">
                                                <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="data.Description"></RadzenTextBox>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" TItem="ReceiptDetails" Title="Project" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var project = projectList?.FirstOrDefault(s => s.Id == data.ProjectId);
                                                }
                                                @project?.ProjectCode
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@data.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="10rem" TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.ReferenceNo)" Title="Reference/Tax Inv#" TextAlign="TextAlign.Center">
                                            <EditTemplate Context="data">
                                                <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="data.ReferenceNo"></RadzenTextBox>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" Visible=true TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.Amount)" Title="Amount" TextAlign="TextAlign.Right">
                                            <Template Context="data">
                                                @(data.Amount == 0.0000M ? "" : data.Amount.ToString("N2"))
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenNumeric Style="width: 100%; font-size:12px" Disabled="@IsDisable" Change="@(args => TransactionHelper(data))" TValue="decimal" @bind-Value="data.Amount" Format="#.00"></RadzenNumeric>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" Visible=false TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.AmountLocal)" Title="Amount Local" TextAlign="TextAlign.Right">
                                            <Template Context="data">
                                                @(data.AmountLocal == 0.0000M ? "" : data.AmountLocal.ToString("N2"))
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" Visible=false TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.SubAmount)" Title="SubAmount" TextAlign="TextAlign.Right">
                                            <Template Context="data">
                                                @(data.SubAmount == 0.0000M ? "" : data.SubAmount.ToString("N2"))
                                                @(data.SubAmountLocal == 0.0000M ? "" : data.SubAmountLocal.ToString("N2"))
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" Visible=true TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.TaxCodeId)" Title="TaxCode" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var taxcode = alltaxCodesList?.FirstOrDefault(t => t.Id == data.TaxCodeId);
                                                }
                                                @taxcode?.TaxCode
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenDropDownDataGrid Change="@(args => TransactionHelper(data))" @bind-Value="data.TaxCodeId" AllowSorting="false" Style="font-size:12px" PageSize="10" Data="@taxCodesList"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="TaxCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="TaxCode" Title="Vat #" />
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="Rate" Title="Rate" />
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="VatType" Title="VatType" />
                                                        <RadzenDropDownDataGridColumn Width="250px" Property="Description" Title="Description" />
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" Visible=true TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.TaxAmount)" Title="Tax" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @(data.TaxAmount == 0.0000M ? "" : data.TaxAmount?.ToString("N4"))
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenNumeric Style="width: 100%; font-size:12px" @bind-Value="data.TaxAmount" Disabled="@IsDisable" Change="@(args => TransactionHelper(data))" TValue="decimal?" Format="#.0000" />
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.WTaxCode)" Title="WTax Code" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var wtaxcode = wTaxCodesList?.FirstOrDefault(w => w.Id == data.WTaxCode);
                                                }
                                                @wtaxcode?.Code
                                            </Template>

                                            @* WTAXCODE DROPDOWN *@
                                            <EditTemplate Context="data">
                                                <RadzenDropDownDataGrid @bind-Value="data.WTaxCode" AllowSorting="false" Style="font-size:12px" PageSize="10" Data="@FilteredWTaxCodesList"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="Code" Density="@density" ValueProperty="Id" Change="@(args => TransactionHelper(data))">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="Code" Title="Code" />
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="Rate" Title="Rate">
                                                            <Template Context="wtaxcode">
                                                                @((wtaxcode.Rate * 100).ToString("0.00") + "%")
                                                            </Template>
                                                        </RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="250px" Property="Description" Title="Description" />
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn Width="9rem" Visible=false TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.NetAmount)" Title="NetAmount" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @(data.NetAmount == 0.0000M ? "" : data.NetAmount.ToString("N4"))
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn Width="9rem" Visible=true TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.WTaxAmount)" Title="WTax" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @(data.WTaxAmount == 0.0000M ? "" : data.WTaxAmount.ToString("N4"))
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="9rem" Visible=false TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.TaxExclusiveAmount)" Title="TaxExclusiveAmount" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @(data.TaxExclusiveAmount == 0.0000M ? "" : data.TaxExclusiveAmount?.ToString("N4"))
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="7rem" Visible=false TItem="ReceiptDetails" Title="WTax Rate" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var wtaxcode = wTaxCodesList?.FirstOrDefault(w => w.Id == data.WTaxCode);
                                                }
                                                @((wtaxcode?.Rate * 100).GetValueOrDefault().ToString("0.00") + "%")
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="7rem" Visible=false TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.IsTaxInclusive)" Title="Is TaxInclusive" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn Width="5rem" Visible=false TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.Pos)" Title="Pos" TextAlign="TextAlign.Center" />

                                        <RadzenDataGridColumn Width="11rem" Visible=true TItem="ReceiptDetails" Property="@nameof(ReceiptDetails.GLBIRClsInfo)" Title="BIR Classification" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                                            <Template Context="data">
                                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" title="Delete" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteRow(data))" Disabled="@(receiptDetailsList.Count == 1 || receipts.IsCancelled is true)" />
                                            </Template>
                                        </RadzenDataGridColumn>

                                    </Columns>
                                </RadzenDataGrid>
                            </div>
                            @* END OF TABLE DETAILS *@
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Notes" Icon="sticky_note_2">
                        <div class="gl-tab-body">
                            <RadzenTextArea Name="Notes" Placeholder="Enter notes here..." @bind-Value=@receipts.Notes
                                            class="@($"gl-notes-area {redtext}")" Style="width:100%;" />
                        </div>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>
        </RadzenCard>

        <!-- SUMMARY -->
        <div class="gl-summary is-sticky is-sm">
            <div class="gl-summary-note">
                <RadzenIcon Icon="info" />
                <span>Amounts shown in local currency</span>
            </div>
            <div class="gl-sum-item">
                <span class="gl-sum-label">Taxable</span>
                <span class="gl-sum-value">@($"{receipts.TaxExclusiveTotalAmountLocal:N2}")</span>
            </div>
            <div class="gl-sum-item">
                <span class="gl-sum-label">Tax</span>
                <span class="gl-sum-value">@($"{receipts.TaxTotalAmountLocal:N2}")</span>
            </div>
            <div class="gl-sum-item is-main">
                <span class="gl-sum-label">Due Amount</span>
                <span class="gl-sum-value"><small>@(currencyList?.FirstOrDefault(c => c.Id == receipts.CurrencyId)?.CurrencyCode)</small>@($"{DueAmount:N2}")</span>
            </div>
        </div>

    </RadzenStack>

    <RadzenPopup @ref=popup Lazy=true class="gl-popup">
        <RadzenDataGrid RowDoubleClick="() => SetDocumentNoPopup(selectedtransactionCodesList.FirstOrDefault().Id)"
                        TItem="TransactionsCode"
                        @ref=transactionsCodeGrid
                        @bind-Value="@selectedtransactionCodesList"
                        Data=@transactionCodesList>
            <Columns>
                <RadzenDataGridColumn TItem="TransactionsCode" Property="@nameof(TransactionsCode.Format)" Title="Format" TextAlign="TextAlign.Center" Width="300px">
                    <Template Context="transactionCode">
                        @transactionCode.Format
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenPopup>
</RadzenTemplateForm>


@if (isloading)
{
    <Spinner Message="Loading receipt..." />
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }


    AlignItems alignItems = AlignItems.Center;
    Density density = Density.Compact;
    TextStyle textStyle = TextStyle.Body2;
    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    Variant btnVariantText = Variant.Text;
    ButtonSize smallbtn = ButtonSize.Small;


    //FOR POP UP DIALOG
    RadzenButton receiptNoButton;   // dati: iisang "button" ref ang gamit ng tatlong button
    RadzenPopup popup;
