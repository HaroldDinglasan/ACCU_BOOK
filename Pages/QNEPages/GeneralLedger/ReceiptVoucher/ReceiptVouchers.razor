    protected List<DeleteModel> deleteModels = new();
    protected async Task DeleteLogic(ReceiptDetails receiptDetails, bool DeleteDetailRow)
    {
        if (!deleteModels.Any(dm => dm.DetailsId == receiptDetails.Id))
        {
            deleteModels.Add(new DeleteModel
            {
                Id = receipts.Id,
                DetailsId = receiptDetails.Id,
                DeleteDetailRow = DeleteDetailRow

            });
        }
    }




    async Task DeleteRow(ReceiptDetails receiptDetails)
    {
        if (receiptDetailsToInsert.Any() || receiptDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }
        if (await DialogService.Confirm("You are about to delete record(s). Do you want to proceed?", "Delete") == true)
        {
            // deleteModel.Id = receiptDetails.Id;
            // deleteModel.TableName = "ReceiptDetails";
            // var data = await deleteServices.DeleteDataOnDetailRows(deleteModel);
            await DeleteLogic(receiptDetails, true);

            Reset(receiptDetails);
            receiptDetailsList.Remove(receiptDetails); // Remove from main list
            ResetPosIndexes();
            await grid.Reload();
            StateHasChanged();
        }


    }


    void Reset(ReceiptDetails receiptDetails)
    {
        receiptDetailsToInsert.Remove(receiptDetails);
        receiptDetailsToUpdate.Remove(receiptDetails);
    }

    void Reset()
    {
        receiptDetailsToInsert.Clear();
        receiptDetailsToUpdate.Clear();
    }




    private async void TransactionHelper(ReceiptDetails row)
    {
        row.TaxRate = taxCodesList.FirstOrDefault(tax => tax.Id == row.TaxCodeId)?.TaxRate ?? 0;
        row.WTaxRate = wTaxCodesList.FirstOrDefault(tax => tax.Id == row.WTaxCode)?.Rate ?? 0;

        ReceiptTransactionHelper.Compute(row);
        // ConvertPackUOM(row);

        if (row.Amount == 0)
        {
            await DeleteLogic(row, false);
        }
    }

