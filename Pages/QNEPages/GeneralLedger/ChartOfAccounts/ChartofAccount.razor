@page "/ChartofAccount"
@attribute [Authorize(Roles = "Admin,User")]

<div class="coa">

   @*  <header class="coa-head">
        <div class="coa-icon"><RadzenIcon Icon="account_tree" /></div>
        <div>
            <h1>Chart of Accounts</h1>
            <p>Browse the account tree. Double-click an account to edit it, right-click for more actions.</p>
        </div>
    </header> *@

    <section class="coa-panel">

        <div class="coa-toolbar">
            <header class="coa-head">
                <div class="coa-icon"><RadzenIcon Icon="account_tree" /></div>
                <div>
                    <h1>Chart of Accounts</h1>
                    <p>Browse the account tree. Double-click an account to edit it, right-click for more actions.</p>
                </div>
            </header>

            <div class="coa-search">
                <RadzenIcon Icon="search" />
                <RadzenTextBox @bind-Value="@searchText"
                               @oninput="OnInput"
                               Change="@OnSearchChanged"
                               Placeholder="Search description, account code or SAC..." />
            </div>

            @if (IsSearching)
            {
                <RadzenButton Icon="close" Text="Clear"  Variant="Variant.Outlined"  Click="@ClearFilter" />
                <span class="coa-count">@(ResultCount == 1 ? "1 match" : $"{ResultCount} matches")</span>
            }

            <span class="coa-legend"><span class="coa-dot"></span> Special account</span>


            <RadzenButton Icon="download"
                          Text="Export Excel"
                          ButtonStyle="ButtonStyle.Success"
                          Variant="Variant.Outlined"
                          Click="@ExportToExcel" />


        </div>

        <RadzenDataGrid @ref="grids" CellContextMenu="(args) => OnCellContextMenu(args)" RowDoubleClick="(args) => Edit(args)"
                        Data="@filteredChartOfAccountsTree" RowRender="@RowRender"
                        AllowColumnReorder="true" TItem="ChartOfAccountTree" AllowAlternatingRows="false"
                        AllowColumnResize="true" LoadChildData="@LoadChildData" SelectionMode="DataGridSelectionMode.Single"
                        IsLoading=@isLoading Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading"
                        Density="Density.Compact" Style="height: calc(100vh - 15rem); min-height: 420px; overflow: hidden;" AllowSorting="true"
                        ColumnWidth="Auto" AllowFiltering="true" FilterPopupRenderMode="PopupRenderMode.OnDemand"
                        FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="@filterCaseSensitivity"
                        LogicalFilterOperator="LogicalFilterOperator.Or"
                        ShowMultiColumnSortingIndex="true"
                        RowCollapse="@(args => grids.ColumnsCollection.ToList().ForEach(c => c.ClearFilters()))">
            <EmptyTemplate>
                <div class="coa-empty">
                    <RadzenIcon Icon="@(IsSearching ? "search_off" : "account_tree")" />
                    <span>@(IsSearching ? $"No accounts match “{searchText.Trim()}”." : "No accounts to show.")</span>
                </div>
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn Width="480px" TItem="ChartOfAccountTree" Property="Description" Title="Description">
                    <Template Context="data">
                        <span class="@SpecialClass(data)">@Highlight(data.Description)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Visible="@IsSearching" Width="220px" TItem="ChartOfAccountTree" Title="Parent account" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <span class="coa-parent">@ParentDescription(data)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChartOfAccountTree" Property="GLAccountCode" Title="Account Code">
                    <Template Context="data">
                        <span class="coa-code @SpecialClass(data)">@Highlight(data.GLAccountCode)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChartOfAccountTree" Property="SpecialAccountCode" Title="SAC">
                    <Template Context="data">
                        <span class="@SpecialClass(data)">@Highlight(data.SpecialAccountCode)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChartOfAccountTree" Property="CurrencyCode" Title="Currency">
                    <Template Context="data">
                        <span class="@SpecialClass(data)">@data.CurrencyCode</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChartOfAccountTree" Property="InputTax" Title="Default Input Tax Code"></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChartOfAccountTree" Property="OutputTax" Title="Default Output Tax Code"></RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </section>
</div>

