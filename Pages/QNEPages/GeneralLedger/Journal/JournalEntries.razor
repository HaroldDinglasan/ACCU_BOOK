    protected async Task OnSubmit()
    {

        busy = true;
        //SAVING
        if (journalDetailsToInsert.Any() || journalDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            busy = false;
            return;
        }

        if (!journalDetailsList.Any(x => x.Description != null))
        {
            NotificationHelper.ShowError(notificationService, "Unsaved Details", "Please insert at least one data on details before saving.");
            busy = false;
            return;
        }

        var data = await journalServices.SaveJournalHeaderAndDetails(journals, journalDetailsList);
        if (data is not null)
        {
            if (data.Contains("Success"))
            {
                var info = await documentsInfoService.SaveDocumentInfo(documentInfo);
                await DialogService.Alert(data + info);
                btnDiseabled = true;
                busy = false;
            }
            else
            {
                await DialogService.Alert(data);
                btnDiseabled = false;
            }

        }
        btnDiseabled = true;
        // bill = new();
        // billDetailsList = new();
        // InitializeQuotationDetailsRows();
        StateHasChanged();
    }


