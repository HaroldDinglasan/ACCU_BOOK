    public decimal TotalDebit => journalDetailsList?.Sum(x => x.NetDebit) ?? 0.00m;
    public decimal TotalCredit => journalDetailsList?.Sum(x => x.NetCredit) ?? 0.00m;

    public decimal TotalWTaxDebit => journalDetailsList?.Sum(p => p.WTaxDebit) ?? 0.00m;
    public decimal TotalWTaxCredit => journalDetailsList?.Sum(p => p.WTaxCredit) ?? 0.00m;

    public decimal Debit => TotalDebit - TotalWTaxDebit;
    public decimal Credit => TotalCredit - TotalWTaxCredit;
    public decimal Different => Math.Abs(Debit - Credit);

