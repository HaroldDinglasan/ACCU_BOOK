    protected DeleteModel deleteModel { get; set; } = new();
    async Task DeleteRow(JournalDetails journalDetails)
    {

        if (journalDetailsToInsert.Any() || journalDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (await DialogService.Confirm("You are about to delete record(s). Do you want to proceed?", "Delete") == true)
        {
            deleteModel.Id = journalDetails.Id;
            deleteModel.TableName = "JournalDetails";
            // var data = await deleteServices.DeleteDataOnDetailRows(deleteModel);

            Reset(journalDetails);
            journalDetailsList.Remove(journalDetails); // Remove from main list
            ResetPosIndexes();
            await grid.Reload();
            StateHasChanged();
        }
    }


    void Reset(JournalDetails journalDetails)
    {
        journalDetailsToInsert.Remove(journalDetails);
        journalDetailsToUpdate.Remove(journalDetails);
    }

    void Reset()
    {
        journalDetailsToInsert.Clear();
        journalDetailsToUpdate.Clear();
    }

    private void OnCreditDebitChanged(JournalDetails journalDetails, bool isDebit)
    {
        if (isDebit)
        {
            if (journalDetails.Debit != 0)
                journalDetails.Credit = 0;
            journalDetails.IsCreditable = false;
        }
        else
        {
            if (journalDetails.Credit != 0)
                journalDetails.Debit = 0;
            journalDetails.IsCreditable = true;
        }

        TransactionHelper(journalDetails);
        StateHasChanged();
    }


