@page "/JournalEntries"
@page "/JournalEntries/Edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin,User")]

@if (isloading)
{
    <Spinner />
}
@if (isloading)
{
    <Spinner />
}
<RadzenTemplateForm TItem="Journals" Data="journals" Submit="@OnSubmit">
    <RadzenStack Gap="0.5rem" class="gl-form gl-flow">

        <!-- TOOLBAR -->
        <CrudToolbar Title="@(Id.HasValue ? "Edit Journal" : "Create Journal")"
                     Subtitle="Manage journal information"
                     Icon="badge"
                     ButtonSize="@smallbtn"
                     SaveText="Save"
                     SaveBusy="@busy"
                     SaveDisabled=@(btnDiseabled || journals.IsCancelled is true )
                     BackText="Back to Search"
                     OnBackSearch="@Navigate" />

        <!-- HEADER: 3 grupo (Document / Accounting / Options) -->
        <RadzenCard class="gl-card is-compact">
            <div class="gl-doc-head">
                <div class="gl-card-icon is-sm"><RadzenIcon Icon="menu_book" /></div>
                <div class="gl-doc-title"><h2>Journal Entry</h2></div>
                @if (!string.IsNullOrEmpty(journals.JournalCode))
                {
                    <span class="gl-doc-code">@journals.JournalCode</span>
                }
                <RadzenBadge Visible="@(status != string.Empty)" Shade="Shade.Dark" BadgeStyle="BadgeStyle.Danger" Text="@status" IsPill="true" />
                <span class="gl-spacer"></span>
                <RadzenButton Visible="Id.HasValue" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Size="ButtonSize.Small" Icon="info" Text="Document info" Click="@OpenDocumentInfoDialog" />
            </div>

            <div class="gl-groups">

                <!-- ============ GROUP 1: DOCUMENT ============ -->
                <div class="gl-group">
                    <div class="gl-group-title"><RadzenIcon Icon="description" /> Document</div>

                    <div class="gl-pair">
                        <div class="gl-field">
                            <RadzenLabel Text="Doc Date" Component="DocDate" class="gl-flabel" />
                            <RadzenDatePicker Name="DocDate" Change="SetDocumentNo" class="@redtext" @bind-Value="@journals.JournalDate" DateFormat="MM/dd/yyyy" Style="width:100%" />
                        </div>
                        <div class="gl-field">
                            <RadzenLabel Text="Journal #" Component="JournalNo" class="gl-flabel" />
                            <div class="gl-field-row">
                                <RadzenTextBox Name="JournalNo" class="@redtext" @bind-Value="@journals.JournalCode" Style="width:100%;" />
                                <RadzenButton @ref=@button class="gl-icon-btn" Icon="format_list_numbered" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                              title="Choose number format" Click="@(args => popup.ToggleAsync(button.Element))" />
                            </div>
                        </div>
                    </div>

                    <div class="gl-field">
                        <RadzenLabel Text="Description*" Component="Description" class="gl-flabel" />
                        <div class="gl-field-row">
                            <RadzenDropDown AllowFiltering="true" AllowClear="true" Name="Description" @bind-Value=@journals.Description Data=@descriptionsList
                                            class="gl-edit-dd" TextProperty="Description" ValueProperty="Description" ShowValueTemplateOnEmpty="true" Style="width:100%">
                                <ValueTemplate Context="data">
                                    <RadzenTextBox @bind-Value=@journals.Description Style="width:100%;" />
                                </ValueTemplate>
                            </RadzenDropDown>
                            <RadzenButton class="gl-icon-btn" Icon="edit_note" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                                          title="Manage descriptions" Click="@OpenDescriptionDialog" />
                        </div>
                        <RadzenRequiredValidator Component="Description" Text="'Description' must not be empty." Popup="true" />
                    </div>
                </div>

                <!-- ============ GROUP 2: ACCOUNTING ============ -->
                <div class="gl-group">
                    <div class="gl-group-title"><RadzenIcon Icon="account_balance_wallet" /> Accounting</div>

                    <div class="gl-field">
                        <RadzenLabel Text="Project" Component="Project" class="gl-flabel" />
                        <RadzenDropDownDataGrid Name="Project" class="@redtext" @bind-Value=@journals.ProjectId AllowSorting="false" Style="width:100%;"
                                                PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                TextProperty="ProjectCode" Density="@density" ValueProperty="Id"
                                                Change="@(args => OnProjectChanged(args))">
                            <Columns>
                                <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                    <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                </RadzenDropDownDataGridColumn>
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </div>

                    <div class="gl-pair is-wide-left">
                        <div class="gl-field">
                            <RadzenLabel Text="Currency*" Component="Currency" class="gl-flabel" />
                            <RadzenDropDownDataGrid Name="Currency" class="@redtext" @bind-Value=@journals.CurrencyId AllowSorting="false" Style="width:100%;" PageSize=10 AllowColumnResize="true"
                                                    AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                    TextProperty="CurrencyCode" Density="@density" Data="@currencyList" ValueProperty="Id">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Width="10%" Property="CurrencyCode" Title="CurrencyCode"></RadzenDropDownDataGridColumn>
                                    <RadzenDropDownDataGridColumn Width="10%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                </Columns>
                            </RadzenDropDownDataGrid>
                            <RadzenRequiredValidator Component="Currency" Text="'Currency' must not be empty." Popup="true" />
                        </div>
                        <div class="gl-field">
                            <RadzenLabel Text="Rate" Component="Rate" class="gl-flabel" />
                            <RadzenNumeric Name="Rate" ShowUpDown="false" Disabled="@(IsForeignCurrency != true)" class="@redtext" @bind-Value=@journals.CurrencyRate Style="width:100%;" Placeholder="Exchange Rate"></RadzenNumeric>
                        </div>
                    </div>
                </div>

                <!-- ============ GROUP 3: OPTIONS ============ -->
                <div class="gl-group">
                    <div class="gl-group-title"><RadzenIcon Icon="tune" /> Options</div>

                    <div class="gl-opts-row">
                        <div class="gl-opt">
                            <RadzenSwitch Name="IsTaxInclusive" @bind-Value=journals.IsTaxInclusive Change="@IsTaxInclusiveChanged" />
                            <RadzenLabel Text="Tax inclusive" Component="IsTaxInclusive" />
                        </div>
                        @if (Id is not null)
                        {
                            <div class="@(journals.IsCancelled == true ? "gl-opt is-danger" : "gl-opt")">
                                <RadzenSwitch Name="IsCancelled" @bind-Value="@journals.IsCancelled" Change=@(args => OnSwitchChanged("IsCancelled")) />
                                <RadzenLabel Text="Cancelled" Component="IsCancelled" />
                            </div>
                        }
                    </div>
                </div>

            </div>
        </RadzenCard>

        <!-- DETAILS + NOTES (tabs). Lumalaki ang table ayon sa dami ng row -->
        <RadzenCard class="gl-card is-compact gl-grid-card">
            <RadzenTabs class="gl-tabs" RenderMode="TabRenderMode.Client">
                <Tabs>

                    <RadzenTabsItem Text="Journal details" Icon="list_alt">
                        <div class="gl-tab-body">
                            <div class="gl-tab-toolbar">
                                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add" Text="Add New" Size="ButtonSize.Small"
                                              Click="@(() => InsertAfterRow(journalDetailsList.LastOrDefault()))" title="Add new row after this row"
                                              Disabled="@(journalDetailsToInsert.Any() || journalDetailsToUpdate.Any() || journals.IsCancelled is true )" />
                            </div>

                            @* TABLE DETAILS *@
                            <div class="gl-grid-wrap">
                                <RadzenDataGrid class="gl-detail-grid" Density="Density.Compact" EmptyText="No details yet. Click Add New to start."
                                                EditMode="@editMode" @ref="grid" ColumnWidth="90px"
                                                Data="@journalDetailsList" AllowColumnResize=true RowCreate="@OnCreateRow" RowRender="@RowRender"
                                                TItem="JournalDetails" RowUpdate="@OnUpdateRow">
                                    <Columns>

                                        <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Left">
                                            <Template Context="data">
                                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                                              Click="@(args => EditRow(data))" title="Edit this row"
                                                              Disabled="@(journals.IsCancelled is true )" />
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@((args) => SaveRow(data))" title="Save" />
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="8rem" TItem="JournalDetails" Property="@nameof(JournalDetails.GLAccountId)" Title="Account" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var stock = glaccountaccountonlylist?.FirstOrDefault(s => s.Id == data.GLAccountId);
                                                }
                                                @stock?.GLAccountCode
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenDropDownDataGrid @bind-Value="data.GLAccountId" Style="width: 100%; font-size:12px" PageSize="10" Data="@glaccountaccountonlylist" AllowVirtualization="true" AllowColumnResize="true"
                                                                        Change="@(args => OnGLAccountChanged(args, data))"
                                                                        AllowClear="true" AllowSorting="false" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="GLAccountCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="6%" Property=@nameof(GLAccounts.GLAccountCode) Title="Account #" />
                                                        <RadzenDropDownDataGridColumn Width="10%" Property=@nameof(GLAccounts.Description) Title="Account Name" />
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn Width="10rem" TItem="JournalDetails" Title="Account Name" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var stock = glaccountaccountonlylist?.FirstOrDefault(s => s.Id == data.GLAccountId);
                                                }
                                                @stock?.Description
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="JournalDetails" Property="@nameof(JournalDetails.Description)" Title="Description" TextAlign="TextAlign.Center">
                                            <EditTemplate Context="data">
                                                <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="data.Description"></RadzenTextBox>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="JournalDetails" Title="Project" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var project = projectList?.FirstOrDefault(s => s.Id == data.ProjectId);
                                                }
                                                @project?.ProjectCode
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenDropDownDataGrid class="@redtext" @bind-Value=@data.ProjectId AllowSorting="false" Style="width: 100%;" PageSize=10 Data="@projectList" AllowVirtualization="true" AllowColumnResize="true"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="ProjectCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="ProjectCode" Title="Project Code"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="15%" Property="Description" Title="Description"></RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="8%" Property="IsActive" Title="Active">
                                                            <Template Context="data2"><RadzenCheckBox TValue="bool" Value="data2.IsActive"></RadzenCheckBox></Template>
                                                        </RadzenDropDownDataGridColumn>
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="JournalDetails" Property="@nameof(JournalDetails.ReferenceNo)" Title="Reference/Tax Inv#" TextAlign="TextAlign.Center">
                                            <EditTemplate Context="data">
                                                <RadzenTextBox Style="width: 100%; font-size:12px" @bind-Value="data.ReferenceNo"></RadzenTextBox>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.Debit)" Title="Debit" TextAlign="TextAlign.Right">
                                            <Template Context="data">
                                                @(data.Debit == 0.0000M ? "" : data.Debit.ToString("N2"))
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenNumeric Style="width: 100%; font-size:12px" Disabled="@IsDisable" Change="@(args => OnCreditDebitChanged(data, isDebit: true))" TValue="decimal" @bind-Value="data.Debit" Format="#.0000"></RadzenNumeric>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.Credit)" Title="Credit" TextAlign="TextAlign.Right">
                                            <Template Context="data">
                                                @(data.Credit == 0.0000M ? "" : data.Credit.ToString("N2"))
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenNumeric Style="width: 100%; font-size:12px" Disabled="@IsDisable" Change="@(args => OnCreditDebitChanged(data, isDebit: false))" TValue="decimal" @bind-Value="data.Credit" Format="#.0000"></RadzenNumeric>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.TaxCodeId)" Title="TaxCode" TextAlign="TextAlign.Right">
                                            <Template Context="data">
                                                @{
                                                    var taxcode = alltaxCodesList?.FirstOrDefault(t => t.Id == data.TaxCodeId);
                                                }
                                                @taxcode?.TaxCode
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenDropDownDataGrid Change="@(args => TransactionHelper(data))" @bind-Value="data.TaxCodeId" AllowSorting="false" Style="font-size:12px" PageSize="10" Data="@taxCodesList"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="TaxCode" Density="@density" ValueProperty="Id">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="TaxCode" Title="Vat #" />
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="Rate" Title="Rate" />
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="VatType" Title="VatType" />
                                                        <RadzenDropDownDataGridColumn Width="250px" Property="Description" Title="Description" />
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.TaxDebit)" Title="TaxDebit" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @(data.TaxDebit == 0.0000M ? "" : data.TaxDebit.ToString("N4"))
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenNumeric Style="width: 100%; font-size:12px" Disabled="@IsDisable" Change="@(args => TransactionHelper(data))" TValue="decimal" @bind-Value="data.TaxDebit" Format="#.0000"></RadzenNumeric>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.TaxCredit)" Title="TaxCredit" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @(data.TaxCredit == 0.0000M ? "" : data.TaxCredit.ToString("N4"))
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenNumeric Style="width: 100%; font-size:12px" Disabled="@IsDisable" Change="@(args => TransactionHelper(data))" TValue="decimal" @bind-Value="data.TaxCredit" Format="#.0000"></RadzenNumeric>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.GLBIRClsInfo)" Title="BIR Classification" TextAlign="TextAlign.Center" />

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.IsCreditable)" Title="Creditable/Payable" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                <div style="cursor:pointer;width:100%;height:100%;"
                                                     @onclick="() => ToggleCreditable(data)">
                                                    @(data.IsCreditable ? "Creditable" : "Payable")
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="JournalDetails" Property="@nameof(JournalDetails.WTaxCode)" Title="WTax Code" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var wtaxcode = wTaxCodesList?.FirstOrDefault(w => w.Id == data.WTaxCode);
                                                }
                                                @wtaxcode?.Code
                                            </Template>

                                            @* WTAXCODE DROPDOWN *@
                                            <EditTemplate Context="data">
                                                <RadzenDropDownDataGrid @bind-Value="data.WTaxCode" AllowSorting="false" Style="font-size:12px" PageSize="10" Data="@FilteredWTaxCodesList"
                                                                        AllowClear="true" FilterCaseSensitivity="@filter" AllowFilteringByAllStringColumns="true"
                                                                        TextProperty="Code" Density="@density" ValueProperty="Id" Change="@(args => TransactionHelper(data))">
                                                    <Columns>
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="Code" Title="Code" />
                                                        <RadzenDropDownDataGridColumn Width="100px" Property="Rate" Title="Rate">
                                                            <Template Context="wtaxcode">
                                                                @((wtaxcode.Rate * 100).ToString("0.00") + "%")
                                                            </Template>
                                                        </RadzenDropDownDataGridColumn>
                                                        <RadzenDropDownDataGridColumn Width="250px" Property="Description" Title="Description" />
                                                    </Columns>
                                                </RadzenDropDownDataGrid>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="JournalDetails" Title="WTax Rate" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @{
                                                    var wtaxcode = wTaxCodesList?.FirstOrDefault(w => w.Id == data.WTaxCode);
                                                }
                                                @((wtaxcode?.Rate * 100).GetValueOrDefault().ToString("0.00") + "%")
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Visible=false TItem="JournalDetails" Property="@nameof(JournalDetails.IsTaxInclusive)" Title="Is TaxInclusive" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn Visible=false TItem="JournalDetails" Property="@nameof(JournalDetails.TaxExclusiveDebit)" Title="TaxExclusiveDebit" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn Visible=false TItem="JournalDetails" Property="@nameof(JournalDetails.TaxExclusiveCredit)" Title="TaxExclusiveCredit" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn Visible=false TItem="JournalDetails" Property="@nameof(JournalDetails.TaxExclusiveDebitLocal)" Title="TaxExclusiveDebitLocal" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn Visible=false TItem="JournalDetails" Property="@nameof(JournalDetails.TaxExclusiveCreditLocal)" Title="TaxExclusiveCreditLocal" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn Visible=false TItem="JournalDetails" Property="@nameof(JournalDetails.Pos)" Title="Pos" TextAlign="TextAlign.Center" />

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.WTaxDebit)" Title="WTaxDebit" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @(data.WTaxDebit == 0.0000M ? "" : data.WTaxDebit.ToString("N4"))
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenNumeric Style="width: 100%; font-size:12px" Disabled="@IsDisable" Change="@(args => TransactionHelper(data))" TValue="decimal" @bind-Value="data.WTaxDebit" Format="#.0000"></RadzenNumeric>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Visible=true TItem="JournalDetails" Property="@nameof(JournalDetails.WTaxCredit)" Title="WTaxCredit" TextAlign="TextAlign.Center">
                                            <Template Context="data">
                                                @(data.WTaxCredit == 0.0000M ? "" : data.WTaxCredit.ToString("N4"))
                                            </Template>
                                            <EditTemplate Context="data">
                                                <RadzenNumeric Style="width: 100%; font-size:12px" Disabled="@IsDisable" Change="@(args => TransactionHelper(data))" TValue="decimal" @bind-Value="data.WTaxCredit" Format="#.0000"></RadzenNumeric>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Width="45px" TextAlign="TextAlign.Center" Property="Action" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                                            <Template Context="data">
                                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" title="Delete" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" Click="@(args => DeleteRow(data))" Disabled="@(journalDetailsList.Count == 1 || journals.IsCancelled is true)" />
                                            </Template>
                                        </RadzenDataGridColumn>

                                    </Columns>
                                </RadzenDataGrid>
                            </div>
                            @* END OF TABLE DETAILS *@
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Notes" Icon="sticky_note_2">
                        <div class="gl-tab-body">
                            <RadzenTextArea Name="Notes" Placeholder="Enter notes here..." @bind-Value=@journals.Notes
                                            class="@($"gl-notes-area {redtext}")" Style="width:100%;" />
                        </div>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>
        </RadzenCard>

        <!-- SUMMARY -->
        <div class="gl-summary is-sticky is-sm">
            <div class="gl-summary-note">
                @*    @if (Different == 0)
                {
                    <span class="gl-status-chip is-ok"><RadzenIcon Icon="check_circle" /> Balanced</span>
                }
                else
                {
                    <span class="gl-status-chip is-bad"><RadzenIcon Icon="error" /> Out of balance</span>
                } *@
            </div>
            <div class="gl-sum-item">
                <span class="gl-sum-label">Difference</span>
                <span class="gl-sum-value"><small>@(currencyList?.FirstOrDefault(c => c.Id == journals.CurrencyId)?.CurrencyCode)</small>@($"{Different:N2}")</span>
            </div>
            <div class="gl-sum-item is-main">
                <span class="gl-sum-label">Debit</span>
                <span class="gl-sum-value"><small>@(currencyList?.FirstOrDefault(c => c.Id == journals.CurrencyId)?.CurrencyCode)</small>@($"{Debit:N2}")</span>
            </div>
            <div class="gl-sum-item is-main">
                <span class="gl-sum-label">Credit</span>
                <span class="gl-sum-value"><small>@(currencyList?.FirstOrDefault(c => c.Id == journals.CurrencyId)?.CurrencyCode)</small>@($"{Credit:N2}")</span>
            </div>

        </div>

    </RadzenStack>

    <RadzenPopup @ref=popup Lazy=true class="gl-popup">
        <RadzenDataGrid RowDoubleClick="() => SetDocumentNoPopup(selectedtransactionCodesList.FirstOrDefault().Id)"
                        TItem="TransactionsCode"
                        @ref=transactionsCodeGrid
                        @bind-Value="@selectedtransactionCodesList"
                        Data=@transactionCodesList>
            <Columns>
                <RadzenDataGridColumn TItem="TransactionsCode" Property="@nameof(TransactionsCode.Format)" Title="Format" TextAlign="TextAlign.Center" Width="300px">
                    <Template Context="transactionCode">
                        @transactionCode.Format
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenPopup>
</RadzenTemplateForm>





@* //FOR POP UP DIALOG *@
<style type="text/css">
    .my-popup {
        display: none;
        position: absolute;
        overflow: hidden;
        height: 160px;
        width: 300px;
        border: var(--rz-panel-border);
        background-color: var(--rz-panel-background-color);
        box-shadow: var(--rz-panel-shadow);
        border-radius: var(--rz-border-radius)
    }
</style>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }


    AlignItems alignItems = AlignItems.Center;
    Density density = Density.Compact;
    TextStyle textStyle = TextStyle.Body2;
    FilterCaseSensitivity filter = FilterCaseSensitivity.CaseInsensitive;
    Variant btnVariantText = Variant.Text;
    ButtonSize smallbtn = ButtonSize.Small;


    //FOR POP UP DIALOG
    RadzenButton button;
    RadzenPopup popup;
    RadzenDataGrid<TransactionsCode> transactionsCodeGrid;
    protected IList<TransactionsCode> selectedtransactionCodesList { get; set; }

    //FOR PROPERTY SET VALUE OF OBJECT
    string btnText = "Save";
    bool busy = false;
    string status = string.Empty;
    string redtext;

    //for diseabled quotatuion details table
    protected bool IsDisable = true;

    //for loading data
    bool isloading = true;
    bool btnDiseabled = false;



    protected Journals journals { get; set; } = new Journals();

    //FOR QUOTATION DETAILS GRID
    // Add this after initializing quotationsDetailsList to ensure a first row is loaded by default
    RadzenDataGrid<JournalDetails> grid;
    DataGridEditMode editMode = DataGridEditMode.Single;
    List<JournalDetails> journalDetailsToInsert = new List<JournalDetails>();
    List<JournalDetails> journalDetailsToUpdate = new List<JournalDetails>();
    protected List<JournalDetails> journalDetailsList { get; set; }

    //ALL LIST FOR DROPDOWN BOX INPUT
    protected IEnumerable<Projects> projectList { get; set; }
    protected IEnumerable<Currencies> currencyList { get; set; }
    protected IEnumerable<Creditors> supplieraccountList { get; set; }
