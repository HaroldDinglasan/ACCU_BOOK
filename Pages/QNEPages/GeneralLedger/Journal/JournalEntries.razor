    protected void InitializeDetailsRows()
    {// Initialize with 5 rows and set default Pos index
        journalDetailsList = Enumerable.Range(1, 5)
           .Select(i => new JournalDetails
           {
               Pos = i,
               JournalId = Id ?? journals.Id,
               IsTaxInclusive = journals.IsTaxInclusive
           })
           .ToList();
    }


    // Helper to reset Pos index after any add/delete
    private void ResetPosIndexes()
    {
        for (int i = 0; i < journalDetailsList.Count; i++)
        {
            journalDetailsList[i].Pos = i + 1;
        }
    }


    //insert after row
    async Task InsertAfterRow(JournalDetails journalDetails)
    {
        // If there's an active edit, prevent adding another row until it's saved.

        if (journalDetailsToInsert.Any() || journalDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }



        if (!grid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var newjournalDetails = new JournalDetails();

        //Set QuotationId to new inserted row
        newjournalDetails.JournalId = Id ?? journals.Id;
        newjournalDetails.IsTaxInclusive = journals.IsTaxInclusive;
        // Assign a sequential Pos for new rows, inserting after the current row's Pos
        journalDetailsToInsert.Add(newjournalDetails);
        var index = journalDetailsList.IndexOf(journalDetails);
        if (index >= 0)
        {
            journalDetailsList.Insert(index + 1, newjournalDetails); // Insert after selected row
        }
        else
        {
            journalDetailsList.Add(newjournalDetails);
        }


        ResetPosIndexes();

        if (journalDetails is not null)
        {
            await grid.InsertAfterRow(newjournalDetails, journalDetails);
        }
        else
        {
            await grid.InsertRow(newjournalDetails);
        }

        await grid.Reload();
        StateHasChanged();
    }

    async Task EditRow(JournalDetails journalDetails)
    {
        if (journalDetailsToInsert.Any() || journalDetailsToUpdate.Any())
        {
            NotificationHelper.ShowWarning(notificationService, "Unsaved Details", "Please click the 'Save' (checkmark) button for any active or newly added detail rows in the grid before saving.");
            return;
        }

        if (!grid.IsValid) return;
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        journalDetailsToUpdate.Add(journalDetails);
        await grid.EditRow(journalDetails);
        StateHasChanged(); // Ensure UI updates and list is reflected
    }

