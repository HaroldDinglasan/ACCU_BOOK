@page "/JournalEntriesList"

<RadzenStack Gap="0.2rem">
    <RadzenDataGrid @ref="grid" Visible="true" @bind-Value=@selectedvwJournal
                    IsLoading=@isLoading Sort="@ShowLoading" Page="@ShowLoading" Group="@ShowLoading" Filter="@ShowLoading"
                    Data="@GetData()"
                    TItem="VW_Journals"
                    RowDoubleClick="() => Edit(selectedvwJournal.FirstOrDefault().Id)"
                    AllowVirtualization="true"
                    ColumnWidth="200px"
                    AllowSorting="true"
                    AllowFiltering="true"
                    ShowPagingSummary="true"
                    ShowMultiColumnSortingIndex="true"
                    FilterMode="FilterMode.CheckBoxList"
                    Style="height: 84vh"
                    AllowColumnPicking="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <HeaderTemplate>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center"
                         Style="width: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem;">
                    <RadzenButton Size="ButtonSize.Small" Text="New"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Icon="add"
                                  Click="@Add" />

                    <!-- DIVIDER -->
                    <div style="border-left: 2px solid #ccc; height: 2rem; margin: 0 0.5rem;"></div>

                    <RadzenTextBox InputSize="InputSize.Medium" @bind-Value="@searchText"
                                   @ref="textBox"
                                   @oninput="@(args => OnInput(args))"
                                   Placeholder="Search..."
                                   Style="width:30rem;" />

                    <RadzenButton Size="ButtonSize.Small" Icon="delete"
                                  Click="@ClearFilter"
                                  Text="Clear" />
                </RadzenStack>
            </RadzenStack>
        </HeaderTemplate>
        <Columns>

            <RadzenDataGridColumn Filterable="false" Width="120px" Visible=true Title="Status">

                <Template Context="data">
                    @if (data.IsCancelled)
                    {
                        <RadzenBadge Text="Cancelled" BadgeStyle="BadgeStyle.Danger" />
                    }
             
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Visible=false TItem="VW_Journals" Property="@nameof(VW_Journals.Id)" Title="Id" />
            <RadzenDataGridColumn Width="110px" TItem="VW_Journals" Property="@nameof(VW_Journals.JournalDate)" FormatString="{0:MM/dd/yyyy}" Title="Date" />
            <RadzenDataGridColumn Width="350px" TItem="VW_Journals" Title="Journal">
                <Template Context="data">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenStack Gap="0">
              
                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0 rz-text-wrap">@data.JournalCode - @data.Description</RadzenText>
                             <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0 rz-text-wrap">@data.Notes</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </Template>
                <FooterTemplate>
                    Total: <b>@totalData</b>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VW_Journals" Property="@nameof(VW_Journals.ProjectCode)" Title="Project" />
            <RadzenDataGridColumn Width="120px" TItem="VW_Journals" Property="@nameof(VW_Journals.CurrencyCode)" Title="Currency" />
            <RadzenDataGridColumn Visible=false Width="120px" TItem="VW_Journals" Property="@nameof(VW_Journals.TaxDate)" Title="Tax Date" FormatString="{0:MM/dd/yyyy}" />
            <RadzenDataGridColumn TItem="VW_Journals" Property="@nameof(VW_Journals.TotalDebit)" Title="Debit" FormatString="{0:N2}" />
            <RadzenDataGridColumn TItem="VW_Journals" Property="@nameof(VW_Journals.TotalCredit)" Title="Credit" FormatString="{0:N2}" />
            <RadzenDataGridColumn Visible=false TItem="VW_Journals" Property="@nameof(VW_Journals.IsCancelled)" Title="IsCancelled" />

        </Columns>
    </RadzenDataGrid>
</RadzenStack>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> authenticationState { get; set; }

    RadzenTextBox textBox;
    RadzenDataGrid<VW_Journals> grid;
    IEnumerable<VW_Journals> vwJournalList;
    protected IList<VW_Journals> selectedvwJournal { get; set; }

    int totalData = 0;
    bool isLoading;
    protected override async Task OnInitializedAsync()
    {
        var authState = (await authenticationState).User;
        if (authState.Identity.IsAuthenticated)
        {
            var RoleId = authState.FindFirst("RoleId").Value;
            GetLoadMenuPermission(RoleId);
        }
    }
    private SystemMenuObjectPermission? permission;
    protected async void GetLoadMenuPermission(string RoleId)
    {
        isLoading = true;
        permission = await permissionService.GetPermissionAsync(
            RoleId,
            "Journal Entries");

        if (permission is null)
            return;
        await ShowLoading();
        await GetListing();
        StateHasChanged();
    }

  
    private async Task GetListing()
    {
        var data = await journalServices.GetVWJournalsList();
        vwJournalList = data is not null ? data : new List<VW_Journals>();
        totalData = vwJournalList.Count();
    }
    private string searchText = "";
    private IEnumerable<VW_Journals> GetData()
    {
        if (vwJournalList == null)
            return Enumerable.Empty<VW_Journals>();


        return vwJournalList
     .Where(x => string.IsNullOrEmpty(searchText) ||
             (x.JournalCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (x.ProjectCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (x.ProjectCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (x.ProjectCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (x.Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    async Task OnInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        await grid.Reload();
    }

    private async Task ClearFilter()
    {
        searchText = string.Empty;
        await grid.Reload();
        StateHasChanged();
    }

    protected void Edit(Guid Id)
    {
        navManager.NavigateTo($"/JournalEntries/Edit/{Id}");
    }

    private void Add()
    {
        navManager.NavigateTo("/JournalEntries");
    }


    async Task ShowLoading()
    {
        await Task.Yield();

        isLoading = false;
    }

}